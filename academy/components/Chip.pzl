<!-- component: Chip -->
<!-- A chip on surface-2 in a rule hairline with sm corners, never tinted; current (the page it links to, or pressed) fills it with the text colour. With href it is a link; otherwise a toggle that filters the timetable to value (theme.ts; none pressed shows every subject). -->
{#let cls = 'inline-flex min-h-control-sm shrink-0 items-center rounded-sm border border-scheme-rule bg-scheme-surface-2 px-chip text-label whitespace-nowrap transition-colors duration-fast hover:bg-scheme-rule current:border-scheme-foreground current:bg-scheme-foreground current:text-scheme-background'}
{#if href}<a class="{ cls }" href="{ href }" aria-current={ current ? 'page' : null }>{ label }</a>{:else}<button class="{ cls }" type="button" data-subject-filter={ value } aria-pressed="false">{ label }</button>{/if}
