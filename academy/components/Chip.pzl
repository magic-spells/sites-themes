<!-- component: Chip -->
<!-- A chip on surface-2, never tinted; current inverts it to the text colour. With href it is a link (current marks the page); otherwise a button that filters the timetable to value (an empty value is All). -->
{#let cls = 'inline-flex min-h-control-sm shrink-0 items-center rounded-sm bg-scheme-surface-2 px-cell text-label whitespace-nowrap transition-colors duration-fast hover:bg-scheme-rule current:bg-scheme-foreground current:text-scheme-background'}
{#if href}<a class="{ cls }" href="{ href }" aria-current={ current ? 'page' : null }>{ label }</a>{:else}<button class="{ cls }" type="button" data-subject-filter={ value } aria-pressed={ current ? 'true' : 'false' }>{ label }</button>{/if}
