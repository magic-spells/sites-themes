<!-- component: DateRow -->
<!-- A dated thing on a rule. From 48rem four columns on one baseline: the day or range, the title, the time and the note in small muted. On phones the date, the title, then the time and the note joined by " · ". The title links to the event's link, or a dated class to its page. -->
{#let
  f = entry.fields
  href = f.link || (f.class ? '/classes/' + f.class.handle : '')
}
<li class="grid gap-space-2xs border-b border-scheme-rule py-space-md md:grid-cols-date md:items-baseline md:gap-space-lg">
  <span class="font-medium"><DateRange from={ f.date } to={ f.end_date } /></span>
  {#if href}<a class="font-medium underline-offset-4 hover:underline hover:decoration-1" href="{ href }">{ entry.title }</a>{:else}<span class="font-medium">{ entry.title }</span>{/if}
  <span class="text-small md:contents"><span class="tabular-nums">{ f.time }</span>{#if f.time && f.note}<span class="text-scheme-muted md:hidden"> · </span>{/if}<span class="text-scheme-muted">{ f.note }</span></span>
</li>
