<!-- component: FormFields -->
<!-- A site form's fields. The engine's field types are text, textarea, email, checkbox and select, so the id picks the input: "phone" is a telephone field. Selects are select-dropdowns (Select); a select with one option is sent hidden. From 48rem, when the form has a phone, its short fields pair up two to a row; selects and the message take the full row. Placeholders are locale strings keyed by the field id. -->
{#let paired = fields | find('id', 'phone')}
<div class="grid gap-space-md md:grid-cols-2">
  {#for field in fields}
    {#if field.type == 'select' && field.options.length == 1}
      <input type="hidden" name={ field.id } value={ field.options[0] } />
    {:else if field.type == 'select'}
      <Select field={ field } prefix={ prefix } preset={ preset } />
    {:else if field.type == 'checkbox'}
      <label class="flex items-start gap-space-xs text-small md:col-span-2"><input class="mt-space-2xs size-icon accent-scheme-foreground" type="checkbox" name={ field.id } value="on" checked={ field.value == 'on' } required={ field.required } />{ field.label }</label>
    {:else}
      <Field name={ field.id } label={ field.label } type={ field.id == 'phone' ? 'tel' : field.type } placeholder={ t('placeholder.' + field.id) } required={ field.required } maxlength={ field.max_length } value={ field.value } error={ field.error } prefix={ prefix } wide={ !paired || field.type == 'textarea' } />
    {/if}
  {/for}
</div>
