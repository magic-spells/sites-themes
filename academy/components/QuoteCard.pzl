<!-- component: QuoteCard -->
<!-- A testimonial on a surface-2 card with lg corners: the quote, then "Name · line" in small with the square thumbnail beside it when there is one. -->
{#let f = entry.fields}
<figure class="flex h-full flex-col gap-space-md rounded-lg bg-scheme-surface-2 p-space-lg { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
  <blockquote class="flex-1 text-lead text-pretty">{ f.quote }</blockquote>
  <figcaption class="flex items-center gap-space-sm">
    {#if f.image}<span class="w-avatar shrink-0"><Well asset={ f.image } alt={ f.image_alt } ratio="aspect-square" width={ 112 } sizes="3.5rem" /></span>{/if}
    <span class="text-small font-medium">{ [f.name, f.line] | compact | join(' · ') }</span>
  </figcaption>
</figure>
