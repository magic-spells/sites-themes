<!-- component: SectionHead -->
<!-- A section's head: the heading in h2 (its words rise in), an optional standfirst under it, and at the right, on the head's last line, the small outlined "All …" button (view_all_label to view_all_href). Stacks on phones, the button under the text. Nothing without a heading. -->
{#if heading}
<div class="mb-space-xl flex flex-wrap items-end justify-between gap-x-space-lg gap-y-space-md">
  <div class="grid max-w-prose gap-space-xs max-md:w-full">
    <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ heading } /></h2>
    {#if text}<p class="text-lead text-pretty text-scheme-muted">{ text }</p>{/if}
  </div>
  {#if view_all_label && view_all_href}<Button href={ view_all_href } tone="outline" small>{ view_all_label }</Button>{/if}
</div>
{/if}
