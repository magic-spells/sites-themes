<!-- component: Select -->
<!-- A form's select field as a select-dropdown: the label, the trigger named by the label and the chosen option (or "Select…" in muted, theme.css), the options in a panel on 2.5rem rows, and the error under it as in Field. preset chooses the option that reads the same (a class page's title in the ask form) when the visitor has chosen none. -->
{#let
  chosen = field.value || (contains(field.options, preset) ? preset : '')
  id = prefix + '-' + field.id
}
<div class="md:col-span-2">
  <span class="mb-space-xs block text-small font-medium" id="label-{ id }">{ field.label }{#if field.required}<span aria-hidden="true"> *</span>{/if}</span>
  <select-dropdown class="text-body" required={ field.required }>
    <select-trigger class="flex min-h-control items-center justify-between gap-space-sm rounded-input px-cell { field.error ? 'border-scheme-foreground ring-1 ring-scheme-foreground ring-inset' : '' }" aria-labelledby="label-{ id } value-{ id }" aria-describedby={ field.error ? 'error-' + id : null }>
      <span class="select-label-text truncate" id="value-{ id }">{ chosen || t('choose') }</span>
      <Icon name="chevron-down" />
    </select-trigger>
    <input type="hidden" name={ field.id } value={ chosen } />
    <select-panel class="*:flex *:min-h-option *:items-center *:py-0">
      {#for option in field.options}<select-option value={ option } selected={ chosen == option }>{ option }</select-option>{/for}
    </select-panel>
  </select-dropdown>
  {#if field.error}<FieldError id="error-{ id }" error={ field.error } />{/if}
</div>
