<!-- component: Select -->
<!-- A form's select field as a select-dropdown: the label, the trigger with the chosen option or "Select…", the options in a panel, and the error under it. preset chooses the option that reads the same (a class page's title in the ask form) when the visitor has chosen none. -->
{#let
  chosen = field.value || (contains(field.options, preset) ? preset : '')
  err = 'error-' + prefix + '-' + field.id
}
<div class="md:col-span-2">
  <span class="mb-space-xs block text-small font-medium" id="label-{ prefix }-{ field.id }">{ field.label }{#if field.required}<span aria-hidden="true"> *</span>{/if}</span>
  <select-dropdown class="text-body" aria-labelledby="label-{ prefix }-{ field.id }">
    <select-trigger class="flex min-h-control items-center justify-between gap-space-sm rounded-input px-cell { field.error ? 'border-scheme-error' : '' }" aria-describedby={ field.error ? err : null }>
      <span class="select-label-text truncate { chosen ? '' : 'text-scheme-muted' }">{ chosen || t('choose') }</span>
      <Icon name="chevron-down" />
    </select-trigger>
    <input type="hidden" name={ field.id } value={ chosen } />
    <select-panel>
      {#for option in field.options}<select-option value={ option } selected={ chosen == option }>{ option }</select-option>{/for}
    </select-panel>
  </select-dropdown>
  {#if field.error}<p class="mt-space-xs text-small text-scheme-error" id="{ err }">{ t('form_field_' + field.error) }</p>{/if}
</div>
