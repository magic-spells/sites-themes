<!-- component: Swatch -->
<!-- A subject's cover: the scheme its place among subjects gives it, taken in turn from blue, brick, burgundy, ink and light blue. subjects is that order, the distinct subjects in class order, which the calling section works out once (classes | sort('fields.order') | map('fields.subject') | uniq | compact): sorting entries is the dearest step in a render, too dear to repeat per swatch. So an owner changes a cover by reordering classes. Bare, it is the 0.875rem square with sm corners and an inset hairline in the cover's rule colour; with cls it is a block in the cover's colours with that class list, around its children (a subject's cover, a class card). -->
{#let covers = ['blue', 'brick', 'burgundy', 'ink', 'light-blue']}
{#for name in subjects, i}{#if name == subject}{#let cover = covers[i % 5] | scheme_class}{#if cls}<div class="{ cover } bg-scheme-background text-scheme-foreground { cls }"><Children/></div>{:else}<span class="{ cover } inline-block size-swatch shrink-0 rounded-sm bg-scheme-background ring-1 ring-scheme-rule ring-inset" aria-hidden="true"></span>{/if}{/if}{/for}
