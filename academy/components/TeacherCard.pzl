<!-- component: TeacherCard -->
<!-- A teacher, one link to their page: the 4:5 photo, the role in small muted, then the name in Card title (first in the markup, so it leads the link's name). -->
<a class="group flex h-full flex-col gap-space-2xs { site.settings.reveal ? 'reveal reveal-fade-up' : '' }" href="{ base_path ?? '/teachers' }/{ entry.handle }">
  <Well asset={ entry.fields.image } alt="" ratio="aspect-portrait" width={ 640 } sizes="(min-width: 64rem) 18rem, (min-width: 48rem) 33vw, 70vw" zoom />
  <h3 class="order-last font-heading text-h4 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">{ entry.title }</h3>
  <p class="pt-space-xs text-small text-scheme-muted">{ entry.fields.role }</p>
</a>
