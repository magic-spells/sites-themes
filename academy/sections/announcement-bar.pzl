<!-- One line above the header, the whole line one link: the notice, then the link label underlined. Ticker: the line repeats on a marquee with a pause button; under reduced motion it stands still. A close button at the right that, with a key, hides it for good. -->
{#if settings.text}
<aside class="bg-scheme-background text-scheme-foreground" data-dismiss-key="{ settings.key }" aria-label="{ t('announcement') }" data-ticker={ settings.motion == 'ticker' ? true : null }>
  <div class="flex items-center ps-control">
    <a class="block min-w-0 flex-1 py-space-xs text-small" href={ settings.link || null }>
      {#if settings.motion == 'ticker'}
        <scrolling-content class="block" speed="30" fade>
          <scrolling-track>
            <scrolling-item class="flex items-center">{#for n in [1, 2, 3]}<span class="whitespace-nowrap">{ settings.text }{#if settings.link_label} <span class="underline decoration-1 underline-offset-4">{ settings.link_label }</span>{/if}</span><Icon name="dot" cls="mx-space-lg size-dot" />{/for}</scrolling-item>
          </scrolling-track>
        </scrolling-content>
      {:else}
        <span class="block text-center text-pretty">{ settings.text }{#if settings.link_label} <span class="ms-space-xs underline decoration-1 underline-offset-4">{ settings.link_label }</span>{/if}</span>
      {/if}
    </a>
    {#if settings.motion == 'ticker'}<button class="flex size-control shrink-0 items-center justify-center text-scheme-muted hover:text-scheme-foreground" type="button" data-ticker-toggle aria-pressed="false"><Icon name="pause" cls="size-icon-sm" /><span class="sr-only">{ t('pause') }</span></button>{/if}
    <button class="flex size-control shrink-0 items-center justify-center text-scheme-muted hover:text-scheme-foreground" type="button" data-dismiss><Icon name="close" cls="size-icon-sm" /><span class="sr-only">{ t('dismiss') }</span></button>
  </div>
</aside>
{/if}

<schema>
{
  "name": "Announcement bar",
  "description": "One notice above the header, the whole line a link, with a close button.",
  "kind": "Header",
  "icon": "megaphone",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Autumn term starts Monday 7 September" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Term dates" },
    { "type": "url", "id": "link", "label": "Link", "default": "/dates" },
    { "type": "select", "id": "motion", "label": "Motion", "default": "ticker", "options": [
      { "value": "static", "label": "Still" },
      { "value": "ticker", "label": "Ticker" }
    ] },
    { "type": "text", "id": "key", "label": "Dismiss key", "default": "", "info": "Set a key (any word) and a closed bar stays closed for that visitor. Change it to show a new notice to everyone." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "ink" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "ink" } }
  ]
}
</schema>
