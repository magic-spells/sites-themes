<!-- One line above the header in the Label type, 2.5rem high, the whole line a link when it has one. Ticker: the line and a dot repeat on a marquee (scrolling-content fills the row with hidden copies); under reduced motion one line stands still. A close button (the way to stop it) at the right that, with a key, hides it for good. -->
{#if settings.text}
<aside class="bg-scheme-background text-scheme-foreground" data-dismiss-key="{ settings.key }" aria-label="{ t('announcement') }" data-ticker={ settings.motion == 'ticker' ? true : null }>
  <div class="flex min-h-bar items-center ps-control-sm">
    <a class="block min-w-0 flex-1 text-label" href={ settings.link || null }>
      {#if settings.motion == 'ticker'}
        <scrolling-content class="block" speed="30" fade>
          <scrolling-track class="gap-space-lg">
            <scrolling-item class="flex items-center"><span class="whitespace-nowrap">{ settings.text }</span><Icon name="dot" cls="ms-space-lg size-dot motion-reduce:hidden" /></scrolling-item>
          </scrolling-track>
        </scrolling-content>
      {:else}
        <span class="block text-center text-pretty">{ settings.text }</span>
      {/if}
    </a>
    <button class="flex size-control-sm shrink-0 items-center justify-center text-scheme-muted hover:text-scheme-foreground" type="button" data-dismiss><Icon name="close" cls="size-icon-sm" /><span class="sr-only">{ t('dismiss') }</span></button>
  </div>
</aside>
{/if}

<schema>
{
  "name": "Announcement bar",
  "description": "One notice above the header, the whole line a link, with a close button.",
  "kind": "Header",
  "icon": "megaphone",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Spring term starts Monday 4 January" },
    { "type": "url", "id": "link", "label": "Link", "default": "/dates" },
    { "type": "select", "id": "motion", "label": "Motion", "default": "ticker", "options": [
      { "value": "static", "label": "Still" },
      { "value": "ticker", "label": "Ticker" }
    ] },
    { "type": "text", "id": "key", "label": "Dismiss key", "default": "", "info": "Set a key (any word) and a closed bar stays closed for that visitor. Change it to show a new notice to everyone." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "ink" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "ink" } }
  ]
}
</schema>
