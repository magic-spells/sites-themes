<!-- The ask on the page, where every ask button lands without JavaScript. From 64rem seven parts to five: the School ask form under its heading (the ask label unless one is set) with the same sent and error states as the sheet; beside it the school's details as a ruled list: the first location's address with the pin and its hours, then the Contact phone and email. With School ask set to link, the heading, the confirm line and a button to the ask link stand in for the form. -->
{#let
  s = site.settings
  loc = content.locations.entries | sort('fields.order') | first
  heading = settings.heading || s.ask_label
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl lg:grid-cols-wide-narrow lg:gap-space-2xl">
    {#if s.ask == 'link'}
      <div class="grid justify-items-start gap-space-md">
        <h2 class="font-heading text-h2 text-balance text-scheme-heading">{ heading }</h2>
        {#if s.confirm_line}<p class="text-small text-scheme-muted">{ s.confirm_line }</p>{/if}
        <Button ask />
      </div>
    {:else}
      <div class="max-w-prose"><AskFields heading={ heading } prefix="page" /></div>
    {/if}
    <dl class="grid border-t border-scheme-rule text-small">
      {#if loc.fields.address}<div class="grid gap-space-2xs border-b border-scheme-rule py-cell"><dt class="text-scheme-muted">{ t('address') }</dt><dd class="flex gap-space-xs"><Icon name="pin" cls="mt-space-2xs size-icon-sm" /><span class="whitespace-pre-line">{ [loc.title, loc.fields.address] | compact | join('\n') }</span></dd></div>{/if}
      {#if loc.fields.hours}<div class="grid gap-space-2xs border-b border-scheme-rule py-cell"><dt class="text-scheme-muted">{ t('hours') }</dt><dd class="whitespace-pre-line">{ loc.fields.hours }</dd></div>{/if}
      {#if s.phone}<div class="grid gap-space-2xs border-b border-scheme-rule py-cell"><dt class="text-scheme-muted">{ t('phone') }</dt><dd><a class="underline decoration-1 underline-offset-4" href="tel:{ s.phone | replace(' ', '') }">{ s.phone }</a></dd></div>{/if}
      {#if s.email}<div class="grid gap-space-2xs border-b border-scheme-rule py-cell"><dt class="text-scheme-muted">{ t('email') }</dt><dd><a class="underline decoration-1 underline-offset-4" href="mailto:{ s.email }">{ s.email }</a></dd></div>{/if}
    </dl>
  </div>
</section>

<schema>
{
  "name": "Ask form",
  "description": "The ask form beside the school's address, hours, phone and email.",
  "kind": "Contact",
  "icon": "send",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Leave empty to use the School ask label." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
