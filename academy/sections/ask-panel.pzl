<!-- The ask sheet behind every ask button: the School ask form in a bottom-sheet on a phone that becomes a centred 40rem dialog from 48rem (styles/theme.css). On a class page its class select starts on that class. It hands focus back to the button that opened it. Sent and error states come back on the page as ?form=…&sent=1 or &error=1, and the sheet opens on its own there. With School ask set to link it is not drawn. -->
{#if site.settings.ask != 'link'}
<dialog-panel>
  <dialog class="text-scheme-foreground" aria-labelledby="ask-title">
    <bottom-sheet id="ask" data-centred>
      <bottom-sheet-header class="flex items-start justify-between gap-space-md py-space-md">
        <div class="grid gap-space-xs">
          <h2 class="font-heading text-h2 text-scheme-heading" id="ask-title">{ settings.heading }</h2>
          {#if settings.text}<p class="text-lead text-pretty text-scheme-muted">{ settings.text }</p>{/if}
        </div>
        <button class="-m-space-xs flex size-control shrink-0 items-center justify-center" type="button" data-action-hide-dialog><Icon name="close" cls="size-space-md" /><span class="sr-only">{ t('close') }</span></button>
      </bottom-sheet-header>
      <bottom-sheet-content>
        <AskFields handle={ settings.form } prefix="sheet" />
      </bottom-sheet-content>
    </bottom-sheet>
  </dialog>
</dialog-panel>
{/if}

<schema>
{
  "name": "Ask panel",
  "description": "The ask form behind every ask button: a sheet on phones, a dialog from tablets.",
  "kind": "Panels",
  "icon": "send",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ask about a class" },
    { "type": "text", "id": "text", "label": "Text", "default": "Tell us who the lessons are for and which days suit. We reply with a place or the waiting list." },
    { "type": "form", "id": "form", "label": "Form", "info": "Leave empty to use the School ask form." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
