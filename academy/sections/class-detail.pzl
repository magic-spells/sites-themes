<!-- A class's page, seven parts to five from 64rem. Left: the subject, the title in h1, the summary as a standfirst, one decision row (the price and its period, the ask button, a rule under), the description and what to bring. Right: the photo, the facts on leaders (ages, level, length, teacher), its week (the weekly sessions in day order) and its dated runs (events of kind class), or "By arrangement" when it has neither. -->
{#let
  entry = page.entry
  f = entry.fields
  weekly = content.sessions.entries | where('fields.class.handle', entry.handle) | sort('fields.start')
  runs = content.events.entries | where('fields.kind', 'class') | where('fields.class.handle', entry.handle) | sort('fields.date')
  fact = 'flex items-baseline gap-space-sm border-b border-scheme-rule py-space-xs'
}
{#if entry}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl lg:grid-cols-wide-narrow lg:gap-space-2xl">
    <div class="grid gap-space-lg">
      <div class="grid justify-items-start gap-space-sm">
        {#if f.subject}<a class="text-small text-scheme-muted underline decoration-1 underline-offset-4" href="{ settings.base_path }?subject={ encodeURIComponent(f.subject) }">{ f.subject }</a>{/if}
        <h1 class="font-heading text-h1 text-balance text-scheme-heading"><Rise text={ entry.title } /></h1>
        {#if f.summary}<p class="max-w-prose text-lead text-pretty text-scheme-muted">{ f.summary }</p>{/if}
      </div>
      <div class="flex flex-wrap items-center justify-between gap-space-md border-b border-scheme-rule pb-space-md">
        <p class="font-heading text-h3"><Price entry={ entry } /></p>
        <Button ask />
      </div>
      {#if f.description}<div class="sites-prose max-w-prose">{ f.description }</div>{/if}
      {#if f.what_to_bring}
        <div class="grid gap-space-sm">
          <h2 class="font-heading text-h3">{ t('what_to_bring') }</h2>
          <ul class="grid gap-space-2xs ps-space-md list-disc">{#for line in f.what_to_bring | split('\n')}{#if line | strip}<li>{ line | strip }</li>{/if}{/for}</ul>
        </div>
      {/if}
    </div>
    <div class="grid gap-space-lg">
      <Well asset={ f.image } alt={ f.image_alt } width={ 960 } sizes="(min-width: 64rem) 30rem, 100vw" eager />
      <dl class="text-small">
        {#if f.ages}<div class="{ fact }"><dt class="text-scheme-muted">{ t('ages') }</dt><Leader /><dd>{ f.ages }</dd></div>{/if}
        {#if f.level}<div class="{ fact }"><dt class="text-scheme-muted">{ t('level') }</dt><Leader /><dd>{ f.level }</dd></div>{/if}
        {#if f.duration_minutes}<div class="{ fact }"><dt class="text-scheme-muted">{ t('length') }</dt><Leader /><dd>{ t('minutes', { n: f.duration_minutes }) }</dd></div>{/if}
        {#if f.coach}<div class="{ fact }"><dt class="text-scheme-muted">{ t('teacher') }</dt><Leader /><dd><a class="underline decoration-1 underline-offset-4" href="{ settings.teachers_path }/{ f.coach.handle }">{ f.coach.title }</a></dd></div>{/if}
      </dl>
      {#if weekly.length}
        <div class="grid gap-space-xs">
          <h2 class="font-heading text-h4">{ t('every_week') }</h2>
          <ul class="text-small">
            {#for d in ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']}{#for slot in weekly | where('fields.day', d)}
              <li class="{ fact }"><span>{ t('day_long.' + d) }</span><Leader /><span>{ slot.fields.start }{#if slot.fields.end}–{ slot.fields.end }{/if}{#if slot.fields.note} · { slot.fields.note }{/if}</span></li>
            {/for}{/for}
          </ul>
        </div>
      {/if}
      {#if runs.length}
        <div class="grid gap-space-xs">
          <h2 class="font-heading text-h4">{ t('dates') }</h2>
          <ul>{#for run in runs}<DateRow entry={ run } />{/for}</ul>
        </div>
      {/if}
      {#if !weekly.length && !runs.length}<p class="text-small text-scheme-muted">{ t('by_arrangement_line') }</p>{/if}
    </div>
  </div>
</section>
{/if}

<schema>
{
  "name": "Class detail",
  "description": "A class's page: its price and the ask, the description, the facts, its week and its dates.",
  "kind": "Collections",
  "icon": "file-text",
  "templates": ["class"],
  "settings": [
    { "type": "url", "id": "base_path", "label": "Class list page", "default": "/classes" },
    { "type": "url", "id": "teachers_path", "label": "Teacher page path", "default": "/teachers" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
