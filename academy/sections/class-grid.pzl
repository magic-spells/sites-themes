<!-- Featured classes as cards, each on its subject's cover by default (or plain): three across from 64rem, two from 48rem, the cards in a row as tall as the tallest; on phones a row that scrolls edge to edge with the next card showing. -->
{#let
  all = content.classes.entries | where('fields.subject') | sort('fields.order')
  classes = (settings.featured_only ? all | where('fields.featured') : all) | slice(0, settings.limit)
  subjects = all | map('fields.subject') | uniq
}
{#if classes.length}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter">
  <div class="mx-auto max-w-column px-gutter md:px-0">
    <SectionHead heading={ settings.heading } text={ settings.text } view_all_label={ settings.view_all_label } view_all_href={ settings.view_all_href } />
  </div>
  <ul class="mx-auto flex max-w-column snap-x snap-mandatory scroll-px-gutter gap-space-lg overflow-x-auto px-gutter md:grid md:snap-none md:grid-cols-2 md:gap-y-space-xl md:overflow-visible md:px-0 lg:grid-cols-3">
    {#for entry in classes}<li class="w-4/5 shrink-0 snap-start md:w-auto"><ClassCard entry={ entry } subjects={ subjects } plain={ settings.style == 'plain' } sub={ settings.heading } /></li>{/for}
  </ul>
</section>
{/if}

<schema>
{
  "name": "Class grid",
  "description": "Featured classes as cards with their ages and price.",
  "kind": "Collections",
  "icon": "layout-grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our classes" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "checkbox", "id": "featured_only", "label": "Featured only", "default": true },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "style", "label": "Cards", "default": "cover", "options": [
      { "value": "cover", "label": "On the subject's cover" },
      { "value": "plain", "label": "Plain" }
    ], "info": "A subject's cover colour comes from its place among the subjects, in class order." },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "All classes" },
    { "type": "url", "id": "view_all_href", "label": "View all link", "default": "/classes" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
