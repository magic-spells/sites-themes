<!-- The band a page ends on: the h2, the School confirm line and the ask button, centred. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-prose justify-items-center gap-space-md text-center">
    <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>
    {#if settings.text}<p class="text-lead text-pretty">{ settings.text }</p>{/if}
    <div class="pt-space-xs"><Button ask /></div>
    {#if site.settings.confirm_line}<p class="text-small text-scheme-muted">{ site.settings.confirm_line }</p>{/if}
  </div>
</section>

<schema>
{
  "name": "CTA band",
  "description": "The band a page ends on: the heading, a line and the ask button.",
  "kind": "Contact",
  "icon": "mouse-pointer-click",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come and try a class" },
    { "type": "text", "id": "text", "label": "Text", "default": "The first group class is free. Tell us who it is for and which days suit." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "brick" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "brick" } }
  ]
}
</schema>
