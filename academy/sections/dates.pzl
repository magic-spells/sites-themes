<!-- One dated list from events, sorted from the first date, of the kinds ticked (terms, closures, events, dated classes), up to the limit (an unticked kind is rejected; a ticked one rejects the '-' no entry has), grouped by the month each starts in: from 64rem the month in three parts of twelve beside its rows in nine. Nothing says upcoming: there is no clock, so past dates are removed by hand. -->
{#let
  s = settings
  list = content.events.entries | sort('fields.date') | reject('fields.kind', s.show_terms ? '-' : 'term') | reject('fields.kind', s.show_closures ? '-' : 'closed') | reject('fields.kind', s.show_events ? '-' : 'event') | reject('fields.kind', s.show_classes ? '-' : 'class') | slice(0, s.limit)
}
{#if list.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } view_all_label={ settings.view_all_label } view_all_href={ settings.view_all_href } />
    <div class="grid gap-space-xl">
      {#for entry in list, i}
        {#let month = entry.fields.date | slice(0, 7)}
        {#if i == 0 || (list[i - 1].fields.date | slice(0, 7)) != month}
          {#let words = entry.fields.date | date('long') | split(' ')}
          <div class="grid gap-space-xs lg:grid-cols-month lg:gap-space-2xl { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
            <h3 class="font-heading text-h3">{ words | first } { words | last }</h3>
            <ul class="border-t border-scheme-rule">{#for item in list}{#if (item.fields.date | slice(0, 7)) == month}<DateRow entry={ item } />{/if}{/for}</ul>
          </div>
        {/if}
      {/for}
    </div>
  </div>
</section>
{/if}

<schema>
{
  "name": "Dates",
  "description": "Term dates, closures and events in one list, grouped by month.",
  "kind": "Collections",
  "icon": "calendar",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Term dates" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "" },
    { "type": "url", "id": "view_all_href", "label": "View all link", "default": "/dates" },
    { "type": "checkbox", "id": "show_terms", "label": "Terms", "default": true },
    { "type": "checkbox", "id": "show_closures", "label": "Closures", "default": true },
    { "type": "checkbox", "id": "show_events", "label": "Events", "default": true },
    { "type": "checkbox", "id": "show_classes", "label": "Dated classes", "default": true },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 48, "step": 1, "default": 12 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Everything", "settings": { "color_scheme": "white" } },
    { "name": "Term dates", "settings": { "show_events": false, "show_classes": false, "color_scheme": "white" } }
  ]
}
</schema>
