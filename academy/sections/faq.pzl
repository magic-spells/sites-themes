<!-- Questions and answers: the heading over the standfirst, the rows that open and close beside it, five parts to seven from 48rem; stacked below. The first row opens when set. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl md:grid-cols-narrow-wide md:gap-space-2xl">
    <div class="grid gap-space-xs">
      <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>
      {#if settings.text}<p class="text-lead text-pretty text-scheme-muted">{ settings.text }</p>{/if}
    </div>
    <Questions items={ blocks } first_open={ settings.first_open } />
  </div>
</section>

<schema>
{
  "name": "FAQ",
  "description": "Questions and answers that open and close.",
  "kind": "Content",
  "icon": "circle-help",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "checkbox", "id": "first_open", "label": "First one open", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": {}, "blocks": [
      { "type": "question", "settings": { "question": "Can my child try a class first?", "answer": "<p>Yes. The first group class is a free trial. Ask about a class and we will offer a date.</p>" } },
      { "type": "question", "settings": { "question": "What if a class is full?", "answer": "<p>We keep a waiting list for every class and offer places in the order we hear from you.</p>" } },
      { "type": "question", "settings": { "question": "Do you teach adults?", "answer": "<p>Yes. Adult Choir and Adult Tap run in the evenings, and every one-to-one lesson is open to adults.</p>" } },
      { "type": "question", "settings": { "question": "How do fees work?", "answer": "<p>Group classes are paid by the term. One-to-one lessons are paid by the lesson, booked in blocks of ten.</p>" } },
      { "type": "question", "settings": { "question": "What happens at half term?", "answer": "<p>The school is closed for half term. Term fees already leave that week out.</p>" } },
      { "type": "question", "settings": { "question": "Do pupils take exams?", "answer": "<p>Only if they want to. Teachers enter pupils for graded exams when they are ready.</p>" } }
    ] }
  ]
}
</schema>
