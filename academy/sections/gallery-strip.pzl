<!-- A strip of photographs (shows, recitals, the studios): a tarot track of equal-width slides cropped to one ratio with lg corners, and the progress hairline and round arrows under it. On a phone the track runs edge to edge, the first slide inset by the gutter and the next one cut at the right; two across from 48rem, three from 64rem. Each photo opens the lightbox. -->
{#let
  items = settings.gallery ? settings.gallery.items | slice(0, 12) : []
  id = 'strip-' + section.id
  ratio = settings.slide_ratio == '1:1' ? 'aspect-square' : (settings.slide_ratio == '4:5' ? 'aspect-portrait' : 'aspect-photo')
  options = { lightbox: true, progressBar: { selector: '#bar-' + id }, slidesPerView: 1.2, gap: '1rem', paddingLeft: '1rem', navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { lightbox: true, slidesPerView: 2, gap: '1.5rem', paddingLeft: 0, navigation: { showButtons: true, showPagination: false } }, '1024': { lightbox: true, slidesPerView: 3, gap: '1.5rem', paddingLeft: 0, navigation: { showButtons: true, showPagination: false } } } }
}
{#if items.length}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter">
  <tarot-carousel class="mx-auto block max-w-column" id={ id }>
    <script type="application/json" data-tarot-options>{ options | json }</script>
    <div class="px-gutter md:px-0"><SectionHead heading={ settings.heading } text={ settings.text } /></div>
    <tarot-viewport>
      <tarot-track>
        {#for item in items, i}
          <tarot-slide>
            <a class="block cursor-zoom-in" href="{ image_url(item.asset, 2560) }" data-tarot-lightbox aria-label="{ t('open_photo', { index: i + 1 }) }">
              <span class="relative block overflow-hidden rounded-lg bg-scheme-surface-2 { ratio }"><img class="absolute inset-0 size-full object-cover" src="{ image_url(item.asset, 1024) }" srcset="{ image_srcset(item.asset, [480, 768, 1024]) }" sizes="(min-width: 64rem) 25rem, (min-width: 48rem) 45vw, 80vw" data-tarot-lightbox-src="{ image_url(item.asset, 2560) }" alt="{ item.alt }" loading="lazy" width={ item.asset.width } height={ item.asset.height } /></span>
            </a>
            {#if item.caption}<p class="mt-space-xs text-small text-scheme-muted" data-tarot-lightbox-fade>{ item.caption }</p>{/if}
          </tarot-slide>
        {/for}
      </tarot-track>
    </tarot-viewport>
    <div class="px-gutter md:px-0"><Arrows bar="bar-{ id }" /></div>
  </tarot-carousel>
</section>
{/if}

<schema>
{
  "name": "Gallery strip",
  "description": "A strip of photos that scrolls sideways, each opening a lightbox.",
  "kind": "Gallery",
  "icon": "gallery-horizontal",
  "settings": [
    { "type": "gallery", "id": "gallery", "label": "Gallery" },
    { "type": "select", "id": "slide_ratio", "label": "Slide shape", "default": "3:2", "options": [
      { "value": "1:1", "label": "Square" },
      { "value": "4:5", "label": "Portrait 4:5" },
      { "value": "3:2", "label": "Landscape 3:2" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On stage" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
