<!-- The header: the wordmark (or the Brand logo) left; from 64rem the main menu and the ask button right. The menu item that points at the classes page opens a dropdown-panel listing every subject as a link to the class list on it, then All classes. Below 64rem: the wordmark and one round menu button on surface-2. Sticky unless turned off, with a rule under it once the page scrolls. No phone. -->
{#let
  s = site.settings
  subjects = content.classes.entries | sort('fields.order') | map('fields.subject') | uniq | compact
}
<sticky-header class="block" settle-overshoot="0" disabled={ settings.sticky ? null : true }>
  <header class="relative border-b border-transparent bg-scheme-background px-gutter text-scheme-foreground transition-colors duration-fast">
    <div class="mx-auto flex min-h-header max-w-column items-center justify-between gap-space-md">
      <a class="font-heading text-h4 whitespace-nowrap" href="/">{#if s.logo}<img class="h-control w-auto" src="{ image_url(s.logo, 320) }" alt="{ s.wordmark || site.name }" width={ s.logo.width } height={ s.logo.height } />{:else}{ s.wordmark || site.name }{/if}</a>
      <div class="flex items-center gap-space-lg">
        {#if settings.menu.items.length}
          <nav class="hidden lg:block" aria-label="{ t('main_navigation') }">
            <ul class="flex items-center">
              {#for item in settings.menu.items}
                {#if item.href == settings.classes_path && subjects.length}
                  <li>
                    <dropdown-component trigger="both" close-delay="150">
                      <dropdown-trigger class="flex min-h-header cursor-pointer items-center gap-space-2xs px-cell">{ item.label }<Icon name="chevron-down" cls="size-icon-sm" /></dropdown-trigger>
                      <dropdown-panel class="w-max rounded-md border border-scheme-rule bg-scheme-background p-space-xs text-scheme-foreground shadow-panel">
                        <ul class="grid">
                          {#for subject in subjects}<li><a class="flex items-center gap-space-sm rounded-sm px-cell py-space-xs hover:bg-scheme-surface-2" href="{ settings.classes_path }?subject={ encodeURIComponent(subject) }"><Swatch subject={ subject } subjects={ subjects } />{ subject }</a></li>{/for}
                          <li class="mt-space-2xs border-t border-scheme-rule pt-space-2xs"><a class="block rounded-sm px-cell py-space-xs text-label hover:bg-scheme-surface-2" href="{ settings.classes_path }">{ t('all_classes') }</a></li>
                        </ul>
                      </dropdown-panel>
                    </dropdown-component>
                  </li>
                {:else}
                  <li><a class="flex min-h-header items-center px-cell underline-offset-8 hover:underline current:underline" href="{ item.href }" aria-current={ item.active ? 'page' : null }>{ item.label }</a></li>
                {/if}
              {/for}
            </ul>
          </nav>
        {/if}
        <span class="hidden lg:contents"><Button ask /></span>
        <button class="flex size-control items-center justify-center rounded-full bg-scheme-surface-2 transition-colors duration-fast hover:bg-scheme-rule lg:hidden" type="button" data-panel-open="mobile-menu" aria-haspopup="dialog" aria-controls="mobile-menu"><Icon name="menu" /><span class="sr-only">{ t('menu') }</span></button>
      </div>
    </div>
  </header>
</sticky-header>

<schema>
{
  "name": "Header",
  "description": "The wordmark, the menu with a Classes panel of every subject and the ask button; the menu button on phones and tablets.",
  "kind": "Header",
  "icon": "panel-top",
  "settings": [
    { "type": "menu", "id": "menu", "label": "Menu" },
    { "type": "url", "id": "classes_path", "label": "Classes page", "default": "/classes", "info": "The menu item pointing here opens a list of every subject." },
    { "type": "checkbox", "id": "sticky", "label": "Sticky", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": { "menu": "main" } }
  ]
}
</schema>
