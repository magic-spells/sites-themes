<!-- The first screen, split seven parts to five from 48rem: the h1 (its words rise in), the standfirst and two buttons (the ask and one outlined link); the 4:3 photo with lg corners, and with an event chosen a label over its lower-left corner naming it and its day ("Starts 4 January" for a run). On phones the label sits under the photo. -->
{#let ev = settings.event}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:grid-cols-wide-narrow md:gap-space-2xl">
    <div class="grid justify-items-start gap-space-md">
      <h1 class="font-heading text-h1 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h1>
      {#if settings.text}<p class="max-w-prose text-lead text-pretty text-scheme-muted">{ settings.text }</p>{/if}
      <div class="flex flex-wrap gap-space-sm pt-space-xs">
        <Button ask />
        {#if settings.button_label && settings.button_href}<Button href={ settings.button_href } tone="outline">{ settings.button_label }</Button>{/if}
      </div>
    </div>
    <div class="grid gap-space-sm md:relative">
      <Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-picture" width={ 1200 } sizes="(min-width: 48rem) 40vw, 100vw" eager />
      {#if ev}
        <div class="md:absolute md:bottom-space-md md:-left-space-md">
          <Label><p class="font-heading text-h4">{ ev.title }</p><p class="text-small text-scheme-muted">{#if ev.fields.end_date}{ t('starts') } {/if}<DateRange from={ ev.fields.date } long /></p></Label>
        </div>
      {/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Hero",
  "description": "The first screen: the heading, a standfirst, the ask and one more button beside a photo with one date on it.",
  "kind": "Hero",
  "icon": "layout-template",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Music and dance lessons for every age" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "Piano, strings, singing, ballet and tap, taught in small groups and one-to-one lessons by teachers who perform." },
    { "type": "text", "id": "button_label", "label": "Second button label", "default": "See the timetable" },
    { "type": "url", "id": "button_href", "label": "Second button link", "default": "/timetable" },
    { "type": "image", "id": "image", "label": "Image (4:3)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "entry", "id": "event", "label": "Label", "info": "An event from your dates, named on the photo with its day. Leave empty for no label." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Split", "settings": {} }
  ]
}
</schema>
