<!-- The first screen, split seven parts to five from 48rem: the h1 (its words rise in), the standfirst and two buttons (the ask and one outlined link); the landscape photo with lg corners, and with show date a label over its lower-left corner naming the first term in events and the day it starts. On phones the label sits under the photo. -->
{#let term = content.events.entries | where('fields.kind', 'term') | sort('fields.date') | first}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:grid-cols-wide-narrow md:gap-space-2xl">
    <div class="grid justify-items-start gap-space-md">
      <h1 class="font-heading text-h1 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h1>
      {#if settings.text}<p class="max-w-prose text-lead text-pretty text-scheme-muted">{ settings.text }</p>{/if}
      <div class="flex flex-wrap gap-space-sm pt-space-xs">
        <Button ask />
        {#if settings.link_label && settings.link}<Button href={ settings.link } tone="outline">{ settings.link_label }</Button>{/if}
      </div>
    </div>
    <div class="grid gap-space-sm md:relative">
      <Well asset={ settings.image } alt={ settings.image_alt } width={ 1200 } sizes="(min-width: 48rem) 40vw, 100vw" eager />
      {#if settings.show_date && term}
        <div class="justify-self-start md:absolute md:bottom-space-lg md:-left-space-lg">
          <Label><p class="font-heading text-h4">{ term.title }</p><p class="text-small text-scheme-muted">{ t('starts', { date: (term.fields.date | date('long')) }) }</p></Label>
        </div>
      {/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Hero",
  "description": "The first screen: the heading, a standfirst, the ask and one more button beside a photo with the next term's start.",
  "kind": "Hero",
  "icon": "layout-template",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Music and dance lessons for every age" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "Piano, strings, singing, ballet and tap, taught in small groups and one-to-one lessons by teachers who perform." },
    { "type": "text", "id": "link_label", "label": "Second button label", "default": "See the timetable" },
    { "type": "url", "id": "link", "label": "Second button link", "default": "/timetable" },
    { "type": "image", "id": "image", "label": "Image (3:2)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "checkbox", "id": "show_date", "label": "Term label", "default": true, "info": "A label on the photo with the first term in your dates and the day it starts. Remove past terms from the dates to move it on." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Split", "settings": {} }
  ]
}
</schema>
