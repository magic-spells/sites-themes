<!-- The first screen: the h1 (its words rise in), the standfirst and two buttons (the ask and one outlined link), stacked full width on phones. Split (the default) sets them seven parts to five beside the 4:3 photo from 48rem, and with a term or event chosen a label over the photo's lower-left corner naming it and its day ("Starts 4 January" for a run); on phones the photo and then the label follow the buttons. Cover runs the photo the full width, at least 70% of the screen tall, under an ink scrim at 55%, with the text at its lower left on the ink scheme's colours and no label. -->
{#let
  ev = settings.event
  cover = settings.layout == 'cover'
}
<section class="{ cover ? 'sites-scheme-ink relative grid min-h-cover items-end' : '' } bg-scheme-background px-gutter py-section text-scheme-foreground">
  {#if cover && settings.image}{ image_tag(settings.image, { sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'absolute inset-0 size-full object-cover' }) }<span class="absolute inset-0 bg-scheme-background/55"></span>{/if}
  <div class="relative mx-auto grid w-full max-w-column items-center gap-space-xl { cover ? '' : 'md:grid-cols-wide-narrow md:gap-space-3xl' }">
    <div class="grid justify-items-start gap-space-md { cover ? 'max-w-prose' : '' }">
      <h1 class="font-heading text-h1 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h1>
      {#if settings.text}<p class="max-w-prose text-lead text-pretty { cover ? '' : 'text-scheme-muted' }">{ settings.text }</p>{/if}
      <div class="grid w-full gap-space-sm pt-space-xs md:flex md:flex-wrap">
        <Button ask />
        {#if settings.button_label && settings.button_href}<Button href={ settings.button_href } tone="outline">{ settings.button_label }</Button>{/if}
      </div>
    </div>
    {#unless cover}
      <div class="grid gap-space-sm md:relative">
        <Well asset={ settings.image } ratio="aspect-picture" width={ 1200 } sizes="(min-width: 48rem) 40vw, 100vw" eager />
        {#if ev}
          <div class="md:absolute md:bottom-space-md md:-left-space-md">
            <Label><p class="font-heading text-h4">{ ev.title }</p><p class="text-small text-scheme-muted">{#if ev.fields.end_date}{ t('starts') } {/if}<DateRange from={ ev.fields.date } long /></p></Label>
          </div>
        {/if}
      </div>
    {/unless}
  </div>
</section>

<schema>
{
  "name": "Hero",
  "description": "The first screen: the heading, a standfirst, the ask and one more button, beside a photo with one date on it or over a full-width photo.",
  "kind": "Hero",
  "icon": "layout-template",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [
      { "value": "split", "label": "Beside a photo" },
      { "value": "cover", "label": "Over a full-width photo" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Music and dance lessons for every age" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "Piano, strings, singing, ballet and tap, taught in small groups and one-to-one lessons by teachers who perform." },
    { "type": "text", "id": "button_label", "label": "Second button label", "default": "See the timetable" },
    { "type": "url", "id": "button_href", "label": "Second button link", "default": "/timetable" },
    { "type": "image", "id": "image", "label": "Image", "info": "Beside a photo it is cropped to 4:3; over a full-width photo it fills the band." },
    { "type": "entry", "id": "event", "label": "Label", "info": "Pick a term or event from your dates: its title and first day sit on the photo. Only beside a photo. Leave empty for no label." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Split", "settings": {} },
    { "name": "Cover", "settings": { "layout": "cover" } }
  ]
}
</schema>
