<!-- A page's head: the h1 (the page title unless a heading is set; its words rise in) and the standfirst under it. Photo sets the text in seven parts beside a 4:3 photo in five from 64rem; the photo follows on phones. -->
{#let photo = settings.layout == 'photo' && settings.image}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl lg:gap-space-2xl { photo ? 'lg:grid-cols-wide-narrow' : '' }">
    <div class="grid gap-space-md">
      <h1 class="max-w-prose font-heading text-h1 text-balance text-scheme-heading"><Rise text={ settings.heading || page.title } /></h1>
      {#if settings.text}<p class="max-w-prose text-lead text-pretty text-scheme-muted">{ settings.text }</p>{/if}
    </div>
    {#if photo}<Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-picture" width={ 960 } sizes="(min-width: 64rem) 30rem, 100vw" eager />{/if}
  </div>
</section>

<schema>
{
  "name": "Page header",
  "description": "The page's title and a standfirst, alone or beside a photo.",
  "kind": "Content",
  "icon": "heading-1",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "plain", "options": [
      { "value": "plain", "label": "Plain" },
      { "value": "photo", "label": "With a photo" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "image", "id": "image", "label": "Image (4:3)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
