<!-- A journal post in the reading column: the topic and date in small muted, the title in h1, the standfirst, the 3:2 photo, the body and the author. -->
{#let
  entry = page.entry
  f = entry.fields
}
{#if entry}
<article class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-prose gap-space-xl">
    <header class="grid gap-space-md">
      <p class="text-small text-scheme-muted">{ f.topic }{#if f.date}{#if f.topic} · {/if}<DateRange from={ f.date } year />{/if}</p>
      <h1 class="font-heading text-h1 text-balance text-scheme-heading"><Rise text={ entry.title } /></h1>
      {#if f.standfirst}<p class="text-lead text-pretty text-scheme-muted">{ f.standfirst }</p>{/if}
    </header>
    <Well asset={ f.image } width={ 1600 } sizes="(min-width: 48rem) 42rem, 100vw" eager />
    <div class="sites-prose text-body">{ f.body }</div>
    {#if f.author}<p class="text-small text-scheme-muted">{ f.author }</p>{/if}
  </div>
</article>
{/if}

<schema>
{
  "name": "Post",
  "description": "A journal post: the title, the photo and the body.",
  "kind": "Content",
  "icon": "file-text",
  "templates": ["post"],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
