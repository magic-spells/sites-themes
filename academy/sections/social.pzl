<!-- The school's social feed, as photos it uploads (no fetch, no API): square tiles with lg corners, each with the Instagram glyph in its corner, linking to its post or to the profile. The head with the handle as its button, six tiles across from 64rem, a row that scrolls below. -->
{#let tiles = blocks | slice(0, 6)}
{#if tiles.length}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter">
  <div class="mx-auto max-w-column">
    <div class="px-gutter md:px-0"><SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.handle } link_href={ settings.url } /></div>
    <ul class="flex snap-x snap-mandatory scroll-px-gutter gap-space-sm overflow-x-auto px-gutter md:gap-space-md md:px-0 lg:grid lg:grid-cols-6">
      {#for block in tiles}
        {#let b = block.settings}
        <li class="w-2/5 shrink-0 snap-start md:w-1/4 lg:w-auto" data-block={ block.editor_id }>
          <a class="group relative block aspect-square overflow-hidden rounded-lg bg-scheme-surface-2" href="{ b.link || settings.url }" target="_blank" rel="noopener">
            {#if b.image}<img class="size-full object-cover transition-transform duration-panel ease-out-soft group-hover:scale-105" src="{ image_url(b.image, 640) }" srcset="{ image_srcset(b.image, [320, 640, 1024]) }" sizes="(min-width: 64rem) 12rem, 40vw" alt="{ b.image_alt || t('social_post') }" loading="lazy" width={ b.image.width } height={ b.image.height } />{/if}
            <span class="absolute end-space-sm bottom-space-sm flex size-control items-center justify-center rounded-full bg-scheme-background"><Icon name="instagram" /></span>
          </a>
        </li>
      {/for}
    </ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Social",
  "description": "Photos from the school's social profile, six tiles under the handle.",
  "kind": "Gallery",
  "icon": "camera",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow along" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@larkfieldacademy", "info": "The tiles are photos you upload, each linking to its post: a live feed would need the engine to fetch it, which sections cannot." },
    { "type": "url", "id": "url", "label": "Profile link", "default": "https://www.instagram.com/larkfieldacademy" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "image", "id": "image", "label": "Image", "info": "Square crops best." },
      { "type": "text", "id": "image_alt", "label": "Alt text", "default": "" },
      { "type": "url", "id": "link", "label": "Post link", "default": "", "info": "Leave empty to link to the profile." }
    ] }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
