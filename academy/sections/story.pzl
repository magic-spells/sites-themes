<!-- The school's story: the photo in seven parts beside the prose in five from 48rem, the photo left or right, with the School accreditation lines under the prose and one outlined button. The photo first on phones. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:gap-space-2xl { settings.image_side == 'right' ? 'md:grid-cols-narrow-wide' : 'md:grid-cols-wide-narrow' }">
    <div class="{ settings.image_side == 'right' ? 'md:order-last' : '' }"><Well asset={ settings.image } alt={ settings.image_alt } width={ 1200 } sizes="(min-width: 48rem) 55vw, 100vw" /></div>
    <div class="grid justify-items-start gap-space-md">
      <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>
      <div class="sites-prose max-w-prose">{ settings.text }</div>
      <Lines cls="text-scheme-muted" />
      {#if settings.link_label && settings.link}<Button href={ settings.link } tone="outline">{ settings.link_label }</Button>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Story",
  "description": "The school's story beside a photo, with the accreditation lines.",
  "kind": "Content",
  "icon": "book-open",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Forty years above the high street" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Larkfield started in 1986 with one piano and a borrowed hall. It now fills two studios and four teaching rooms, and some of the teachers were pupils here first.</p>" },
    { "type": "image", "id": "image", "label": "Image (3:2)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "select", "id": "image_side", "label": "Image", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "" },
    { "type": "url", "id": "link", "label": "Button link", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
