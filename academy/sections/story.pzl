<!-- The school's story: the text in seven parts beside the 4:5 photo in five from 64rem, the photo right or left. The heading, the prose and the School accreditation lines as a small ruled list. From 64rem the photo takes no height of its own: the row is the text's height plus 3rem above and below, and the photo is 4:5 up to that height (about 1.3 times a short text), cropped to it past that. The photo after the text on phones. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl lg:gap-space-2xl { settings.image_side == 'left' ? 'lg:grid-cols-narrow-wide' : 'lg:grid-cols-wide-narrow' }">
    <div class="grid gap-space-md lg:py-space-xl { settings.image_side == 'left' ? 'lg:order-last' : '' }">
      <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>
      <div class="sites-prose max-w-prose">{ settings.text }</div>
      {#if settings.show_accreditation}<Lines cls="max-w-prose text-scheme-muted" ruled />{/if}
    </div>
    <div class="lg:relative lg:self-stretch"><div class="lg:absolute lg:inset-0 lg:flex lg:items-center"><Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-portrait w-full max-h-full" width={ 960 } sizes="(min-width: 64rem) 30rem, 100vw" /></div></div>
  </div>
</section>

<schema>
{
  "name": "Story",
  "description": "The school's story beside a photo, with the accreditation lines.",
  "kind": "Content",
  "icon": "book-open",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Larkfield started in 1986 with one piano and a borrowed hall. It now fills two studios and four teaching rooms, and some of the teachers were pupils here first.</p>" },
    { "type": "image", "id": "image", "label": "Image (4:5)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "select", "id": "image_side", "label": "Image", "default": "right", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "checkbox", "id": "show_accreditation", "label": "Accreditation lines", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
