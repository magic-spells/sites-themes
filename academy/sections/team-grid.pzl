<!-- The teachers: 4:5 photos, each with the role over the name, one link to their page unless linking is off. Four across from 64rem, two from 48rem; on phones a row that scrolls with the next teacher showing. -->
{#let
  team = content.coaches.entries | sort('fields.order')
  people = (settings.featured_only ? team | where('fields.featured') : team) | slice(0, settings.limit)
}
{#if people.length}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter">
  <div class="mx-auto max-w-column px-gutter md:px-0">
    <SectionHead heading={ settings.heading } text={ settings.text } view_all_label={ settings.view_all_label } view_all_href={ settings.view_all_href } />
  </div>
  <ul class="mx-auto flex max-w-column snap-x snap-mandatory scroll-px-gutter gap-x-space-lg gap-y-space-xl overflow-x-auto px-gutter md:grid md:snap-none md:grid-cols-2 md:overflow-visible md:px-0 lg:grid-cols-4">
    {#for entry in people}<li class="w-3/4 shrink-0 snap-start md:w-auto"><TeacherCard entry={ entry } plain={ !settings.link_to_detail } sub={ settings.heading } /></li>{/for}
  </ul>
</section>
{/if}

<schema>
{
  "name": "Team grid",
  "description": "The teachers, each with their role and a link to their page.",
  "kind": "Team",
  "icon": "users",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our teachers" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "All teachers" },
    { "type": "url", "id": "view_all_href", "label": "View all link", "default": "/teachers" },
    { "type": "checkbox", "id": "featured_only", "label": "Featured only", "default": false },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "link_to_detail", "label": "Link to each teacher's page", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
