<!-- Ways to visit before joining: two or three equal white panels with md corners and a rule hairline, each a heading, a line, an optional date line in small muted and a button at the foot: outlined to its link, or the ask when ask is ticked. Three across from 64rem, two from 48rem. -->
{#if blocks.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid gap-space-md md:grid-cols-2 lg:grid-cols-3">
      {#for block in blocks}
        {#let b = block.settings}
        <li class="sites-scheme-white grid content-between justify-items-start gap-space-md rounded-md border border-scheme-rule bg-scheme-background p-space-md text-scheme-foreground { site.settings.reveal ? 'reveal reveal-fade-up' : '' }" data-block={ block.editor_id }>
          <div class="grid gap-space-xs">
            <Heading sub={ settings.heading } cls="font-heading text-h3">{ b.heading }</Heading>
            {#if b.text}<p class="text-body text-pretty">{ b.text }</p>{/if}
            {#if b.date_line}<p class="text-small text-scheme-muted">{ b.date_line }</p>{/if}
          </div>
          {#if b.ask}<Button ask tone="outline">{ b.button_label || site.settings.ask_label }</Button>{:else if b.button_label && b.button_href}<Button href={ b.button_href } tone="outline">{ b.button_label }</Button>{/if}
        </li>
      {/for}
    </ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Visit options",
  "description": "Two or three ways to visit: an open morning, a trial class, a look round.",
  "kind": "Contact",
  "icon": "door-open",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "blocks": [
    { "type": "option", "name": "Option", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Trial class" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "" },
      { "type": "text", "id": "date_line", "label": "Date line", "default": "" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "" },
      { "type": "url", "id": "button_href", "label": "Button link", "default": "" },
      { "type": "checkbox", "id": "ask", "label": "Button asks", "default": false, "info": "The button opens the ask; an empty label reads the School ask label." }
    ] }
  ],
  "max_blocks": 3,
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" }, "blocks": [
      { "type": "option", "settings": { "heading": "Open morning", "text": "Come and watch any Saturday class and meet the teachers.", "date_line": "Saturday 24 April · 10:00–12:00", "button_label": "Term dates", "button_href": "/dates" } },
      { "type": "option", "settings": { "heading": "Trial lesson", "text": "The first group class is free. We hold a place for you that week.", "ask": true } },
      { "type": "option", "settings": { "heading": "A look round", "text": "Any weekday afternoon, by arrangement with the office.", "button_label": "Contact the office", "button_href": "/contact" } }
    ] }
  ]
}
</schema>
