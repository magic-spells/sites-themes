<!-- Ways to visit before joining: two or three equal white cards, each with a heading, a line and a button; a card with no link asks (the ask button with the card's label). -->
{#if blocks.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid gap-space-md md:grid-cols-3">
      {#for block in blocks}
        {#let b = block.settings}
        <li class="sites-scheme-white grid content-between justify-items-start gap-space-md rounded-lg bg-scheme-background p-space-lg text-scheme-foreground { site.settings.reveal ? 'reveal reveal-fade-up' : '' }" data-block={ block.editor_id }>
          <div class="grid gap-space-xs">
            <h3 class="font-heading text-h4">{ b.heading }</h3>
            {#if b.text}<p class="text-small text-pretty text-scheme-muted">{ b.text }</p>{/if}
          </div>
          {#if b.link}<Button href={ b.link } tone="outline">{ b.button_label }</Button>{:else}<Button ask tone="outline">{ b.button_label }</Button>{/if}
        </li>
      {/for}
    </ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Visit options",
  "description": "Two or three ways to visit: an open morning, a trial class, a tour.",
  "kind": "Contact",
  "icon": "door-open",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit first" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "light-blue" }
  ],
  "blocks": [
    { "type": "option", "name": "Option", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Trial class" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Ask for a place" },
      { "type": "url", "id": "link", "label": "Button link", "default": "", "info": "Leave empty to open the ask form." }
    ] }
  ],
  "max_blocks": 3,
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "light-blue" }, "blocks": [
      { "type": "option", "settings": { "heading": "Open morning", "text": "Watch classes, meet the teachers and try an instrument. No need to book.", "button_label": "See the date", "link": "/dates" } },
      { "type": "option", "settings": { "heading": "Trial class", "text": "The first group class is free. We hold a place for you that week.", "button_label": "Ask for a trial", "link": "" } },
      { "type": "option", "settings": { "heading": "A look round", "text": "Any weekday afternoon, by arrangement with the office.", "button_label": "Ask for a visit", "link": "" } }
    ] }
  ]
}
</schema>
