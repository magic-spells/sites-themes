<!-- template: Maintenance -->
<!-- layout: default -->
<!-- The site paused, on feint with no header or footer: the wordmark, "Back soon.", one line with the Contact email for anything urgent, and the Contact phone. -->
<Utility bare>
  <p class="font-heading text-h3">{ site.settings.wordmark || site.name }</p>
  <h1 class="font-heading text-h2 text-balance">{ t('maintenance_title') }</h1>
  {#if site.settings.email}<p class="text-body text-pretty">{ t('maintenance_body', { email: site.settings.email }) }</p>{/if}
  {#if site.settings.phone}<a class="text-body font-medium underline decoration-1 underline-offset-4" href="tel:{ site.settings.phone | replace(' ', '') }">{ site.settings.phone }</a>{/if}
</Utility>
