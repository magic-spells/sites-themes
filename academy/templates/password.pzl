<!-- template: Password -->
<!-- layout: default -->
<!-- The site behind a password, on feint with no header or footer: one white card at most 26.25rem wide with the wordmark, the line, the password field over Enter, and the Contact email in small muted. -->
<Utility bare>
  <div class="w-full max-w-card text-left">
    <div class="sites-scheme-white grid gap-space-md rounded-lg border border-scheme-rule bg-scheme-background p-space-lg text-scheme-foreground lg:p-space-xl">
      <p class="font-heading text-h3">{ site.settings.wordmark || site.name }</p>
      <h1 class="text-body">{ t('password_body') }</h1>
      <form class="grid gap-space-md" method="post" action="/_sites/unlock">
        <input type="hidden" name="to" value="{ request.query.return_to }" />
        {#if request.query.password_error}<p class="text-small text-scheme-error" role="alert">{ request.query.password_error }</p>{/if}
        <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" required prefix="password" />
        <Button type="submit" wide>{ t('password_submit') }</Button>
      </form>
      {#if site.settings.email}<a class="justify-self-start text-small text-scheme-muted underline decoration-1 underline-offset-4" href="mailto:{ site.settings.email }">{ site.settings.email }</a>{/if}
    </div>
  </div>
</Utility>
