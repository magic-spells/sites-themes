<!-- component: Field -->
<!-- A labelled input in one box: the label in the Label style at the top of
     a hairline box in the scheme's input border, the value under it, the
     whole box ringed on focus. A declared form field carries no
     autocomplete token, so name, email and phone are recognised by id. The
     error sits under the box, tied to the input by aria-describedby. -->
<div class={ wrapper_class }>
  <div class="grid min-h-control content-center rounded-input border border-scheme-input-border bg-scheme-input-background px-step-sm py-step-xs text-scheme-input-foreground focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-scheme-links { error ? 'border-scheme-error' : '' }">
    <label class="block text-label" for="field-{ prefix }-{ name }">{ label }{#if required}<span aria-hidden="true"> *</span>{/if}</label>
    {#if type == 'textarea'}
      <textarea class="block min-h-textarea w-full resize-y bg-transparent font-body text-body text-scheme-input-foreground outline-none" id="field-{ prefix }-{ name }" name={ name } rows={ rows ?? 4 } maxlength={ maxlength } required={ required } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ error ? 'error-' + prefix + '-' + name : null }>{ value }</textarea>
    {:else}
      <input class="block w-full bg-transparent font-body text-body text-scheme-input-foreground outline-none" id="field-{ prefix }-{ name }" name={ name } type={ type ?? 'text' } autocomplete={ autocomplete ?? (type == 'email' ? 'email' : (name == 'name' ? 'name' : (type == 'tel' ? 'tel' : 'off'))) } maxlength={ maxlength } required={ required } value={ value } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ error ? 'error-' + prefix + '-' + name : null } />
    {/if}
  </div>
  {#if error}<p class="mt-step-2xs font-mono text-spec text-scheme-error uppercase" id="error-{ prefix }-{ name }">{ t('form_field_' + error) }</p>{/if}
</div>
