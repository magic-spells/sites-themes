<!-- component: HoursTable -->
<!-- A location's hours: the textarea split into lines, each line's last
     word the times and the rest the days, as a two-column mono table. No day
     is marked as current: there is no clock. -->
{#if hours}
<table class="w-full font-mono text-body-sm tabular-nums">
  <caption class="sr-only">{ t('opening_hours') }</caption>
  <tbody>
    {#for line in hours | split('\n')}
      {#let
        row = line | strip
        times = row | split(' ') | last
        days = row | replace(times, '') | strip
      }
      {#if row}<tr class="border-b border-scheme-rule"><th class="py-step-xs pr-step-md text-left font-normal text-scheme-muted uppercase" scope="row">{ days }</th><td class="py-step-xs text-right font-medium">{ times }</td></tr>{/if}
    {/for}
  </tbody>
</table>
{/if}
