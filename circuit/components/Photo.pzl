<!-- component: Photo -->
<!-- An image well, square-cornered and flush: the ratio class sets its shape,
     treatment mono greys the photo and duotone floods it with the accent
     through a multiply layer. zoom scales it on the parent group's hover. -->
{#if asset}
<span class="relative block overflow-hidden bg-scheme-surface-2 { ratio }">
  <img class="absolute inset-0 size-full object-cover { treatment == 'mono' || treatment == 'duotone' ? 'grayscale' : '' } { zoom ? 'transition-transform duration-hover ease-out-soft group-hover:scale-hover' : '' }" data-zoom={ zoom ? true : null } src="{ image_url(asset, width ?? 800) }" srcset="{ image_srcset(asset, [480, 768, 1024, 1600]) }" sizes="{ sizes ?? '100vw' }" alt="{ alt ?? asset.alt }" loading="{ eager ? 'eager' : 'lazy' }" fetchpriority={ eager ? 'high' : null } width={ asset.width } height={ asset.height } />
  {#if treatment == 'duotone'}<span class="absolute inset-0 bg-accent mix-blend-multiply" aria-hidden="true"></span>{/if}
  <Children/>
</span>
{/if}
