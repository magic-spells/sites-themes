<!-- component: PlanCard -->
<!-- A plan: name and note on top, the price in the Numeral face with the
     period in mono, the summary, the features as a mono check list, and a
     square button (the plan's own checkout link, or the primary action).
     The featured plan is raised and inverted: it carries the opposite
     scheme class, so every colour inside follows. -->
{#let
  f = entry.fields
  free = f.period == 'free' || f.price == 0
}
<article class="flex h-full flex-col gap-step-md p-step-lg { featured ? 'bg-scheme-background text-scheme-foreground ' + invert : 'bg-scheme-surface-2 text-scheme-foreground' } { featured && raise ? 'md:-my-step-md md:py-step-xl' : '' }">
  <div class="flex flex-wrap items-center justify-between gap-step-xs">
    <h3 class="font-heading text-h4 font-extrabold text-scheme-heading uppercase stretch-heading">{ entry.title }</h3>
    {#if show_note && f.note}<span class="inline-flex min-h-tag items-center rounded-chip bg-accent px-step-xs font-mono text-spec font-medium text-on-accent uppercase">{ f.note }</span>{/if}
  </div>
  <p class="flex flex-wrap items-baseline gap-x-step-xs">
    <span class="font-heading text-h1 font-black tabular-nums stretch-display">{ free ? t('free') : (f.price % 1 == 0 ? f.price | currency(site.settings.currency_symbol, 0) : f.price | currency(site.settings.currency_symbol)) }</span>
    {#if !free && f.period}<span class="font-mono text-body-sm text-scheme-muted">/ { t('period.' + f.period) }</span>{/if}
  </p>
  {#if f.summary}<p class="text-body text-scheme-muted">{ f.summary }</p>{/if}
  <ul class="grid flex-1 content-start gap-step-xs border-t border-scheme-rule pt-step-md font-mono text-body-sm">
    {#for line in f.features | split('\n')}{#if line | strip}<li class="grid grid-cols-check items-start gap-step-xs"><span class="sites-icon mt-0.5 size-icon-small text-accent" aria-hidden="true">{#svg 'icons/check.svg'}</span><span>{ line | strip }</span></li>{/if}{/for}
  </ul>
  <div class="pt-step-xs">
    {#if f.link}<Button href={ f.link } wide={ true } external={ true }>{ t('choose_plan') }</Button>
    {:else}<Button action={ true } wide={ true }>{ action_label || site.settings.action_label }</Button>{/if}
  </div>
</article>
