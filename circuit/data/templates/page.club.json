        "heading": "Before you come in",
        "color_scheme": "white",
        "kicker": "Questions"
      },
      "blocks": [
        {
          "id": "s_faq_b1",
          "type": "item",
          "settings": {
            "question": "Where does the run start?",
            "answer": "<p>By the river gate at Riverside. We run a 5 km or a 12 km loop of the river and finish back at the gate.</p>"
          }
        },
        {
          "id": "s_faq_b2",
          "type": "item",
          "settings": {
            "question": "Are there pace groups?",
            "answer": "<p>Three on Saturdays, at 5:00, 5:45 and 6:30 per km, each with a run leader and a back marker. Nobody runs alone.</p>"
          }
        },
        {
          "id": "s_faq_b3",
          "type": "item",
          "settings": {
            "question": "What should I bring?",
            "answer": "<p>Running shoes, a layer for the start and water if it is warm. There is a bag drop at the gate.</p>"
          }
        },
        {
          "id": "s_faq_b4",
          "type": "item",
          "settings": {
            "question": "Is it free?",
            "answer": "<p>Yes. Every run is free for everyone, member or not. Coffee after is on you.</p>"
          }
        }
      ]
    }
