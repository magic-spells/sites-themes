          "id": "s_faq_b1",
          "type": "item",
          "settings": {
            "question": "Is there a joining fee?",
            "answer": "<p>No. You pay the first month when you join and that is it.</p>"
          }
        },
        {
          "id": "s_faq_b2",
          "type": "item",
          "settings": {
            "question": "Can I freeze or cancel?",
            "answer": "<p>Yes. Memberships are month to month: freeze for up to two months a year, or cancel with a month's notice.</p>"
          }
        },
        {
          "id": "s_faq_b3",
          "type": "item",
          "settings": {
            "question": "Does my plan work at both locations?",
            "answer": "<p>Unlimited and Open gym work at North and Riverside. Packs and drop-ins too.</p>"
          }
        },
        {
          "id": "s_faq_b4",
          "type": "item",
          "settings": {
            "question": "Are there student or NHS rates?",
            "answer": "<p>Yes, 15% off Unlimited with a valid card. Ask at the desk.</p>"
          }
        }
