<!-- Hours and locations: cards two across, each a 3:2 photo (or the static
     map), the name, the address, the hours as a two-column mono table, and
     Directions and Call. Today is never marked. -->
{#let shown = settings.locations.entries | sort('fields.order') | slice(0, Math.min(settings.limit, 12))}
{#if shown.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid gap-gap-lg md:grid-cols-2">
      {#for entry in shown}<li><LocationCard entry={ entry } href="{ settings.base_path }/{ entry.handle }" show_hours={ settings.show_hours } show_map={ settings.show_map } /></li>{/for}
    </ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Locations",
  "description": "Each location with its photo or map, address, hours, Directions and Call.",
  "kind": "Contact",
  "icon": "mail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find us" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "collection", "id": "locations", "label": "Locations", "info": "Reads locations: title, handle, address, hours, phone, map_url, map_image, image, note and order." },
    { "type": "range", "id": "limit", "label": "Limit", "min": 1, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_hours", "label": "Show hours", "default": true },
    { "type": "checkbox", "id": "show_map", "label": "Show the map instead of the photo", "default": false },
    { "type": "url", "id": "base_path", "label": "Location page path", "default": "/locations" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "concrete" }
  ],
  "presets": [
    { "name": "Default", "settings": { "locations": "locations" } }
  ]
}
</schema>
