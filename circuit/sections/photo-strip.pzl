<!-- A strip of photographs at their own ratios that breaks the grid: a tarot
     track, 3.5 / 2.5 / 1.3 across, every other photo dropped a step when
     stagger is on, bleeding off the right edge on a phone with a progress
     bar under it. Each photo opens the lightbox. -->
{#let
  items = settings.gallery.items | slice(0, 24)
  id = 'strip-' + section.id
  options = { lightbox: true, slidesPerView: 1.3, gap: '1rem', paddingLeft: '1rem', paddingRight: 0, navigation: { showButtons: false, showPagination: false }, scrollbar: { show: true, selector: '#' + id + '-bar' }, breakpoints: { '768': { lightbox: true, scrollbar: { show: false }, slidesPerView: 2.5, gap: '1.5rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: true, showPagination: false } }, '1024': { lightbox: true, scrollbar: { show: false }, slidesPerView: 3.5, gap: '1.5rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: true, showPagination: false } } } }
}
{#if items.length}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter">
  <tarot-carousel class="mx-auto block max-w-column" id={ id } data-track="photos">
    <script type="application/json" data-tarot-options>{ options | json }</script>
    <SectionHead heading={ settings.heading } text={ settings.text } inset={ true }><Arrows /></SectionHead>
    <tarot-viewport>
      <tarot-track class="items-start">
        {#for item in items, i}
          <tarot-slide class="{ settings.stagger && i % 2 == 1 ? 'md:pt-step-2xl' : '' }">
            <a class="block cursor-zoom-in" href="{ image_url(item.asset, 2560) }" data-tarot-lightbox aria-label="{ t('open_photo', { index: i + 1 }) }"><img class="h-auto w-full { settings.treatment != 'natural' ? 'grayscale' : '' }" src="{ image_url(item.asset, 1024) }" srcset="{ image_srcset(item.asset, [480, 768, 1024, 1280]) }" sizes="(min-width: 64rem) 22rem, (min-width: 48rem) 40vw, 80vw" data-tarot-lightbox-src="{ image_url(item.asset, 2560) }" alt="{ item.alt }" loading="lazy" width={ item.asset.width } height={ item.asset.height } /></a>
            {#if item.caption}<p class="mt-step-xs font-mono text-spec text-scheme-meta uppercase" data-caption data-tarot-lightbox-fade>{ item.caption }</p>{/if}
          </tarot-slide>
        {/for}
      </tarot-track>
    </tarot-viewport>
    <div class="mt-step-md px-gutter md:hidden" id="{ id }-bar"></div>
  </tarot-carousel>
</section>
{/if}

<schema>
{
  "name": "Photo strip",
  "description": "Photographs at their own ratios on a draggable strip, with a lightbox.",
  "kind": "Content",
  "icon": "images",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Around the gym" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "gallery", "id": "gallery", "label": "Gallery", "info": "Reads each item's asset, alt and caption, up to 24." },
    { "type": "checkbox", "id": "stagger", "label": "Stagger", "default": true },
    { "type": "select", "id": "treatment", "label": "Photo treatment", "default": "natural", "options": [
      { "value": "natural", "label": "Natural" },
      { "value": "mono", "label": "Mono" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
