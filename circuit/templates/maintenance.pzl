<!-- template: Maintenance -->
<!-- layout: default -->
<!-- A short pause notice on black: the wordmark, the line and how to reach
     the desk meanwhile. data-bare hides the groups (styles/theme.css). -->
<section class="sites-scheme-black grid min-h-dvh flex-1 place-items-center bg-scheme-background px-gutter py-section text-scheme-foreground" data-bare>
  <div class="grid w-full max-w-reading justify-items-center gap-step-md text-center">
    <p class="font-heading text-wordmark font-black text-scheme-heading uppercase stretch-heading">{ site.settings.wordmark || site.name }</p>
    <h1 class="font-heading text-h1 font-black text-balance text-scheme-heading uppercase stretch-display">{ t('maintenance_title') }</h1>
    <p class="text-body-lg text-pretty text-scheme-muted">{ t('maintenance_body') }</p>
    {#if site.settings.phone}<a class="font-mono text-body-sm text-scheme-links underline decoration-1 underline-offset-4 hover:no-underline" href="tel:{ site.settings.phone | replace(' ', '') }">{ site.settings.phone }</a>{/if}
    {#if site.settings.email}<a class="font-mono text-body-sm text-scheme-links underline decoration-1 underline-offset-4 hover:no-underline" href="mailto:{ site.settings.email }">{ site.settings.email }</a>{/if}
  </div>
</section>
