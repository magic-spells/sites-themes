<!-- template: Password -->
<!-- layout: default -->
<!-- The first hero slide behind a dark scrim, the wordmark at the display
     size, the password field and Enter. data-bare hides the header, footer
     and panel groups (styles/theme.css). -->
{#let photo = galleries['hero-slides'].items[0]}
<section class="sites-scheme-black relative isolate grid min-h-dvh flex-1 place-items-center bg-scheme-background px-gutter py-section text-on-photo" data-bare>
  {#if photo}<img class="absolute inset-0 -z-10 size-full object-cover grayscale" src="{ image_url(photo.asset, 2000) }" srcset="{ image_srcset(photo.asset, [768, 1280, 2000, 2560]) }" sizes="100vw" alt="" width={ photo.asset.width } height={ photo.asset.height } />{/if}
  <span class="absolute inset-0 -z-10 bg-scrim" aria-hidden="true"></span>
  <div class="grid w-full justify-items-center gap-step-lg text-center">
    <h1 class="font-heading text-display font-black text-balance uppercase stretch-display">{ site.settings.wordmark || site.name }</h1>
    <div class="grid w-full max-w-text gap-step-md">
      <p class="text-body-lg text-pretty">{ t('password_body') }</p>
      <!-- The unlock endpoint reads `password` and redirects to the `to` path. -->
      <form class="flex w-full flex-wrap items-end gap-step-xs text-left" method="post" action="/_sites/unlock">
        <input type="hidden" name="to" value="{ request.query.return_to }" />
        {#if request.query.password_error}<p class="w-full font-mono text-spec uppercase" role="alert">{ request.query.password_error }</p>{/if}
        <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" required={ true } prefix="password" wrapper_class="min-w-0 flex-1" />
        <Submit>{ t('password_submit') }</Submit>
      </form>
      <p class="font-mono text-spec font-medium uppercase">{ t('password_help') }</p>
    </div>
  </div>
</section>
