<!-- template: Password -->
<!-- layout: default -->
<!-- The wordmark on Black, a line, the password field over a full-width
     Enter, and a mono help line. data-bare hides the header, footer and
     panel groups (styles/theme.css). -->
<section class="sites-scheme-black relative isolate grid min-h-dvh flex-1 place-items-center bg-scheme-background px-gutter py-section text-scheme-foreground" data-bare>
  <div class="grid w-full justify-items-center gap-step-lg text-center">
    <h1 class="font-heading text-h1 font-black text-balance text-scheme-heading uppercase stretch-heading">{ site.settings.wordmark || site.name }</h1>
    <div class="grid w-full max-w-text gap-step-md">
      <p class="text-body-lg text-pretty text-scheme-muted">{ t('password_body') }</p>
      <!-- The unlock endpoint reads `password` and redirects to the `to` path. -->
      <form class="grid w-full gap-step-xs text-left" method="post" action="/_sites/unlock">
        <input type="hidden" name="to" value="{ request.query.return_to }" />
        {#if request.query.password_error}<p class="w-full font-mono text-spec uppercase" role="alert">{ request.query.password_error }</p>{/if}
        <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" required={ true } prefix="password" />
        <Submit wide={ true }>{ t('password_submit') }</Submit>
      </form>
      <p class="font-mono text-spec font-medium uppercase">{ t('password_help') }</p>
    </div>
  </div>
</section>
