<!-- component: Arrows -->
<!-- A carousel's round previous and next buttons on the tint, at the sides of its track halfway down, shown while the carousel (a group) is hovered or holds focus; from 48rem only (phones swipe). Tarot finds the buttons by their data-action attributes. -->
<div class="pointer-events-none absolute inset-x-0 top-1/2 flex -translate-y-1/2 justify-between opacity-0 transition-opacity duration-fast group-focus-within:opacity-100 group-hover:opacity-100 max-md:hidden">
  <button class="pointer-events-auto flex size-tap items-center justify-center rounded-full bg-scheme-tint transition-colors duration-fast hover:bg-scheme-foreground hover:text-scheme-background disabled:pointer-events-none disabled:opacity-40" type="button" data-action-tarot-previous aria-label="{ t('previous') }"><Glyph name="arrow-left" /></button>
  <button class="pointer-events-auto flex size-tap items-center justify-center rounded-full bg-scheme-tint transition-colors duration-fast hover:bg-scheme-foreground hover:text-scheme-background disabled:pointer-events-none disabled:opacity-40" type="button" data-action-tarot-next aria-label="{ t('next') }"><Glyph name="arrow-right" /></button>
</div>
