<!-- component: ChooserTile -->
<!-- A concern as a bordered tile, the whole tile one link: the icon in a tint circle, the concern in Card title, its line in Meta when line is set, a chevron at the foot right; surface-2 on hover. target service links to the treatment that usually helps instead of the concern's page. -->
{#let
  f = entry.fields
  href = target == 'service' && f.service ? '/services/' + f.service.handle : '/conditions/' + entry.handle
}
<article class="group relative flex h-full flex-col gap-space-md rounded-card border border-scheme-border bg-scheme-background p-space-lg transition-colors duration-fast hover:bg-scheme-surface-2 { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
  <IconCircle icon={ f.icon || 'tooth' } />
  <div class="grid gap-space-2xs">
    <h3 class="font-heading text-card"><a class="after:absolute after:inset-0" href="{ href }">{ entry.title }</a></h3>
    {#if line && f.summary}<p class="text-body-sm text-pretty text-scheme-muted">{ f.summary }</p>{/if}
  </div>
  <Glyph name="chevron-right" cls="mt-auto size-glyph self-end" />
</article>
