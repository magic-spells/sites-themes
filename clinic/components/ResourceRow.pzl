<!-- component: ResourceRow -->
<!-- A patient form or guide from a resource block, one link on a hairline: a file, arrow or portal glyph in the link colour, the label in Card title, the note in Meta. -->
{#let b = block.settings}
<li class="border-b border-scheme-border" data-block={ editor_id }>
  <a class="group flex items-start gap-space-md py-space-md" href="{ b.link }">
    <Glyph name={ b.kind == 'portal' ? 'external' : (b.kind == 'link' ? 'arrow-up-right' : 'file') } cls="size-glyph text-link" />
    <span class="grid gap-space-2xs"><span class="font-heading text-card group-hover:underline group-hover:underline-offset-4">{ b.label }</span>{#if b.note}<span class="text-body-sm text-scheme-muted">{ b.note }</span>{/if}</span>
  </a>
</li>
