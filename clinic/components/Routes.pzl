<!-- component: Routes -->
<!-- The two ways in: the ask button and the phone as a tel: link in the Price style. Side by side from 48rem; stacked on phones (the full width, even in a centred band), or always with stack, the button full width and the phone at the left. label replaces the ask label (Book with Dr Reyes). -->
{#let s = site.settings}
<div class="flex flex-col items-start gap-space-md max-md:justify-self-stretch { stack ? '' : 'md:flex-row md:items-center md:gap-space-lg' }">
  <Button ask wide={ stack } cls={ stack ? null : 'max-md:w-full' }>{ label || s.ask_label }</Button>
  {#if s.phone}
  <a class="font-heading text-h3 tnum hover:underline hover:underline-offset-4" href="tel:{ s.phone | replace(' ', '') }">{ s.phone }</a>
  {/if}
</div>
