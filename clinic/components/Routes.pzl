<!-- component: Routes -->
<!-- The two ways in: the ask button and the phone. Side by side from 48rem; stacked on phones, or always with stack, the button the full width and the phone aligned with the text (centred in a centred band). label replaces the ask label (Book with Dr Reyes). -->
<div class="flex flex-col gap-space-md max-md:justify-self-stretch { stack ? '' : 'md:flex-row md:items-center md:gap-space-lg' }">
  <Button ask>{ label || site.settings.ask_label }</Button>
  <Phone />
</div>
