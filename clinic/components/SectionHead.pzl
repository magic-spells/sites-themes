<!-- component: SectionHead -->
<!-- A section's head: the h2, an optional standfirst under it, and at the right the outlined "All …" button or whatever the section passes in (the rating pill). rule draws a hairline under both; center centres them (the cta band, the quote carousel). Stacks on phones. The gap to the content is xl. -->
{#if heading}
<div class="mb-space-xl flex flex-wrap gap-x-space-lg gap-y-space-md { center ? 'flex-col items-center text-center' : 'items-end justify-between' } { rule ? 'border-b border-scheme-border pb-space-md' : '' }">
  <div class="grid max-w-reading gap-space-xs">
    <h2 class="font-heading text-h2 text-balance">{ heading }</h2>
    {#if text}<p class="text-body-lg text-pretty text-scheme-muted">{ text }</p>{/if}
  </div>
  {#if link_label && link_href}<Button href={ link_href } tone="outline">{ link_label }</Button>{/if}
  <Children/>
</div>
{/if}
