<!-- component: Stars -->
<!-- A review's stars in the accent, one per star it gives. Nothing without stars. -->
{#if stars}<p class="flex gap-space-2xs text-scheme-accent" role="img" aria-label="{ t('rating', { n: stars }) }">{#for n in [1, 2, 3, 4, 5] | slice(0, stars)}<Glyph name="star" cls="size-icon-sm" />{/for}</p>{/if}
