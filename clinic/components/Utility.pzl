<!-- component: Utility -->
<!-- The utility pages' band: the page's own content (its children) centred in the column on white. bare hides the header, footer and panel groups (styles/theme.css). -->
<section class="{ (scheme ?? 'white') | scheme_class } flex flex-1 items-center bg-scheme-background px-gutter py-section text-scheme-foreground" data-bare={ bare ? true : null }>
  <div class="mx-auto grid w-full max-w-column justify-items-center gap-space-md text-center"><Children/></div>
</section>
