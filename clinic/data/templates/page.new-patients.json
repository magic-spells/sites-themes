      "blocks": []
    },
    {
      "id": "s_visit",
      "type": "first-visit",
      "preset": "Rail",
      "settings": {
        "layout": "rail",
        "image": "as_4x5_ice",
        "image_alt": "The Oakfield waiting room",
        "color_scheme": "white"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Forms ahead",
            "text": "Fill in your forms online, or arrive 15 minutes early."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Welcome and X-rays",
            "text": "A hygienist takes your history and the X-rays we need."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Your exam",
            "text": "Your dentist checks every tooth and your gums, and listens."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Your plan and next visit",
            "text": "We go through options and costs before anything starts."
          }
        },
        {
          "type": "bring",
          "settings": {
            "text": "Photo ID"
          }
        },
        {
          "type": "bring",
          "settings": {
            "text": "Your insurance card"
          }
        },
        {
          "type": "bring",
          "settings": {
            "text": "A list of your medications"
          }
        },
        {
          "type": "bring",
          "settings": {
            "text": "Your previous dentist's details, if you have them"
          }
        }
      ]
    },
