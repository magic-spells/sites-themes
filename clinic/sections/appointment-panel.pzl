<!-- TODO sync with Figma -->
<!-- The appointment request behind every ask button while Practice booking link is empty: the appointment form in a bottom-sheet on a phone that becomes a centred 40rem dialog from 48rem with the one soft shadow (styles/theme.css). It hands focus back to the button that opened it. Sent and error states come back on the page as ?form=…&sent=1 or &error=1, and the sheet opens on its own there. With a booking link set every ask is a plain link and this renders nothing. -->
{#if !site.settings.booking_url}
<dialog-panel>
  <dialog class="text-scheme-foreground" aria-labelledby="appointment-title">
    <bottom-sheet id="appointment" data-centred>
      <bottom-sheet-header class="flex items-start justify-between gap-space-md pt-space-md">
        <div class="grid gap-space-xs">
          <h2 class="font-heading text-h3" id="appointment-title">{ settings.heading || site.settings.ask_label }</h2>
          <p class="text-body-sm text-scheme-muted"><StatusDot /></p>
        </div>
        <button class="-m-space-xs flex size-tap shrink-0 items-center justify-center hover:text-link" type="button" data-action-hide-dialog><Glyph name="close" cls="size-glyph" /><span class="sr-only">{ t('close') }</span></button>
      </bottom-sheet-header>
      <bottom-sheet-content>
        <AppointmentFields handle={ settings.form } prefix="sheet" />
      </bottom-sheet-content>
    </bottom-sheet>
  </dialog>
</dialog-panel>
{/if}

<schema>
{
  "name": "Appointment panel",
  "description": "The appointment request behind every ask button: a sheet on phones, a dialog from tablets.",
  "kind": "Panels",
  "icon": "calendar-check",
  "settings": [
    { "type": "paragraph", "content": "Shown while the Practice booking link is empty. Set a booking link and every ask button goes there instead." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Leave empty to use the Practice ask label." },
    { "type": "form", "id": "form", "label": "Form", "info": "Leave empty to use the Practice appointment form." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
