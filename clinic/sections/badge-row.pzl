<!-- TODO sync with Figma -->
<!-- Stub: code B replaces this body. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } />
    <ul class="flex flex-wrap gap-space-xl">{#for block in blocks}<Badge block={ block } editor_id={ block.editor_id } dark={ settings.color_scheme == 'navy' || settings.color_scheme == 'slate' } />{/for}</ul>
  </div>
</section>

<schema>
{
  "name": "Badge row",
  "description": "Accreditations and memberships as a row of logos.",
  "kind": "Content",
  "icon": "award",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Accredited by" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cloud" }
  ],
  "blocks": [
    { "type": "badge", "name": "Badge", "settings": [
      { "type": "image", "id": "image", "label": "Logo" },
      { "type": "text", "id": "alt", "label": "Name", "info": "Read aloud in place of the logo." },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cloud" } }
  ]
}
</schema>
