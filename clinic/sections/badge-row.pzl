<!-- TODO sync with Figma -->
<!-- Accreditations: an optional heading centred, then the logos from the blocks, greyscale at the badge opacity (inverted on navy and slate); a centred wrapping row from 48rem, a row that scrolls past the right edge on phones. -->
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter">
  <div class="mx-auto max-w-column">
    {#if settings.heading}<h2 class="mb-space-lg px-gutter text-center font-heading text-card md:px-0">{ settings.heading }</h2>{/if}
    <ul class="flex snap-x items-center gap-space-xl overflow-x-auto px-gutter md:flex-wrap md:justify-center md:overflow-visible md:px-0">{#for block in blocks}<Badge block={ block } editor_id={ block.editor_id } dark={ settings.color_scheme == 'navy' || settings.color_scheme == 'slate' } />{/for}</ul>
  </div>
</section>

<schema>
{
  "name": "Badge row",
  "description": "Accreditations and memberships as a row of logos.",
  "kind": "Content",
  "icon": "award",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Accredited by" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cloud" }
  ],
  "blocks": [
    { "type": "badge", "name": "Badge", "settings": [
      { "type": "image", "id": "image", "label": "Logo" },
      { "type": "text", "id": "alt", "label": "Name", "info": "Read aloud in place of the logo." },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cloud" } }
  ]
}
</schema>
