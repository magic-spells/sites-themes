<!-- The call bar, phones only: fixed to the foot of the screen below 48rem while Practice call bar is on, the phone number as an outlined tel: button and the ask button filling the rest of the row, safe-area padding under them. It steps aside while the sheet or the menu is open. -->
{#let s = site.settings}
{#if s.show_call_bar && s.phone}
<div class="fixed inset-x-0 bottom-0 z-30 flex gap-space-sm bg-scheme-background px-gutter pt-space-sm pb-safe text-scheme-foreground md:hidden panel-open:hidden">
  <Button href="tel:{ s.phone | replace(' ', '') }" tone="outline" cls="tnum">{ s.phone }</Button>
  <Button ask cls="flex-1">{ settings.ask_label || s.ask_label }</Button>
</div>
<div class="h-call-bar md:hidden" aria-hidden="true"></div>
{/if}

<schema>
{
  "name": "Call bar",
  "description": "Phones only: Call and the ask button fixed to the foot of the screen.",
  "kind": "Panels",
  "icon": "phone",
  "settings": [
    { "type": "text", "id": "ask_label", "label": "Button label", "default": "Book", "info": "Short: the phone number takes its own width first. Leave empty for the Practice ask label." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "navy" } }
  ]
}
</schema>
