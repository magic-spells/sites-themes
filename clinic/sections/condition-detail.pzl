<!-- A concern's page: the title in h1, the summary as the standfirst, the body in seven parts beside the 3:2 photo in five (the photo first on phones); then the treatment that usually helps as one service card, who to see as one clinician card, and the two routes. -->
{#let
  entry = page.entry
  f = entry.fields
}
{#if entry}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-2xl">
    <header class="grid max-w-reading gap-space-sm">
      <h1 class="font-heading text-h1 text-balance"><Rise text={ entry.title } /></h1>
      {#if f.summary}<p class="text-body-lg text-pretty text-scheme-muted">{ f.summary }</p>{/if}
    </header>
    <div class="grid items-start gap-space-xl md:grid-cols-text-picture md:gap-space-3xl">
      {#if f.body}<div class="sites-prose text-body" data-lead>{ f.body }</div>{/if}
      {#if f.image}<div class="max-md:order-first"><Well asset={ f.image } alt={ f.image_alt } width={ 1200 } sizes="(min-width: 48rem) 40vw, 100vw" eager /></div>{/if}
    </div>
    {#if f.service}<div class="grid gap-space-md"><h2 class="font-heading text-h4">{ t('treatment') }</h2><div class="max-w-card"><ServiceCard entry={ f.service } price /></div></div>{/if}
    {#if f.team}<div class="grid gap-space-md"><h2 class="font-heading text-h4">{ t('who_to_see') }</h2><div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6"><ClinicianCard entry={ f.team } /></div></div>{/if}
    <Routes />
  </div>
</section>
{/if}

<schema>
{
  "name": "Concern detail",
  "description": "A concern's page: what it is, the treatment that usually helps, who to see and the routes.",
  "kind": "Content",
  "icon": "file-text",
  "templates": ["condition"],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
