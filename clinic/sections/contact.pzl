<!-- TODO sync with Figma -->
<!-- The contact page: the heading and standfirst over the contact form (name, email, subject, message) on a white card in seven parts; every location's hours card stacked in five. -->
{#let locations = content.locations.entries | sort('fields.order') | slice(0, 4)}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl md:grid-cols-text-picture md:gap-space-2xl">
    <div class="grid gap-space-lg">
      <div class="grid gap-space-xs">
        <h2 class="font-heading text-h2 text-balance">{ settings.heading }</h2>
        {#if settings.text}<p class="max-w-reading text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
      </div>
      <div class="sites-scheme-white rounded-card border border-scheme-border bg-scheme-background p-space-xl text-scheme-foreground">
        <AppointmentFields handle={ settings.form || site.settings.contact_form } prefix="contact" plain />
      </div>
    </div>
    <ul class="grid gap-space-md">{#for loc in locations}<li><HoursCard entry={ loc } /></li>{/for}</ul>
  </div>
</section>

<schema>
{
  "name": "Contact",
  "description": "A contact form on a card beside the offices' hours.",
  "kind": "Contact",
  "icon": "mail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Write to us" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "For records, a bill or anything that is not an appointment. We answer within one working day." },
    { "type": "form", "id": "form", "label": "Form", "info": "Leave empty to use the Contact form setting." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
