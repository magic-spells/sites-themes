<!-- TODO sync with Figma -->
<!-- Stub: code B replaces this body. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-md">
    <h2 class="font-heading text-h2">{ settings.heading }</h2>
    <p class="text-body-lg text-scheme-muted">{ settings.text || site.settings.confirm_line }</p>
    <Routes />
    {#if settings.form == 'inline'}<AppointmentFields prefix="cta" compact />{/if}
  </div>
</section>

<schema>
{
  "name": "Call to action",
  "description": "The band every page ends on: the heading, the confirm line and the two routes, or the short request form beside them.",
  "kind": "Contact",
  "icon": "megaphone",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to book?" },
    { "type": "text", "id": "text", "label": "Text", "default": "", "info": "Leave empty to use the Practice confirm line." },
    { "type": "select", "id": "form", "label": "Request form", "default": "none", "options": [
      { "value": "none", "label": "None: the two routes" },
      { "value": "inline", "label": "Beside the heading, on a white card" }
    ], "info": "The form shows four fields and links to the full one." },
    { "type": "checkbox", "id": "show_proof_row", "label": "Proof row", "default": true, "info": "With the form only." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "navy" } },
    { "name": "With the form", "settings": { "form": "inline", "color_scheme": "navy" } }
  ]
}
</schema>
