<!-- TODO sync with Figma -->
<!-- The band every page ends on, a hairline at its foot (the seam to the footer). None: the heading, the confirm line and the routes, centred. Inline: two halves from 48rem, the heading, the confirm line and the routes stacked left; the four-field request form on a white card right, with its link to the full form. -->
{#let
  s = site.settings
  text = settings.text || s.confirm_line
}
<section class="border-b border-scheme-border bg-scheme-background px-gutter py-section text-scheme-foreground">
  {#if settings.form == 'inline'}
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:grid-cols-2 md:gap-space-3xl">
    <div class="grid gap-space-lg">
      <h2 class="font-heading text-h2 text-balance">{ settings.heading }</h2>
      {#if text}<p class="text-body-lg text-pretty text-scheme-muted">{ text }</p>{/if}
      <Routes stack />
    </div>
    <FormCard heading={ settings.form_heading }><AppointmentFields prefix="cta-{ section.id }" compact /></FormCard>
  </div>
  {:else}
  <div class="mx-auto grid max-w-column justify-items-center text-center">
    <SectionHead heading={ settings.heading } text={ text } center />
    <Routes />
  </div>
  {/if}
</section>

<schema>
{
  "name": "Call to action",
  "description": "The band every page ends on: the heading, the confirm line and the two routes, or the short request form beside them.",
  "kind": "Contact",
  "icon": "megaphone",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to book?" },
    { "type": "text", "id": "text", "label": "Text", "default": "", "info": "Leave empty to use the Practice confirm line." },
    { "type": "select", "id": "form", "label": "Request form", "default": "none", "options": [
      { "value": "none", "label": "None: the two routes" },
      { "value": "inline", "label": "Beside the heading, on a white card" }
    ], "info": "The form shows four fields and links to the full one." },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Request an appointment", "info": "Over the request form on its card." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "navy" } },
    { "name": "With the form", "settings": { "form": "inline", "color_scheme": "navy" } }
  ]
}
</schema>
