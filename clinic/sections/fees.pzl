<!-- TODO sync with Figma -->
<!-- Stub: code B replaces this body. -->
{#let services = content.services.entries | sort('fields.order') | reject('fields.price', null) | slice(0, 12)}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } />
    <ul>{#for entry in services}<FeeRow entry={ entry } duration={ settings.show_duration } />{/for}</ul>
    {#if settings.disclaimer}<p class="text-body-sm text-scheme-muted">{ settings.disclaimer }</p>{/if}
  </div>
</section>

<schema>
{
  "name": "Fees",
  "description": "Your fees as a table, grouped by category, from the services with a price.",
  "kind": "Collections",
  "icon": "receipt",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fees" },
    { "type": "select", "id": "source", "label": "Services", "default": "all", "options": [
      { "value": "all", "label": "All with a price" },
      { "value": "featured", "label": "Featured" },
      { "value": "category", "label": "One category" }
    ] },
    { "type": "entry", "id": "category", "label": "Category", "info": "One category only." },
    { "type": "checkbox", "id": "show_duration", "label": "Durations", "default": true },
    { "type": "select", "id": "columns", "label": "Tables on desktop", "default": "1", "options": [
      { "value": "1", "label": "One column" },
      { "value": "2", "label": "Two side by side" }
    ] },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Fees are a guide. We confirm the cost of your treatment before it begins." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Check your coverage" },
    { "type": "url", "id": "cta_link", "label": "Button link", "default": "/fees", "info": "Leave empty to call the Practice phone." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cloud" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cloud" } },
    { "name": "Featured", "settings": { "source": "featured", "color_scheme": "cloud" } }
  ]
}
</schema>
