<!-- TODO sync with Figma -->
<!-- The fee table: the section head with the disclaimer as its standfirst and "Check your coverage" (a link, or a call to the Practice phone); then, per category, an h4 over a 2px rule in the text colour and its priced services as fee rows on hairlines. All with a price, the featured ones, or one category; two tables side by side from 64rem with columns 2. -->
{#let
  s = site.settings
  priced = content.services.entries | sort('fields.order') | reject('fields.price', null)
  services = settings.source == 'featured' ? priced | where('fields.featured') : priced
  groups = settings.source == 'category' && settings.category ? [settings.category] : content.categories.entries | sort('fields.order') | slice(0, 12)
  cta = settings.cta_link || (s.phone ? 'tel:' + (s.phone | replace(' ', '')) : null)
}
{#if services.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.disclaimer } link_label={ settings.cta_label } link_href={ cta } />
    <div class="gap-x-space-2xl { settings.columns == '2' ? 'lg:columns-2' : '' }">
      {#for category in groups}
        {#let rows = services | where('fields.category.id', category.id) | slice(0, 12)}
        {#if rows.length}
        <div class="break-inside-avoid pb-space-2xl last:pb-0">
          <h3 class="border-b-2 border-scheme-foreground pb-space-xs font-heading text-h4">{ category.title }</h3>
          <ul>{#for entry in rows}<FeeRow entry={ entry } duration={ settings.show_duration } />{/for}</ul>
        </div>
        {/if}
      {/for}
    </div>
  </div>
</section>
{/if}

<schema>
{
  "name": "Fees",
  "description": "Your fees as a table, grouped by category, from the services with a price.",
  "kind": "Collections",
  "icon": "receipt",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fees" },
    { "type": "select", "id": "source", "label": "Services", "default": "all", "options": [
      { "value": "all", "label": "All with a price" },
      { "value": "featured", "label": "Featured" },
      { "value": "category", "label": "One category" }
    ] },
    { "type": "entry", "id": "category", "label": "Category", "info": "One category only." },
    { "type": "checkbox", "id": "show_duration", "label": "Durations", "default": true },
    { "type": "select", "id": "columns", "label": "Tables on desktop", "default": "1", "options": [
      { "value": "1", "label": "One column" },
      { "value": "2", "label": "Two side by side" }
    ] },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Fees are a guide. We confirm the cost of your treatment before it begins." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Check your coverage" },
    { "type": "url", "id": "cta_link", "label": "Button link", "default": "/fees", "info": "Leave empty to call the Practice phone." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cloud" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cloud" } },
    { "name": "Featured", "settings": { "source": "featured", "color_scheme": "cloud" } }
  ]
}
</schema>
