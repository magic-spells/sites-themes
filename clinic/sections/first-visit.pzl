<!-- TODO sync with Figma -->
<!-- Stub: code B replaces this body. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.duration_line } />
    <ol>{#for block in blocks | where('type', 'step'), i}<Step block={ block } number={ settings.show_numbers ? i + 1 : null } editor_id={ block.editor_id } />{/for}</ol>
    <ul>{#for block in blocks | where('type', 'bring')}<li data-block={ block.editor_id }>{ block.settings.text }</li>{/for}</ul>
  </div>
</section>

<schema>
{
  "name": "First visit",
  "description": "What happens at a first visit, step by step, with what to bring and the forms to fill in ahead.",
  "kind": "Content",
  "icon": "list-ordered",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your first visit" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "rail", "options": [
      { "value": "rail", "label": "Steps down a line, beside a photo" },
      { "value": "row", "label": "Steps in a row" }
    ] },
    { "type": "checkbox", "id": "show_numbers", "label": "Step numbers", "default": true },
    { "type": "text", "id": "duration_line", "label": "Duration line", "default": "Plan for 60–90 minutes" },
    { "type": "image", "id": "image", "label": "Photo (4:5)", "info": "Steps down a line only." },
    { "type": "text", "id": "image_alt", "label": "Photo alt text", "default": "" },
    { "type": "text", "id": "bring_heading", "label": "What to bring heading", "default": "What to bring" },
    { "type": "text", "id": "forms_label", "label": "Forms button", "default": "Fill in your forms ahead", "info": "Goes to the Practice patient forms link; hidden without one." },
    { "type": "text", "id": "portal_label", "label": "Portal link", "default": "Patient portal", "info": "Goes to the Practice patient portal; hidden without one." },
    { "type": "text", "id": "parking_line", "label": "Parking line", "default": "Free parking behind the building; step-free entrance." },
    { "type": "checkbox", "id": "show_ask", "label": "Ask button", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "ice" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "limit": 6, "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Line" }
    ] },
    { "type": "bring", "name": "What to bring", "limit": 6, "settings": [
      { "type": "text", "id": "text", "label": "Item" }
    ] }
  ],
  "presets": [
    { "name": "Rail", "settings": { "layout": "rail", "color_scheme": "ice" }, "blocks": [
      { "type": "step", "settings": { "title": "Forms ahead", "text": "Fill in your forms online, or arrive 15 minutes early." } },
      { "type": "step", "settings": { "title": "Welcome and X-rays", "text": "A hygienist takes your history and the X-rays we need." } },
      { "type": "step", "settings": { "title": "Your exam", "text": "Your dentist checks every tooth and your gums, and listens." } },
      { "type": "step", "settings": { "title": "Your plan and next visit", "text": "We go through options and costs before anything starts." } },
      { "type": "bring", "settings": { "text": "Photo ID" } },
      { "type": "bring", "settings": { "text": "Your insurance card" } },
      { "type": "bring", "settings": { "text": "A list of your medications" } },
      { "type": "bring", "settings": { "text": "Your previous dentist's details, if you have them" } }
    ] },
    { "name": "Row", "settings": { "layout": "row", "color_scheme": "ice" } }
  ]
}
</schema>
