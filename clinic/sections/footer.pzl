<!-- The colophon on slate: the wordmark, the tagline, the registration lines and, over a hairline, the social links; Visit (the first location's name, address, phone and hours); Services (each category on the Services page's tab, then All services); Patients (a menu). A strip under a rule: the small print, the legal links and the Practice footer note, spread across from 48rem. Four equal columns from 64rem, two from 48rem, one on phones. -->
{#let
  s = site.settings
  categories = content.categories.entries | sort('fields.order') | slice(0, 6)
  home = content.locations.entries | sort('fields.order') | first
  link = 'hover:underline hover:underline-offset-4'
}
<footer class="bg-scheme-background px-gutter pt-section pb-space-xl text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-2xl">
    <div class="grid gap-space-xl md:grid-cols-2 lg:grid-cols-4">
      <div class="grid max-w-text content-start gap-space-md text-body-sm text-scheme-muted">
        <a class="font-heading text-h3 text-scheme-foreground" href="/">{ s.wordmark || site.name }</a>
        {#if s.tagline}<p class="text-pretty">{ s.tagline }</p>{/if}
        {#if s.registration_lines}<p class="grid">{#for line in s.registration_lines | split('\n')}<span>{ line }</span>{/for}</p>{/if}
        {#if settings.social_menu.items.length}<p class="border-t border-scheme-border pt-space-md text-scheme-foreground">{#for item in settings.social_menu.items, i}{#if i} · {/if}<a class="{ link }" href="{ item.href }">{ item.label }</a>{/for}</p>{/if}
      </div>
      {#if home}
        <div>
          <h2 class="mb-space-md font-heading text-body-lg font-medium">{ t('visit') }</h2>
          {#let f = home.fields}
          <address class="grid gap-space-sm text-body not-italic">
            <span class="font-heading text-h4 font-medium">{ home.title }</span>
            {#if f.address}<span class="whitespace-pre-line">{ f.address }</span>{/if}
            {#if f.phone}<a class="justify-self-start text-body-lg tnum { link }" href="tel:{ f.phone | replace(' ', '') }">{ f.phone }</a>{/if}
            {#if f.hours}<span class="whitespace-pre-line text-body-sm text-scheme-muted tnum">{ f.hours }</span>{/if}
          </address>
        </div>
      {/if}
      {#if categories.length}
        <nav aria-labelledby="footer-services">
          <h2 class="mb-space-md font-heading text-body-lg font-medium" id="footer-services">{ t('services') }</h2>
          <ul class="grid gap-space-sm text-body">
            {#for category in categories}<li><a class="{ link }" href="{ settings.services_path }?category={ category.handle }">{ category.title }</a></li>{/for}
            <li><a class="{ link }" href="{ settings.services_path }">{ t('all_services') }</a></li>
          </ul>
        </nav>
      {/if}
      {#if settings.patients_menu.items.length}
        <nav aria-labelledby="footer-patients">
          <h2 class="mb-space-md font-heading text-body-lg font-medium" id="footer-patients">{ settings.patients_menu.title }</h2>
          <ul class="grid gap-space-sm text-body">{#for item in settings.patients_menu.items}<li><a class="{ link }" href="{ item.href }">{ item.label }</a></li>{/for}</ul>
        </nav>
      {/if}
    </div>
    <div class="flex flex-col gap-space-sm border-t border-scheme-border pt-space-lg text-body-sm md:flex-row md:items-center md:justify-between">
      {#if settings.small_print}<p class="text-scheme-muted">{ settings.small_print }</p>{/if}
      {#if settings.legal_menu.items.length}<p>{#for item in settings.legal_menu.items, i}{#if i} · {/if}<a class="{ link }" href="{ item.href }">{ item.label }</a>{/for}</p>{/if}
      {#if s.footer_note}<p class="text-scheme-muted">{ s.footer_note }</p>{/if}
    </div>
  </div>
</footer>

<schema>
{
  "name": "Footer",
  "description": "The wordmark and registration lines, the services, a patients menu and the offices, then the small print.",
  "kind": "Footer",
  "icon": "panel-bottom",
  "settings": [
    { "type": "paragraph", "content": "The tagline, registration lines and footer note come from the Brand and Practice settings; Visit shows your first location." },
    { "type": "url", "id": "services_path", "label": "Services page", "default": "/services", "info": "Each category links to its tab on this page." },
    { "type": "menu", "id": "patients_menu", "label": "Patients menu", "info": "Its title heads the column: New patients, Insurance and fees, Patient forms, Patient portal." },
    { "type": "menu", "id": "social_menu", "label": "Social links" },
    { "type": "menu", "id": "legal_menu", "label": "Legal links" },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "© 2026 Oakfield Family Dental" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "slate" }
  ],
  "presets": [
    { "name": "Default", "settings": { "patients_menu": "patients", "social_menu": "social", "legal_menu": "legal", "color_scheme": "slate" } }
  ]
}
</schema>
