<!-- The first screen: the h1, the standfirst and two buttons (the ask, and an outline link left out when its label is empty), side by side from 30rem, in seven parts of twelve. Split: beside the 4:5 (or 3:2) photo, which comes first at 3:2 on phones. Panel: no buttons (the card is the ask), beside the four-field request form on a white card. Cover: over the photo filling the band (3:2 from 48rem, or the full screen), the band's colour fading from 80% on the type's side to 20%; inset rounds it inside the page margins. Only the cover carries data-over-hero, for the over-hero header. -->
{#let
  layout = settings.layout
  cover = layout == 'cover'
}
<section class="bg-scheme-background text-scheme-foreground { cover ? (settings.inset ? 'px-gutter pb-space-lg' : '') : 'px-gutter py-section' }" data-over-hero={ cover || null }>
  <div class="{ cover ? 'relative isolate flex items-center overflow-hidden px-gutter py-section ' + (settings.height == 'full' ? 'min-h-svh' : 'md:aspect-photo md:max-h-svh md:w-full') + (settings.inset ? ' rounded-photo' : '') : '' }">
    {#if cover}{ image_tag(settings.image, { alt: settings.image_alt, class: 'absolute inset-0 -z-10 size-full object-cover', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }) }<span class="absolute inset-0 -z-10 bg-scrim"></span>{/if}
    <div class="mx-auto grid w-full max-w-column items-center gap-space-xl md:grid-cols-text-picture md:gap-space-3xl">
      <div class="grid gap-space-lg">
        <h1 class="font-heading text-h1 text-balance"><Rise text={ settings.heading } /></h1>
        {#if settings.text}<p class="max-w-reading text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
        {#if layout != 'panel'}<div class="grid gap-space-sm xs:flex">
          <Button ask />
          {#if settings.secondary_label}<Button tone="outline" href={ settings.secondary_link }>{ settings.secondary_label }</Button>{/if}
        </div>{/if}
      </div>
      {#if layout == 'panel'}
        <FormCard heading={ settings.form_heading }><AppointmentFields prefix="hero-{ section.id }" compact /></FormCard>
      {:else if !cover}
        <div class="max-md:order-first"><Well asset={ settings.image } alt={ settings.image_alt } ratio={ settings.ratio == 'photo' ? 'aspect-photo' : 'aspect-photo md:aspect-portrait' } width={ 1200 } sizes="(min-width: 48rem) 40vw, 100vw" eager /></div>
      {/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Hero",
  "description": "The first screen: the heading and two buttons beside a photo, over it, or beside the short request form.",
  "kind": "Hero",
  "icon": "panel-top",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [
      { "value": "split", "label": "Type beside a photo" },
      { "value": "cover", "label": "Type over a photo" },
      { "value": "panel", "label": "Type beside the request form" }
    ], "info": "The request form shows four fields (reason, name, phone, time of day); the full form stays in the panel." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Family dentistry in Oakfield, with time to listen." },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "Two offices, six clinicians and evening hours on Thursdays. Gentle care for every age, since 2007." },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Request an appointment", "info": "Type beside the request form only." },
    { "type": "image", "id": "image", "label": "Image", "info": "4:5 beside the type, 3:2 behind it." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "select", "id": "ratio", "label": "Photo shape", "default": "portrait", "options": [
      { "value": "portrait", "label": "Portrait (4:5)" },
      { "value": "photo", "label": "Landscape (3:2)" }
    ], "info": "Type beside a photo only." },
    { "type": "select", "id": "height", "label": "Height", "default": "tall", "options": [
      { "value": "tall", "label": "Tall" },
      { "value": "full", "label": "The full screen" }
    ], "info": "Type over a photo only." },
    { "type": "checkbox", "id": "inset", "label": "Inset", "default": false, "info": "Type over a photo only: the photo rounded inside the page margins." },
    { "type": "text", "id": "secondary_label", "label": "Second button label", "default": "Our services", "info": "Leave empty to show the ask button alone. Not beside the request form." },
    { "type": "url", "id": "secondary_link", "label": "Second button link", "default": "/services" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Split", "settings": { "layout": "split", "color_scheme": "white" } },
    { "name": "Cover", "settings": { "layout": "cover", "color_scheme": "navy" } },
    { "name": "Panel", "settings": { "layout": "panel", "color_scheme": "cloud" } }
  ]
}
</schema>
