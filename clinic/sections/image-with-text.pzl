<!-- TODO sync with Figma -->
<!-- A photo beside copy: the text in seven parts and the photo in five from 48rem, left or right; stacked on phones, the photo first. Single: one 4:5 well. Duo: two 1rem wells offset, the second lower and overlapping the first's corner. The heading, the rich text and one outlined button. -->
{#let left = settings.image_side == 'left'}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:gap-space-3xl { left ? 'md:grid-cols-picture-text' : 'md:grid-cols-text-picture' }">
    <div class="grid justify-items-start gap-space-md { left ? 'md:order-last' : '' }">
      <h2 class="font-heading text-h2 text-balance">{ settings.heading }</h2>
      <div class="sites-prose max-w-reading text-body-lg text-scheme-muted">{ settings.text }</div>
      {#if settings.link_label && settings.link}<Button href={ settings.link } tone="outline">{ settings.link_label }</Button>{/if}
    </div>
    {#if settings.layout == 'duo' && settings.image_2}
      <div class="grid grid-cols-6 max-md:order-first">
        <div class="col-span-4 col-start-1 row-start-1"><Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-portrait" width={ 800 } sizes="(min-width: 48rem) 28vw, 66vw" /></div>
        <div class="col-span-3 col-start-4 row-start-1 mt-space-3xl self-end"><Well asset={ settings.image_2 } alt={ settings.image_2_alt } ratio="aspect-square" width={ 640 } sizes="(min-width: 48rem) 20vw, 50vw" /></div>
      </div>
    {:else}
      <div class="max-md:order-first"><Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-portrait" width={ 960 } sizes="(min-width: 48rem) 40vw, 100vw" /></div>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Image with text",
  "description": "One photo, or two offset, beside a heading, text and a button.",
  "kind": "Content",
  "icon": "columns-2",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "single", "options": [
      { "value": "single", "label": "One photo" },
      { "value": "duo", "label": "Two photos, offset" }
    ] },
    { "type": "image", "id": "image", "label": "Image (4:5)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "image", "id": "image_2", "label": "Second image (1:1)", "info": "Two photos only." },
    { "type": "text", "id": "image_2_alt", "label": "Second image alt text", "default": "" },
    { "type": "select", "id": "image_side", "label": "Photos", "default": "right", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Time to listen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We book longer appointments than most practices, so there is time to explain what we see and answer every question.</p>" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "About us" },
    { "type": "url", "id": "link", "label": "Button link", "default": "/about" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } },
    { "name": "Two photos", "settings": { "layout": "duo", "color_scheme": "white" } }
  ]
}
</schema>
