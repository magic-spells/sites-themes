<!-- TODO sync with Figma -->
<!-- Two or more offices as hours cards, three across from 64rem, two from 48rem, one on phones, each under its 4:3 map image (or its photo), linked to the location's page. -->
{#let locs = content.locations.entries | sort('fields.order') | slice(0, 12)}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid gap-space-lg md:grid-cols-2 lg:grid-cols-3">
      {#for loc in locs}
        <li class="grid content-start gap-space-md">
          <a class="block" href="/locations/{ loc.handle }" aria-label="{ loc.title }"><Well asset={ loc.fields.map_image || loc.fields.image } alt={ loc.fields.map_image_alt } ratio="aspect-map" width={ 800 } sizes="(min-width: 64rem) 26rem, (min-width: 48rem) 50vw, 100vw" /></a>
          <HoursCard entry={ loc } />
        </li>
      {/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Locations",
  "description": "Every office as an hours card under its map.",
  "kind": "Contact",
  "icon": "map-pin",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cloud" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cloud" } }
  ]
}
</schema>
