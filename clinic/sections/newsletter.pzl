<!-- Advice by email, centred: the heading (and a line when set) over one white field whose label is its placeholder (the label stays for screen readers) beside the button, stacked on phones. No note. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading justify-items-center gap-space-lg text-center">
    <div class="grid gap-space-xs">
      <h2 class="font-heading text-h2 text-balance">{ settings.heading }</h2>
      {#if settings.text}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
    </div>
    <Form handle={ settings.form || site.settings.newsletter_form } class="grid w-full max-w-card gap-space-xs">
      {#if form.sent}
        <p class="text-body-lg" role="status">{ form.success_message || t('form_success') }</p>
      {:else}
        <div class="flex flex-col gap-space-sm sm:flex-row">
          {#for field in form.fields}
            <label class="sr-only" for="news-{ field.id }">{ field.label }</label>
            <input class="block min-h-control min-w-0 flex-1 rounded-input border bg-input-background px-space-sm text-body text-input-text placeholder:text-input-placeholder focus:border-input-active focus:outline-2 focus:outline-offset-1 focus:outline-input-active { field.error ? 'border-scheme-error' : 'border-input-border' }" id="news-{ field.id }" name={ field.id } type={ field.type } placeholder={ field.label } autocomplete="email" maxlength={ field.max_length } required={ field.required } value={ field.value } aria-invalid={ field.error ? 'true' : 'false' } aria-describedby={ field.error ? 'news-error' : null } />
          {/for}
          <Button type="submit">{ form.submit_label }</Button>
        </div>
        {#if form.error}<p class="text-body-sm text-scheme-error" id="news-error" role="alert">{ t('form_error') }</p>{/if}
      {/if}
    </Form>
  </div>
</section>

<schema>
{
  "name": "Newsletter",
  "description": "Advice by email: a heading and one field.",
  "kind": "Contact",
  "icon": "mail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Advice in your inbox" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "form", "id": "form", "label": "Form", "info": "Leave empty to use the Contact newsletter form." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "ice" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "ice" } }
  ]
}
</schema>
