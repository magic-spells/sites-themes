<!-- A page's head: the h1 (the page title unless a heading is set), the standfirst under it. Left or centred; no kicker. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-md { settings.align == 'center' ? 'justify-items-center text-center' : 'justify-items-start' }">
    <h1 class="max-w-reading font-heading text-h1 text-balance"><Rise text={ settings.heading || page.title } /></h1>
    {#if settings.text}<p class="max-w-reading text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
  </div>
</section>

<schema>
{
  "name": "Page header",
  "description": "The page's title and a standfirst.",
  "kind": "Content",
  "icon": "heading-1",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Centred" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cloud" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cloud" } }
  ]
}
</schema>
