<!-- TODO sync with Figma -->
<!-- Stub: code B replaces this body. -->
{#let plans = content.plans.entries | sort('fields.order') | slice(0, 6)}
{#if plans.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid gap-space-lg md:grid-cols-3">{#for entry in plans}<li><PlanCard entry={ entry } /></li>{/for}</ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Plans",
  "description": "Membership or health plans as cards, the featured one raised.",
  "kind": "Collections",
  "icon": "badge-check",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "No insurance? Our Smile Plan" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "source", "label": "Plans", "default": "all", "options": [
      { "value": "all", "label": "All" },
      { "value": "featured", "label": "Featured" }
    ] },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "3", "options": [
      { "value": "2", "label": "Two" },
      { "value": "3", "label": "Three" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cloud" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cloud" } }
  ]
}
</schema>
