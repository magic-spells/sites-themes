<!-- Prose in the 40rem reading column: an optional heading, then the editor's rich text, its first paragraph the lead. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading gap-space-md">
    {#if settings.heading}<h2 class="font-heading text-h2 text-balance">{ settings.heading }</h2>{/if}
    <div class="sites-prose text-body" data-lead>{ settings.text }</div>
  </div>
</section>

<schema>
{
  "name": "Rich text",
  "description": "A heading and prose in a reading column.",
  "kind": "Content",
  "icon": "text-align-start",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We keep what you tell us to answer you and to care for you. We never sell it. Ask us to see or delete it any time.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
