<!-- A service's page: its category as the one overline, the name in h1, the summary once as a standfirst, then ONE decision row on a hairline (the duration and the price left, the ask button right). The description in seven parts beside the 3:2 photo (or the icon large on the tint) in five, the picture first on phones. Under the description: what the visit includes (a fold), the concerns it helps as chips, who provides it, and the questions in the blocks. -->
{#let
  entry = page.entry
  f = entry.fields
  concerns = content.conditions.entries | sort('fields.order') | where('fields.service.id', entry.id) | slice(0, 12)
  who = f.team
}
{#if entry}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-2xl">
    <header class="grid gap-space-lg">
      <div class="grid max-w-reading gap-space-sm">
        {#if f.category}<p class="text-body-sm text-scheme-muted"><a class="hover:underline hover:underline-offset-4" href="{ settings.services_path }?category={ f.category.handle }">{ f.category.title }</a></p>{/if}
        <h1 class="font-heading text-h1 text-balance"><Rise text={ entry.title } /></h1>
        {#if f.summary}<p class="text-body-lg text-pretty text-scheme-muted">{ f.summary }</p>{/if}
      </div>
      <div class="flex flex-wrap items-center justify-between gap-space-md border-b border-scheme-border pb-space-lg">
        <p class="flex flex-wrap items-baseline gap-x-space-md gap-y-space-2xs">
          <Price entry={ entry } cls="font-heading text-h3" />
          {#if f.price_note}<span class="text-body-sm text-scheme-muted">{ f.price_note }</span>{/if}
          {#if f.duration_minutes}<span class="text-body-sm text-scheme-muted tnum">{ t('minutes', { n: f.duration_minutes }) }</span>{/if}
        </p>
        <Button ask cls="max-md:w-full" />
      </div>
    </header>
    <div class="grid items-start gap-space-xl md:grid-cols-text-picture md:gap-space-3xl">
      <div class="grid gap-space-xl">
        {#if f.description}<div class="sites-prose text-body" data-lead>{ f.description }</div>{/if}
        {#if f.includes}
          <collapsible-component class="block border-y border-scheme-border">
            <h2><button class="group flex w-full items-center justify-between gap-space-md py-space-md text-left font-heading text-card" type="button">{ t('includes') }<Glyph name="chevron-down" cls="size-icon transition-transform duration-fast group-aria-expanded:rotate-180" /></button></h2>
            <collapsible-content open>
              <ul class="grid gap-space-sm pb-space-md">{#for line in f.includes | split('\n')}{#if line | strip}<li class="flex gap-space-sm"><Glyph name="check" cls="mt-space-2xs size-icon text-link" />{ line | strip }</li>{/if}{/for}</ul>
            </collapsible-content>
          </collapsible-component>
        {/if}
        {#if concerns.length}
          <div class="grid gap-space-sm">
            <h2 class="font-heading text-card">{ t('concerns_helped') }</h2>
            <ul class="flex flex-wrap gap-space-xs">{#for c in concerns}<li><a class="flex min-h-tap items-center rounded-full bg-scheme-tint px-chip text-body-sm hover:bg-scheme-surface-2" href="/conditions/{ c.handle }">{ c.title }</a></li>{/for}</ul>
          </div>
        {/if}
        {#if who}
          <div class="grid gap-space-sm">
            <h2 class="font-heading text-card">{ t('who_provides') }</h2>
            <div class="grid grid-cols-2 md:grid-cols-3"><ClinicianCard entry={ who } /></div>
          </div>
        {/if}
        {#if blocks.length}
          <div class="grid gap-space-md">
            <h2 class="font-heading text-h3">{ settings.faq_heading }</h2>
            <Questions items={ blocks } first_open />
          </div>
        {/if}
      </div>
      <div class="max-md:order-first">{#if f.image}<Well asset={ f.image } alt={ f.image_alt } width={ 1200 } sizes="(min-width: 48rem) 40vw, 100vw" eager />
      {:else}<span class="flex aspect-photo items-center justify-center rounded-photo bg-scheme-tint text-link"><Glyph name={ f.icon || 'tooth' } cls="size-glyph-2xl" /></span>{/if}</div>
    </div>
  </div>
</section>
{/if}

<schema>
{
  "name": "Service detail",
  "description": "A service's page: the decision row, the description, what it includes, the concerns it helps and who provides it.",
  "kind": "Content",
  "icon": "file-text",
  "templates": ["service"],
  "settings": [
    { "type": "url", "id": "services_path", "label": "Services page", "default": "/services", "info": "The category above the title links to its tab here." },
    { "type": "text", "id": "faq_heading", "label": "Questions heading", "default": "Questions" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" }, "blocks": [
      { "type": "question", "settings": { "question": "Will my insurance cover it?", "answer": "<p>Call us with your plan name and we'll check before your visit. We file the claim for you.</p>" } },
      { "type": "question", "settings": { "question": "Does it hurt?", "answer": "<p>We numb the area first and check in as we go. Tell us and we stop.</p>" } }
    ] }
  ]
}
</schema>
