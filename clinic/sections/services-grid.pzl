<!-- Services as cards, three across from 64rem (or two or four), two from 48rem, one on phones: the icon (or the 3:2 photo with image), the name, the summary, the arrow and the price. Featured, all, or one category's, in their order, up to the limit. -->
{#let
  all = content.services.entries | sort('fields.order')
  picked = settings.source == 'featured' ? all | where('fields.featured') : (settings.source == 'category' && settings.category ? all | where('fields.category.id', settings.category.id) : all)
  services = picked | slice(0, settings.limit)
  cols = settings.columns == '2' ? 'lg:grid-cols-2' : (settings.columns == '4' ? 'lg:grid-cols-4' : 'lg:grid-cols-3')
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link }><ul class="grid gap-space-lg md:grid-cols-2 { cols }">{#for entry in services}<li><ServiceCard entry={ entry } photo={ settings.show_image } price={ settings.show_price } /></li>{/for}</ul></SectionHead>
  </div>
</section>

<schema>
{
  "name": "Services grid",
  "description": "Services as cards with their icon or photo, summary and price.",
  "kind": "Collections",
  "icon": "layout-grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular services" },
    { "type": "select", "id": "head_align", "label": "Heading", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" }] },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "All services" },
    { "type": "url", "id": "link", "label": "Button link", "default": "/services" },
    { "type": "select", "id": "source", "label": "Services", "default": "featured", "options": [
      { "value": "featured", "label": "Featured" },
      { "value": "all", "label": "All" },
      { "value": "category", "label": "One category" }
    ] },
    { "type": "entry", "id": "category", "label": "Category", "info": "One category only." },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "3", "options": [
      { "value": "2", "label": "Two" },
      { "value": "3", "label": "Three" },
      { "value": "4", "label": "Four" }
    ] },
    { "type": "checkbox", "id": "show_image", "label": "Photos", "default": false, "info": "The service's 3:2 photo instead of its icon." },
    { "type": "checkbox", "id": "show_price", "label": "Prices", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } },
    { "name": "Photos", "settings": { "show_image": true, "color_scheme": "cloud" } }
  ]
}
</schema>
