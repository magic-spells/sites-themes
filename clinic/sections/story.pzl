<!-- The practice's story: the heading, the prose, the Practice registration lines in Meta and a text link in seven parts, beside the 4:3 photo in five, left or right; stacked on phones, the text first. -->
{#let
  s = site.settings
  left = settings.image_side == 'left'
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:gap-space-3xl { left ? 'md:grid-cols-picture-text' : 'md:grid-cols-text-picture' }">
    <div class="grid justify-items-start gap-space-md { left ? 'md:order-last' : '' }">
      <h2 class="font-heading text-h2 text-balance">{ settings.heading }</h2>
      <div class="sites-prose max-w-reading text-body-lg">{ settings.text }</div>
      {#if settings.show_registration && s.registration_lines}<p class="grid text-body-sm text-scheme-muted">{#for line in s.registration_lines | split('\n')}<span>{ line }</span>{/for}</p>{/if}
      {#if settings.link_label && settings.link}<a class="text-body font-medium text-link underline underline-offset-4" href="{ settings.link }">{ settings.link_label }</a>{/if}
    </div>
    <Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-map" width={ 960 } sizes="(min-width: 48rem) 40vw, 100vw" />
  </div>
</section>

<schema>
{
  "name": "Story",
  "description": "The practice's story beside a photo, with your registration lines.",
  "kind": "Content",
  "icon": "book-open",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our practice" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Dr Hannah Reyes opened the Oakfield office in 2007 with two chairs and one hygienist. Pine Ridge followed in 2019. Six of us now, and most of our patients come by word of mouth.</p>" },
    { "type": "checkbox", "id": "show_registration", "label": "Registration lines", "default": true, "info": "The Practice registration lines under the text." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Meet the team" },
    { "type": "url", "id": "link", "label": "Link", "default": "/team" },
    { "type": "image", "id": "image", "label": "Image (4:3)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "select", "id": "image_side", "label": "Image", "default": "right", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cloud" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cloud" } }
  ]
}
</schema>
