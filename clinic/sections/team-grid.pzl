<!-- TODO sync with Figma -->
<!-- The clinicians as cards: the 4:5 portrait, the name with the letters, the role; four across from 64rem (or three), three from 48rem, two on phones, or one swiping row on phones. Featured, all, or a group: the people whose role has (or lacks) the group's word, so a large practice shows Dentists and Hygienists as two bands. A location narrows any of them; on a location's own page it narrows to that location. -->
{#let
  team = content.team.entries | sort('fields.order')
  here = page.entry ? content.locations.entries | find('id', page.entry.id) : null
  place = settings.location || here
  local = place ? team | where('fields.location.id', place.id) : team
  people = settings.source == 'group' ? local : (settings.source == 'featured' ? local | where('fields.featured') : local) | slice(0, settings.limit)
  word = settings.group | downcase
  row = settings.mobile == 'row'
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link } />
    <ul class="grid gap-x-space-md gap-y-space-xl md:grid-cols-3 md:gap-x-space-lg { settings.columns == '3' ? '' : 'lg:grid-cols-4' } { row ? 'max-md:-mx-gutter max-md:flex max-md:snap-x max-md:snap-mandatory max-md:overflow-x-auto max-md:px-gutter max-md:scroll-px-gutter' : 'grid-cols-2' }">
      {#for entry in people}
        {#if settings.source != 'group' || !word || contains(entry.fields.role | downcase, word) == (settings.match != 'lacks')}
        <li class="{ row ? 'max-md:w-3/5 max-md:shrink-0 max-md:snap-start' : '' }"><ClinicianCard entry={ entry } /></li>
        {/if}
      {/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Team grid",
  "description": "Your clinicians as portrait cards: featured, all, or one group by role.",
  "kind": "Collections",
  "icon": "users",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our team" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "All team" },
    { "type": "url", "id": "link", "label": "Button link", "default": "/team" },
    { "type": "select", "id": "source", "label": "People", "default": "featured", "options": [
      { "value": "featured", "label": "Featured" },
      { "value": "all", "label": "All" },
      { "value": "group", "label": "A group, by role" }
    ] },
    { "type": "text", "id": "group", "label": "Group word", "default": "", "info": "A group only: a word in the role, like dentist, hygienist or physio. Not case-sensitive." },
    { "type": "select", "id": "match", "label": "Group is the people whose role", "default": "has", "options": [
      { "value": "has", "label": "Has the word" },
      { "value": "lacks", "label": "Lacks the word" }
    ], "info": "Lacks makes the rest of the team one group: hygienists, the manager and the front desk." },
    { "type": "entry", "id": "location", "label": "Location", "info": "Only the people at this location. On a location's page, empty means that location." },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 4, "info": "Featured and all only." },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "4", "options": [
      { "value": "3", "label": "Three" },
      { "value": "4", "label": "Four" }
    ] },
    { "type": "select", "id": "mobile", "label": "On phones", "default": "grid", "options": [
      { "value": "grid", "label": "Two across" },
      { "value": "row", "label": "One row that swipes" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } },
    { "name": "Group", "settings": { "source": "group", "group": "dentist", "heading": "Dentists", "link_label": "", "color_scheme": "white" } }
  ]
}
</schema>
