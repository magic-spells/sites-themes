<!-- TODO sync with Figma -->
<!-- Stub: code B replaces this body. -->
{#let reviews = content.testimonials.entries | sort('fields.order') | slice(0, settings.limit)}
{#if reviews.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading }>{#if settings.show_rating}<RatingPill />{/if}</SectionHead>
    <ul class="grid gap-space-lg md:grid-cols-3">{#for entry in reviews}<li><ReviewCard entry={ entry } /></li>{/for}</ul>
    {#if settings.layout == 'carousel'}<Arrows bar="reviews-bar" />{/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Testimonials",
  "description": "Patients' reviews as cards or a carousel, with your rating.",
  "kind": "Collections",
  "icon": "quote",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "checkbox", "id": "show_rating", "label": "Rating", "default": true, "info": "The Practice rating, review count and review link beside the heading." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "rows", "options": [
      { "value": "rows", "label": "Cards in rows" },
      { "value": "carousel", "label": "Carousel" }
    ] },
    { "type": "select", "id": "source", "label": "Reviews", "default": "featured", "options": [
      { "value": "featured", "label": "Featured first" },
      { "value": "all", "label": "All" }
    ], "info": "On a service's or a clinician's page, the reviews that name them come first when there are any." },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Rows", "settings": { "layout": "rows", "color_scheme": "white" } },
    { "name": "Carousel", "settings": { "layout": "carousel", "limit": 8, "color_scheme": "cloud" } }
  ]
}
</schema>
