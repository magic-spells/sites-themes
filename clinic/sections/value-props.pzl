<!-- TODO sync with Figma -->
<!-- Stub: code B replaces this body. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } />
    <ul>{#for block in blocks}<li data-block={ block.editor_id }>{ block.settings.title }: { block.settings.text }</li>{/for}</ul>
  </div>
</section>

<schema>
{
  "name": "Value props",
  "description": "Three or four reasons to choose you, each with an icon and one line.",
  "kind": "Content",
  "icon": "badge-check",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Oakfield" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "row", "options": [
      { "value": "row", "label": "One row (two by two on phones)" },
      { "value": "cards", "label": "Cards" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "blocks": [
    { "type": "prop", "name": "Reason", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "heart", "options": [
      { "value": "heart", "label": "Heart" }, { "value": "clock", "label": "Clock" }, { "value": "calendar", "label": "Calendar" }, { "value": "pin", "label": "Pin" },
      { "value": "phone", "label": "Phone" }, { "value": "check", "label": "Check" }, { "value": "smile", "label": "Smile" }, { "value": "tooth", "label": "Tooth" },
      { "value": "shield-plus", "label": "Shield" }, { "value": "stethoscope", "label": "Stethoscope" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "leaf", "label": "Leaf" },
      { "value": "hand", "label": "Hand" }, { "value": "baby", "label": "Baby" }, { "value": "paw", "label": "Paw" }, { "value": "brain", "label": "Brain" }
    ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Line" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Row", "settings": { "layout": "row", "color_scheme": "navy" }, "blocks": [
      { "type": "prop", "settings": { "icon": "heart", "title": "Gentle, unhurried care", "text": "Longer appointments, so nobody feels rushed." } },
      { "type": "prop", "settings": { "icon": "clock", "title": "Same-day emergency slots", "text": "Call before 10 am and we'll see you today." } },
      { "type": "prop", "settings": { "icon": "calendar", "title": "Evening hours on Thursdays", "text": "Open until 7 pm at Oakfield." } },
      { "type": "prop", "settings": { "icon": "pin", "title": "Two offices, one team", "text": "Oakfield and Pine Ridge, the same clinicians." } }
    ] },
    { "name": "Cards", "settings": { "layout": "cards", "color_scheme": "cloud" } }
  ]
}
</schema>
