<!-- template: Maintenance -->
<!-- layout: default -->
<!-- The site paused, with no header or footer: the wordmark, "Back soon" with the phone for anything urgent, and the Practice emergency line. -->
<Utility bare>
  <p class="font-heading text-h3 font-bold">{ site.settings.wordmark || site.name }</p>
  <h1 class="max-w-reading font-heading text-h2 text-balance">{ t('maintenance_body', { phone: site.settings.phone }) }</h1>
  {#if site.settings.emergency_line}<p class="text-body-lg text-pretty text-scheme-muted">{ site.settings.emergency_line }</p>{/if}
</Utility>
