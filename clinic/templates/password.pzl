<!-- template: Password -->
<!-- layout: default -->
<!-- The site behind a password, on cloud with no header or footer: one white card at most 26.25rem wide with the wordmark, the line, the password field over Enter, and the phone in Meta. -->
<Utility bare scheme="cloud">
  <div class="w-full max-w-card text-left">
    <FormCard>
      <p class="font-heading text-h3 font-bold">{ site.settings.wordmark || site.name }</p>
      <h1 class="text-body">{ t('password_body') }</h1>
      <form class="grid gap-space-md" method="post" action="/_sites/unlock">
        <input type="hidden" name="to" value="{ request.query.return_to }" />
        {#if request.query.password_error}<p class="text-body-sm text-scheme-error" role="alert">{ request.query.password_error }</p>{/if}
        <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" required prefix="password" />
        <Button type="submit" wide>{ t('password_submit') }</Button>
      </form>
      {#if site.settings.phone}<a class="justify-self-start text-body-sm text-scheme-muted tnum hover:underline hover:underline-offset-4" href="tel:{ site.settings.phone | replace(' ', '') }">{ site.settings.phone }</a>{/if}
    </FormCard>
  </div>
</Utility>
