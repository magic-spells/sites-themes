<!-- template: Password -->
<!-- layout: default -->
<!-- The site behind a password, with no header or footer: the wordmark, the line, the password field over Enter, and the phone. -->
<Utility bare>
  <p class="font-heading text-h3 font-bold">{ site.settings.wordmark || site.name }</p>
  <h1 class="font-heading text-h2 text-balance">{ t('password_body') }</h1>
  <form class="grid w-full max-w-text gap-space-sm text-left" method="post" action="/_sites/unlock">
    <input type="hidden" name="to" value="{ request.query.return_to }" />
    {#if request.query.password_error}<p class="text-body-sm text-scheme-error" role="alert">{ request.query.password_error }</p>{/if}
    <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" required prefix="password" />
    <Button type="submit" wide>{ t('password_submit') }</Button>
  </form>
  {#if site.settings.phone}<a class="font-heading text-h3 tnum hover:underline hover:underline-offset-4" href="tel:{ site.settings.phone | replace(' ', '') }">{ site.settings.phone }</a>{/if}
</Utility>
