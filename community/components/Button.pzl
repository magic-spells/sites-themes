<!-- component: Button -->
<!-- The button: fully round, sentence case, 500. tone primary (the scheme's button, the default) or secondary (the scheme's secondary button, a hairline in its text colour). size sm is the 2.5rem pill of a section head. With type it is a <button> of that type; wide fills the row; cls adds classes. -->
{#let
  look = tone == 'secondary' ? 'border-scheme-secondary-button-foreground bg-scheme-secondary-button-background text-scheme-secondary-button-foreground hover:bg-scheme-secondary-button-hover-background hover:text-scheme-secondary-button-hover-foreground' : 'border-scheme-button-background bg-scheme-button-background text-scheme-button-foreground hover:border-scheme-button-hover-background hover:bg-scheme-button-hover-background hover:text-scheme-button-hover-foreground'
  all = 'inline-flex items-center justify-center rounded-button border text-center transition-colors duration-fast ' + (size == 'sm' ? 'min-h-pill px-pill-x text-label ' : 'min-h-control px-button-x py-button-y text-button ') + look + (wide ? ' w-full' : '') + (cls ? ' ' + cls : '')
}
{#if type}<button class="{ all }" type="{ type }"><Children/></button>{:else}<a class="{ all }" href="{ href }"><Children/></a>{/if}
