<!-- component: Field -->
<!-- A labelled input: the label above in the label size, the box on the band with the muted hairline, the placeholder muted; the error under it, tied by aria-describedby. -->
{#let
  id = 'field-' + prefix + '-' + name
  err = error ? 'error-' + prefix + '-' + name : null
  box = 'block w-full rounded-input border bg-scheme-input-background px-space-sm text-body text-scheme-input-foreground placeholder:text-scheme-muted ' + (error ? 'border-scheme-error' : 'border-scheme-input-border')
}
<div class={ wide ? 'md:col-span-2' : null }>
  <label class="mb-space-xs block text-label" for="{ id }">{ label }{#if required}<span aria-hidden="true"> *</span>{/if}</label>
  {#if type == 'textarea'}
    <textarea class="{ box } min-h-textarea resize-y py-space-sm" id="{ id }" name={ name } placeholder={ placeholder } maxlength={ maxlength } required={ required } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ err }>{ value }</textarea>
  {:else}
    <input class="{ box } min-h-control" id="{ id }" name={ name } type={ type ?? 'text' } placeholder={ placeholder } autocomplete={ autocomplete ?? (type == 'email' ? 'email' : (name == 'name' ? 'name' : 'off')) } maxlength={ maxlength } required={ required } value={ value } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ err } />
  {/if}
  {#if error}<p class="mt-space-xs text-small text-scheme-error" id="{ err }">{ t('form_field_' + error) }</p>{/if}
</div>
