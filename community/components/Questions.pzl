<!-- component: Questions -->
<!-- The faq's and the first visit's rows: hairlines above, between and under, each question in 500 at H4 size with a plus (a minus once open), the answer under it in 400. items are blocks with settings.question and settings.answer; the first opens. Without JavaScript every row shows. No numbers. -->
<ul class="border-b border-scheme-border">
  {#for item in items, i}
    <li class="border-t border-scheme-border" data-block={ item.editor_id }>
      <collapsible-component>
        <h3 class="text-scheme-heading"><button class="group flex items-center justify-between gap-space-md py-space-md text-h4 font-medium" type="button">{ item.settings.question }<Glyph name="plus" cls="size-icon-sm group-aria-expanded:hidden" /><Glyph name="minus" cls="hidden size-icon-sm group-aria-expanded:block" /></button></h3>
        <collapsible-content open={ i == 0 }>
          <div class="sites-prose max-w-reading pb-space-lg">{ item.settings.answer }</div>
        </collapsible-content>
      </collapsible-component>
    </li>
  {/for}
</ul>
