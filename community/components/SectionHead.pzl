<!-- component: SectionHead -->
<!-- A section's head: the h2 and the standfirst under it at reading width, and the outlined "All …" pill at the right, level with the heading's first line; below 48rem the pill goes under the standfirst. The pill hides on the page it points to. The gap to the content is xl. -->
{#if heading}
<div class="mb-space-xl flex flex-col items-start gap-space-sm md:flex-row md:justify-between md:gap-space-xl">
  <div class="grid max-w-reading gap-space-sm">
    <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ heading } /></h2>
    {#if text}<p class="text-pretty">{ text }</p>{/if}
  </div>
  {#if link_label && link_href && page.path != link_href}<Button href={ link_href } tone="secondary" size="sm" cls="shrink-0 md:mt-space-3xs">{ link_label }</Button>{/if}
</div>
{/if}
