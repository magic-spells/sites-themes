<!-- component: Well -->
<!-- A photo well: the frame that cuts a photo to its fixed crop (ratio, aspect-square by default) over surface-2, with a hairline and 0.5rem corners. With no asset it holds a quiet placeholder glyph. -->
<span class="grid place-items-center overflow-hidden bg-scheme-surface-2 outline outline-scheme-border -outline-offset-1 rounded-photo { ratio ?? 'aspect-square' }">
  {#if asset}<img class="size-full object-cover" src="{ image_url(asset, width ?? 800) }" srcset="{ image_srcset(asset, [480, 768, 1024, 1600]) }" sizes="{ sizes ?? '100vw' }" alt="{ alt ?? asset.alt }" loading="{ eager ? 'eager' : 'lazy' }" fetchpriority={ eager ? 'high' : null } width={ asset.width } height={ asset.height } />{:else}<Glyph name="image" cls="size-icon text-scheme-muted" />{/if}
</span>
