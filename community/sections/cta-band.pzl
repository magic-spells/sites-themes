<!-- One ask, centred: the H2, a standfirst and one or two buttons (primary, then secondary). -->
{#let
  one = settings.link
  two = settings.link_2
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading justify-items-center gap-space-md text-center">
    <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>
    {#if settings.text}<p class="text-pretty">{ settings.text }</p>{/if}
    {#if one?.href || two?.href}
      <div class="flex flex-wrap justify-center gap-space-sm pt-space-xs">
        {#if one?.href}<Button href={ one.href }>{ one.label }</Button>{/if}
        {#if two?.href}<Button href={ two.href } tone="secondary">{ two.label }</Button>{/if}
      </div>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Call to action",
  "description": "One line and one or two buttons.",
  "kind": "Content",
  "icon": "megaphone",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come and say hello" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "link", "id": "link", "label": "Button" },
    { "type": "link", "id": "link_2", "label": "Second button" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "blue" }
  ],
  "presets": [
    { "name": "Default", "settings": { "link": { "href": "/visit", "label": "Visit us" }, "color_scheme": "blue" } }
  ]
}
</schema>
