<!-- Your first visit: the heading, the standfirst and an optional button in five parts; the questions in seven as rows that open, no numbers. Stacks below 64rem. -->
{#let link = settings.link}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl lg:grid-cols-five-seven lg:gap-space-2xl">
    <div class="grid max-w-reading justify-items-start gap-space-sm">
      <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>
      {#if settings.text}<p class="text-pretty">{ settings.text }</p>{/if}
      {#if link?.href && link?.label && page.path != link.href}<Button href={ link.href } tone="secondary" cls="mt-space-sm">{ link.label }</Button>{/if}
    </div>
    <Questions items={ blocks } />
  </div>
</section>

<schema>
{
  "name": "First visit",
  "description": "What to expect the first time: the time, the cost, what to bring, children, access and who to ask.",
  "kind": "Content",
  "icon": "footprints",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your first visit" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "New to the house? Here is what to expect." },
    { "type": "link", "id": "link", "label": "Button", "info": "Hidden on the page it points to." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "What time should I arrive?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Any time during a session is fine. Most people arrive in the first ten minutes.</p>" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "link": { "href": "/visit", "label": "Plan your visit" } }, "blocks": [
      { "type": "question", "settings": { "question": "What time should I arrive?", "answer": "<p>Any time during a session is fine. Most people arrive in the first ten minutes.</p>" } },
      { "type": "question", "settings": { "question": "Does it cost anything?", "answer": "<p>Most groups are free. Where there is a charge, the group's page says so and you pay on the day.</p>" } },
      { "type": "question", "settings": { "question": "Who do I ask when I get there?", "answer": "<p>Whoever is at the desk by the door. They will introduce you to the group.</p>" } }
    ] }
  ]
}
</schema>
