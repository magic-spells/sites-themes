<!-- The hall's sign: the logo at the Brand width, or the name in the heading face (H4, H3 from 48rem; a long name stays at H4, two lines at most); from 64rem the main menu in one line of body text with a hairline under the current page (an item with children opens a dropdown-panel of them) and the one ask. Below 64rem the name and the menu icon. No phone, no status. Sticky: the padding shrinks and a hairline shows once the page scrolls. -->
{#let
  s = site.settings
  name = s.name || site.name
  link = 'underline-offset-8 decoration-1 hover:underline current:underline'
}
<sticky-header class="block" settle-overshoot="0" disabled={ !settings.sticky }>
  <header class="border-b border-transparent bg-scheme-background px-gutter py-space-sm text-scheme-foreground transition-all duration-fast lg:py-space-lg scrolled:border-scheme-border scrolled:py-space-xs">
    <div class="mx-auto flex max-w-column items-center gap-space-xl">
      <a class="me-auto line-clamp-2 max-w-sign font-heading text-balance { name.length > 32 ? 'text-h4' : 'text-h4 md:text-h3' }" href="/">{#if s.logo}<img class="block h-auto max-w-full" src="{ image_url(s.logo, 480) }" alt="{ name }" width={ s.logo_width * 16 } height={ (s.logo_width * 16 * s.logo.height / s.logo.width) | round } />{:else}{ name }{/if}</a>
      {#if menus.main.items.length}
        <nav class="hidden lg:block" aria-label="{ t('main_navigation') }">
          <ul class="flex items-center gap-space-lg">
            {#for item in menus.main.items}
              <li>
                {#if item.children.length}
                  <dropdown-component trigger="both" close-delay="150">
                    <dropdown-trigger class="flex min-h-control items-center gap-space-2xs">{ item.label }<Glyph name="chevron-down" cls="size-icon-sm" /></dropdown-trigger>
                    <dropdown-panel class="{ 'paper' | scheme_class } min-w-full rounded-paper border border-scheme-border bg-scheme-background p-space-xs text-scheme-foreground">
                      <ul class="grid">{#for child in item.children}<li><a class="block rounded-inner px-space-sm py-space-xs whitespace-nowrap hover:bg-scheme-surface-2 current:underline" href="{ child.href }" aria-current={ child.active ? 'page' : null }>{ child.label }</a></li>{/for}</ul>
                    </dropdown-panel>
                  </dropdown-component>
                {:else}
                  <a class="flex min-h-control items-center { link }" href="{ item.href }" aria-current={ item.active ? 'page' : null }>{ item.label }</a>
                {/if}
              </li>
            {/for}
          </ul>
        </nav>
      {/if}
      {#if s.ask_label && s.ask_url}<Button ask cls="max-lg:hidden" />{/if}
      <button class="-me-space-sm flex size-control items-center justify-center lg:hidden" type="button" data-panel-open="mobile-menu" aria-haspopup="dialog" aria-controls="mobile-menu"><Glyph name="menu" /><span class="sr-only">{ t('menu') }</span></button>
    </div>
  </header>
</sticky-header>

<schema>
{
  "name": "Header",
  "description": "The house's name or logo, the main menu and the one ask; the menu icon on phones.",
  "kind": "Header",
  "icon": "panel-top",
  "settings": [
    { "type": "paragraph", "content": "The name, logo and button come from the Brand and House settings; the links from the main menu." },
    { "type": "checkbox", "id": "sticky", "label": "Sticky", "default": true, "info": "Stays at the top as the page scrolls, a little shorter." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
