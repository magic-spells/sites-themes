<!-- A 3:2 picture in seven parts beside the text in five (the picture left or right; above the text on phones): the H2, the text and one optional button. Without a picture the text runs alone at reading width. -->
{#let
  right = settings.side == 'right'
  link = settings.link
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:gap-space-2xl { settings.image ? (right ? 'md:grid-cols-five-seven' : 'md:grid-cols-seven-five') : '' }">
    {#if settings.image}<div class="{ right ? 'md:order-last' : '' }"><Well asset={ settings.image } ratio="aspect-wide" width={ 1200 } sizes="(min-width: 48rem) 55vw, 100vw" /></div>{/if}
    <div class="grid max-w-reading justify-items-start gap-space-md">
      {#if settings.heading}<h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>{/if}
      {#if settings.text}<div class="sites-prose text-pretty">{ settings.text }</div>{/if}
      {#if link?.href && link?.label}<Button href={ link.href } tone="secondary" cls="mt-space-xs">{ link.label }</Button>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Image with text",
  "description": "A picture beside a heading, text and a button.",
  "kind": "Content",
  "icon": "columns-2",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A house run by its neighbours" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The house opened in a former bank in 1984. Today a coordinator and sixty volunteers keep it open six days a week.</p>" },
    { "type": "image", "id": "image", "label": "Image", "info": "3:2 crops best." },
    { "type": "select", "id": "side", "label": "Picture", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "link", "id": "link", "label": "Button" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
