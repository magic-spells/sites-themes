<!-- Stub (code B builds the board): the section head, the events, then the notices as a plain list. -->
{#let events = content.events.entries | sort('fields.date') | slice(0, settings.limit)}
<section class="bg-scheme-background px-gutter py-section-tight text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ t('all_events') } link_href="/whats-on" />
    <ul>
      {#for entry in events}<li><a href="/whats-on/{ entry.handle }">{ entry.title }</a> · { entry.fields.date | date('medium') }</li>{/for}
      {#for block in blocks}<li data-block={ block.editor_id }>{ block.settings.text }</li>{/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Noticeboard",
  "description": "Paper slips on a board: the next events, then notices from the house.",
  "kind": "Collections",
  "icon": "sticky-note",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Noticeboard" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "One-off events and news from the house." },
    { "type": "range", "id": "limit", "label": "Events", "min": 0, "max": 9, "step": 1, "default": 6, "info": "The next events, soonest first. 0 shows the notices alone." },
    { "type": "url", "id": "newsletter_link", "label": "Newsletter link", "default": "", "info": "With nothing pinned up, the one slip invites visitors to the newsletter here." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "blue" }
  ],
  "blocks": [
    { "type": "notice", "name": "Notice", "settings": [
      { "type": "textarea", "id": "text", "label": "Text", "default": "Volunteers wanted for the Friday supper rota, one evening a month." },
      { "type": "link", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "blue" } }
  ]
}
</schema>
