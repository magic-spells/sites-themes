<!-- Stub (code B builds the wall): the section head and the album covers or the gallery's photos as a plain list. -->
{#let items = settings.source == 'gallery' ? (settings.gallery ? settings.gallery.items : []) : (content.albums.entries | sort('fields.date') | reverse)}
{#if items.length > 2}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ t('all_photos') } link_href="/photos" />
    <ul>{#for item in items}<li>{ item.title || item.alt }</li>{/for}</ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Photo wall",
  "description": "Prints of the house's photos across the page: album covers or one gallery.",
  "kind": "Content",
  "icon": "images",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Photos" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "source", "label": "Photos", "default": "albums", "options": [
      { "value": "albums", "label": "Album covers" },
      { "value": "gallery", "label": "A gallery" }
    ], "info": "Album covers link to their albums; a gallery's photos open larger." },
    { "type": "gallery", "id": "gallery", "label": "Gallery" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "collage", "options": [
      { "value": "collage", "label": "Collage" },
      { "value": "mosaic", "label": "Mosaic" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
