<!-- Prose at reading width, left or centred: an optional heading, then the text (the page's own body when the section has none). Signed: a person closes it, their portrait or initial at 3rem beside the role over the name, and the band runs loose: the coordinator's note. -->
{#let
  who = settings.person
  centre = settings.align == 'center'
}
<section class="bg-scheme-background px-gutter text-scheme-foreground { who ? 'py-section-loose' : 'py-section' }">
  <div class="mx-auto grid max-w-reading gap-space-lg { centre ? 'justify-items-center text-center' : '' }">
    {#if settings.heading}<h2 class="font-heading text-h2 text-balance"><Rise text={ settings.heading } /></h2>{/if}
    <div class="sites-prose text-pretty { who ? 'text-lead' : '' }">{#if settings.body}{ settings.body }{:else}{ page.content }{/if}</div>
    {#if who}<PersonLine person={ who } />{/if}
  </div>
</section>

<schema>
{
  "name": "Rich text",
  "description": "Prose in a reading column, optionally signed by a person.",
  "kind": "Content",
  "icon": "text-align-start",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "", "info": "Leave empty to show the page's own text." },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Centred" }
    ] },
    { "type": "entry", "id": "person", "label": "Signed by", "info": "A person from People: their role and name close the text, as a note from them." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} },
    { "name": "Signed note", "settings": { "body": "<p>Larch Street is a small house with a lot going on. Almost all of it is run by neighbours who came along once for a cup of tea and stayed.</p>" } }
  ]
}
</schema>
