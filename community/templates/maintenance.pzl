<!-- template: Maintenance -->
<!-- layout: default -->
<!-- The site paused, on blue with no header or footer: the name, "Back soon." and one line with the email for anything urgent. -->
<Utility bare scheme="blue">
  <p class="font-heading text-h3 text-balance text-scheme-heading">{ site.settings.name || site.name }</p>
  <h1 class="font-heading text-h2 text-balance text-scheme-heading">{ t('maintenance_title') }</h1>
  {#if site.settings.email}<p class="text-pretty">{ t('maintenance_body', { email: site.settings.email }) }</p>{/if}
</Utility>
