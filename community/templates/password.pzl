<!-- template: Password -->
<!-- layout: default -->
<!-- The site behind a password, on mist with no header or footer: one paper card with the name, the line and the password field over Enter. -->
<Utility bare scheme="mist">
  <div class="{ 'paper' | scheme_class } grid w-full max-w-sign gap-space-md rounded-paper bg-scheme-background p-space-lg text-left text-scheme-foreground md:p-space-xl">
    <p class="font-heading text-h3 text-balance text-scheme-heading">{ site.settings.name || site.name }</p>
    <h1>{ t('password_body') }</h1>
    <form class="grid gap-space-md" method="post" action="/_sites/unlock">
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}<p class="text-small text-scheme-error" role="alert">{ request.query.password_error }</p>{/if}
      <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" required prefix="password" />
      <Button type="submit" wide>{ t('password_submit') }</Button>
    </form>
  </div>
</Utility>
