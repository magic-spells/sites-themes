<!-- component: Field -->
<!-- props: name label type autocomplete required rows maxlength options value error placeholder prefix wrapper_class -->
<div class={ wrapper_class }>
  <label class="sites-label" for="field-{ prefix }-{ name }">{ label }</label>
  {#if type == 'textarea'}
    <textarea class="sites-input" id="field-{ prefix }-{ name }" name={ name } rows={ rows ?? 4 } maxlength={ maxlength } required={ required } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ error ? 'error-' + prefix + '-' + name : null }>{ value }</textarea>
  {:else if type == 'select'}
    <select class="sites-input" id="field-{ prefix }-{ name }" name={ name } required={ required } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ error ? 'error-' + prefix + '-' + name : null }>
      <option value="">{ t('form_choose_option') }</option>
      {#for option in options}<option value={ option } selected={ value == option }>{ option }</option>{/for}
    </select>
  {:else if type == 'checkbox'}
    <input id="field-{ prefix }-{ name }" name={ name } type="checkbox" value="on" checked={ value == 'on' } required={ required } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ error ? 'error-' + prefix + '-' + name : null } />
  {:else}
    <!-- A declared form field carries no autocomplete token, so the two that
         browsers actually fill in are recognized by name here. -->
    <input class="sites-input" id="field-{ prefix }-{ name }" name={ name } type={ type ?? 'text' } autocomplete={ autocomplete ?? (type == 'email' ? 'email' : (name == 'name' ? 'name' : 'off')) } maxlength={ maxlength } required={ required } value={ value } placeholder={ placeholder } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ error ? 'error-' + prefix + '-' + name : null } />
  {/if}
  {#if error}<p class="mt-space-xs text-sm text-error-fg" id="error-{ prefix }-{ name }">{ t('form_field_' + error) }</p>{/if}
</div>
