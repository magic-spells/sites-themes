    {
      "id": "s_features",
      "type": "features-grid",
      "settings": {
        "columns": "3",
        "heading": "What you will find",
        "padding": "normal",
        "text": "A small shop, chosen by hand. Everything on the shelves is here because someone here read it."
      },
      "blocks": [
        {
          "id": "b_feat_books",
          "type": "feature",
          "settings": {
            "icon": "book",
            "text": "Around four thousand titles, and no algorithm anywhere near them.",
            "title": "Chosen by hand"
          }
        },
        {
          "id": "b_feat_prints",
          "type": "feature",
          "settings": {
            "icon": "sparkle",
            "text": "A changing wall of local printmakers, framed while you wait.",
