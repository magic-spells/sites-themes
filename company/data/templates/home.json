    {
      "id": "s_about",
      "type": "image-with-text",
      "settings": {
        "body": "\u003cp\u003eAda opened the front room in 1998 with about six hundred books and a folding table. The back room came later, and with it the chairs, the readings, and the habit of staying open late.\u003c/p\u003e\u003cp\u003eIt is still two people and a cat, and still the same rule: nothing on the shelf that nobody here has read.\u003c/p\u003e",
        "eyebrow": "Our room",
        "heading": "Eighteen years on the same street",
        "image": "as_interior",
        "layout": "text_first",
        "link": "/about",
        "link_label": "About the shop",
        "padding": "normal",
        "ratio": "portrait"
      },
      "blocks": []
