          }
        },
        {
          "id": "b_feat_late",
          "type": "feature",
          "settings": {
            "icon": "clock",
            "text": "Until nine, with something to drink and usually somebody reading aloud.",
            "title": "Open late on Thursdays"
          }
        },
        {
          "id": "b_feat_orders",
          "type": "feature",
          "settings": {
            "icon": "truck",
            "text": "Most titles arrive within three days, held at the counter for a fortnight.",
