<dialog class="fixed inset-x-0 bottom-0 top-auto m-0 w-full max-w-none bg-scheme-background text-scheme-foreground shadow-lg" id="dialog-cookie-notice" data-dialog-notice data-dialog-key="{ settings.key }" aria-label="{ settings.heading }">
  <div class="sites-container flex flex-col items-start gap-space-md py-space-md md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <p class="font-heading text-lg text-scheme-heading">{ settings.heading }</p>
      <div class="sites-prose mt-space-xs text-sm">{ settings.body }</div>
    </div>
    <div class="flex flex-wrap gap-space-sm">
      {#if settings.link_label}
        <Button href={ settings.link_href } tone="quiet">{ settings.link_label }</Button>
      {/if}
      <button class="sites-button" type="button" data-dialog-close>{ settings.accept_label }</button>
    </div>
  </div>
</dialog>

<schema>
{
  "name": "Notice",
  "kind": "Panels",
  "icon": "cookie",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A word about cookies" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>We set no cookies. Your browser's local storage remembers that you have read this, and nothing else is measured.</p>" },
    { "type": "text", "id": "accept_label", "label": "Dismiss button", "default": "Fine by me" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the policy" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/privacy" },
    { "type": "text", "id": "key", "label": "Remember key",
      "info": "Change it to show the notice again to everyone who has already dismissed it.",
      "default": "notice-2026-01" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "inverse" }
  ],
  "presets": [
    { "name": "Default",
      "settings": { "heading": "A word about cookies",
        "body": "<p>We set no cookies. Your browser's local storage remembers that you have read this, and nothing else is measured.</p>",
        "accept_label": "Fine by me", "link_label": "Read the policy", "link_href": "/privacy",
        "key": "notice-2026-01", "color_scheme": "inverse" } }
  ]
}
</schema>
