<section class="bg-scheme-background text-scheme-foreground">
  <div class="sites-container { settings.padding == 'compact' ? 'py-space-xl' : 'py-space-2xl' }">
    {#if settings.heading}
      <div class="max-w-2xl">
        <h2 class="font-heading text-3xl tracking-tight text-balance text-scheme-heading">{ settings.heading }</h2>
        {#if settings.text}<p class="mt-space-md text-lg text-pretty">{ settings.text }</p>{/if}
      </div>
    {/if}
    {#if settings.gallery.items.length}
      <!-- Whole class names, not built up: Tailwind only generates what it can read. -->
      <ul class="mt-space-xl grid grid-cols-2 gap-space-md { settings.columns == '2' ? 'md:grid-cols-2' : settings.columns == '4' ? 'md:grid-cols-4' : 'md:grid-cols-3' }">
        {#for item in settings.gallery.items}
          <li>
            <figure>
              {#if item.video}
                <video class="w-full rounded-lg object-cover { settings.ratio == 'portrait' ? 'aspect-3/4' : settings.ratio == 'landscape' ? 'aspect-video' : 'aspect-square' }"
                  controls preload="metadata" src="{ item.asset.url }"></video>
                <span class="sr-only">{ item.alt }</span>
              {:else}
                { image_tag(item.asset, {class: 'w-full rounded-lg object-cover ' + (settings.ratio == 'portrait' ? 'aspect-3/4' : settings.ratio == 'landscape' ? 'aspect-video' : 'aspect-square'), sizes: '(min-width: 48rem) 24rem, 50vw', alt: item.alt}) }
              {/if}
              {#if item.caption}
                <figcaption class="mt-space-xs text-sm text-grey-medium">{ item.caption }</figcaption>
              {/if}
            </figure>
          </li>
        {/for}
      </ul>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Inside the shop" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "" },
    { "type": "gallery", "id": "gallery", "label": "Gallery",
      "info": "Pick a gallery; its items render in the order you arranged them, video included." },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ] },
    { "type": "select", "id": "ratio", "label": "Tile shape", "default": "square",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait", "label": "Portrait" }
      ] },
    { "type": "select", "id": "padding", "label": "Padding", "default": "normal",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "compact", "label": "Compact" }
      ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" }
  ],
  "presets": [
    { "name": "Default", "settings": { "heading": "Inside the shop", "columns": "3", "ratio": "square", "padding": "normal", "color_scheme": "default" } },
    { "name": "Wide tiles", "settings": { "heading": "Inside the shop", "columns": "2", "ratio": "landscape", "padding": "normal", "color_scheme": "default" } }
  ]
}
</schema>
