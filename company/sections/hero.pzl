<section class="relative isolate overflow-hidden bg-scheme-background text-scheme-foreground">
  {#if settings.video}
    <video class="absolute inset-0 -z-10 size-full object-cover" autoplay muted loop playsinline
      poster={ settings.image ? settings.image.url : null } src="{ settings.video.url }"></video>
  {:else if settings.image}
    { image_tag(settings.image, {class: 'absolute inset-0 -z-10 size-full object-cover', loading: 'eager', fetchpriority: 'high'}) }
  {/if}
  {#if settings.image || settings.video}
    <div class="absolute inset-0 -z-10 bg-grey-extra-dark { settings.overlay == 'none' ? 'opacity-0' : settings.overlay == 'light' ? 'opacity-25' : settings.overlay == 'strong' ? 'opacity-70' : 'opacity-50' }"></div>
  {/if}

  <div class="sites-container flex { settings.height == 'short' ? 'min-h-80' : settings.height == 'tall' ? 'min-h-screen' : 'min-h-96' } flex-col justify-center py-space-2xl { settings.align == 'center' ? 'items-center text-center' : 'items-start' }">
    <div class="max-w-2xl">
      {#if settings.eyebrow}<Chip>{ settings.eyebrow }</Chip>{/if}
      <h1 class="{ settings.eyebrow ? 'mt-space-md' : '' } font-heading text-5xl tracking-tight text-balance text-scheme-heading">{ settings.heading }</h1>
      {#if settings.text}
        <p class="mt-space-md text-xl text-pretty text-scheme-foreground">{ settings.text }</p>
      {/if}
      {#if blocks.length}
        <div class="mt-space-lg flex flex-wrap gap-space-sm { settings.align == 'center' ? 'justify-center' : '' }">
          {#for block in blocks}
            <Button href={ block.settings.href } tone={ block.settings.tone } editor_id={ block.editor_id }>{ block.settings.label }</Button>
          {/for}
        </div>
      {/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "A short standing label above the heading.", "default": "Since 1998" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A shop for books worth keeping" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Two rooms of new and second-hand books, a wall of prints, and somewhere to sit while you decide." },
    { "type": "image", "id": "image", "label": "Background image", "info": "Doubles as the poster frame when a background video is set." },
    { "type": "video", "id": "video", "label": "Background video", "info": "Plays muted and looped. It replaces the background image." },
    { "type": "select", "id": "overlay", "label": "Overlay", "default": "medium",
      "info": "Darkens the background so text stays readable.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "light", "label": "Light" },
        { "value": "medium", "label": "Medium" },
        { "value": "strong", "label": "Strong" }
      ] },
    { "type": "select", "id": "height", "label": "Height", "default": "medium",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "medium", "label": "Medium" },
        { "value": "tall", "label": "Full screen" }
      ] },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centered" }
      ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "inverse" }
  ],
  "blocks": [
    { "type": "link", "name": "Button", "limit": 2, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Read on" },
      { "type": "url", "id": "href", "label": "Link", "default": "/" },
      { "type": "select", "id": "tone", "label": "Tone", "default": "primary",
        "options": [
          { "value": "primary", "label": "Primary" },
          { "value": "secondary", "label": "Secondary" },
          { "value": "quiet", "label": "Quiet" }
        ] }
    ] }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Image",
      "settings": { "eyebrow": "Since 1998", "heading": "A shop for books worth keeping",
        "text": "Two rooms of new and second-hand books, a wall of prints, and somewhere to sit while you decide.",
        "overlay": "medium", "height": "medium", "align": "left", "color_scheme": "inverse" },
      "blocks": [
        { "type": "link", "settings": { "label": "Plan a visit", "href": "/contact", "tone": "primary" } },
        { "type": "link", "settings": { "label": "Read the journal", "href": "/journal", "tone": "secondary" } }
      ] },
    { "name": "Plain",
      "settings": { "eyebrow": "", "heading": "A shop for books worth keeping",
        "text": "Two rooms of new and second-hand books, a wall of prints, and somewhere to sit while you decide.",
        "overlay": "none", "height": "short", "align": "center", "color_scheme": "default" },
      "blocks": [{ "type": "link", "settings": { "label": "Plan a visit", "href": "/contact", "tone": "primary" } }] }
  ]
}
</schema>
