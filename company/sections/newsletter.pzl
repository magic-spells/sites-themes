<section class="bg-scheme-background text-scheme-foreground">
  <div class="sites-container py-space-2xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-heading text-3xl tracking-tight text-balance text-scheme-heading">{ settings.heading }</h2>
      {#if settings.text}<p class="mt-space-md text-lg text-pretty">{ settings.text }</p>{/if}
      <Form handle={ settings.form } class="mt-space-lg">
        {#if form.sent}
          <p class="text-success-fg" role="status">{ form.success_message }</p>
        {:else}
          <div class="flex flex-col items-stretch gap-space-sm sm:flex-row sm:items-end">
            {#for field in form.fields}
              <Field name={ field.id } label={ field.label } type={ field.type }
                maxlength={ field.max_length } required={ field.required }
                options={ field.options } value={ field.value } error={ field.error }
                placeholder={ settings.placeholder } prefix={ section.id } wrapper_class="flex-1 text-left" />
            {/for}
            <button class="sites-button" type="submit">{ form.submit_label }</button>
          </div>
          <noscript><p class="mt-space-sm text-sm">{ t('form_requires_javascript') }</p></noscript>
          {#if form.error}
            <p class="mt-space-sm text-sm text-error-fg" role="alert">{ t(form.error == 'expired' ? 'form_field_expired' : 'form_error') }</p>
          {/if}
        {/if}
      </Form>
      {#if settings.note}<p class="mt-space-sm text-sm opacity-80">{ settings.note }</p>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A letter, once a month" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "What came in, what we are reading, and who is speaking in the back room." },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "you@example.com" },
    { "type": "text", "id": "note", "label": "Note", "default": "One email a month. Leave whenever you like." },
    { "type": "form", "id": "form", "label": "Form",
      "info": "The form this section signs the visitor up to.",
      "default": "newsletter" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "inverse" }
  ],
  "presets": [
    { "name": "Default",
      "settings": { "heading": "A letter, once a month",
        "text": "What came in, what we are reading, and who is speaking in the back room.",
        "placeholder": "you@example.com",
        "note": "One email a month. Leave whenever you like.",
        "form": "newsletter", "color_scheme": "inverse" } }
  ]
}
</schema>
