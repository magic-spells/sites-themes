<article class="bg-scheme-background text-scheme-foreground">
  <header class="sites-container pt-space-xl">
    <div class="mx-auto max-w-3xl">
      {#if settings.show_meta}
        <p class="flex flex-wrap items-center gap-space-sm text-sm text-grey-medium">
          <Chip>{ page.entry.fields.topic }</Chip>
          <time datetime="{ page.entry.fields.date }">{ page.entry.fields.date | date('long') }</time>
          <span aria-hidden="true">·</span>
          <span>{ page.entry.fields.reading_minutes | pluralize('minute') } { t('read_suffix') }</span>
        </p>
      {/if}
      <h1 class="mt-space-md font-heading text-4xl tracking-tight text-balance text-scheme-heading">{ page.entry.title ?? page.title }</h1>
      {#if page.entry.fields.standfirst}
        <p class="mt-space-md text-xl text-pretty text-scheme-foreground">{ page.entry.fields.standfirst }</p>
      {/if}
      {#if page.entry.fields.author}
        <p class="mt-space-md text-sm text-grey-medium">{ t('by_line') } { page.entry.fields.author }</p>
      {/if}
    </div>
  </header>

  <!-- The entry's image field is resolved to the asset, so it feeds
       image_url for its variants. -->
  {#let image = page.entry.fields.image}
  {#if settings.show_image && image}
    <div class="sites-container pt-space-lg">
      <img class="mx-auto aspect-video w-full max-w-5xl rounded-lg object-cover"
        src="{ image_url(image, 1280) }"
        srcset="{ image_url(image, 640) } 640w, { image_url(image, 1280) } 1280w, { image_url(image, 1600) } 1600w"
        sizes="(min-width: 64rem) 64rem, 100vw"
        alt="{ page.entry.fields.image_alt }" width="{ image.width }" height="{ image.height }" />
    </div>
  {/if}

  <div class="sites-container py-space-xl">
    <div class="sites-prose mx-auto max-w-3xl">{ page.entry.fields.body | raw }</div>
  </div>
</article>

<schema>
{
  "name": "Post",
  "description": "One journal entry: its byline, its picture, and its writing.",
  "kind": "Content",
  "icon": "file-text",
  "templates": ["post"],
  "settings": [
    { "type": "checkbox", "id": "show_meta", "label": "Show the topic and date", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show the picture", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": { "show_meta": true, "show_image": true } }
  ]
}
</schema>
