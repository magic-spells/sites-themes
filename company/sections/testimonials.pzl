<section class="bg-scheme-background text-scheme-foreground">
  <div class="sites-container { settings.padding == 'compact' ? 'py-space-xl' : 'py-space-2xl' }">
    <div class="max-w-2xl">
      <h2 class="font-heading text-3xl tracking-tight text-balance text-scheme-heading">{ settings.heading }</h2>
      {#if settings.text}<p class="mt-space-md text-lg text-pretty">{ settings.text }</p>{/if}
    </div>
    <ul class="mt-space-xl grid gap-space-lg md:grid-cols-2 { settings.columns == '3' ? 'lg:grid-cols-3' : '' }">
      {#for block in blocks}
        <li class="flex flex-col rounded-lg border border-scheme-chip-border bg-scheme-chip-background p-space-lg" data-block={ block.editor_id }>
          <span class="sites-icon size-7 text-scheme-icons">{#svg 'icons/quote.svg'}</span>
          {#if block.settings.rating}
            <p class="mt-space-sm flex gap-space-xs text-scheme-icons">
              {#for 1...5, star}
                <span class="sites-icon size-4 { star > block.settings.rating ? 'opacity-25' : '' }">{#svg 'icons/star.svg'}</span>
              {/for}
              <span class="sr-only">{ block.settings.rating } { t('out_of_five') }</span>
            </p>
          {/if}
          <blockquote class="mt-space-md flex-1 font-heading text-xl text-pretty text-scheme-heading">{ block.settings.quote }</blockquote>
          <p class="mt-space-md text-sm">
            <span class="font-semibold text-scheme-heading">{ block.settings.name }</span>
            {#if block.settings.role}<span class="text-scheme-foreground"> — { block.settings.role }</span>{/if}
          </p>
        </li>
      {/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "" },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" }
      ] },
    { "type": "select", "id": "padding", "label": "Padding", "default": "normal",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "compact", "label": "Compact" }
      ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" }
  ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "Say what somebody actually said." },
      { "type": "text", "id": "name", "label": "Name", "default": "A customer" },
      { "type": "text", "id": "role", "label": "Role or place", "default": "" },
      { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5,
        "info": "Zero hides the stars." }
    ] }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Default",
      "settings": { "heading": "What people say", "columns": "3", "padding": "normal", "color_scheme": "default" },
      "blocks": [
        { "type": "quote", "settings": { "quote": "I came in for a birthday card and left an hour later with three books and a recommendation I am still thinking about.", "name": "Imogen R.", "role": "Old Town", "rating": 5 } },
        { "type": "quote", "settings": { "quote": "They found a print I had been after for two years, framed it, and would not let me pay for the rush.", "name": "Daniel O.", "role": "Ferry Road", "rating": 5 } },
        { "type": "quote", "settings": { "quote": "The Thursday readings are the best hour of my week, and nobody minds if you only listen.", "name": "Priya N.", "role": "Regular since 2019", "rating": 4 } }
      ] }
  ]
}
</schema>
