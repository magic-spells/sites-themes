<!-- template: Password -->
<!-- layout: default -->
<div class="sites-container py-space-2xl">
  <div class="mx-auto max-w-md text-center">
    <Chip>{ t('password_chip') }</Chip>
    <h1 class="mt-space-md font-heading text-4xl tracking-tight text-balance text-scheme-heading">{ site.name }</h1>
    <p class="mt-space-md text-lg text-pretty text-scheme-foreground">{ t('password_body') }</p>
    <!-- The unlock endpoint reads `password` and redirects to the `to` path. -->
    <form class="mt-space-lg text-left" method="post" action="/_sites/unlock">
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}
        <p class="mb-space-sm text-sm text-error-fg" role="alert">{ request.query.password_error }</p>
      {/if}
      <Field name="password" label="{ t('password_label') }" type="password" autocomplete="current-password" required={ true } />
      <div class="mt-space-md">
        <button class="sites-button w-full" type="submit">{ t('password_submit') }</button>
      </div>
    </form>
    <p class="mt-space-lg text-sm text-grey-medium">{ t('password_help') } <a class="text-scheme-links underline underline-offset-2" href="mailto:{ site.settings.contact_email }">{ site.settings.contact_email }</a></p>
  </div>
</div>
