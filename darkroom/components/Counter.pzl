<!-- component: Counter -->
<!-- props: index total carousel_id tone -->
<!-- "04 / 18" in mono, tabular figures. With a carousel id theme.ts keeps
     the first number on the carousel's selected slide. tone "photo" sets it
     light, for a counter laid over a photograph. -->
<p class="font-mono text-counter tabular-nums { tone == 'photo' ? 'text-on-photo' : 'text-scheme-meta' }" data-counter-for={ carousel_id }><span data-counter-index>{ index < 10 ? '0' : '' }{ index }</span> / { total < 10 ? '0' : '' }{ total }</p>
