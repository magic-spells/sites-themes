      "label": "Link href",
      "default": "/privacy"
    },
    {
      "type": "text",
      "id": "key",
      "label": "Key",
      "default": "darkroom-notice-2026-10"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
