<!-- A non-modal region, not a dialog: the page stays usable behind it. It
     renders hidden; theme.ts shows it once per key, both buttons hide it and
     the choice is remembered. -->
<section class="fixed inset-x-0 bottom-0 z-40 border-t border-scheme-rule bg-scheme-surface text-scheme-foreground md:inset-x-auto md:right-gutter md:bottom-gutter md:w-full md:max-w-notice md:border" id="cookie-notice" data-notice="{ settings.key }" role="region" aria-label="{ t('cookie_notice_label') }" hidden>
  <div class="grid gap-step-md p-step-lg">
    <div class="sites-prose text-body-sm text-scheme-foreground">{ settings.body }</div>
    <div class="flex flex-wrap items-center gap-step-sm">
      <button class="sites-button min-h-9 min-w-button" type="button" data-notice-close="accept">{ settings.accept_label }</button>
      {#if settings.decline_label}<button class="sites-button sites-button-outline min-h-9 min-w-button" type="button" data-notice-close="decline">{ settings.decline_label }</button>{/if}
      {#if settings.link_label}<a class="ml-auto font-mono text-meta tracking-meta text-scheme-muted uppercase underline decoration-1 underline-offset-4 hover:text-scheme-links" href="{ settings.link_href }">{ settings.link_label }</a>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Cookie notice",
  "description": "A privacy region whose accept and decline buttons remember dismissal.",
  "kind": "Panels",
  "icon": "cookie",
  "settings": [
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>This site remembers your choice about this notice in your browser. No tracking cookies are used.</p>"
    },
    {
      "type": "text",
      "id": "accept_label",
      "label": "Accept label",
      "default": "Accept"
    },
    {
      "type": "text",
      "id": "decline_label",
      "label": "Decline label",
      "default": "Decline"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Privacy"
    },
    {
      "type": "url",
      "id": "link_href",
      "label": "Link href",
      "default": "/privacy"
    },
    {
      "type": "text",
      "id": "key",
      "label": "Key",
      "default": "darkroom-notice-2026-10"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "body": "<p>This site remembers your choice about this notice in your browser. No tracking cookies are used.</p>",
        "accept_label": "Accept",
        "decline_label": "Decline",
        "link_label": "Privacy",
        "link_href": "/privacy",
        "key": "darkroom-notice-2026-10"
      }
    }
  ]
}
</schema>
