<!-- section: cv-list; D1 placeholder -->
<section>cv-list
  {#for block in blocks}<span data-block={ block.editor_id }>row</span>{/for}</section>

<schema>
{
  "name": "Cv list",
  "description": "Exhibitions, publications or awards in dated rows.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Exhibitions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": ""
        },
        {
          "type": "text",
          "id": "text",
          "label": "Entry",
          "default": ""
        },
        {
          "type": "text",
          "id": "place",
          "label": "Place",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Exhibitions",
      "settings": {
        "heading": "Exhibitions",
        "color_scheme": "surface"
      },
      "blocks": [
        {
          "type": "row",
          "settings": {
            "year": "2025",
            "text": "Salt Roads",
            "place": "Galleri Format, Stockholm"
          }
        },
        {
          "type": "row",
          "settings": {
            "year": "2023",
            "text": "Hollow Season",
            "place": "Röda Sten Konsthall, Gothenburg"
          }
        },
        {
          "type": "row",
          "settings": {
            "year": "2022",
            "text": "Harbour Light",
            "place": "Galleri Box, Gothenburg"
          }
        }
      ]
    },
    {
      "name": "Publications",
      "settings": {
        "heading": "Publications",
        "color_scheme": "surface"
      },
      "blocks": [
        {
          "type": "row",
          "settings": {
            "year": "2025",
            "text": "Salt Roads — artist’s book",
            "place": "Independent edition"
          }
        },
        {
          "type": "row",
          "settings": {
            "year": "2024",
            "text": "Night Ferry",
            "place": "Nordic Photography Review"
          }
        }
      ]
    },
    {
      "name": "Awards",
      "settings": {
        "heading": "Awards",
        "color_scheme": "surface"
      },
      "blocks": [
        {
          "type": "row",
          "settings": {
            "year": "2024",
            "text": "Swedish Arts Grants Committee — working grant",
            "place": ""
          }
        },
        {
          "type": "row",
          "settings": {
            "year": "2021",
            "text": "Västra Götaland cultural scholarship",
            "place": ""
          }
        }
      ]
    }
  ]
}
</schema>
