<!-- A photograph (the photographer's portrait by default) beside a short
     text: eyebrow, heading, body and a link. Image first puts the picture on
     the left; text first puts it on the right, flush to the column edge. The
     picture always comes first below 48rem. Opening a page, it carries the
     page's <h1> for screen readers. -->
{#let
  image = settings.image || site.settings.photographer_portrait
  well = settings.ratio == 'landscape' ? 'aspect-3/2' : settings.ratio == 'square' ? 'aspect-square' : 'aspect-4/5'
  text_first = settings.layout == 'text_first'
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  {#if section.index == 0}<h1 class="sr-only">{ page.title }</h1>{/if}
  <div class="mx-auto flex max-w-column flex-col gap-step-xl md:flex-row md:items-center md:gap-step-3xl { text_first ? 'md:flex-row-reverse md:justify-between' : '' }">
    {#if image}
      <img class="w-full bg-scheme-surface object-cover md:w-1/2 lg:max-w-image { well }" src="{ image_url(image, 1280) }" srcset="{ image_srcset(image, [480, 768, 1280]) }" sizes="(min-width: 48rem) 40vw, 100vw" alt="{ image.alt }" loading="lazy" width={ image.width } height={ image.height } />
    {/if}
    <div class="grid max-w-text content-start justify-items-start gap-step-sm md:flex-1">
      {#if settings.eyebrow}<p class="font-mono text-meta tracking-meta text-scheme-meta uppercase">{ settings.eyebrow }</p>{/if}
      {#if settings.heading}<h2 class="font-heading text-h2 font-medium text-balance text-scheme-heading">{ settings.heading }</h2>{/if}
      {#if settings.body}<div class="sites-prose">{ settings.body }</div>{/if}
      {#if settings.caption}<p class="font-mono text-caption text-scheme-meta">{ settings.caption }</p>{/if}
      {#if settings.link_label && settings.link}<a class="mt-step-xs text-body text-scheme-links underline decoration-1 underline-offset-4 hover:text-scheme-foreground" href="{ settings.link }">{ settings.link_label }</a>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Image with text",
  "description": "A portrait and writing; the photograph comes first on mobile.",
  "kind": "Content",
  "icon": "columns-2",
  "settings": [
    {
      "type": "image",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "default": "portrait",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_first",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ],
      "info": "Image first places the image left; text first places it right on desktop."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mara Lindqvist"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>I photograph landscapes and the traces of people who work in them. I live in Gothenburg and work across the Nordic countries and further afield.</p>"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "",
      "info": "A short line under the body, such as the representation."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "About the practice"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/about"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "ratio": "portrait",
        "layout": "image_first",
        "eyebrow": "About",
        "heading": "Mara Lindqvist",
        "body": "<p>I photograph landscapes and the traces of people who work in them. I live in Gothenburg and work across the Nordic countries and further afield.</p>",
        "link_label": "About the practice",
        "link": "/about",
        "caption": ""
      }
    }
  ]
}
</schema>
