<!-- section: packages; D1 placeholder -->
<section>packages
  {#for block in blocks}<span data-block={ block.editor_id }>package</span>{/for}</section>

<schema>
{
  "name": "Packages",
  "description": "Photographic packages as rows or photo tiles.",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Working together"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Packages"
    },
    {
      "type": "text",
      "id": "standfirst",
      "label": "Standfirst",
      "default": "Sessions, days and editorial rates."
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "default": "<p>All rates exclude travel and applicable tax. Usage is agreed in writing. <a href=\"/contact\">Write</a> for a proposal.</p>"
    },
    {
      "type": "text",
      "id": "enquire_label",
      "label": "Enquire label",
      "default": "Enquire"
    },
    {
      "type": "url",
      "id": "enquire_href",
      "label": "Enquire href",
      "default": "/contact?subject=Commission"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "rows",
      "options": [
        {
          "value": "rows",
          "label": "Rows"
        },
        {
          "value": "tiles",
          "label": "Tiles"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": ""
        },
        {
          "type": "text",
          "id": "for",
          "label": "For",
          "default": ""
        },
        {
          "type": "textarea",
          "id": "inclusions",
          "label": "Inclusions",
          "default": ""
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": ""
        },
        {
          "type": "text",
          "id": "from_label",
          "label": "From label",
          "default": "From"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured",
          "default": false
        },
        {
          "type": "image",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Default",
      "settings": {
        "eyebrow": "Working together",
        "heading": "Packages",
        "standfirst": "Sessions, days and editorial rates.",
        "footnote": "<p>All rates exclude travel and applicable tax. Usage is agreed in writing. <a href=\"/contact\">Write</a> for a proposal.</p>",
        "enquire_label": "Enquire",
        "enquire_href": "/contact?subject=Commission",
        "layout": "rows",
        "color_scheme": "surface"
      },
      "blocks": [
        {
          "type": "package",
          "settings": {
            "name": "Session",
            "for": "A portrait, a room or a short editorial assignment.",
            "inclusions": "Planning call\nUp to three hours photographing\nEdited image selection",
            "price": "€ 1,200",
            "from_label": "From",
            "note": "Usage and travel agreed separately.",
            "featured": false,
            "photo": "as_3x2_1",
            "category": "On site"
          }
        },
        {
          "type": "package",
          "settings": {
            "name": "Day",
            "for": "Time on location, with room for the weather.",
            "inclusions": "Planning and location research\nOne day photographing\nEdited image selection and delivery gallery",
            "price": "€ 2,400",
            "from_label": "From",
            "note": "Usage and travel agreed separately.",
            "featured": true,
            "photo": "as_3x2_2",
            "category": "On site"
          }
        },
        {
          "type": "package",
          "settings": {
            "name": "Project",
            "for": "A body of work, from the first conversation to the final sequence.",
            "inclusions": "Research and a written proposal\nAgreed days photographing\nEditing, sequencing and production advice",
            "price": "By conversation",
            "from_label": "",
            "note": "A proposal follows our first conversation.",
            "featured": false,
            "photo": "as_4x5_2",
            "category": "Studio"
          }
        },
        {
          "type": "package",
          "settings": {
            "name": "Workshop",
            "for": "A day in the darkroom for up to six.",
            "inclusions": "One day in the studio\nPaper and printing materials\nIndividual print review",
            "price": "€ 480",
            "from_label": "From",
            "note": "Per person. Dates by arrangement.",
            "featured": false,
            "photo": "as_1x1_2",
            "category": "Studio"
          }
        }
      ]
    }
  ]
}
</schema>
