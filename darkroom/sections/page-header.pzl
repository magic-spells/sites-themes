<!-- An eyebrow in Meta, the page heading and a standfirst, in a reading
     column at the left or centred. No bottom padding: the section below
     brings its own. The heading falls back to the page title. -->
{#let center = settings.align == 'center'}
<section class="bg-scheme-background px-gutter pt-section text-scheme-foreground">
  <div class="mx-auto flex max-w-column flex-col { center ? 'items-center text-center' : '' }">
    <div class="grid max-w-reading gap-step-sm">
      {#if settings.chip}<p class="font-mono text-meta tracking-meta text-scheme-meta uppercase">{ settings.chip }</p>{/if}
      <h1 class="font-heading text-h1 font-medium text-balance text-scheme-heading">{ settings.heading || page.title }</h1>
      {#if settings.standfirst}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.standfirst }</p>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Page header",
  "description": "The page heading and standfirst, with an optional eyebrow.",
  "kind": "Hero",
  "icon": "heading-1",
  "settings": [
    {
      "type": "text",
      "id": "chip",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "text",
      "id": "standfirst",
      "label": "Standfirst",
      "default": "",
      "info": "Leave empty to use the page search description."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Left",
      "settings": {
        "chip": "",
        "heading": "",
        "standfirst": "",
        "align": "left",
        "color_scheme": "surface"
      }
    },
    {
      "name": "Centered",
      "settings": {
        "chip": "",
        "heading": "",
        "standfirst": "",
        "align": "center",
        "color_scheme": "surface"
      }
    }
  ]
}
</schema>
