<!-- section: page-header; D1 placeholder -->
<section>page-header</section>

<schema>
{
  "name": "Page header",
  "description": "The page heading and standfirst, with an optional eyebrow.",
  "settings": [
    {
      "type": "text",
      "id": "chip",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "text",
      "id": "standfirst",
      "label": "Standfirst",
      "default": "",
      "info": "Leave empty to use the page search description."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    }
  ],
  "presets": [
    {
      "name": "Left",
      "settings": {
        "chip": "",
        "heading": "",
        "standfirst": "",
        "align": "left",
        "color_scheme": "surface"
      }
    },
    {
      "name": "Centered",
      "settings": {
        "chip": "",
        "heading": "",
        "standfirst": "",
        "align": "center",
        "color_scheme": "surface"
      }
    }
  ]
}
</schema>
