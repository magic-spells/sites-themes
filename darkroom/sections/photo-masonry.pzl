<!-- A gallery in CSS columns at the photographs' own ratios, three across
     from 48rem and one below it. Captions show over a tile on hover, or not
     at all. With the lightbox on, a tile opens it with a fade. -->
{#let
  gallery = settings.gallery.items.length ? settings.gallery : page.entry.fields.photos
  items = gallery.items
  id = 'lightbox-' + section.id
  cols = settings.columns == '4' ? 'md:columns-3 lg:columns-4' : settings.columns == '2' ? 'md:columns-2' : 'md:columns-3'
  gap = settings.gap == 'tight' ? 'gap-step-2xs *:mb-step-2xs' : settings.gap == 'loose' ? 'gap-gap-lg *:mb-gap-lg' : 'gap-gap-sm *:mb-gap-sm'
}
{#if items.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <ul class="mx-auto max-w-column columns-1 *:break-inside-avoid { cols } { gap }" aria-label="{ gallery.title || t('gallery_label') }">
    {#for item in items, i}
      <li><PhotoTile item={ item } ratio="natural" sizes="(min-width: 48rem) 33vw, 100vw" captions={ settings.captions } lightbox_id={ settings.lightbox ? id : null } index={ i } /></li>
    {/for}
  </ul>
  {#if settings.lightbox}
    <LightboxCompanion items={ items } id={ id }><script type="application/json" data-tarot-options>{ { lightbox: true, draggable: false, navigation: { showButtons: false, showPagination: false } } | json }</script></LightboxCompanion>
  {/if}
</section>
{/if}

<schema>
{
  "name": "Photo masonry",
  "description": "Natural-ratio photographs arranged in columns with a lightbox.",
  "kind": "Content",
  "icon": "layout-dashboard",
  "settings": [
    {
      "type": "gallery",
      "id": "gallery",
      "label": "Gallery",
      "info": "Reads items in order: asset (url, width, height, alt), caption, alt and video. Leave empty to use page.entry.fields.photos where the page binds a series."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Gap",
      "default": "normal",
      "options": [
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "loose",
          "label": "Loose"
        }
      ]
    },
    {
      "type": "select",
      "id": "captions",
      "label": "Captions",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "hover",
          "label": "Hover"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "lightbox",
      "label": "Lightbox",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "columns": "3",
        "gap": "normal",
        "captions": "none",
        "lightbox": true
      }
    }
  ]
}
</schema>
