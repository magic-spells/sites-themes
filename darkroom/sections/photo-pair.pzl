<!-- Two photographs side by side at one ratio, each with its caption,
     stacked below 48rem. With no images chosen they come from the series of
     the page it is on, by index. -->
{#let
  photos = page.entry.fields.photos.items
  a = settings.image_a ? { asset: settings.image_a, caption: '', alt: settings.image_a.alt } : photos[settings.index_a]
  b = settings.image_b ? { asset: settings.image_b, caption: '', alt: settings.image_b.alt } : photos[settings.index_b]
  pair = [{ item: a, caption: settings.caption_a || a.caption }, { item: b, caption: settings.caption_b || b.caption }]
  well = settings.ratio == '3:2' ? 'aspect-3/2' : settings.ratio == '1:1' ? 'aspect-square' : settings.ratio == 'natural' ? '' : 'aspect-4/5'
}
{#if a.asset || b.asset}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-gap-md md:grid-cols-2">
    {#for photo in pair}
      {#if photo.item.asset}
        <figure class="grid content-start gap-step-xs">
          <img class="w-full bg-scheme-surface object-cover { well }" src="{ image_url(photo.item.asset, 1280) }" srcset="{ image_srcset(photo.item.asset, [480, 768, 1280]) }" sizes="(min-width: 48rem) 50vw, 100vw" alt="{ photo.item.alt }" loading="lazy" width={ photo.item.asset.width } height={ photo.item.asset.height } />
          {#if photo.caption}<figcaption class="font-mono text-caption text-scheme-muted">{ photo.caption }</figcaption>{/if}
        </figure>
      {/if}
    {/for}
  </div>
</section>
{/if}

<schema>
{
  "name": "Photo pair",
  "description": "Two photographs; empty images fall back to the current series by index.",
  "settings": [
    {
      "type": "image",
      "id": "image_a",
      "label": "Image a"
    },
    {
      "type": "image",
      "id": "image_b",
      "label": "Image b"
    },
    {
      "type": "number",
      "id": "index_a",
      "label": "Index a",
      "default": 0,
      "min": 0
    },
    {
      "type": "number",
      "id": "index_b",
      "label": "Index b",
      "default": 1,
      "min": 0
    },
    {
      "type": "text",
      "id": "caption_a",
      "label": "Caption a",
      "default": ""
    },
    {
      "type": "text",
      "id": "caption_b",
      "label": "Caption b",
      "default": ""
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "default": "4:5",
      "options": [
        {
          "value": "4:5",
          "label": "4:5"
        },
        {
          "value": "3:2",
          "label": "3:2"
        },
        {
          "value": "1:1",
          "label": "1:1"
        },
        {
          "value": "natural",
          "label": "Natural"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "index_a": 0,
        "index_b": 1,
        "caption_a": "",
        "caption_b": "",
        "ratio": "4:5",
        "color_scheme": "surface"
      }
    }
  ]
}
</schema>
