<!-- section: photo-single; D1 placeholder -->
<section>photo-single</section>

<schema>
{
  "name": "Photo single",
  "description": "One photograph, or a photograph selected by index from the current series.",
  "settings": [
    {
      "type": "image",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "number",
      "id": "index",
      "label": "Index",
      "default": 0,
      "min": 0,
      "info": "Zero-based index into page.entry.fields.photos.items when no image is selected."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "number",
      "label": "Show photograph number",
      "default": false
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wide",
      "options": [
        {
          "value": "bleed",
          "label": "Bleed"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "reading",
          "label": "Reading"
        }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "default": "16:9",
      "options": [
        {
          "value": "16:9",
          "label": "16:9"
        },
        {
          "value": "3:2",
          "label": "3:2"
        },
        {
          "value": "4:5",
          "label": "4:5"
        },
        {
          "value": "1:1",
          "label": "1:1"
        },
        {
          "value": "natural",
          "label": "Natural"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "index": 0,
        "caption": "",
        "number": false,
        "width": "wide",
        "ratio": "16:9",
        "color_scheme": "surface"
      }
    }
  ]
}
</schema>
