<!-- section: prints-band; D1 placeholder -->
<section>prints-band</section>

<schema>
{
  "name": "Prints band",
  "description": "A print beside edition details and a contact link.",
  "settings": [
    {
      "type": "image",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Prints and editions"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Selected photographs are available as signed prints. Each is made in the studio, checked in daylight and numbered by hand."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enquire about a print"
    },
    {
      "type": "url",
      "id": "button_href",
      "label": "Button href",
      "default": "/contact?subject=Prints"
    },
    {
      "type": "text",
      "id": "edition_note",
      "label": "Edition note",
      "default": "Editions of ten. Signed and numbered."
    },
    {
      "type": "select",
      "id": "frame",
      "label": "Frame",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "mat",
          "label": "Mat"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_first",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "band"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Prints and editions",
        "text": "Selected photographs are available as signed prints. Each is made in the studio, checked in daylight and numbered by hand.",
        "button_label": "Enquire about a print",
        "button_href": "/contact?subject=Prints",
        "edition_note": "Editions of ten. Signed and numbered.",
        "frame": "none",
        "layout": "image_first",
        "color_scheme": "band"
      }
    }
  ]
}
</schema>
