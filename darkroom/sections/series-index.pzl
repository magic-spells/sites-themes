<!-- section: series-index; D1 placeholder -->
<section>series-index</section>

<schema>
{
  "name": "Series index",
  "description": "Series as a grid or thumbnail rows, ordered by year.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured series"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Create the workspace content type series with year, location, statement (richtext), cover (image), cover_alt, photos (gallery handle) and edition_note. Reads title, handle and those fields; orders year newest first."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Base path",
      "default": "/work"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "list",
          "label": "List"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "default": "4:5",
      "options": [
        {
          "value": "4:5",
          "label": "4:5"
        },
        {
          "value": "3:2",
          "label": "3:2"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "default": 3,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show counts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_toggle",
      "label": "Show toggle",
      "default": false,
      "info": "Offer list and grid views on the Work index."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "All work"
    },
    {
      "type": "url",
      "id": "view_all_href",
      "label": "View all href",
      "default": "/work"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    }
  ],
  "presets": [
    {
      "name": "Featured",
      "settings": {
        "heading": "Featured series",
        "base_path": "/work",
        "layout": "grid",
        "columns": "3",
        "ratio": "4:5",
        "limit": 3,
        "show_counts": true,
        "show_toggle": false,
        "view_all_label": "All work",
        "view_all_href": "/work",
        "color_scheme": "surface",
        "collection": "series"
      }
    },
    {
      "name": "Index",
      "settings": {
        "heading": "",
        "base_path": "/work",
        "layout": "list",
        "columns": "3",
        "ratio": "4:5",
        "limit": 12,
        "show_counts": true,
        "show_toggle": true,
        "view_all_label": "",
        "view_all_href": "",
        "color_scheme": "surface",
        "collection": "series"
      }
    },
    {
      "name": "Grid",
      "settings": {
        "heading": "Featured series",
        "base_path": "/work",
        "layout": "grid",
        "columns": "3",
        "ratio": "4:5",
        "limit": 3,
        "show_counts": true,
        "show_toggle": false,
        "view_all_label": "All work",
        "view_all_href": "/work",
        "color_scheme": "surface",
        "collection": "series"
      }
    }
  ]
}
</schema>
