<!-- The series of the workspace's series type, newest first: a grid of
     covers (three or two across) or a list of rows. With the switch on it
     renders both and shows one, the reader's choice remembered (theme.ts).
     No pagination: limit caps the count. -->
{#let
  all = settings.collection.entries | sort('fields.year') | reverse
  series = all | slice(0, settings.limit)
  view = settings.layout == 'list' ? 'list' : 'grid'
  toggle = settings.show_toggle
  two = settings.columns == '2'
  show_view_all = settings.view_all_label && settings.view_all_href
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" data-view={ toggle ? view : false }>
  <div class="mx-auto grid max-w-column gap-gap-lg">
    {#if settings.heading || toggle}
      <div class="flex min-h-8 items-center justify-between gap-step-sm">
        {#if settings.heading}<h2 class="font-mono text-meta tracking-meta text-scheme-muted uppercase">{ settings.heading }</h2>{/if}
        {#if toggle}
          <div class="ms-auto flex gap-step-sm" role="group" hidden data-view-switch aria-label="{ t('view_label') }">
            <button class="flex size-8 items-center justify-center text-scheme-meta hover:text-scheme-foreground aria-pressed:text-scheme-foreground" type="button" data-view-set="list" aria-pressed="{ view == 'list' ? 'true' : 'false' }"><span class="sites-icon size-5">{#svg 'icons/list.svg'}</span><span class="sr-only">{ t('view_list') }</span></button>
            <button class="flex size-8 items-center justify-center text-scheme-meta hover:text-scheme-foreground aria-pressed:text-scheme-foreground" type="button" data-view-set="grid" aria-pressed="{ view == 'grid' ? 'true' : 'false' }"><span class="sites-icon size-5">{#svg 'icons/grid.svg'}</span><span class="sr-only">{ t('view_grid') }</span></button>
          </div>
        {/if}
      </div>
    {/if}
    {#if series.length == 0}
      <p class="border-t border-scheme-rule pt-step-md text-body text-scheme-muted">{ t('series_empty') }</p>
    {:else}
      {#if toggle || view == 'grid'}
        <ul class="grid gap-x-gap-lg gap-y-step-xl md:grid-cols-2 { two ? '' : 'lg:grid-cols-3' } view-list:hidden" data-grid>
          {#for entry in series}<SeriesCard entry={ entry } href="{ settings.base_path }/{ entry.handle }" ratio={ settings.ratio } show_counts={ settings.show_counts } sizes={ two ? '(min-width: 48rem) 50vw, 100vw' : '(min-width: 64rem) 33vw, (min-width: 48rem) 50vw, 100vw' } />{/for}
        </ul>
      {/if}
      {#if toggle || view == 'list'}
        <ul class="border-t border-scheme-rule view-grid:hidden" data-list>
          {#for entry in series}<SeriesRow entry={ entry } href="{ settings.base_path }/{ entry.handle }" show_counts={ settings.show_counts } />{/for}
        </ul>
      {/if}
    {/if}
    {#if series.length || show_view_all}
      <div class="flex flex-wrap items-center justify-between gap-step-sm">
        <p class="font-mono text-caption text-scheme-meta">{ t('series_count', { count: all.length }) }</p>
        {#if show_view_all}<a class="border-b border-scheme-links pb-step-2xs font-mono text-meta tracking-meta uppercase hover:text-scheme-links" href="{ settings.view_all_href }">{ settings.view_all_label }</a>{/if}
      </div>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Series index",
  "description": "Series as a grid or thumbnail rows, ordered by year.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured series"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Create the workspace content type series with year, location, statement (richtext), cover (image), cover_alt, photos (gallery handle) and edition_note. Reads title, handle and those fields; orders year newest first."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Base path",
      "default": "/work"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "list",
          "label": "List"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "default": "4:5",
      "options": [
        {
          "value": "4:5",
          "label": "4:5"
        },
        {
          "value": "3:2",
          "label": "3:2"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "default": 3,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show counts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_toggle",
      "label": "Show toggle",
      "default": false,
      "info": "Offer list and grid views on the Work index."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "All work"
    },
    {
      "type": "url",
      "id": "view_all_href",
      "label": "View all href",
      "default": "/work"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    }
  ],
  "presets": [
    {
      "name": "Featured",
      "settings": {
        "heading": "Featured series",
        "base_path": "/work",
        "layout": "grid",
        "columns": "3",
        "ratio": "4:5",
        "limit": 3,
        "show_counts": true,
        "show_toggle": false,
        "view_all_label": "All work",
        "view_all_href": "/work",
        "color_scheme": "surface",
        "collection": "series"
      }
    },
    {
      "name": "Index",
      "settings": {
        "heading": "",
        "base_path": "/work",
        "layout": "list",
        "columns": "3",
        "ratio": "4:5",
        "limit": 12,
        "show_counts": true,
        "show_toggle": true,
        "view_all_label": "",
        "view_all_href": "",
        "color_scheme": "surface",
        "collection": "series"
      }
    },
    {
      "name": "Grid",
      "settings": {
        "heading": "Featured series",
        "base_path": "/work",
        "layout": "grid",
        "columns": "3",
        "ratio": "4:5",
        "limit": 3,
        "show_counts": true,
        "show_toggle": false,
        "view_all_label": "All work",
        "view_all_href": "/work",
        "color_scheme": "surface",
        "collection": "series"
      }
    }
  ]
}
</schema>
