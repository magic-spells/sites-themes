<!-- section: services; D1 placeholder -->
<section>services
  {#for block in blocks}<span data-block={ block.editor_id }>service</span>{/for}</section>

<schema>
{
  "name": "Services",
  "description": "A draggable strip of photographic services linking to Contact by subject.",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Services"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What I take on"
    },
    {
      "type": "text",
      "id": "standfirst",
      "label": "Standfirst",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "text",
      "id": "enquire_label",
      "label": "Enquire label",
      "default": "Enquire"
    },
    {
      "type": "url",
      "id": "contact_path",
      "label": "Contact path",
      "default": "/contact"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": ""
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": ""
        },
        {
          "type": "image",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "subject",
          "label": "Subject",
          "default": "Commission"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Default",
      "settings": {
        "eyebrow": "Services",
        "heading": "What I take on",
        "standfirst": "",
        "show_arrows": true,
        "enquire_label": "Enquire",
        "contact_path": "/contact",
        "color_scheme": "surface"
      },
      "blocks": [
        {
          "type": "service",
          "settings": {
            "name": "Editorial",
            "description": "Photographs for stories that need time on the ground.",
            "photo": "as_3x2_1",
            "subject": "Commission"
          }
        },
        {
          "type": "service",
          "settings": {
            "name": "Portraits",
            "description": "People in the rooms and places they know.",
            "photo": "as_4x5_1",
            "subject": "Commission"
          }
        },
        {
          "type": "service",
          "settings": {
            "name": "Architecture and interiors",
            "description": "Buildings in the light they were designed for; a day on site and a second for the weather.",
            "photo": "as_3x2_3",
            "subject": "Commission"
          }
        },
        {
          "type": "service",
          "settings": {
            "name": "Books and exhibitions",
            "description": "Sequencing, prints and work made for the page or the wall.",
            "photo": "as_1x1_1",
            "subject": "Press"
          }
        },
        {
          "type": "service",
          "settings": {
            "name": "Workshops and talks",
            "description": "Small groups, practical questions and time to make photographs.",
            "photo": "as_3x2_5",
            "subject": "Other"
          }
        }
      ]
    }
  ]
}
</schema>
