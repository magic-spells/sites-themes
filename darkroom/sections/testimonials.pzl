<!-- Voices one at a time: from 48rem the quote, name and role at the left
     and a 4:5 photograph at the right, fading between them, each with its
     counter and arrows under the quote. Below 48rem the photograph comes
     first, the next voice peeks at the right edge, and dots and a counter sit
     under the strip. -->
{#let
  id = 'voices-' + section.id
  total = (blocks.length < 10 ? '0' : '') + blocks.length
  options = { effect: 'carousel', loop: true, gap: '1rem', paddingLeft: '1rem', paddingRight: '2.5rem', navigation: { showButtons: false, showPagination: true }, breakpoints: { '768': { effect: 'fade', gap: 0, paddingLeft: 0, paddingRight: 0, navigation: { showButtons: false, showPagination: false } } } }
}
{#if blocks.length}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter" aria-roledescription="carousel" aria-label="{ settings.heading || t('carousel_label') }">
  {#if settings.heading}<h2 class="sr-only">{ settings.heading }</h2>{/if}
  <tarot-carousel class="mx-auto block max-w-column" id={ id }>
    <script type="application/json" data-tarot-options>{ options | json }</script>
    <tarot-viewport>
      <tarot-track>
        {#for block in blocks, i}
          <tarot-slide class="bg-scheme-background" data-block={ block.editor_id }>
            <figure class="flex flex-col gap-step-lg md:flex-row-reverse md:items-center md:justify-between md:gap-step-3xl">
              {#if block.settings.photo}<img class="aspect-4/5 w-full bg-scheme-surface object-cover md:w-1/2 lg:max-w-image" src="{ image_url(block.settings.photo, 1280) }" srcset="{ image_srcset(block.settings.photo, [480, 768, 1280]) }" sizes="(min-width: 48rem) 40vw, 85vw" alt="" loading="lazy" width={ block.settings.photo.width } height={ block.settings.photo.height } />{/if}
              <div class="grid max-w-text content-start gap-step-xl md:flex-1">
                {#if settings.heading}<p class="hidden font-mono text-meta tracking-meta text-scheme-meta uppercase md:block" aria-hidden="true">{ settings.heading }</p>{/if}
                <div class="grid gap-step-lg">
                  <blockquote class="font-heading text-quote text-balance text-scheme-heading italic">{ block.settings.quote }</blockquote>
                  <figcaption class="grid gap-step-2xs">
                    <span class="text-body text-scheme-foreground">{ block.settings.name }</span>
                    {#if block.settings.role}<span class="font-mono text-caption text-scheme-meta">{ block.settings.role }</span>{/if}
                  </figcaption>
                </div>
                {#if settings.show_counter || settings.show_arrows}
                  <div class="hidden items-center justify-between md:flex">
                    {#if settings.show_counter}<p class="font-mono text-counter tabular-nums text-scheme-meta">{ i + 1 < 10 ? '0' : '' }{ i + 1 } / { total }</p>{:else}<span></span>{/if}
                    {#if settings.show_arrows && blocks.length > 1}
                      <div class="flex gap-step-xs">
                        <button class="flex size-8 items-center justify-center border border-scheme-rule hover:border-scheme-foreground" type="button" data-carousel-step="previous" aria-label="{ t('previous') }"><span class="sites-icon size-6">{#svg 'icons/angle-left.svg'}</span></button>
                        <button class="flex size-8 items-center justify-center border border-scheme-rule hover:border-scheme-foreground" type="button" data-carousel-step="next" aria-label="{ t('next') }"><span class="sites-icon size-6">{#svg 'icons/angle-right.svg'}</span></button>
                      </div>
                    {/if}
                  </div>
                {/if}
              </div>
            </figure>
          </tarot-slide>
        {/for}
      </tarot-track>
    </tarot-viewport>
    <div class="mt-step-md flex items-center justify-between px-gutter md:hidden">
      <div data-tarot-pagination></div>
      {#if settings.show_counter}<Counter index={ 1 } total={ blocks.length } carousel_id={ id } />{/if}
    </div>
  </tarot-carousel>
</section>
{/if}

<schema>
{
  "name": "Testimonials",
  "description": "Voices paired with photographs, shown one at a time.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In their words"
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show counter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "voice",
      "name": "Voice",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": ""
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": ""
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": ""
        },
        {
          "type": "image",
          "id": "photo",
          "label": "Photo"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "In their words",
        "show_counter": true,
        "show_arrows": true,
        "color_scheme": "surface"
      },
      "blocks": [
        {
          "type": "voice",
          "settings": {
            "quote": "Mara waited for the light without asking the building to become something else. The photographs have the same patience.",
            "name": "Elin Berg",
            "role": "Architect, Gothenburg",
            "photo": "as_4x5_1"
          }
        },
        {
          "type": "voice",
          "settings": {
            "quote": "The sequence made sense of a place we had been looking at for years.",
            "name": "Jonas Hall",
            "role": "Editor",
            "photo": "as_3x2_3"
          }
        },
        {
          "type": "voice",
          "settings": {
            "quote": "A small print that changes with the room through the day.",
            "name": "Anna Ek",
            "role": "Print collector",
            "photo": "as_4x5_2"
          }
        }
      ]
    }
  ]
}
</schema>
