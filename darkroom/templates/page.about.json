      "type": "statement",
      "preset": "Default",
      "settings": {
        "eyebrow": "The practice",
        "body": "<p>I return to places until the familiar becomes <em>specific</em>: the mark on the wall, the edge of the field, the light that stays for <em>a minute</em>.</p>",
        "color_scheme": "surface-alt"
      },
      "blocks": []
    },
