<!-- template: Password -->
<!-- layout: default -->
<!-- A photograph from the home hero behind the scrim, the wordmark at the
     display size, and the password field. data-bare hides the header, footer
     and panel groups (styles/theme.css). -->
{#let photo = galleries['home-hero'].items[0]}
<section class="relative grid min-h-dvh flex-1 place-items-center bg-scheme-surface px-gutter py-section text-on-photo" data-bare>
  {#if photo}<img class="absolute inset-0 size-full object-cover" src="{ image_url(photo.asset, 1600) }" srcset="{ image_srcset(photo.asset, [768, 1280, 1600, 2560]) }" sizes="100vw" alt="" width={ photo.asset.width } height={ photo.asset.height } />{/if}
  <span class="absolute inset-0 bg-scrim" aria-hidden="true"></span>
  <div class="relative grid w-full justify-items-center gap-step-lg text-center">
    <h1 class="font-heading text-display font-semibold">{ site.settings.wordmark || site.name }</h1>
    <div class="grid w-full max-w-notice gap-step-md">
      <p class="text-body-lg text-pretty text-on-photo/80">{ t('password_body') }</p>
      <!-- The unlock endpoint reads `password` and redirects to the `to` path. -->
      <form class="grid w-full gap-step-md text-left" method="post" action="/_sites/unlock">
        <input type="hidden" name="to" value="{ request.query.return_to }" />
        {#if request.query.password_error}<p class="font-mono text-caption text-on-photo" role="alert">{ request.query.password_error }</p>{/if}
        <Field name="password" label="{ t('password_label') }" type="password" autocomplete="current-password" required={ true } rows={ null } maxlength={ null } options={ null } value={ null } error={ null } placeholder={ t('password_label') } prefix="password" wrapper_class="" />
        <button class="sites-button w-full" type="submit">{ t('password_submit') }</button>
      </form>
      <p class="font-mono text-caption text-on-photo/70">{ t('password_help') }</p>
    </div>
  </div>
</section>
