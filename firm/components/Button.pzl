<!-- The button, in sentence case. tone: solid (the scheme's button, the default) or outline (the scheme's secondary button, a hairline in its text colour). With type it is a <button> of that type, otherwise a link to href. small is the 2.75rem height; cls adds classes. -->
{#let
  look = tone == 'outline' ? 'border-current bg-scheme-outline text-scheme-outline-text hover:bg-scheme-outline-hover hover:text-scheme-outline-hover-text' : 'border-transparent bg-scheme-button text-scheme-button-text hover:bg-scheme-button-hover hover:text-scheme-button-hover-text'
  all = 'inline-flex items-center justify-center rounded-button border px-button-x text-button whitespace-nowrap transition-colors duration-fast ease-standard ' + (small ? 'min-h-tap ' : 'min-h-control ') + look + (cls ? ' ' + cls : '')
}
{#if type}<button class="{ all }" type="{ type }"><Children/></button>{:else}<a class="{ all }" href="{ href }"><Children/></a>{/if}
