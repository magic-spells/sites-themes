<!-- A section's head: the h2 and, when set, a standfirst under it, in the reading width; center centres both. Children follow the standfirst. -->
<div class="grid max-w-reading gap-space-xs { center ? 'justify-items-center text-center' : '' }">
  <h2 class="font-heading text-h2 text-balance text-scheme-heading">{ heading }</h2>
  {#if text}<p class="text-body-lg text-pretty text-scheme-muted">{ text }</p>{/if}
  <Children/>
</div>
