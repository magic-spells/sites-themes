<!-- The page's opening band and its h1, with more air than a section. text: the heading with its accent phrase, the standfirst and two buttons. split: the same in seven parts beside a 4:5 picture in five, the picture under the text on phones. The first button left without a link is the ask; the second, outlined, shows when it has a label. -->
{#let split = settings.layout == 'split'}
<section class="bg-scheme-background px-gutter py-hero text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl { split ? 'md:grid-cols-text-picture' : '' }">
    <div class="grid max-w-band justify-items-start gap-space-md">
      <h1 class="font-heading text-h1 text-balance text-scheme-heading">{ settings.heading }{#if settings.accent} <span class="text-accent">{ settings.accent }</span>{/if}</h1>
      {#if settings.text}<p class="max-w-reading text-lead text-pretty">{ settings.text }</p>{/if}
      <div class="flex flex-wrap gap-inset pt-space-xs">
        <Button href={ settings.button_link } label={ settings.button_label } />
        {#if settings.button2_label}<Button href={ settings.button2_link } label={ settings.button2_label } tone="outline" />{/if}
      </div>
    </div>
    {#if split}<Well asset={ settings.image } cls="aspect-portrait rounded-card" sizes="(min-width: 48rem) 40vw, 100vw" eager />{/if}
  </div>
</section>

<schema>
{
  "name": "Hero",
  "description": "The page's heading, a standfirst and two buttons, alone or beside a picture.",
  "kind": "Hero",
  "icon": "heading-1",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "text", "options": [
      { "value": "text", "label": "Text" },
      { "value": "split", "label": "Text and picture" }
    ] },
    { "type": "image", "id": "image", "label": "Image (4:5)", "info": "Text and picture only." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Advice you can act on" },
    { "type": "text", "id": "accent", "label": "Accent words", "default": "", "info": "Set after the heading in the accent colour." },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "", "info": "Leave the label and link empty for the ask." },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Practice areas", "info": "Outlined. Leave it empty for one button." },
    { "type": "url", "id": "button2_link", "label": "Second button link", "default": "/practice-areas" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "navy" } }
  ]
}
</schema>
