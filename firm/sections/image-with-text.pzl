<!-- A photo beside copy: the text in seven parts and the 4:3 photo in five from 48rem, the photo left or right; stacked on phones, the photo first. The heading, the rich text and one text link. -->
{#let left = settings.image_side == 'left'}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:gap-space-3xl { left ? 'md:grid-cols-picture-text' : 'md:grid-cols-text-picture' }">
    <div class="grid justify-items-start gap-space-md { left ? 'md:order-last' : '' }">
      <h2 class="font-heading text-h2 text-balance text-scheme-heading">{ settings.heading }</h2>
      <div class="sites-prose max-w-reading text-body-lg">{ settings.text }</div>
      {#if settings.link_label && settings.link}<a class="font-medium text-link underline" href="{ settings.link }">{ settings.link_label }</a>{/if}
    </div>
    <div class="max-md:order-first"><Well asset={ settings.image } ratio="aspect-landscape" sizes="(min-width: 48rem) 40vw, 100vw" /></div>
  </div>
</section>

<schema>
{
  "name": "Image with text",
  "description": "A photo beside a heading, text and a link.",
  "kind": "Content",
  "icon": "columns-2",
  "settings": [
    { "type": "image", "id": "image", "label": "Image (4:3)" },
    { "type": "select", "id": "image_side", "label": "Photo", "default": "right", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our approach" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One adviser stays with your matter from the first call to the last letter, so you always know who to ask and what happens next.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "About us" },
    { "type": "url", "id": "link", "label": "Link", "default": "/about" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
