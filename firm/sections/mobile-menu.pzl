<!-- The menu sheet below 64rem: a square sheet from the right edge on every viewport, over the page dimmed to half. The main menu in H3, the clients links under a rule, and the ask at the foot. It closes on the backdrop, a swipe, Escape and its close button, and hands focus back to the menu button. -->
<dialog-panel>
  <dialog class="rounded-none text-scheme-foreground" aria-label="{ t('menu') }">
    <sheet-panel id="mobile-menu" position="right" desktop-mode="edge">
      <sheet-header class="flex justify-end">
        <button class="flex size-control items-center justify-center rounded-full bg-scheme-surface-2" type="button" data-action-hide-dialog><Glyph name="close" /><span class="sr-only">{ t('close') }</span></button>
      </sheet-header>
      <sheet-content class="flex flex-col gap-space-lg">
        {#if menus.main.items.length}
          <nav aria-label="{ t('main_navigation') }">
            <ul class="grid gap-space-xs font-heading text-h3">{#for item in menus.main.items}<li><a class="hover:underline current:underline" href="{ item.href }" aria-current={ item.active ? 'page' : null }>{ item.label }</a></li>{/for}</ul>
          </nav>
        {/if}
        {#if menus.clients.items.length}
          <nav aria-label="{ menus.clients.title }">
            <ul class="grid gap-space-xs border-t border-scheme-border pt-space-md">{#for item in menus.clients.items}<li><a class="hover:underline" href="{ item.href }">{ item.label }</a></li>{/for}</ul>
          </nav>
        {/if}
        <Button cls="mt-auto" />
      </sheet-content>
    </sheet-panel>
  </dialog>
</dialog-panel>

<schema>
{
  "name": "Mobile menu",
  "description": "The menu sheet below 64rem: the main menu, the clients links and the ask.",
  "kind": "Panels",
  "icon": "menu",
  "settings": [
    { "type": "paragraph", "content": "The main and clients menus; the button is the ask, from the Firm settings." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
