<!-- The menu drawer below 64rem: a dialog-panel from the right over the page dimmed by the text colour at 50%. It closes on the backdrop, Escape and its ×, and hands focus back to the menu icon. The main menu in H3. -->
<dialog-panel id="mobile-menu" position="right">
  <dialog-backdrop class="bg-backdrop"></dialog-backdrop>
  <dialog class="overflow-y-auto bg-scheme-background text-scheme-foreground" aria-label="{ t('menu') }">
    <div class="grid gap-space-lg px-gutter pb-space-xl">
      <div class="flex min-h-header items-center justify-end"><button class="-me-space-xs flex size-tap items-center justify-center" type="button" data-action-hide-dialog><Glyph name="close" cls="size-glyph" /><span class="sr-only">{ t('close') }</span></button></div>
      {#if settings.menu.items.length}
        <nav aria-label="{ t('main_navigation') }">
          <ul class="grid gap-space-xs font-heading text-h3">{#for item in settings.menu.items}<li><a class="block py-space-2xs hover:underline current:underline" href="{ item.href }" aria-current={ item.active ? 'page' : null }>{ item.label }</a></li>{/for}</ul>
        </nav>
      {/if}
    </div>
  </dialog>
</dialog-panel>

<schema>
{
  "name": "Mobile menu",
  "description": "The menu drawer below 64rem.",
  "kind": "Panels",
  "icon": "menu",
  "settings": [
    { "type": "menu", "id": "menu", "label": "Menu" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": { "menu": "main" } }
  ]
}
</schema>
