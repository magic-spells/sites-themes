<!-- A letter by email, centred: the heading (and a line when set) over one field whose label is its placeholder (the label stays for screen readers) beside the button, stacked on phones. No note. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading justify-items-center gap-space-lg">
    <SectionHead heading={ settings.heading } text={ settings.text } center />
    <Form handle={ settings.form } class="grid w-full max-w-narrow gap-space-xs">
      {#if form.sent}
        <p class="text-center text-lead" role="status">{ form.success_message || t('form_success') }</p>
      {:else}
        <div class="flex flex-col gap-space-sm sm:flex-row sm:items-start">
          {#for field in form.fields}<Field field={ field } prefix="news" inline cls="flex-1" />{/for}
          <Button type="submit" label={ form.submit_label } />
        </div>
        {#if form.error}<p class="flex items-start gap-space-xs text-small" role="alert"><Glyph name="alert" cls="mt-space-2xs size-icon" />{ t('form_error') }</p>{/if}
        <noscript><p class="text-center text-small text-scheme-muted">{ t('form_requires_javascript') }</p></noscript>
      {/if}
    </Form>
  </div>
</section>

<schema>
{
  "name": "Newsletter",
  "description": "A heading and one email field.",
  "kind": "Contact",
  "icon": "mail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter" },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "form", "id": "form", "label": "Form", "default": "newsletter" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cream" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cream" } }
  ]
}
</schema>
