<!-- Where to find the firm: the offices as a ruled list in five parts (each its name, address, hours, note and a Directions link, each only when set) beside a 4:3 map picture in seven, the two centred on each other; the map above the list on phones. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-lg">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <div class="grid items-center gap-space-xl md:grid-cols-picture-text">
      <ul class="border-t border-scheme-border">
        {#for block in blocks}
          {#let o = block.settings}
          <li class="grid justify-items-start gap-space-2xs border-b border-scheme-border py-space-md" data-block={ block.editor_id }>
            <h3 class="text-h4 text-scheme-heading">{ o.name }</h3>
            {#if o.address}<p class="whitespace-pre-line">{ o.address }</p>{/if}
            {#if o.hours}<p class="whitespace-pre-line text-scheme-muted tabular-nums">{ o.hours }</p>{/if}
            {#if o.note}<p class="text-scheme-muted">{ o.note }</p>{/if}
            {#if o.map_link}<a class="mt-space-xs underline hover:decoration-2" href="{ o.map_link }">{ t('directions') }</a>{/if}
          </li>
        {/for}
      </ul>
      <Well asset={ settings.image } cls="aspect-landscape rounded-card max-md:order-first" sizes="(min-width: 48rem) 55vw, 100vw" />
    </div>
  </div>
</section>

<schema>
{
  "name": "Offices",
  "description": "The offices as a ruled list beside a map picture.",
  "kind": "Contact",
  "icon": "map-pin",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Offices" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "image", "id": "image", "label": "Map (4:3)", "info": "A picture of a map, or of the building." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "blocks": [
    { "type": "office", "name": "Office", "settings": [
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "textarea", "id": "address", "label": "Address", "info": "One line per line of the address." },
      { "type": "textarea", "id": "hours", "label": "Hours", "info": "One line per line." },
      { "type": "text", "id": "note", "label": "Note", "info": "Such as By appointment." },
      { "type": "url", "id": "map_link", "label": "Directions link" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" }, "blocks": [
      { "type": "office", "settings": { "name": "Main office", "address": "Street address\nCity, State ZIP", "hours": "Monday to Friday 9–5" } }
    ] }
  ]
}
</schema>
