<!-- A page's head: the h1 (the page title unless a heading is set) and the standfirst under it, in the reading width at the column's left. No kicker. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column justify-items-start gap-space-md">
    <h1 class="max-w-reading font-heading text-h1 text-balance text-scheme-heading">{ settings.heading || page.title }</h1>
    {#if settings.text}<p class="max-w-reading text-lead text-pretty">{ settings.text }</p>{/if}
  </div>
</section>

<schema>
{
  "name": "Page header",
  "description": "The page's title and a standfirst.",
  "kind": "Content",
  "icon": "heading-1",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
