<!-- One group of people in their order as round portraits, four a row (two on phones), centred: the role over the name and letters, each card the link to the person's page. The "All …" pill sits level with the heading. Nothing when the group is empty. -->
{#let people = content.team.entries | where('fields.group', settings.group) | sort('fields.order') | slice(0, settings.limit)}
{#if people.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-xl">
    <SectionHead heading={ settings.heading } text={ settings.text } pill={ settings.pill_label } href={ settings.pill_link } />
    <ul class="grid grid-cols-2 gap-x-space-md gap-y-space-xl md:grid-cols-4 md:gap-x-space-lg">{#for person in people}<li><PersonCard person={ person } circle /></li>{/for}</ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "People",
  "description": "One group of people as round portraits, each linking to their page.",
  "kind": "Collections",
  "icon": "users",
  "settings": [
    { "type": "select", "id": "group", "label": "Group", "default": "professionals", "options": [
      { "value": "professionals", "label": "Professionals" },
      { "value": "staff", "label": "Staff" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our people" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 12 },
    { "type": "text", "id": "pill_label", "label": "Pill label", "default": "", "info": "The outlined link beside the heading, such as All people. Leave it empty for none." },
    { "type": "url", "id": "pill_link", "label": "Pill link", "default": "/people" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "white" } }
  ]
}
</schema>
