<!-- One post in the reading column: the title as the h1, the standfirst, one meta line (the author linking to their page, the date, the topic), the 3:2 image when set, the body, then the author's person card over a hairline. -->
{#let
  post = page.entry
  f = post.fields
}
{#if post}
<article class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading gap-space-md">
    <h1 class="font-heading text-h1 text-balance text-scheme-heading">{ post.title }</h1>
    {#if f.standfirst}<p class="text-lead text-pretty">{ f.standfirst }</p>{/if}
    <p class="text-small text-scheme-muted">{#if f.team}<a class="underline hover:decoration-2" href="/people/{ f.team.handle }">{ f.team.title }</a> · {/if}<time class="tabular-nums" datetime="{ f.date }">{ date(f.date, 'long') }</time>{#if f.topic} · { f.topic }{/if}</p>
    {#if f.image}<Well asset={ f.image } cls="mt-space-xs aspect-photo rounded-card" sizes="(min-width: 48rem) 40rem, 100vw" />{/if}
    {#if f.body}<div class="sites-prose pt-space-xs">{ f.body }</div>{/if}
    {#if f.team}<div class="mt-space-lg border-t border-scheme-border pt-space-lg"><div class="max-w-3xs"><PersonCard person={ f.team } /></div></div>{/if}
  </div>
</article>
{/if}

<schema>
{
  "name": "Post",
  "description": "One post: its title, author, date, body and the author's card.",
  "kind": "Content",
  "icon": "file-text",
  "templates": ["post"],
  "settings": [
    { "type": "paragraph", "content": "Reads the post this page shows and its author." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
