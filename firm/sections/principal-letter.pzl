<!-- A letter from one person: in seven parts the heading, the letter at 60 characters a line, and the signature (the name and letters, the role under it); their 4:5 portrait in five, under the letter on phones. -->
{#let
  person = settings.person
  f = person.fields
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:grid-cols-text-picture">
    <div class="grid justify-items-start gap-space-md">
      <SectionHead heading={ settings.heading } />
      {#if settings.body}<div class="sites-prose max-w-letter">{ settings.body }</div>{/if}
      {#if person}<p class="grid gap-space-2xs pt-space-xs"><span class="text-h4 text-scheme-heading">{ person.title }{#if f.letters}, { f.letters }{/if}</span><span class="text-small text-scheme-muted">{ f.role }</span></p>{/if}
    </div>
    {#if person}<Well asset={ f.image } name={ person.title } cls="aspect-portrait rounded-card" sizes="(min-width: 48rem) 40vw, 100vw" />{/if}
  </div>
</section>

<schema>
{
  "name": "Letter",
  "description": "A letter signed by one of your people, beside their portrait.",
  "kind": "Content",
  "icon": "scroll-text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" },
    { "type": "richtext", "id": "body", "label": "Letter", "default": "" },
    { "type": "entry", "id": "person", "label": "Signed by", "info": "One of your people: their portrait, name, letters and role." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cream" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cream" } }
  ]
}
</schema>
