<!-- What clients say, split: the heading and the ask in five parts; the quote in seven with its meta line, and with more than one quote a tarot track of one at a time with its page dots under it; the note (no guarantee of a similar result) closes it. Nothing without quotes. -->
{#let
  id = 'quotes-' + section.id
  options = { loop: true, navigation: { showButtons: false } }
}
{#if blocks.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl md:grid-cols-picture-text">
    <div class="grid justify-items-start gap-space-md">
      <SectionHead heading={ settings.heading } text={ settings.text } />
      <Button href={ settings.button_link } label={ settings.button_label } />
    </div>
    <div class="grid gap-space-md">
      {#if blocks.length > 1}
        <tarot-carousel id={ id }>
          <script type="application/json" data-tarot-options>{ options | json }</script>
          <tarot-viewport><tarot-track>{#for block in blocks}<tarot-slide data-block={ block.editor_id }><Quote quote={ block.settings } /></tarot-slide>{/for}</tarot-track></tarot-viewport>
        </tarot-carousel>
      {:else}
        <div data-block={ blocks[0].editor_id }><Quote quote={ blocks[0].settings } /></div>
      {/if}
      {#if settings.note}<p class="max-w-narrow text-small text-pretty text-scheme-muted">{ settings.note }</p>{/if}
    </div>
  </div>
</section>
{/if}

<schema>
{
  "name": "Quotes",
  "description": "Clients' words one at a time beside the heading and the ask.",
  "kind": "Content",
  "icon": "message-square-quote",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What clients say" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "", "info": "Leave the label and link empty for the ask." },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Prior results do not guarantee a similar outcome.", "info": "Under the quotes. Leave it empty for none." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cream" }
  ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "line", "label": "Line", "info": "Who they are, such as Business owner, Vancouver." }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "cream" }, "blocks": [
      { "type": "quote", "settings": { "quote": "They explained every document line by line before we signed it.", "name": "Dana K.", "line": "Business owner" } },
      { "type": "quote", "settings": { "quote": "We knew who was handling our plan, and what it would cost, from the first meeting.", "name": "Margaret L.", "line": "Client since 2019" } }
    ] }
  ]
}
</schema>
