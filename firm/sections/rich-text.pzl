<!-- Prose in the reading column: an optional heading, then the editor's rich text. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading gap-space-md">
    {#if settings.heading}<h2 class="font-heading text-h2 text-balance text-scheme-heading">{ settings.heading }</h2>{/if}
    <div class="sites-prose">{ settings.text }</div>
  </div>
</section>

<schema>
{
  "name": "Rich text",
  "description": "A heading and prose in a reading column.",
  "kind": "Content",
  "icon": "text-align-start",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We advise people and businesses on the decisions that matter most to them. Tell us where things stand, and we will tell you plainly what we would do and what it will cost.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
