{
  "colors": {
    "brand": {
      "primary": "#141C2B",
      "secondary": "#2A3448",
      "accent": "#7A6A4F"
    },
    "grey": {
      "extra_light": "#F6F5F2",
      "light": "#D8D6D0",
      "medium": "#8C9097",
      "dark": "#5C6068",
      "extra_dark": "#2F343B"
    },
    "info": {
      "bg": "#E6EBF2",
      "fg": "#1F3A5F"
    },
    "success": {
      "bg": "#E6F2EA",
      "fg": "#1E6B3C"
    },
    "warning": {
      "bg": "#FBF0DA",
      "fg": "#7A4E00"
    },
    "error": {
      "bg": "#FBEDEA",
      "fg": "#A3261B"
    }
  },
  "fonts": {
    "heading": {
      "family": "Georgia, 'Times New Roman', serif",
      "weights": [
        400,
        700
      ],
      "source": "system"
    },
    "body": {
      "family": "system-ui, sans-serif",
      "weights": [
        400,
        500,
        600
      ],
      "source": "system"
    },
    "mono": {
      "family": "ui-monospace, monospace",
      "weights": [
        400
      ],
      "source": "system"
    }
  },
  "type": {
    "base": "1rem",
    "scale": {
      "xs": "0.8125rem",
      "sm": "0.9375rem",
      "base": "1.0625rem",
      "lg": "1.25rem",
      "xl": "1.375rem",
      "2xl": "1.75rem",
      "3xl": "2.5rem",
      "4xl": "3.5rem",
      "5xl": "3.5rem"
    },
    "leading": {
      "tight": "1.1",
      "normal": "1.55",
      "relaxed": "1.7"
    }
  },
  "spacing": {
    "xs": "0.5rem",
    "sm": "1rem",
    "md": "1.5rem",
    "lg": "2rem",
    "xl": "3rem",
    "2xl": "5rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "full": "9999rem"
  },
  "shadow": {
    "sm": "none",
    "md": "none",
    "lg": "0 24px 48px -16px rgb(20 28 43 / 0.24)"
  },
  "border": {
    "width": "1px",
    "color": "#D8D6D0"
  },
  "input": {
    "background": "#FFFFFF",
    "border": "#8C9097",
    "radius": "0.25rem",
    "text": "#1E2229",
    "placeholder": "#6A6E75",
    "focus_ring": "#141C2B"
  },
  "button": {
    "radius": "0.25rem",
    "padding_x": "1.5rem",
    "padding_y": "0.75rem",
    "weight": "500",
    "primary_bg": "#141C2B",
    "primary_text": "#FFFFFF",
    "secondary_bg": "transparent",
    "secondary_text": "#1E2229"
  },
  "link": {
    "color": "#1E2229",
    "hover_color": "#141C2B",
    "underline": "always"
  },
  "schemes": [
