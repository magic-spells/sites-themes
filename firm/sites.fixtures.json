  "forms": {
    "consultation": {
      "handle": "consultation",
      "name": "Consultation",
      "fields": [
        {
          "id": "name",
          "type": "text",
          "label": "Name",
          "required": true,
          "max_length": 200
        },
        {
          "id": "email",
          "type": "email",
          "label": "Email",
          "required": true,
          "max_length": 200
        },
        {
          "id": "phone",
          "type": "text",
          "label": "Phone",
          "required": false,
          "max_length": 200
        },
        {
          "id": "matter",
          "type": "select",
          "label": "What it’s about",
          "required": false,
          "max_length": 200,
          "options": [
            "Estate planning",
            "Trusts and powers of attorney",
            "Probate and trust administration",
            "Business formation",
            "Contracts and leases",
            "Buying or selling a business",
            "Tax planning"
          ]
        },
        {
          "id": "who",
          "type": "select",
          "label": "Who is this for",
          "required": false,
          "max_length": 200,
          "options": [
            "Me",
            "My family",
            "My business"
          ]
        },
        {
          "id": "others",
          "type": "text",
          "label": "Others involved",
          "required": false,
          "max_length": 200
        },
        {
          "id": "message",
          "type": "textarea",
          "label": "How can we help",
          "required": true,
          "max_length": 1000
        },
        {
          "id": "acknowledge",
          "type": "checkbox",
          "label": "I understand this does not make me a client",
          "required": true,
          "max_length": 200
        }
      ],
      "success_message": "Thank you. We reply within one working day with who would handle it and when we can meet.",
      "submit_label": "Send request",
      "redirect_path": ""
    },
    "newsletter": {
      "handle": "newsletter",
