      "entries": [
        {
          "id": "team_ruth_thorne",
          "handle": "ruth-thorne",
          "title": "Ruth Thorne",
          "fields": {
            "role": "Partner",
            "letters": "JD",
            "group": "professionals",
            "bio": "<p>Ruth founded the firm with Chidi Abara in 2015 and leads its estate planning. She has drafted wills and trusts for Oregon and Washington families since 2007, and she explains every document in plain terms before anyone signs it.</p>",
            "credentials": "Admitted in Oregon, 2007\nAdmitted in Washington, 2010\nOregon State Bar Estate Planning Section",
            "image": "as_ruth_thorne",
            "email": "ruth@thorneabara.com",
            "order": 1
          }
        },
        {
          "id": "team_chidi_abara",
          "handle": "chidi-abara",
          "title": "Chidi Abara",
          "fields": {
            "role": "Partner",
            "letters": "JD",
            "group": "professionals",
            "bio": "<p>Chidi leads the business practice: forming companies, writing operating agreements, reviewing contracts and leases, and seeing owners through the sale of a business.</p>",
            "credentials": "Admitted in Oregon, 2013",
            "image": "as_chidi_abara",
            "email": "chidi@thorneabara.com",
            "order": 2
          }
        },
        {
          "id": "team_lena_marsh",
          "handle": "lena-marsh",
          "title": "Lena Marsh",
          "fields": {
            "role": "Associate",
            "letters": "JD",
            "group": "professionals",
            "bio": "<p>Lena handles probate and trust administration, from small estate affidavits to estates with property on both sides of the river. She gives every family a timeline at the first meeting.</p>",
            "credentials": "Admitted in Oregon, 2020",
            "image": "as_lena_marsh",
            "email": "lena@thorneabara.com",
            "order": 3
          }
        },
        {
          "id": "team_tomas_reyes",
          "handle": "tomas-reyes",
          "title": "Tomas Reyes",
          "fields": {
            "role": "Of counsel",
            "letters": "JD, LL.M., CPA",
