<!-- layout: default -->
<!-- The site behind a password, with no header or footer: the name, the line, and the password field over Enter in the narrow column. -->
{#let field = { id: 'password', type: 'password', label: t('password_label'), required: true }}
<Utility bare>
  <div class="grid w-full max-w-narrow gap-space-md text-left">
    <p class="font-heading text-h3 text-scheme-heading">{ site.settings.wordmark || site.name }</p>
    <h1 class="text-body">{ t('password_body') }</h1>
    <form class="grid gap-space-md" method="post" action="/_sites/unlock">
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}<p class="flex items-start gap-space-xs text-small" role="alert"><Glyph name="alert" cls="mt-space-2xs size-icon" />{ request.query.password_error }</p>{/if}
      <Field field={ field } prefix="password" />
      <Button type="submit" label={ t('password_submit') } cls="justify-self-start" />
    </form>
  </div>
</Utility>
