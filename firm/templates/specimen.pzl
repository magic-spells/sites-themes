<!-- layout: default -->
<!-- The shared elements on the first scheme, for the render review: the buttons and the text link, a section head with its pill, the person cards in both looks, a post card and the ask form. No menu links here. -->
{#let
  people = content.team.entries
  posts = content.posts.entries
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-2xl">
    <h1 class="font-heading text-h1 text-scheme-heading">{ page.title }</h1>
    <div class="flex flex-wrap items-center gap-inset"><Button /><Button href="/practice-areas" label="Practice areas" tone="outline" /><a class="underline" href="/about">Read about the firm</a></div>
    <SectionHead heading="Our people" text="Who handles each kind of matter." pill="All people" href="/people" />
    <div class="grid grid-cols-2 gap-x-space-md gap-y-space-lg md:grid-cols-4">{#for person in people | slice(0, 4)}<PersonCard person={ person } circle />{/for}</div>
    <div class="grid gap-space-lg md:grid-cols-3"><PersonCard person={ people[3] } /><PostCard post={ posts[0] } /></div>
    <div class="max-w-reading"><AskForm prefix="specimen" /></div>
  </div>
</section>
