<!-- component: PostRow -->
<!-- props: entry href -->
<!-- One row of a post list: the date column, the title and standfirst, and
     the topic and reading time at the right. Below 48rem it folds to a short
     dateline over the title and drops the standfirst, as the design does. -->
<li class="border-b border-scheme-rule">
  <a class="group grid gap-step-2xs py-step-md md:grid-cols-post-row md:items-baseline md:gap-x-step-lg" href="{ href }">
    <p class="hidden font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase md:block"><PostDate value={ entry.fields.date } year={ true } /></p>
    <div class="grid gap-step-2xs">
      <p class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase md:hidden"><PostDate value={ entry.fields.date } year={ false } />{#if entry.fields.topic}<span aria-hidden="true"> · </span>{ entry.fields.topic }{/if}{#if entry.fields.reading_minutes}<span aria-hidden="true"> · </span>{ t('reading_time_short', { minutes: entry.fields.reading_minutes }) }{/if}</p>
      <h3 class="font-heading text-h4 font-medium text-scheme-heading decoration-1 underline-offset-4 group-hover:underline">{ entry.title }</h3>
      {#if entry.fields.standfirst}<p class="hidden text-body text-pretty text-scheme-muted md:block">{ entry.fields.standfirst }</p>{/if}
    </div>
    <p class="hidden font-mono text-meta font-medium tracking-meta whitespace-nowrap text-scheme-meta uppercase md:block">{ entry.fields.topic }{#if entry.fields.topic && entry.fields.reading_minutes}<span aria-hidden="true"> · </span>{/if}{#if entry.fields.reading_minutes}{ t('reading_time_short', { minutes: entry.fields.reading_minutes }) }{/if}</p>
  </a>
</li>
