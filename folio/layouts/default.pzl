<!-- layout: default -->
<html lang="{ site.locale }">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ page.title } — { site.name }</title>
    <Slot name="head-content"/>
  </head>
  <body>
    <a href="#content">{ t('skip_to_content') }</a>
    <Slot name="header-group"/>
    <main id="content"><Slot/></main>
    <Slot name="footer-group"/>
    <Slot name="panel-group"/>
  </body>
</html>
