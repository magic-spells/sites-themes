<aside class="bg-scheme-background px-gutter py-step-sm text-scheme-foreground" data-dismiss-key="{ settings.key }" aria-label="{ settings.text }">
  <div class="mx-auto flex max-w-column items-center gap-step-md md:px-step-lg">
    <span class="size-5 shrink-0" aria-hidden="true"></span>
    <p class="flex-1 text-center font-mono text-meta font-medium tracking-note text-pretty">
      { settings.text }
      {#if settings.link_label}<a class="ml-step-2xs text-scheme-links underline decoration-1 underline-offset-4 hover:text-scheme-heading" href="{ settings.link }">{ settings.link_label }</a>{/if}
    </p>
    <button class="sites-icon size-7 text-scheme-meta hover:text-scheme-heading" type="button" data-dismiss>{#svg 'icons/close.svg'}<span class="sr-only">{ t('dismiss_announcement') }</span></button>
  </div>
</aside>

<schema>
{
  "name": "Announcement bar",
  "description": "A short notice and optional link, remembered when dismissed.",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "A new essay every other Tuesday. The October letter is out."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read the letter"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/#section-s_newsletter"
    },
    {
      "type": "text",
      "id": "key",
      "label": "Remember key",
      "default": "folio-announcement-2026-10",
      "info": "Change this to show the announcement again after dismissal."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "ink"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "text": "A new essay every other Tuesday. The October letter is out.",
        "link_label": "Read the letter",
        "link": "/#section-s_newsletter",
        "key": "folio-announcement-2026-10",
        "color_scheme": "ink"
      }
    }
  ]
}
</schema>
