<div>Announcement bar</div>

<schema>
{
  "name": "Announcement bar",
  "description": "A short notice and optional link, remembered when dismissed.",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "A new essay every other Tuesday. The October letter is out."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read the letter"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/#section-s_newsletter"
    },
    {
      "type": "text",
      "id": "key",
      "label": "Remember key",
      "default": "folio-announcement-2026-10",
      "info": "Change this to show the announcement again after dismissal."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "ink"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "text": "A new essay every other Tuesday. The October letter is out.",
        "link_label": "Read the letter",
        "link": "/#section-s_newsletter",
        "key": "folio-announcement-2026-10",
        "color_scheme": "ink"
      }
    }
  ]
}
</schema>
