{#let
  post_author = settings.use_post_author ? page.entry.fields.author : null
  name = settings.name || post_author || site.settings.writer_name
  bio = settings.bio || site.settings.writer_bio
  portrait = settings.portrait ?? site.settings.writer_portrait
  links = settings.links.items.length ? settings.links : site.settings.writer_links
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto flex max-w-reading flex-wrap items-center gap-step-lg { site.settings.reveal_on_scroll ? 'reveal reveal-fade-up' : '' }">
    {#if portrait}
      <img class="size-portrait shrink-0 rounded-full bg-scheme-surface object-cover" src="{ image_url(portrait, 160, { height: 160 }) }" srcset="{ image_url(portrait, 160, { height: 160 }) } 1x, { image_url(portrait, 320, { height: 320 }) } 2x" alt="{ portrait.alt }" width="72" height="72" loading="lazy" />
    {/if}
    <div class="grid min-w-bio flex-1 gap-step-xs">
      {#if settings.label}<p class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ settings.label }</p>{/if}
      <h2 class="font-heading text-h3 font-medium text-scheme-heading">{ name }</h2>
      {#if bio}<p class="text-body text-pretty">{ bio }</p>{/if}
      {#if links.items.length}
        <ul class="flex flex-wrap font-mono text-meta font-medium tracking-meta text-scheme-links uppercase" aria-label="{ t('social_links') }">
          {#for item in links.items, i}
            <li>{#if i > 0}<span class="whitespace-pre" aria-hidden="true"> · </span>{/if}<a class="decoration-1 underline-offset-4 hover:underline" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null }>{ item.label }</a></li>
          {/for}
        </ul>
      {/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Author card",
  "description": "A writer portrait, biography and links, using site settings when empty.",
  "settings": [
    {
      "type": "image",
      "id": "portrait",
      "label": "Portrait",
      "info": "Leave empty to use the Writer portrait."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "",
      "info": "Leave empty to use the Writer name."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The writer"
    },
    {
      "type": "textarea",
      "id": "bio",
      "label": "Biography",
      "default": "",
      "info": "Leave empty to use the Writer biography."
    },
    {
      "type": "menu",
      "id": "links",
      "label": "Links menu",
      "info": "Leave empty to use the Writer links menu."
    },
    {
      "type": "checkbox",
      "id": "use_post_author",
      "label": "Use the current post author",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "tint"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "name": "",
        "label": "The writer",
        "bio": "",
        "use_post_author": false,
        "color_scheme": "tint"
      }
    }
  ]
}
</schema>
