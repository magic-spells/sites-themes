<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-x-step-2xl gap-y-step-xl md:grid-cols-2 { site.settings.reveal_on_scroll ? 'reveal reveal-fade-up' : '' }">
    <div class="grid gap-step-md">
      {#if settings.show_heading}<h2 class="font-heading text-h2 font-medium text-scheme-heading">{ settings.heading }</h2>{/if}
      {#if settings.text}<p class="text-body text-pretty">{ settings.text }</p>{/if}
      {#if settings.show_details}
        <dl class="grid gap-step-sm pt-step-xs">
          {#if site.settings.contact_email}
            <div class="grid gap-step-2xs">
              <dt class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ t('label_email') }</dt>
              <dd class="text-body"><a class="decoration-1 underline-offset-4 hover:text-scheme-links hover:underline" href="mailto:{ site.settings.contact_email }">{ site.settings.contact_email }</a></dd>
            </div>
          {/if}
          {#if site.settings.address}
            <div class="grid gap-step-2xs">
              <dt class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ t('label_post') }</dt>
              <dd class="text-body whitespace-pre-line">{ site.settings.address }</dd>
            </div>
          {/if}
          {#if site.settings.hours}
            <div class="grid gap-step-2xs">
              <dt class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ t('label_hours') }</dt>
              <dd class="text-body">{ site.settings.hours }</dd>
            </div>
          {/if}
        </dl>
      {/if}
    </div>

    <!-- The site owns the fields; this theme chooses their markup. -->
    <Form handle={ settings.form } class="grid gap-step-sm" aria-label="{ settings.heading }">
      {#if form.sent}
        <p class="text-body-lg text-scheme-heading" role="status">{ form.success_message }</p>
      {:else}
        {#for field in form.fields}
          <Field name={ field.id } label={ field.label } type={ field.type } autocomplete={ null }
            rows={ 3 } maxlength={ field.max_length } required={ field.required }
            options={ field.options } value={ field.value } error={ field.error }
            placeholder={ field.label } prefix={ section.id } wrapper_class="" />
        {/for}
        {#if form.error}
          <p class="font-mono text-meta tracking-caption text-scheme-error" role="alert">{ t(form.error == 'expired' ? 'form_field_expired' : 'form_error') }</p>
        {/if}
        <div class="grid justify-items-start gap-step-xs">
          <button class="sites-button min-w-button" type="submit">{ form.submit_label }</button>
          <noscript><p class="font-mono text-meta tracking-caption text-scheme-meta">{ t('form_requires_javascript') }</p></noscript>
          {#if settings.note}<p class="font-mono text-meta tracking-caption text-scheme-meta">{ settings.note }</p>{/if}
        </div>
      {/if}
    </Form>
  </div>
</section>

<schema>
{
  "name": "Contact form",
  "description": "A contact form with optional heading and site contact details.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Write to Nell"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show the heading",
      "default": true
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Letters about paths, towns and weather are always welcome. I read every one and answer most, slowly."
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show the postal address and reply hours",
      "default": true
    },
    {
      "type": "form",
      "id": "form",
      "label": "Form",
      "default": "contact"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the button",
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Write to Nell",
        "show_heading": true,
        "text": "Letters about paths, towns and weather are always welcome. I read every one and answer most, slowly.",
        "show_details": true,
        "form": "contact",
        "note": "",
        "color_scheme": "paper"
      }
    }
  ]
}
</schema>
