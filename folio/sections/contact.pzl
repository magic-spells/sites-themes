<div>Contact form</div>

<schema>
{
  "name": "Contact form",
  "description": "A contact form with optional heading and site contact details.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Write to Nell"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show the heading",
      "default": true
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Letters about paths, towns and weather are always welcome. I read every one and answer most, slowly."
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show the postal address and reply hours",
      "default": true
    },
    {
      "type": "form",
      "id": "form",
      "label": "Form",
      "default": "contact"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the button",
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Write to Nell",
        "show_heading": true,
        "text": "Letters about paths, towns and weather are always welcome. I read every one and answer most, slowly.",
        "show_details": true,
        "form": "contact",
        "note": "",
        "color_scheme": "paper"
      }
    }
  ]
}
</schema>
