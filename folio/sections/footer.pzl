<footer class="border-t border-scheme-rule bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-step-xl">
    <div class="flex flex-wrap justify-between gap-x-step-lg gap-y-step-xl">
      <div class="grid max-w-narrow flex-1 basis-footer-brand content-start gap-step-sm">
        <a class="font-heading text-h3 font-medium text-scheme-heading" href="/">{ site.name }</a>
        {#if site.settings.tagline}<p class="text-body text-pretty text-scheme-muted">{ site.settings.tagline }</p>{/if}
      </div>
      <div class="grid w-full grid-cols-2 gap-step-lg md:flex md:w-auto">
        {#for menu in [settings.menu_primary, settings.menu_secondary]}
          {#if menu.items.length}
            <nav class="grid content-start gap-step-xs md:min-w-footer-menu" aria-label="{ menu.title }">
              <h2 class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ menu.title }</h2>
              <ul class="grid gap-step-xs">
                {#for item in menu.items}
                  <li><a class="text-body text-scheme-muted decoration-1 underline-offset-4 hover:text-scheme-heading hover:underline" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null } aria-current={ item.active ? 'page' : null }>{ item.label }</a></li>
                {/for}
              </ul>
            </nav>
          {/if}
        {/for}
      </div>
    </div>

    <div class="flex items-start justify-between gap-step-xl border-t border-scheme-rule pt-step-lg font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">
      <p class="shrink-0">{ settings.copyright }</p>
      {#if blocks.length}
        <ul class="flex flex-wrap justify-end text-right" aria-label="{ t('social_links') }">
          {#for block in blocks, i}
            <li data-block={ block.editor_id }>{#if i > 0}<span class="whitespace-pre" aria-hidden="true"> · </span>{/if}<a class="hover:text-scheme-links" href="{ block.settings.url }">{ block.settings.label }</a></li>
          {/for}
        </ul>
      {/if}
    </div>
  </div>
</footer>

<schema>
{
  "name": "Footer",
  "description": "The site name, tagline, two menus and social links.",
  "kind": "Footer",
  "icon": "panel-bottom",
  "settings": [
    {
      "type": "menu",
      "id": "menu_primary",
      "label": "Main footer menu"
    },
    {
      "type": "menu",
      "id": "menu_secondary",
      "label": "Second footer menu"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "default": "© 2026 The Slow Mile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "RSS"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Default",
      "settings": {
        "copyright": "© 2026 The Slow Mile",
        "color_scheme": "cream",
        "menu_primary": "journal",
        "menu_secondary": "elsewhere"
      },
      "blocks": [
        {
          "type": "social",
          "settings": {
            "label": "RSS",
            "url": "https://theslowmile.example/feed.xml"
          }
        },
        {
          "type": "social",
          "settings": {
            "label": "Instagram",
            "url": "https://www.instagram.com/"
          }
        },
        {
          "type": "social",
          "settings": {
            "label": "Email",
            "url": "mailto:nell@theslowmile.com"
          }
        }
      ]
    }
  ]
}
</schema>
