{#let
  ratio = settings.ratio == 'landscape' ? 'aspect-3/2' : (settings.ratio == 'square' ? 'aspect-square' : 'aspect-4/5')
  text_first = settings.layout == 'text_first'
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto flex max-w-column flex-col gap-x-step-2xl gap-y-step-xl md:flex-row md:items-center { site.settings.reveal_on_scroll ? 'reveal reveal-fade-up' : '' }">
    <!-- The picture comes first on a phone whichever side it takes from
         48rem up. -->
    <div class="shrink-0 md:w-1/2 lg:w-well { text_first ? 'md:order-last' : '' }">
      {#if settings.image}
        { image_tag(settings.image, { class: 'w-full bg-scheme-surface object-cover ' + ratio, sizes: '(min-width: 64rem) 30rem, (min-width: 48rem) 50vw, 100vw', alt: settings.image.alt ?? '' }) }
      {:else}
        <div class="w-full bg-scheme-surface { ratio }"></div>
      {/if}
    </div>
    <div class="grid flex-1 content-center gap-step-md">
      {#if settings.eyebrow}<p class="font-mono text-meta font-medium tracking-meta text-scheme-links uppercase">{ settings.eyebrow }</p>{/if}
      {#if settings.heading}<h2 class="font-heading text-h2 font-medium text-scheme-heading">{ settings.heading }</h2>{/if}
      {#if settings.body}<div class="sites-prose text-pretty">{ settings.body }</div>{/if}
      {#if settings.link_label}<p><a class="font-mono text-meta font-medium tracking-meta text-scheme-links uppercase underline decoration-1 underline-offset-4 hover:text-scheme-heading" href="{ settings.link }">{ settings.link_label }</a></p>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Image with text",
  "description": "An image beside a heading and writing; the image comes first on mobile.",
  "kind": "Content",
  "icon": "columns-2",
  "settings": [
    {
      "type": "image",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "default": "portrait",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "landscape",
          "label": "Landscape (3:2)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_first",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A valley with one café and two buses a day"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>I write about towns, weather and the paths between them, mostly on foot and mostly slowly.</p><p>The journal started as notes for myself. It became letters when people started asking where the closed path went.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "More about the walks"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/journal"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "ratio": "portrait",
        "layout": "image_first",
        "eyebrow": "About",
        "heading": "A valley with one café and two buses a day",
        "body": "<p>I write about towns, weather and the paths between them, mostly on foot and mostly slowly.</p><p>The journal started as notes for myself. It became letters when people started asking where the closed path went.</p>",
        "link_label": "More about the walks",
        "link": "/journal"
      }
    }
  ]
}
</schema>
