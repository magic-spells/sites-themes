<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-x-step-2xl gap-y-step-lg md:grid-cols-2 { site.settings.reveal_on_scroll ? 'reveal reveal-fade-up' : '' }">
    <div class="grid gap-step-md">
      <h2 class="font-heading text-h2 font-medium text-scheme-heading">{ settings.heading }</h2>
      {#if settings.text}<p class="text-body text-pretty text-scheme-muted">{ settings.text }</p>{/if}
    </div>
    <div class="grid gap-step-sm">
      <Form handle={ settings.form } class="grid gap-step-sm">
        {#if form.sent}
          <p class="text-body-lg text-scheme-heading" role="status">{ form.success_message }</p>
        {:else}
          <div class="flex flex-wrap gap-step-xs">
            {#for field in form.fields}
              <Field name={ field.id } label={ field.label } type={ field.type } autocomplete={ null } rows={ 4 }
                maxlength={ field.max_length } required={ field.required }
                options={ field.options } value={ field.value } error={ field.error }
                placeholder={ settings.placeholder || field.label } prefix={ section.id } wrapper_class="grow basis-field" />
            {/for}
            <button class="sites-button grow basis-subscribe lg:min-h-control" type="submit">{ form.submit_label }</button>
          </div>
          {#if form.error}
            <p class="font-mono text-meta tracking-caption text-scheme-error" role="alert">{ t(form.error == 'expired' ? 'form_field_expired' : 'form_error') }</p>
          {/if}
          <noscript><p class="font-mono text-meta tracking-caption text-scheme-meta">{ t('form_requires_javascript') }</p></noscript>
        {/if}
      </Form>
      {#if settings.note}<p class="font-mono text-meta tracking-caption text-pretty text-scheme-meta">{ settings.note }</p>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Newsletter",
  "description": "A letter signup with a site-owned form and a short privacy note.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A letter when there is something to say"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Usually once a month. Never more than twice."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "One click to leave. Your address goes nowhere else."
    },
    {
      "type": "form",
      "id": "form",
      "label": "Form",
      "default": "newsletter"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "ink"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "A letter when there is something to say",
        "text": "Usually once a month. Never more than twice.",
        "placeholder": "you@example.com",
        "note": "One click to leave. Your address goes nowhere else.",
        "form": "newsletter",
        "color_scheme": "ink"
      }
    }
  ]
}
</schema>
