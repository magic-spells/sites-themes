<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <header class="mx-auto grid max-w-reading gap-step-md { settings.align == 'center' ? 'justify-items-center text-center' : 'justify-items-start' }">
    {#if settings.chip}<Chip>{ settings.chip }</Chip>{/if}
    <h1 class="max-w-heading font-heading text-h1 font-normal text-pretty text-scheme-heading">{ settings.heading || page.title }</h1>
    {#if settings.standfirst || page.seo.description}
      <p class="text-body-lg leading-standfirst font-light text-pretty text-scheme-muted italic">{ settings.standfirst || page.seo.description }</p>
    {/if}
  </header>
</section>

<schema>
{
  "name": "Page header",
  "description": "The page title and standfirst, with an optional label.",
  "settings": [
    {
      "type": "text",
      "id": "chip",
      "label": "Label",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "text",
      "id": "standfirst",
      "label": "Standfirst",
      "default": "",
      "info": "Leave empty to use the page search description."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "chip": "",
        "heading": "",
        "standfirst": "",
        "align": "left",
        "color_scheme": "cream"
      }
    },
    {
      "name": "Centered",
      "settings": {
        "chip": "",
        "heading": "",
        "standfirst": "",
        "align": "center",
        "color_scheme": "cream"
      }
    }
  ]
}
</schema>
