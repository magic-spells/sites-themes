{#let
  entry = page.entry
  image = entry.fields.image
}
<article class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading gap-step-xl">
    <div class="grid gap-step-lg">
      <header class="grid gap-step-md">
        {#if settings.show_meta}<Dateline entry={ entry } read={ true } />{/if}
        <h1 class="font-heading text-h1 font-normal text-scheme-heading">{ entry.title ?? page.title }</h1>
        {#if entry.fields.standfirst}<p class="text-body-lg leading-standfirst font-light text-pretty text-scheme-muted italic">{ entry.fields.standfirst }</p>{/if}
        {#if settings.show_byline && entry.fields.author}<p class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ t('by_line') } { entry.fields.author }</p>{/if}
      </header>

      {#if settings.show_image && image}
        <figure class="grid gap-step-xs">
          <img class="aspect-video w-full bg-scheme-surface object-cover"
            src="{ image_url(image, 1280) }"
            srcset="{ image_url(image, 480) } 480w, { image_url(image, 768) } 768w, { image_url(image, 1280) } 1280w, { image_url(image, 1600) } 1600w"
            sizes="(min-width: 48rem) 45rem, 100vw"
            alt="{ entry.fields.image_alt }" loading="eager" fetchpriority="high" width="{ image.width }" height="{ image.height }" />
          {#if entry.fields.image_caption}<figcaption class="font-mono text-meta tracking-caption text-scheme-meta">{ entry.fields.image_caption }</figcaption>{/if}
        </figure>
      {/if}

      <div class="sites-prose { settings.drop_cap ? 'folio-drop-cap' : '' }">{ entry.fields.body }</div>
    </div>
    {#if settings.show_end_rule}<hr class="mx-auto h-0.5 w-10 border-0 bg-scheme-links" />{/if}
  </div>
</article>

<schema>
{
  "name": "Post",
  "description": "One journal entry, its metadata, image, byline and writing.",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show the topic, date and reading time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show the picture",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_byline",
      "label": "Show the byline",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "drop_cap",
      "label": "Show a drop cap",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_end_rule",
      "label": "Show the end rule",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "templates": [
    "post"
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "show_meta": true,
        "show_image": true,
        "show_byline": true,
        "drop_cap": true,
        "show_end_rule": true,
        "color_scheme": "paper"
      }
    }
  ]
}
</schema>
