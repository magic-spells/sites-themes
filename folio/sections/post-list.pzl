{#let
  sorted = settings.collection.entries | sort('fields.date') | reverse
  by_topic = settings.topic ? (sorted | where('fields.topic', settings.topic)) : sorted
  pool = settings.exclude_current && page.entry ? (by_topic | reject('handle', page.entry.handle)) : by_topic
  skip = settings.offset ?? 0
  posts = pool | slice(skip, settings.limit)
  show_view_all = settings.view_all_label && settings.view_all_href
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-step-md">
    {#if settings.heading}<h2 class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ settings.heading }</h2>{/if}
    {#if posts.length == 0}
      <p class="border-t border-scheme-rule pt-step-md text-body text-scheme-muted">{ t('posts_empty') }</p>
    {:else if settings.layout == 'grid'}
      <ul class="grid gap-x-space-xs gap-y-step-lg md:grid-cols-2 md:gap-x-space-sm { settings.columns == '2' ? '' : 'lg:grid-cols-3' }">
        {#for entry in posts}<PostCard entry={ entry } href="{ settings.base_path }/{ entry.handle }" />{/for}
      </ul>
    {:else}
      <ul class="border-t border-scheme-rule">
        {#for entry in posts}<PostRow entry={ entry } href="{ settings.base_path }/{ entry.handle }" />{/for}
      </ul>
    {/if}
    {#if (settings.show_count && posts.length) || show_view_all}
      <div class="flex flex-wrap items-center justify-between gap-step-sm">
        {#if settings.show_count && posts.length}<p class="font-mono text-meta tracking-caption text-scheme-meta">{ t('post_count', { shown: posts.length, total: pool.length }) }</p>{:else}<span></span>{/if}
        {#if show_view_all}<a class="border-b border-scheme-links pb-step-2xs font-mono text-meta font-medium tracking-meta text-scheme-links uppercase hover:border-scheme-heading hover:text-scheme-heading" href="{ settings.view_all_href }">{ settings.view_all_label }</a>{/if}
      </div>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Post list",
  "description": "Journal entries as rows or cards, with an optional count and view-all link.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recent"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Content type",
      "info": "Uses posts fields topic, date, author, reading_minutes, standfirst, image, image_alt and body; image_caption is optional."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Index path",
      "default": "/journal",
      "info": "Each entry links to this path plus its handle."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "list",
      "options": [
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Posts shown",
      "default": 4,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Skip the newest",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 0
    },
    {
      "type": "text",
      "id": "topic",
      "label": "Topic",
      "default": "",
      "info": "Leave empty for every topic; otherwise match the entry topic exactly."
    },
    {
      "type": "checkbox",
      "id": "exclude_current",
      "label": "Exclude the current post",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show the post count",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View-all label",
      "default": "Everything in the journal"
    },
    {
      "type": "url",
      "id": "view_all_href",
      "label": "View-all link",
      "default": "/journal"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Recent",
      "settings": {
        "heading": "Recent",
        "base_path": "/journal",
        "layout": "list",
        "columns": "3",
        "limit": 4,
        "topic": "",
        "exclude_current": false,
        "show_count": true,
        "view_all_label": "Everything in the journal",
        "view_all_href": "/journal",
        "color_scheme": "paper",
        "collection": "posts"
      }
    },
    {
      "name": "Index",
      "settings": {
        "heading": "All posts",
        "base_path": "/journal",
        "layout": "list",
        "columns": "3",
        "limit": 12,
        "topic": "",
        "exclude_current": false,
        "show_count": true,
        "view_all_label": "",
        "view_all_href": "",
        "color_scheme": "paper",
        "collection": "posts"
      }
    },
    {
      "name": "More to read",
      "settings": {
        "heading": "More to read",
        "base_path": "/journal",
        "layout": "list",
        "columns": "3",
        "limit": 3,
        "topic": "",
        "exclude_current": true,
        "show_count": false,
        "view_all_label": "",
        "view_all_href": "",
        "color_scheme": "paper",
        "collection": "posts"
      }
    },
    {
      "name": "Grid",
      "settings": {
        "heading": "Recent",
        "base_path": "/journal",
        "layout": "grid",
        "columns": "3",
        "limit": 3,
        "topic": "",
        "exclude_current": false,
        "show_count": true,
        "view_all_label": "Everything in the journal",
        "view_all_href": "/journal",
        "color_scheme": "paper",
        "collection": "posts"
      }
    }
  ]
}
</schema>
