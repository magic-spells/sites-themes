<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <figure class="mx-auto flex max-w-reading gap-step-xs { site.settings.reveal_on_scroll ? 'reveal reveal-fade-up' : '' }">
    <!-- The opening mark hangs in its own column, so the quote's lines align. -->
    <span class="font-heading text-h1 leading-none font-light text-scheme-links italic" aria-hidden="true">“</span>
    <div class="grid gap-step-md">
      <blockquote class="max-w-heading font-heading text-h1 leading-none font-light text-pretty text-scheme-heading italic"><p>{ settings.quote }</p></blockquote>
      {#if settings.attribution}<figcaption class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ settings.attribution }</figcaption>{/if}
    </div>
  </figure>
</section>

<schema>
{
  "name": "Pull quote",
  "description": "A quotation with a hanging opening mark and optional attribution.",
  "kind": "Content",
  "icon": "quote",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Nobody has taken it down because nobody is quite sure whose job that is."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "Nell Harker, The path above the town"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "tint"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "quote": "Nobody has taken it down because nobody is quite sure whose job that is.",
        "attribution": "Nell Harker, The path above the town",
        "color_scheme": "tint"
      }
    }
  ]
}
</schema>
