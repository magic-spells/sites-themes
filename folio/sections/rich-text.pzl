<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid { settings.width == 'wide' ? 'max-w-column' : 'max-w-reading' } gap-step-md">
    {#if settings.heading}<h2 class="font-heading text-h2 font-medium text-scheme-heading">{ settings.heading }</h2>{/if}
    <div class="sites-prose">{ settings.body || page.content }</div>
  </div>
</section>

<schema>
{
  "name": "Rich text",
  "description": "A heading and writing, falling back to the page content when empty.",
  "kind": "Content",
  "icon": "align-left",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "",
      "info": "Leave empty to use the page’s own writing."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "",
        "body": "",
        "width": "narrow"
      }
    },
    {
      "name": "Wide",
      "settings": {
        "heading": "",
        "body": "",
        "width": "wide"
      }
    }
  ]
}
</schema>
