<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading gap-step-md">
    {#if settings.heading}<h2 class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ settings.heading }</h2>{/if}
    {#if blocks.length}
      <ul class="border-t border-scheme-rule">
        {#for block in blocks}
          <li class="border-b border-scheme-rule" data-block={ block.editor_id }>
            <a class="group flex items-center justify-between gap-step-md py-step-md" href="{ block.settings.url }">
              <span class="font-heading text-h4 font-medium text-scheme-heading decoration-1 underline-offset-4 group-hover:underline">{ block.settings.name }</span>
              <span class="font-mono text-meta font-medium tracking-meta whitespace-nowrap text-scheme-meta uppercase">{ block.settings.count }</span>
            </a>
          </li>
        {/for}
      </ul>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Topics",
  "description": "A manually arranged list of topics with links and count labels.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Topics"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Walking"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "default": "/journal"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Count",
          "default": "3 essays"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Topics",
        "color_scheme": "paper"
      },
      "blocks": [
        {
          "type": "topic",
          "settings": {
            "name": "Walking",
            "url": "/journal",
            "count": "3 essays"
          }
        },
        {
          "type": "topic",
          "settings": {
            "name": "Towns",
            "url": "/journal",
            "count": "5 essays"
          }
        },
        {
          "type": "topic",
          "settings": {
            "name": "Weather",
            "url": "/journal",
            "count": "3 essays"
          }
        },
        {
          "type": "topic",
          "settings": {
            "name": "Seasons",
            "url": "/journal",
            "count": "2 essays"
          }
        }
      ]
    }
  ]
}
</schema>
