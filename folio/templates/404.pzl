<!-- template: NotFound -->
<!-- layout: default -->
{#let
  sorted = content.posts.entries | sort('fields.date') | reverse
  posts = sorted | slice(0, 3)
}
<section class="sites-scheme-cream bg-scheme-background px-gutter py-section text-scheme-foreground">
  <header class="mx-auto grid max-w-reading justify-items-start gap-step-md">
    <Chip>404</Chip>
    <h1 class="font-heading text-h1 font-normal text-scheme-heading">{ t('not_found_title') }</h1>
    <p class="text-body-lg leading-standfirst font-light text-pretty text-scheme-muted italic">{ t('not_found_body') }</p>
  </header>
</section>
{#if posts.length}
<section class="sites-scheme-paper bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-step-md">
    <h2 class="font-mono text-meta font-medium tracking-meta text-scheme-meta uppercase">{ t('recent_posts') }</h2>
    <ul class="border-t border-scheme-rule">
      {#for entry in posts}<PostRow entry={ entry } href="{ site.settings.posts_path }/{ entry.handle }" />{/for}
    </ul>
    <div class="flex flex-wrap items-center justify-between gap-step-sm">
      <p class="font-mono text-meta tracking-caption text-scheme-meta">{ t('post_count', { shown: posts.length, total: sorted.length }) }</p>
      <a class="border-b border-scheme-links pb-step-2xs font-mono text-meta font-medium tracking-meta text-scheme-links uppercase hover:border-scheme-heading hover:text-scheme-heading" href="{ site.settings.posts_path }">{ t('view_all_posts') }</a>
    </div>
  </div>
</section>
{/if}
