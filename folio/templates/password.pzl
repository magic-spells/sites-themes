<!-- template: Password -->
<!-- layout: default -->
<!-- data-bare hides the header, footer and panel groups (styles/theme.css). -->
<section class="grid flex-1 place-items-center bg-scheme-background px-gutter py-section text-scheme-foreground" data-bare>
  <div class="grid w-full max-w-narrow justify-items-center gap-step-md text-center">
    <h1 class="font-heading text-h3 font-medium text-scheme-heading">{ site.name }</h1>
    <p class="text-body-lg text-pretty text-scheme-muted">{ t('password_body') }</p>
    <!-- The unlock endpoint reads `password` and redirects to the `to` path. -->
    <form class="grid w-full gap-step-md text-left" method="post" action="/_sites/unlock">
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}
        <p class="font-mono text-meta tracking-caption text-scheme-error" role="alert">{ request.query.password_error }</p>
      {/if}
      <Field name="password" label="{ t('password_label') }" type="password" autocomplete="current-password" required={ true }
        rows={ null } maxlength={ null } options={ null } value={ null } error={ null } placeholder={ t('password_label') } prefix="password" wrapper_class="" />
      <button class="sites-button w-full" type="submit">{ t('password_submit') }</button>
    </form>
    <p class="font-mono text-meta tracking-caption text-scheme-meta">{ t('password_help') }</p>
  </div>
</section>
