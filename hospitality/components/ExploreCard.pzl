<!-- component: ExploreCard -->
<!-- props: entry base_path -->
<!-- A thing to do, one link, in the stay card's shape: a paper card at content radius with a hairline on any band, a 3:2 well at well radius, the title, the meta line and one line of summary; the text block grows so a row's cards end level. -->
{#let f = entry.fields}
<article class="sites-scheme-paper group relative flex h-full flex-col gap-space-sm rounded-content border border-scheme-border bg-scheme-background p-space-sm text-scheme-foreground { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
  <Well asset={ f.image } alt={ f.image_alt } ratio="aspect-photo" radius="well" width={ 800 } sizes="(min-width: 64rem) 25rem, (min-width: 48rem) 50vw, 85vw" zoom={ true } />
  <div class="flex flex-1 flex-col gap-space-2xs px-space-xs pb-space-xs">
    <h3 class="text-h4 font-semibold"><a class="after:absolute after:inset-0 hover:underline hover:underline-offset-4" href="{ base_path ?? '/explore' }/{ entry.handle }">{ entry.title }</a></h3>
    <ExploreMeta f={ f } />
    {#if f.summary}<p class="text-body-sm text-pretty text-scheme-muted">{ f.summary }</p>{/if}
  </div>
</article>
