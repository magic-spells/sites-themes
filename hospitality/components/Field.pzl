<!-- component: Field -->
<!-- props: name label type required maxlength value error prefix rows autocomplete -->
<!-- A labelled input: the label above, the box on the scheme's input background with its border, ringed in the accent on focus; the error under it, tied by aria-describedby. Name, email and phone are recognised for autocomplete. -->
<div>
  <label class="mb-space-2xs block text-body-sm font-semibold" for="field-{ prefix }-{ name }">{ label }{#if required}<span aria-hidden="true"> *</span>{/if}</label>
  {#if type == 'textarea'}
    <textarea class="block min-h-textarea w-full resize-y rounded-input border bg-scheme-input-background px-space-sm py-space-xs text-body text-scheme-input-foreground placeholder:text-scheme-meta focus:outline-2 focus:outline-offset-2 focus:outline-accent { error ? 'border-scheme-error' : 'border-scheme-input-border' }" id="field-{ prefix }-{ name }" name={ name } rows={ rows ?? 4 } maxlength={ maxlength } required={ required } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ error ? 'error-' + prefix + '-' + name : null }>{ value }</textarea>
  {:else}
    <input class="block min-h-control w-full rounded-input border bg-scheme-input-background px-space-sm text-body text-scheme-input-foreground placeholder:text-scheme-meta focus:outline-2 focus:outline-offset-2 focus:outline-accent { error ? 'border-scheme-error' : 'border-scheme-input-border' }" id="field-{ prefix }-{ name }" name={ name } type={ type ?? 'text' } autocomplete={ autocomplete ?? (type == 'email' ? 'email' : (name == 'name' ? 'name' : (type == 'tel' ? 'tel' : 'off'))) } maxlength={ maxlength } required={ required } value={ value } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ error ? 'error-' + prefix + '-' + name : null } />
  {/if}
  {#if error}<p class="mt-space-2xs text-body-sm text-scheme-error" id="error-{ prefix }-{ name }">{ t('form_field_' + error) }</p>{/if}
</div>
