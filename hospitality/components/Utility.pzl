<!-- component: Utility -->
<!-- props: bare -->
<!-- The utility pages' band on night: the first stay's photo in a tall content-radius well in five parts, the page's own heading, line and action in seven (its children). bare hides the header, footer and panel groups (styles/theme.css). -->
{#let stay = content.stays.entries | sort('fields.order') | first}
<section class="sites-scheme-night flex flex-1 items-center bg-scheme-background px-gutter py-section text-scheme-foreground" data-bare={ bare ? true : null }>
  <div class="mx-auto grid w-full max-w-column items-center gap-space-xl md:grid-cols-picture-text md:gap-space-3xl">
    {#if stay}<div class="max-md:hidden"><Well asset={ stay.fields.image } alt="" ratio="aspect-portrait" width={ 960 } sizes="40vw" eager={ true } /></div>{/if}
    <div class="grid max-w-reading justify-items-start gap-space-md"><Children/></div>
  </div>
</section>
