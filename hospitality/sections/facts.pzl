<!-- The place in short label and value rows from the Place settings (check-in, check-out, open, pets, parking, directions) on hairlines, two columns from 48rem. Empty settings are left out; never counts. -->
{#let
  s = site.settings
  rows = [['check_in', s.check_in], ['check_out', s.check_out], ['open', s.open_season], ['pets', s.pets], ['parking', s.parking], ['directions', s.directions]]
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <dl class="grid gap-x-space-3xl md:grid-flow-col md:grid-cols-2 md:grid-rows-3">
      {#for row in rows}{#if row[1]}<div class="grid gap-space-2xs border-b border-scheme-border py-space-sm"><dt class="text-body-sm text-scheme-meta">{ t('fact.' + row[0]) }</dt><dd class="text-body">{ row[1] }</dd></div>{/if}{/for}
    </dl>
  </div>
</section>

<schema>
{
  "name": "Facts",
  "description": "Check-in, check-out, the season, pets, parking and directions from the Place settings.",
  "kind": "Content",
  "icon": "info",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "paragraph", "content": "The rows come from the Place settings." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
