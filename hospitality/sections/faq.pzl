<!-- Questions and answers as rows that open (components/Questions.pzl) under the head; columns sets two columns of rows from 64rem. -->
{#if blocks.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <Questions items={ blocks } first_open={ settings.first_open } columns={ settings.columns } />
  </div>
</section>
{/if}

<schema>
{
  "name": "FAQ",
  "description": "Questions and answers as rows that open.",
  "kind": "Content",
  "icon": "circle-help",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "checkbox", "id": "first_open", "label": "First answer open", "default": false },
    { "type": "checkbox", "id": "columns", "label": "Two columns on desktop", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "blocks": [
    { "type": "item", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "When can we check in?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>From 3 pm. Check-out is by 11 am.</p>" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Default", "settings": {}, "blocks": [
      { "type": "item", "settings": { "question": "When can we check in?", "answer": "<p>From 3 pm. Check-out is by 11 am, and you are welcome to stay on the dock until you go.</p>" } },
      { "type": "item", "settings": { "question": "Can we bring our dog?", "answer": "<p>Dogs are welcome in the cabins for $25 a night, not in the farmhouse rooms.</p>" } },
      { "type": "item", "settings": { "question": "Is there Wi-Fi?", "answer": "<p>In every cabin and the farmhouse. It is slow by the point, which most people like.</p>" } },
      { "type": "item", "settings": { "question": "Can we have a campfire?", "answer": "<p>In the fire pits only, unless there is a fire ban. We post it at the barn.</p>" } }
    ] }
  ]
}
</schema>
