<!-- The gallery's photos as prints on the band. collage: no rotation, each print at its box in an aspect-ratio stage (the box is its left, top and width as fractions of the stage; its ratio sets its height); up to six photos make the stepped row of five, seven or more the two interlocking rows of seven; phones show a stepped column of five. fan: five prints tilted in an arc, the middle on top. stagger: two tall photos, the second lower, with their caption cards. mosaic: one large photo and four squares. Prints in the collage and the fan drift at their own depths when parallax is on, behind the head. -->
{#let
  all = settings.gallery ? settings.gallery.items : []
  layout = settings.layout
  seven = layout == 'collage' && all.length >= 7
  items = all | slice(0, layout == 'stagger' ? 2 : (seven ? 7 : 5))
  phone = [
    ['aspect-portrait', 'left-0 top-0'],
    ['aspect-3/4', 'left-123/343 top-232/1185'],
    ['aspect-square', 'left-0 top-482/1185'],
    ['aspect-3/4', 'left-123/343 top-659/1185'],
    ['aspect-portrait', 'left-0 top-909/1185'],
    ['', 'max-md:hidden'],
    ['', 'max-md:hidden']
  ]
  wide = seven ? [
    ['md:aspect-photo', 'md:left-0 md:top-0 md:w-13/33'],
    ['md:aspect-3/4', 'md:left-49/132 md:top-2/31 md:w-5/22'],
    ['md:aspect-photo', 'md:left-19/33 md:top-0 md:w-14/33'],
    ['md:aspect-map', 'md:left-1/22 md:top-16/31 md:w-5/22'],
    ['md:aspect-tile', 'md:left-1/4 md:top-19/31 md:w-1/3'],
    ['md:aspect-map', 'md:left-37/66 md:top-35/62 md:w-3/11'],
    ['md:aspect-square', 'md:left-107/132 md:top-69/124 md:w-25/132']
  ] : [
    ['md:aspect-3/4', 'md:left-0 md:top-3/13 md:w-5/22'],
    ['md:aspect-portrait', 'md:left-17/88 md:top-0 md:w-5/22'],
    ['md:aspect-square', 'md:left-17/44 md:top-9/26 md:w-5/22'],
    ['md:aspect-portrait', 'md:left-51/88 md:top-1/13 md:w-5/22'],
    ['md:aspect-3/4', 'md:left-17/22 md:top-3/13 md:w-5/22']
  ]
  fan = [
    ['aspect-3/4', '-rotate-6 md:-rotate-8'],
    ['aspect-portrait', 'z-1 -rotate-3 md:-rotate-4'],
    ['aspect-square', 'z-2'],
    ['aspect-portrait', 'z-1 rotate-3 md:rotate-4'],
    ['aspect-3/4', 'rotate-6 md:rotate-8']
  ]
}
{#if items.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <div class="relative z-10"><SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } /></div>
    {#case layout}
      {:when 'fan'}
        <ul class="flex items-center justify-center py-space-xl">
          {#for item in items, i}<li class="-mx-space-2xl w-7/16 shrink-0 md:-mx-space-xl md:w-5/18 lg:-mx-space-md lg:w-5/22 { fan[i][1] }" data-parallax={ settings.parallax ? 0.02 + i % 3 * 0.03 : null }><Well asset={ item.asset } alt={ item.alt } ratio={ fan[i][0] } edge={ true } width={ 640 } sizes="(min-width: 64rem) 22vw, (min-width: 48rem) 28vw, 44vw" /></li>{/for}
        </ul>
      {:when 'stagger'}
        <ul class="grid gap-space-xl md:grid-cols-2">
          {#for item in items, i}<li class="{ i ? 'max-md:ms-space-xl md:mt-space-3xl' : 'max-md:me-space-xl' }"><Well asset={ item.asset } alt={ item.alt } ratio="aspect-portrait" caption={ item.caption } width={ 960 } sizes="(min-width: 48rem) 50vw, 90vw" /></li>{/for}
        </ul>
      {:when 'mosaic'}
        <ul class="grid grid-cols-2 gap-space-xs md:grid-cols-4">
          {#for item in items, i}<li class="{ i ? '' : 'col-span-2 md:row-span-2' }"><Well asset={ item.asset } alt={ item.alt } ratio={ i ? 'aspect-square' : 'aspect-photo md:aspect-square' } width={ i ? 640 : 1280 } sizes="{ i ? '(min-width: 48rem) 25vw, 50vw' : '(min-width: 48rem) 50vw, 100vw' }" /></li>{/for}
        </ul>
      {:else}
        <ul class="relative aspect-343/1185 { seven ? 'md:aspect-66/31' : 'md:aspect-33/13' }">
          {#for item in items, i}<li class="absolute w-220/343 { phone[i][1] } { wide[i][1] }" data-parallax={ settings.parallax ? 0.02 + i % 3 * 0.03 : null }><Well asset={ item.asset } alt={ item.alt } ratio="{ phone[i][0] } { wide[i][0] }" edge={ true } width={ 800 } sizes="(min-width: 48rem) 40vw, 65vw" /></li>{/for}
        </ul>
    {/case}
  </div>
</section>
{/if}

<schema>
{
  "name": "Gallery collage",
  "description": "A gallery's photos laid out as overlapping prints of mixed sizes.",
  "kind": "Gallery",
  "icon": "images",
  "settings": [
    { "type": "gallery", "id": "gallery", "label": "Gallery", "info": "Reads each item's asset, alt and caption. Collage arranges five or seven." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "collage", "options": [
      { "value": "collage", "label": "Collage" },
      { "value": "fan", "label": "Fan" },
      { "value": "stagger", "label": "Stagger" },
      { "value": "mosaic", "label": "Mosaic" }
    ], "info": "Collage: five prints in a stepped row, or seven in two interlocking rows. Fan: five prints in an arc. Stagger: two tall photos with their captions. Mosaic: one large photo and four small." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The place" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All photos" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/gallery" },
    { "type": "checkbox", "id": "parallax", "label": "Parallax", "default": true, "info": "The collage and fan prints drift a little on scroll. Off for visitors who ask for reduced motion." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "brick" }
  ],
  "presets": [
    { "name": "Collage", "settings": { "layout": "collage", "gallery": "collage", "color_scheme": "brick" } },
    { "name": "Stagger", "settings": { "layout": "stagger", "gallery": "collage", "link_label": "", "color_scheme": "paper" } }
  ]
}
</schema>
