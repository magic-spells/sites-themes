<!-- A 4:5 picture in five parts beside a heading, text and an outlined button in seven. picture sets its side; edge slant cuts the picture's inner edge at 12° with a wedge of the band's own colour; the caption card sits over its outer corner. -->
{#let right = settings.picture == 'right'}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:gap-space-3xl { right ? 'md:grid-cols-text-picture' : 'md:grid-cols-picture-text' }">
    <div class="{ right ? 'md:order-last' : '' }">
      <Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-portrait" caption={ settings.caption_card ? settings.caption : '' } caption_meta={ settings.caption_meta } width={ 1200 } sizes="(min-width: 48rem) 40vw, 100vw">{#if settings.edge == 'slant'}<svg class="absolute inset-y-0 hidden h-full w-4/15 text-scheme-background md:block { right ? '-left-px -scale-x-100' : '-right-px' }" viewBox="0 0 27 100" preserveAspectRatio="none" aria-hidden="true"><path d="M27 0V100H0Z" fill="currentColor"/></svg>{/if}</Well>
    </div>
    <div class="grid justify-items-start gap-space-md">
      <h2 class="text-h2 font-semibold text-balance text-scheme-heading"><Accent text={ settings.heading } rise={ true } /></h2>
      {#if settings.body}<div class="sites-prose text-scheme-muted">{ settings.body }</div>{/if}
      {#if settings.link_label && settings.link_href}<Button href={ settings.link_href } tone="secondary">{ settings.link_label }</Button>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Image with text",
  "description": "A picture beside a heading, text and a button, with a straight or slanted edge.",
  "kind": "Content",
  "icon": "image",
  "settings": [
    { "type": "image", "id": "image", "label": "Picture", "info": "4:5." },
    { "type": "text", "id": "image_alt", "label": "Picture alt text", "default": "" },
    { "type": "select", "id": "picture", "label": "Picture", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "edge", "label": "Edge", "default": "straight", "options": [
      { "value": "straight", "label": "Straight" },
      { "value": "slant", "label": "Slant" }
    ], "info": "Slant cuts the picture's inner edge at an angle, from 48rem." },
    { "type": "checkbox", "id": "caption_card", "label": "Caption card", "default": false },
    { "type": "text", "id": "caption", "label": "Caption title", "default": "The sauna" },
    { "type": "text", "id": "caption_meta", "label": "Caption line", "default": "Open 4–9 pm" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The sauna, by the water" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>A wood-fired cedar sauna on the dock, with the lake three steps away. Book an hour for two or bring the whole cabin.</p>" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Things to do" },
    { "type": "url", "id": "link_href", "label": "Button link", "default": "/explore" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } },
    { "name": "Slant", "settings": { "edge": "slant", "caption_card": true, "color_scheme": "forest" } }
  ]
}
</schema>
