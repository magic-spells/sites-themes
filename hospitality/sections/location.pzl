<!-- Where the place is: the photo on the wide seven parts at 4:3; beside it the address, the directions, the check-in line, the static map (a pin over it) and a link to the map. -->
{#let s = site.settings}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <div class="grid items-start gap-space-xl md:grid-cols-text-picture md:gap-space-3xl">
      <Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-map" width={ 1200 } sizes="(min-width: 48rem) 55vw, 100vw" />
      <div class="grid gap-space-md">
        {#if s.address}<address class="text-body-lg not-italic">{ s.address | newline_to_br }</address>{/if}
        {#if s.directions}<p class="text-body text-scheme-muted">{ s.directions }</p>{/if}
        {#if s.check_in}<p class="text-body-sm text-scheme-meta">{ [t('fact.check_in') + ' ' + s.check_in, s.check_out ? t('fact.check_out') + ' ' + s.check_out : null] | compact | join(' · ') }</p>{/if}
        {#if s.map_image}<a class="block" href={ s.map_url || null } target="_blank" rel="noopener"><Well asset={ s.map_image } alt={ s.map_image_alt || t('map_of', { name: site.name }) } ratio="aspect-tile" width={ 960 } sizes="(min-width: 48rem) 40vw, 100vw"><span class="absolute inset-0 flex items-center justify-center text-accent"><Glyph name="pin" cls="size-glyph" /></span></Well></a>{/if}
        {#if s.map_url}<a class="inline-flex items-center gap-space-xs justify-self-start text-body-sm font-semibold hover:underline hover:underline-offset-4" href="{ s.map_url }" target="_blank" rel="noopener">{ t('open_map') }<span class="text-accent"><Glyph name="arrow-right" /></span></a>{/if}
      </div>
    </div>
  </div>
</section>

<schema>
{
  "name": "Location",
  "description": "The address, directions and check-in times beside a photo, with the static map.",
  "kind": "Content",
  "icon": "map-pin",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where we are" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "image", "id": "image", "label": "Photo", "info": "4:3." },
    { "type": "text", "id": "image_alt", "label": "Photo alt text", "default": "" },
    { "type": "paragraph", "content": "The address, directions, times and the map come from the Place settings." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
