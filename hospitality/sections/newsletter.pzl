<!-- A short sign-up: the heading and a line in seven parts, one email field labelled by its placeholder only and the button in five; stacked on phones. The sent and error states show in place. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-lg md:grid-cols-text-picture md:gap-x-space-3xl">
    <div class="grid gap-space-xs">
      <h2 class="text-h2 font-semibold text-balance text-scheme-heading"><Accent text={ settings.heading } rise={ true } /></h2>
      {#if settings.text}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
    </div>
    <Form handle={ settings.form } class="grid gap-space-xs" id="newsletter-{ section.id }">
      {#if form.sent}
        <p class="text-body-lg" role="status">{ form.success_message || t('form_success') }</p>
      {:else}
        {#let field = form.fields | find('type', 'email')}
        <div class="flex flex-wrap gap-space-xs">
          <input class="min-h-control min-w-0 flex-1 rounded-input border bg-scheme-input-background px-space-md text-body text-scheme-input-foreground placeholder:text-scheme-meta focus:outline-2 focus:outline-offset-2 focus:outline-accent { field && field.error ? 'border-scheme-error' : 'border-scheme-input-border' }" type="email" name={ field ? field.id : 'email' } value={ field ? field.value : null } placeholder="{ settings.placeholder }" aria-label="{ settings.placeholder }" autocomplete="email" required aria-invalid={ field && field.error ? 'true' : 'false' } aria-describedby={ field && field.error ? 'error-newsletter-' + section.id : null } />
          <Button type="submit">{ form.submit_label || settings.button_label }</Button>
        </div>
        {#if field && field.error}<p class="text-body-sm text-scheme-error" id="error-newsletter-{ section.id }">{ t('form_field_' + field.error) }</p>{:else if form.error}<p class="text-body-sm text-scheme-error" role="alert">{ t('form_error') }</p>{/if}
        <noscript><p class="text-body-sm text-scheme-muted">{ t('form_requires_javascript') }</p></noscript>
      {/if}
    </Form>
  </div>
</section>

<schema>
{
  "name": "Newsletter",
  "description": "A heading, a line and one email field.",
  "kind": "Forms",
  "icon": "mail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Letters from the lake" },
    { "type": "text", "id": "text", "label": "Text", "default": "A note every month or so: what's in season, what's open, what we're building." },
    { "type": "form", "id": "form", "label": "Form" },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "forest" }
  ],
  "presets": [
    { "name": "Forest", "settings": { "form": "newsletter", "color_scheme": "forest" } },
    { "name": "Paper", "settings": { "form": "newsletter", "color_scheme": "paper" } }
  ]
}
</schema>
