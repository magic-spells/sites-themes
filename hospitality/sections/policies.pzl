<!-- The policies (house rules, cancellation, privacy) as rows that open (components/Questions.pzl) in the reading column. -->
{#if blocks.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-reading">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <Questions items={ blocks } first_open={ settings.first_open } />
  </div>
</section>
{/if}

<schema>
{
  "name": "Policies",
  "description": "House rules, cancellation and privacy as rows that open.",
  "kind": "Content",
  "icon": "scroll-text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "checkbox", "id": "first_open", "label": "First open", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "blocks": [
    { "type": "item", "name": "Policy", "settings": [
      { "type": "text", "id": "question", "label": "Title", "default": "Cancellation" },
      { "type": "richtext", "id": "answer", "label": "Text", "default": "<p>Free cancellation up to 14 days before arrival; after that the first night is kept.</p>" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Default", "settings": {}, "blocks": [
      { "type": "item", "settings": { "question": "House rules", "answer": "<ul><li>No smoking indoors</li><li>Quiet after 10 pm</li><li>Campfires in the pits only</li><li>Please take your boots off</li></ul>" } },
      { "type": "item", "settings": { "question": "Cancellation", "answer": "<p>Free cancellation up to 14 days before arrival; after that the first night is kept.</p>" } },
      { "type": "item", "settings": { "question": "Privacy", "answer": "<p>We keep your name, email and dates to run your stay, and nothing else.</p>" } }
    ] }
  ]
}
</schema>
