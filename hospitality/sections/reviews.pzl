<!-- What guests say, under a centred head. grid: review cards three, then two across, on phones a row that scrolls and bleeds off the right edge. carousel: one centred quote at a time with the stars and the attribution, page dots under it, round arrows at the stage's sides on hover from 64rem. -->
{#let
  id = 'reviews-' + section.id
  all = content.reviews.entries | sort('fields.order')
  reviews = (settings.featured_only ? all | where('fields.featured') : all) | slice(0, settings.limit)
  options = { slidesPerView: 1, gap: '1.5rem', loop: true, navigation: { showButtons: true, showPagination: true } }
}
{#if reviews.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" id="reviews">
  <div class="mx-auto max-w-column">
    {#if settings.layout == 'carousel'}
      <tarot-carousel class="block" id={ id }>
        <script type="application/json" data-tarot-options>{ options | json }</script>
        <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } centred={ true } />
        <div class="group relative">
          <tarot-viewport><tarot-track>
            {#for entry in reviews}
              {#let f = entry.fields}
              <tarot-slide>
                <figure class="mx-auto grid max-w-reading justify-items-center gap-space-md text-center">
                  {#if f.rating}<p class="flex gap-space-2xs text-accent" role="img" aria-label="{ t('rating', { n: f.rating }) }">{#for n in [1, 2, 3, 4, 5]}<Glyph name={ n <= f.rating ? 'star-filled' : 'star' } />{/for}</p>{/if}
                  <blockquote class="text-h3 font-medium text-balance">{ f.quote }</blockquote>
                  <figcaption class="text-body-sm text-scheme-meta">{ [f.name, f.place] | compact | join(' · ') }{#if f.date} · <Month d={ f.date } />{/if}</figcaption>
                </figure>
              </tarot-slide>
            {/for}
          </tarot-track></tarot-viewport>
          {#if reviews.length > 1}<Arrows wrap="pointer-events-none absolute *:pointer-events-auto inset-0 hidden items-center justify-between opacity-0 transition-opacity duration-fast group-hover:opacity-100 has-focus-visible:opacity-100 lg:flex" />{/if}
        </div>
      </tarot-carousel>
    {:else}
      <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } centred={ true } />
      <ul class="grid items-stretch gap-space-md max-md:-me-gutter max-md:flex max-md:snap-x max-md:snap-mandatory max-md:overflow-x-auto max-md:pe-gutter md:grid-cols-2 lg:grid-cols-3">
        {#for entry in reviews}<li class="max-md:w-stay-card max-md:shrink-0 max-md:snap-start"><ReviewCard entry={ entry } /></li>{/for}
      </ul>
    {/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Reviews",
  "description": "What guests say: a grid of cards, or one quote at a time.",
  "kind": "Social proof",
  "icon": "quote",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [
      { "value": "grid", "label": "Grid" },
      { "value": "carousel", "label": "Carousel" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "What people say after a week on the lake." },
    { "type": "checkbox", "id": "featured_only", "label": "Featured only", "default": false },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/about#reviews" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "forest" }
  ],
  "presets": [
    { "name": "Grid", "settings": { "layout": "grid", "color_scheme": "forest" } },
    { "name": "Carousel", "settings": { "layout": "carousel", "color_scheme": "forest" } }
  ]
}
</schema>
