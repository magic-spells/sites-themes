<!-- D5 supplies the section markup against this frozen schema. -->
<section class="bg-scheme-background text-scheme-foreground"></section>

<schema>
{
  "name": "Announcement bar",
  "description": "A short notice and optional link, remembered when dismissed.",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Road closed at the mill bridge"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Latest stories"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/news"
    },
    {
      "type": "text",
      "id": "key",
      "label": "Remember key",
      "default": "ledger-announcement-2026-10",
      "info": "Change this to show the announcement again after dismissal."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "ink"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "text": "Road closed at the mill bridge",
        "link_label": "Latest stories",
        "link": "/news",
        "key": "ledger-announcement-2026-10",
        "color_scheme": "ink"
      }
    }
  ]
}
</schema>
