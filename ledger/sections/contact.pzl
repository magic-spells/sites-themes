<!-- The tips desk: a kicker, heading and text over the newsroom's contact
     details (from the Contact site settings) on the left, the site form on
     the right with its fields on the second surface. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-x-gap-lg gap-y-step-xl md:grid-cols-2">
    <div class="grid gap-step-md">
      {#if settings.show_heading}
        <p class="font-body text-kicker font-semibold text-scheme-links uppercase">{ t('contact_kicker') }</p>
        <h2 class="font-heading text-h2 font-bold text-pretty text-scheme-heading">{ settings.heading }</h2>
      {/if}
      {#if settings.text}<p class="text-body text-pretty">{ settings.text }</p>{/if}
      {#if settings.show_details && (site.settings.contact_email || site.settings.address || site.settings.hours)}
        <dl class="grid gap-step-md border-t border-scheme-rule pt-step-md">
          {#if site.settings.contact_email}
            <div class="grid gap-step-2xs" id="tips">
              <dt class="font-body text-kicker font-semibold text-scheme-meta uppercase">{ t('label_tips') }</dt>
              <dd class="text-body"><a class="decoration-1 underline-offset-4 hover:text-scheme-links hover:underline" href="mailto:{ site.settings.contact_email }">{ site.settings.contact_email }</a></dd>
            </div>
          {/if}
          {#if site.settings.address}
            <div class="grid gap-step-2xs">
              <dt class="font-body text-kicker font-semibold text-scheme-meta uppercase">{ t('label_post') }</dt>
              <dd class="text-body whitespace-pre-line">{ site.settings.address }</dd>
            </div>
          {/if}
          {#if site.settings.hours}
            <div class="grid gap-step-2xs">
              <dt class="font-body text-kicker font-semibold text-scheme-meta uppercase">{ t('label_hours') }</dt>
              <dd class="text-body">{ site.settings.hours }</dd>
            </div>
          {/if}
        </dl>
      {/if}
    </div>

    <!-- The site owns the fields; this theme chooses their markup. -->
    <Form handle={ settings.form } class="grid gap-step-sm" aria-label="{ settings.heading }">
      {#if form.sent}
        <p class="text-body-lg font-semibold text-scheme-heading" role="status">{ form.success_message }</p>
      {:else}
        {#for field in form.fields}
          <Field name={ field.id } label={ field.label } type={ field.type } autocomplete={ null }
            rows={ 3 } maxlength={ field.max_length } required={ field.required }
            options={ field.options } value={ field.value } error={ field.error }
            placeholder={ field.label } prefix={ section.id } wrapper_class="" filled={ true } />
        {/for}
        {#if form.error}
          <p class="font-mono text-meta text-scheme-error" role="alert">{ t(form.error == 'expired' ? 'form_field_expired' : 'form_error') }</p>
        {/if}
        <div class="grid justify-items-start gap-step-xs">
          <button class="sites-button min-w-35" type="submit">{ form.submit_label }</button>
          <noscript><p class="font-mono text-meta text-scheme-meta">{ t('form_requires_javascript') }</p></noscript>
          {#if settings.note}<p class="font-mono text-meta text-scheme-meta">{ settings.note }</p>{/if}
        </div>
      {/if}
    </Form>
  </div>
</section>

<schema>
{
  "name": "Contact form",
  "description": "A contact form with optional heading and site contact details.",
  "kind": "Contact",
  "icon": "mail",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Send us a story"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show the heading",
      "default": true
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Seen something the valley should know about? Write to the newsroom. We read everything, and we protect our sources."
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show the postal address and reply hours",
      "default": true
    },
    {
      "type": "form",
      "id": "form",
      "label": "Form",
      "default": "contact"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the button",
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Send us a story",
        "show_heading": true,
        "text": "Seen something the valley should know about? Write to the newsroom. We read everything, and we protect our sources.",
        "show_details": true,
        "form": "contact",
        "note": "",
        "color_scheme": "paper"
      }
    }
  ]
}
</schema>
