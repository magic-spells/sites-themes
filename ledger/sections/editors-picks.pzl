<!-- D5 supplies the section markup against this frozen schema. -->
<section class="bg-scheme-background text-scheme-foreground"></section>

<schema>
{
  "name": "Editor's picks",
  "description": "Selected stories in a Tarot carousel. On mobile retain the left gutter, remove the right gutter and let the next card peek.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Editor's picks"
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Index path",
      "default": "/news"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "info": "Arrows appear from tablet up; mobile uses swipe with the right edge bleeding to the viewport.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "ink"
    }
  ],
  "blocks": [
    {
      "type": "pick",
      "name": "Pick",
      "settings": [
        {
          "type": "entry",
          "id": "entry",
          "label": "Story",
          "info": "Uses posts fields topic, date, author, reading_minutes, standfirst, image, image_alt and body; image_credit, updated and key_facts are optional. Dates are calendar dates, never relative times."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Editor's picks",
        "base_path": "/news",
        "show_arrows": true,
        "color_scheme": "ink"
      },
      "blocks": [
        {
          "type": "pick",
          "settings": {}
        },
        {
          "type": "pick",
          "settings": {}
        },
        {
          "type": "pick",
          "settings": {}
        },
        {
          "type": "pick",
          "settings": {}
        },
        {
          "type": "pick",
          "settings": {}
        }
      ]
    }
  ]
}
</schema>
