<!-- D5 supplies the section markup against this frozen schema. -->
<section class="bg-scheme-background text-scheme-foreground"></section>

<schema>
{
  "name": "Feature story",
  "description": "One selected story, with the image on the left or right.",
  "settings": [
    {
      "type": "entry",
      "id": "post",
      "label": "Story",
      "info": "Leave empty to select the newest story in the chosen topic."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Content type",
      "info": "Uses posts fields topic, date, author, reading_minutes, standfirst, image, image_alt and body; image_credit, updated and key_facts are optional. Dates are calendar dates, never relative times."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Index path",
      "default": "/news"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Travel"
    },
    {
      "type": "text",
      "id": "topic",
      "label": "Topic",
      "info": "Exact fields.topic match for automatic selection.",
      "default": ""
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show the picture",
      "default": true
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Read link label",
      "default": "Read the story"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Image Left",
      "settings": {
        "base_path": "/news",
        "heading": "Travel",
        "topic": "",
        "image_position": "left",
        "show_image": true,
        "read_label": "Read the story",
        "color_scheme": "paper",
        "collection": "posts"
      }
    },
    {
      "name": "Image Right",
      "settings": {
        "base_path": "/news",
        "heading": "Travel",
        "topic": "",
        "image_position": "right",
        "show_image": true,
        "read_label": "Read the story",
        "color_scheme": "paper",
        "collection": "posts"
      }
    }
  ]
}
</schema>
