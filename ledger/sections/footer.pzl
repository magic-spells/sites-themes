<!-- Brand, Topics and About: the wordmark and tagline take the free width,
     the two menus sit at the right edge (under the brand on a phone). A 3px
     rule across the top, the copyright and social links under a hairline. -->
<footer class="border-t-3 border-scheme-rule-strong bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-gap-lg">
    <div class="flex flex-wrap gap-gap-lg">
      <div class="grid w-full content-start gap-step-sm md:w-auto md:flex-1">
        <a class="justify-self-start font-heading text-h3 font-bold text-scheme-heading uppercase" href="/">{ site.name }</a>
        {#if site.settings.tagline}<p class="max-w-brand text-body-sm text-pretty text-scheme-muted">{ site.settings.tagline }</p>{/if}
      </div>
      {#for menu in [settings.menu_primary, settings.menu_secondary]}
        {#if menu.items.length}
          <nav class="grid min-w-footer-menu content-start gap-step-sm" aria-label="{ menu.title }">
            <h2 class="font-body text-kicker font-semibold text-scheme-muted uppercase">{ menu.title }</h2>
            <ul class="grid gap-step-sm">
              {#for item in menu.items}
                <li><a class="text-body text-scheme-heading decoration-1 underline-offset-4 hover:text-scheme-links hover:underline" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null } aria-current={ menu.title == settings.menu_secondary.title && item.active && !contains(item.href, '#') && (menu.items | find('active', true)).label == item.label ? 'page' : null }>{ item.label }</a></li>
              {/for}
            </ul>
          </nav>
        {/if}
      {/for}
    </div>

    <div class="flex flex-wrap items-start justify-between gap-x-step-md gap-y-step-xs border-t border-scheme-rule pt-step-md font-mono text-meta text-scheme-muted">
      <p>{ settings.copyright }</p>
      {#if blocks.length}
        <ul class="flex flex-wrap" aria-label="{ t('social_links') }">
          {#for block in blocks, i}
            <li data-block={ block.editor_id }>{#if i > 0}<span class="whitespace-pre" aria-hidden="true"> · </span>{/if}<a class="hover:text-scheme-links" href="{ block.settings.url }">{ block.settings.label }</a></li>
          {/for}
        </ul>
      {/if}
    </div>
  </div>
</footer>

<schema>
{
  "name": "Footer",
  "description": "Brand, Topics and About columns, a strong top rule and social links; no signup form.",
  "kind": "Footer",
  "icon": "panel-bottom",
  "settings": [
    {
      "type": "menu",
      "id": "menu_primary",
      "label": "Topics menu"
    },
    {
      "type": "menu",
      "id": "menu_secondary",
      "label": "About menu"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "default": "© 2026 The Daily Ledger"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "RSS"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Default",
      "settings": {
        "copyright": "© 2026 The Daily Ledger",
        "color_scheme": "paper",
        "menu_primary": "topics",
        "menu_secondary": "about"
      },
      "blocks": [
        {
          "type": "social",
          "settings": {
            "label": "RSS",
            "url": "https://dailyledger.example/feed.xml"
          }
        },
        {
          "type": "social",
          "settings": {
            "label": "Instagram",
            "url": "https://www.instagram.com/"
          }
        },
        {
          "type": "social",
          "settings": {
            "label": "Email",
            "url": "mailto:tips@example.com"
          }
        }
      ]
    }
  ]
}
</schema>
