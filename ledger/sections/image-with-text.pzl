{#let
  ratio = settings.ratio == 'landscape' ? 'aspect-3/2' : (settings.ratio == 'square' ? 'aspect-square' : 'aspect-4/5')
  text_first = settings.layout == 'text_first'
}
<!-- A picture and a column of writing, half the page column each from 48rem.
     The picture comes first on a phone whichever side it takes from 48rem
     up. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-gap-lg md:grid-cols-2">
    <div class="{ text_first ? 'md:order-last' : '' }">
      {#if settings.image}
        { image_tag(settings.image, { class: 'w-full bg-scheme-surface object-cover ' + ratio, sizes: '(min-width: 75rem) 37rem, (min-width: 48rem) 50vw, 100vw', alt: settings.image.alt ?? '' }) }
      {:else}
        <div class="w-full bg-scheme-surface { ratio }"></div>
      {/if}
    </div>
    <div class="grid content-center justify-items-start gap-step-md">
      {#if settings.eyebrow}<p class="font-body text-kicker font-semibold text-scheme-links uppercase">{ settings.eyebrow }</p>{/if}
      {#if settings.heading}<h2 class="font-heading text-h2 font-bold text-pretty text-scheme-heading">{ settings.heading }</h2>{/if}
      {#if settings.body}<div class="sites-prose text-body text-pretty">{ settings.body }</div>{/if}
      {#if settings.link_label}<Button href="{ settings.link }" tone="primary" wide={ false }>{ settings.link_label }</Button>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Image with text",
  "description": "An image beside a heading and writing; the image comes first on mobile.",
  "kind": "Content",
  "icon": "columns-2",
  "settings": [
    {
      "type": "image",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "default": "landscape",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "landscape",
          "label": "Landscape (3:2)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_first",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Since 1962"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A newsroom above the mill"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Eleven reporters, two photographers and one editor work from the second floor of the old mill, a short walk from the bridge.</p><p>We publish every day and print a weekend edition that still sells out at the station kiosk.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "About the Ledger"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/about"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "ratio": "landscape",
        "layout": "image_first",
        "eyebrow": "Since 1962",
        "heading": "A newsroom above the mill",
        "body": "<p>Eleven reporters, two photographers and one editor work from the second floor of the old mill, a short walk from the bridge.</p><p>We publish every day and print a weekend edition that still sells out at the station kiosk.</p>",
        "link_label": "About the Ledger",
        "link": "/about"
      }
    }
  ]
}
</schema>
