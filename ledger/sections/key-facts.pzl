<!-- D5 supplies the section markup against this frozen schema. -->
<section class="bg-scheme-background text-scheme-foreground"></section>

<schema>
{
  "name": "Key facts",
  "description": "One fact per non-empty line of the current story key_facts field. Hidden when empty; slate on the aside, with an unfilled outer wrapper.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Key numbers"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "slate"
    }
  ],
  "templates": [
    "post"
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Key numbers",
        "color_scheme": "slate"
      }
    }
  ]
}
</schema>
