{#let
  sorted = settings.collection.entries | sort('fields.date') | reverse
  by_topic = settings.topic ? (sorted | where('fields.topic', settings.topic)) : sorted
  pool = settings.exclude_current && page.entry ? (by_topic | reject('handle', page.entry.handle)) : by_topic
  posts = pool | slice(settings.offset ?? 0, settings.limit)
  view_all = settings.view_all_label && settings.view_all_href
  view = settings.layout == 'grid' ? 'grid' : 'list'
  toggle = settings.show_toggle
}
<!-- The latest headlines, newest first: the day in the left column and the
     headline, a hairline between rows. Days only: the page is cached, so no
     time of day, no "ago" and no "updated at" clock. The count and view-all
     link sit in the head when they are on. -->
{#if posts.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" data-view={ toggle ? view : false }>
  <div class="mx-auto grid max-w-column">
    <div class="flex flex-wrap items-baseline justify-between gap-x-step-md gap-y-step-2xs border-t-3 border-scheme-rule-strong py-step-xs">
      <h2 class="font-heading text-h4 font-semibold text-scheme-heading uppercase">{ settings.heading }</h2>
      <div class="flex items-center gap-step-sm">
        {#if settings.show_count}<p class="font-mono text-meta text-scheme-meta">{ t('post_count', { shown: posts.length, total: pool.length }) }</p>{/if}
        {#if view_all}<a class="font-body text-kicker font-semibold text-scheme-links uppercase decoration-1 underline-offset-4 hover:underline" href="{ settings.view_all_href }">{ settings.view_all_label }</a>{/if}
        {#if toggle}<ViewSwitch view={ view } />{/if}
      </div>
    </div>
    {#if toggle || view == 'list'}
      <ul class="view-grid:hidden" data-list>
        {#for entry in posts}<StoryRow entry={ entry } href="{ settings.base_path }/{ entry.handle }" image={ settings.show_images } />{/for}
      </ul>
    {/if}
    {#if toggle || view == 'grid'}
      <ul class="grid gap-gap-md pt-step-sm md:grid-cols-2 { settings.columns == '3' ? 'lg:grid-cols-3' : '' } view-list:hidden" data-grid>
        {#for entry in posts}
          <li><StoryCard entry={ entry } href="{ settings.base_path }/{ entry.handle }" heading="h4" wide={ false } kicker={ true } dek={ false } byline={ true } topic={ false } sizes="(min-width: 75rem) 37rem, (min-width: 48rem) 50vw, 100vw" reveal={ true } /></li>
        {/for}
      </ul>
    {/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Latest list",
  "description": "Latest headlines with calendar dates only; never time of day, relative times or a live clock.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Content type",
      "info": "Uses posts fields topic, date, author, reading_minutes, standfirst, image, image_alt and body; image_credit, updated and key_facts are optional. Dates are calendar dates, never relative times."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Index path",
      "default": "/news",
      "info": "Each entry links to this path plus its handle."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "list",
      "options": [
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show thumbnails in the list",
      "default": false,
      "info": "A small picture beside each row in the list layout."
    },
    {
      "type": "checkbox",
      "id": "show_toggle",
      "label": "Let readers switch between list and grid",
      "default": false,
      "info": "The layout above is the view a reader sees first."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "2",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Stories shown",
      "default": 5,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Skip the newest",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 0
    },
    {
      "type": "text",
      "id": "topic",
      "label": "Topic",
      "default": "",
      "info": "Leave empty for every topic; otherwise match the entry topic exactly."
    },
    {
      "type": "checkbox",
      "id": "exclude_current",
      "label": "Exclude the current story",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show the story count",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View-all label",
      "default": "All stories"
    },
    {
      "type": "url",
      "id": "view_all_href",
      "label": "View-all link",
      "default": "/news"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "slate"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Latest",
        "base_path": "/news",
        "layout": "list",
        "show_images": false,
        "show_toggle": false,
        "columns": "2",
        "limit": 5,
        "offset": 0,
        "topic": "",
        "exclude_current": false,
        "show_count": true,
        "view_all_label": "All stories",
        "view_all_href": "/news",
        "color_scheme": "slate",
        "collection": "posts"
      }
    }
  ]
}
</schema>
