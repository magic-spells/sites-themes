<!-- D5 supplies the section markup against this frozen schema. -->
<section class="bg-scheme-background text-scheme-foreground"></section>

<schema>
{
  "name": "Latest list",
  "description": "Latest headlines with calendar dates only; never time of day, relative times or a live clock.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Content type",
      "info": "Uses posts fields topic, date, author, reading_minutes, standfirst, image, image_alt and body; image_credit, updated and key_facts are optional. Dates are calendar dates, never relative times."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Index path",
      "default": "/news",
      "info": "Each entry links to this path plus its handle."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "list",
      "options": [
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show thumbnails in the list",
      "default": false,
      "info": "A small picture beside each row in the list layout."
    },
    {
      "type": "checkbox",
      "id": "show_toggle",
      "label": "Let readers switch between list and grid",
      "default": false,
      "info": "The layout above is the view a reader sees first."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "2",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Stories shown",
      "default": 5,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Skip the newest",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 0
    },
    {
      "type": "text",
      "id": "topic",
      "label": "Topic",
      "default": "",
      "info": "Leave empty for every topic; otherwise match the entry topic exactly."
    },
    {
      "type": "checkbox",
      "id": "exclude_current",
      "label": "Exclude the current story",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show the story count",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View-all label",
      "default": "All stories"
    },
    {
      "type": "url",
      "id": "view_all_href",
      "label": "View-all link",
      "default": "/news"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "slate"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Latest",
        "base_path": "/news",
        "layout": "list",
        "show_images": false,
        "show_toggle": false,
        "columns": "2",
        "limit": 5,
        "offset": 0,
        "topic": "",
        "exclude_current": false,
        "show_count": true,
        "view_all_label": "All stories",
        "view_all_href": "/news",
        "color_scheme": "slate",
        "collection": "posts"
      }
    }
  ]
}
</schema>
