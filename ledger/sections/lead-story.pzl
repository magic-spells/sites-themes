{#let
  sorted = settings.collection.entries | sort('fields.date') | reverse
  lead = settings.post ?? (sorted | first)
  href = settings.base_path + '/' + lead.handle
  image = settings.show_image ? lead.fields.image : null
  credit = lead.fields.image_credit
  short_credit = credit && contains(credit, 'Photo:') ? 'Photo:' + (credit | split('Photo:') | last) : credit
  with_pictures = sorted | where('fields.image') | reject('handle', lead.handle)
  rail = settings.show_rail ? (with_pictures | slice(0, settings.rail_limit)) : []
}
<!-- The lead story and its rail. The rail's thumbnails need pictures, so it
     takes the newest stories that have one, after the lead. At desktop the
     lead takes 46rem and the rail 28rem; at tablet they split the column; on
     a phone the rail follows the lead, without its rule. The first section
     on a page carries the page's h1, and a hidden h2 heads the rail so the
     outline does not skip to its h3 rows. Nothing here reveals on scroll: it is
     the first screen. -->
{#if lead}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-gap-lg { rail.length ? 'md:grid-cols-2 lg:grid-cols-lead lg:justify-between' : '' }">
    <article class="grid content-start gap-step-sm">
      {#if image}
        <a class="relative block aspect-16/10 overflow-hidden bg-scheme-surface" href="{ href }" tabindex="-1" aria-hidden="true">
          <img class="absolute inset-0 size-full object-cover"
            src="{ image_url(image, 1280) }"
            srcset="{ image_url(image, 480) } 480w, { image_url(image, 768) } 768w, { image_url(image, 1024) } 1024w, { image_url(image, 1280) } 1280w, { image_url(image, 1600) } 1600w"
            sizes="(min-width: 64rem) 46rem, (min-width: 48rem) 50vw, 100vw"
            alt="{ lead.fields.image_alt }" loading="eager" fetchpriority="high" width="{ image.width }" height="{ image.height }" />
          {#if short_credit}<span class="absolute right-0 bottom-0 bg-scheme-background px-step-xs py-step-2xs font-mono text-meta text-scheme-muted">{ short_credit }</span>{/if}
        </a>
      {/if}
      <div class="grid gap-step-xs">
        {#if lead.fields.topic}<p class="font-body text-kicker font-semibold text-scheme-links uppercase">{ lead.fields.topic }</p>{/if}
        {#if section.index == 0}
          <h1 class="font-heading text-h1 font-bold text-pretty text-scheme-heading"><a class="decoration-2 underline-offset-4 hover:underline" href="{ href }" aria-label={ settings.read_label ? settings.read_label + ': ' + lead.title : null }>{ lead.title }</a></h1>
        {:else}
          <h2 class="font-heading text-h1 font-bold text-pretty text-scheme-heading"><a class="decoration-2 underline-offset-4 hover:underline" href="{ href }" aria-label={ settings.read_label ? settings.read_label + ': ' + lead.title : null }>{ lead.title }</a></h2>
        {/if}
        {#if lead.fields.standfirst}<p class="text-dek text-pretty text-scheme-muted">{ lead.fields.standfirst }</p>{/if}
        <Byline entry={ lead } author={ true } by={ true } read={ false } />
      </div>
    </article>

    {#if rail.length}
      <div class="flex gap-step-md">
        {#if settings.show_rail_rule}<span class="hidden w-px shrink-0 bg-scheme-rule md:block" aria-hidden="true"></span>{/if}
        <h2 class="sr-only" id="rail-heading-{ section.id }">{ t('more_stories') }</h2>
        <ul class="min-w-0 flex-1" aria-labelledby="rail-heading-{ section.id }">
          {#for entry in rail}
            <li class="border-b border-scheme-rule last:border-b-0">
              <a class="group flex items-start gap-step-sm py-step-sm" href="{ settings.base_path }/{ entry.handle }">
                <div class="grid min-w-0 flex-1 gap-step-2xs">
                  {#if entry.fields.topic}<p class="font-body text-kicker font-semibold text-scheme-links uppercase">{ entry.fields.topic }</p>{/if}
                  <h3 class="font-heading text-h4 font-semibold text-pretty text-scheme-heading decoration-1 underline-offset-4 group-hover:underline">{ entry.title }</h3>
                  <Byline entry={ entry } author={ false } by={ false } read={ false } />
                </div>
                <img class="size-thumb shrink-0 bg-scheme-surface object-cover" src="{ image_url(entry.fields.image, 160, { height: 160 }) }" srcset="{ image_url(entry.fields.image, 160, { height: 160 }) } 1x, { image_url(entry.fields.image, 320, { height: 320 }) } 2x" alt="{ entry.fields.image_alt }" width="64" height="64" />
              </a>
            </li>
          {/for}
        </ul>
      </div>
    {/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Lead story",
  "description": "One lead story and a rail of two to four stories, with square thumbnails.",
  "settings": [
    {
      "type": "entry",
      "id": "post",
      "label": "Lead story",
      "info": "Leave empty to use the newest entry by date."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Content type",
      "info": "Uses posts fields topic, date, author, reading_minutes, standfirst, image, image_alt and body; image_credit, updated and key_facts are optional. Dates are calendar dates, never relative times."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Index path",
      "default": "/news"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show the picture",
      "default": true
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Read link label",
      "default": "Read the story"
    },
    {
      "type": "checkbox",
      "id": "show_rail",
      "label": "Show the story rail",
      "default": true
    },
    {
      "type": "range",
      "id": "rail_limit",
      "label": "Rail stories",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_rail_rule",
      "label": "Show the rail rule",
      "info": "Use a divider between the lead and rail from tablet up; omit on mobile.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "base_path": "/news",
        "show_image": true,
        "read_label": "Read the story",
        "show_rail": true,
        "rail_limit": 4,
        "show_rail_rule": true,
        "color_scheme": "paper",
        "collection": "posts"
      }
    }
  ]
}
</schema>
