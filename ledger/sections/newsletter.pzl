<!-- D5 supplies the section markup against this frozen schema. -->
<section class="bg-scheme-background text-scheme-foreground"></section>

<schema>
{
  "name": "Newsletter",
  "description": "A letter signup with a site-owned form and a short privacy note.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Six stories by seven"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The morning's six stories in your inbox by seven, every weekday. Free."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Unsubscribe in one click. We never share your address."
    },
    {
      "type": "form",
      "id": "form",
      "label": "Form",
      "default": "newsletter"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "ink"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Six stories by seven",
        "text": "The morning's six stories in your inbox by seven, every weekday. Free.",
        "placeholder": "you@example.com",
        "note": "Unsubscribe in one click. We never share your address.",
        "form": "newsletter",
        "color_scheme": "ink"
      }
    }
  ]
}
</schema>
