<!-- D5 supplies the section markup against this frozen schema. -->
<section class="bg-scheme-background text-scheme-foreground"></section>

<schema>
{
  "name": "Page header",
  "description": "A page title and standfirst above a strong bottom rule.",
  "settings": [
    {
      "type": "text",
      "id": "chip",
      "label": "Label",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "text",
      "id": "standfirst",
      "label": "Standfirst",
      "default": "",
      "info": "Leave empty to use the page search description."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "chip": "",
        "heading": "",
        "standfirst": "",
        "align": "left",
        "color_scheme": "paper"
      }
    },
    {
      "name": "Centered",
      "settings": {
        "chip": "",
        "heading": "",
        "standfirst": "",
        "align": "center",
        "color_scheme": "paper"
      }
    }
  ]
}
</schema>
