<!-- D5 supplies the section markup against this frozen schema. -->
<section class="bg-scheme-background text-scheme-foreground"></section>

<schema>
{
  "name": "Rich text",
  "description": "A heading and writing, falling back to the page content when empty.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "",
      "info": "Leave empty to use the page’s own writing."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "",
        "body": "",
        "width": "narrow",
        "color_scheme": "paper"
      }
    },
    {
      "name": "Wide",
      "settings": {
        "heading": "",
        "body": "",
        "width": "wide",
        "color_scheme": "paper"
      }
    }
  ]
}
</schema>
