{#let
  sorted = settings.collection.entries | sort('fields.date') | reverse
  by_topic = settings.topic ? (sorted | where('fields.topic', settings.topic)) : sorted
  pool = settings.exclude_current && page.entry ? (by_topic | reject('handle', page.entry.handle)) : by_topic
  posts = pool | slice(settings.offset ?? 0, settings.limit)
  view_all = settings.view_all_label && settings.view_all_href
  view = settings.layout == 'list' ? 'list' : 'grid'
  toggle = settings.show_toggle
  columns = settings.columns == '2' ? '' : (settings.columns == '3' ? 'lg:grid-cols-3' : 'lg:grid-cols-4')
  card_sizes = settings.columns == '2' ? '(min-width: 75rem) 37rem, (min-width: 48rem) 50vw, 100vw' : (settings.columns == '3' ? '(min-width: 75rem) 24.5rem, (min-width: 48rem) 50vw, 100vw' : '(min-width: 75rem) 18rem, (min-width: 64rem) 25vw, (min-width: 48rem) 50vw, 100vw')
}
<!-- The index body: cards four, two or one across, then the count ("12 of
     21 stories") and an optional view-all link under a hairline. With the
     reader's switch on, both views render and the chosen one shows. Without
     a heading, a hidden h2 keeps the outline from skipping to the cards' h3. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" data-view={ toggle ? view : false }>
  <div class="mx-auto grid max-w-column gap-step-lg">
    {#unless settings.heading}<h2 class="sr-only">{ t('more_stories') }</h2>{/unless}
    {#if settings.heading || toggle}
      <div class="flex items-center justify-between gap-step-sm { settings.heading ? 'border-t-3 border-scheme-rule-strong pt-step-xs' : '' }">
        {#if settings.heading}<h2 class="font-heading text-h4 font-semibold text-scheme-heading uppercase">{ settings.heading }</h2>{/if}
        {#if toggle}<div class="ms-auto"><ViewSwitch view={ view } /></div>{/if}
      </div>
    {/if}
    {#if posts.length == 0}
      <p class="text-body text-scheme-muted">{ t('posts_empty') }</p>
    {:else}
      {#if toggle || view == 'grid'}
        <ul class="grid gap-gap-md md:grid-cols-2 { columns } view-list:hidden" data-grid>
          {#for entry in posts}
            <li><StoryCard entry={ entry } href="{ settings.base_path }/{ entry.handle }" heading="h4" wide={ false } kicker={ true } dek={ false } byline={ true } topic={ false } sizes="{ card_sizes }" reveal={ true } /></li>
          {/for}
        </ul>
      {/if}
      {#if toggle || view == 'list'}
        <ul class="border-t border-scheme-rule view-grid:hidden" data-list>
          {#for entry in posts}<PostRow entry={ entry } href="{ settings.base_path }/{ entry.handle }" image={ settings.show_images } />{/for}
        </ul>
      {/if}
    {/if}
    {#if (settings.show_count && posts.length) || view_all}
      <div class="flex flex-wrap items-baseline justify-between gap-step-sm border-t border-scheme-rule pt-step-sm">
        {#if settings.show_count && posts.length}<p class="font-mono text-meta text-scheme-meta">{ t('post_count', { shown: posts.length, total: pool.length }) }</p>{:else}<span></span>{/if}
        {#if view_all}<a class="font-body text-kicker font-semibold text-scheme-links uppercase decoration-1 underline-offset-4 hover:underline" href="{ settings.view_all_href }">{ settings.view_all_label }</a>{/if}
      </div>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Story grid",
  "description": "Stories in four, two or one columns, with a count and optional view link.",
  "kind": "Collections",
  "icon": "layout-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Content type",
      "info": "Uses posts fields topic, date, author, reading_minutes, standfirst, image, image_alt and body; image_credit, updated and key_facts are optional. Dates are calendar dates, never relative times."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Index path",
      "default": "/news",
      "info": "Each entry links to this path plus its handle."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show thumbnails in the list",
      "default": true,
      "info": "A small picture beside each row in the list layout."
    },
    {
      "type": "checkbox",
      "id": "show_toggle",
      "label": "Let readers switch between list and grid",
      "default": false,
      "info": "The layout above is the view a reader sees first."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        },
        {
          "value": "4",
          "label": "Four"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Stories shown",
      "default": 12,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Skip the newest",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 0
    },
    {
      "type": "text",
      "id": "topic",
      "label": "Topic",
      "default": "",
      "info": "Leave empty for every topic; otherwise match the entry topic exactly."
    },
    {
      "type": "checkbox",
      "id": "exclude_current",
      "label": "Exclude the current story",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show the story count",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View-all label",
      "default": "All stories"
    },
    {
      "type": "url",
      "id": "view_all_href",
      "label": "View-all link",
      "default": "/news"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "",
        "base_path": "/news",
        "layout": "grid",
        "show_images": true,
        "show_toggle": false,
        "columns": "4",
        "limit": 12,
        "offset": 0,
        "topic": "",
        "exclude_current": false,
        "show_count": true,
        "view_all_label": "All stories",
        "view_all_href": "/news",
        "collection": "posts"
      }
    },
    {
      "name": "Index",
      "settings": {
        "heading": "",
        "base_path": "/news",
        "layout": "grid",
        "show_images": true,
        "show_toggle": true,
        "columns": "4",
        "limit": 12,
        "offset": 0,
        "topic": "",
        "exclude_current": false,
        "show_count": true,
        "view_all_label": "",
        "view_all_href": "",
        "collection": "posts"
      }
    }
  ]
}
</schema>
