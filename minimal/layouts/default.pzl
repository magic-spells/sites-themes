<!-- layout: default -->
<html lang="{ site.locale }">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ page.seo.title || page.title } — { site.name }</title>
    {#if page.seo.description}<meta name="description" content="{ page.seo.description }" />{/if}
    {#if page.seo.noindex}<meta name="robots" content="noindex" />{/if}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{ page.seo.title || page.title }" />
    {#if page.seo.description}<meta property="og:description" content="{ page.seo.description }" />{/if}
    {#if page.seo.image}<meta property="og:image" content="{ url(image_url(page.seo.image, 1280)) }" />
    <meta name="twitter:card" content="summary_large_image" />{/if}
    {#if site.settings.favicon}<link rel="icon" type="image/png" href="{ image_url(site.settings.favicon, 160, { height: 160, format: 'png' }) }" />
    {:else}<link rel="icon" type="image/svg+xml" href="{ asset_url('favicon.svg') }" />{/if}
    <Slot name="head-content"/>
  </head>
  <body class="flex min-h-screen flex-col bg-scheme-background font-body text-base text-scheme-foreground antialiased">
    <a class="sr-only focus:not-sr-only focus:absolute focus:m-space-md focus:rounded-md focus:bg-brand-primary focus:px-space-md focus:py-space-sm focus:text-white" href="#content">{ t('skip_to_content') }</a>
    <Slot name="header-group"/>
    <main id="content" class="flex-1"><Slot/></main>
    <Slot name="footer-group"/>
    <Slot name="panel-group"/>
  </body>
</html>
