<section class="bg-scheme-background">
  <div class="mx-auto max-w-3xl px-space-lg py-space-2xl">
    <h1 class="font-heading text-5xl tracking-tight text-balance text-scheme-heading">{ settings.heading }</h1>
    <p class="mt-space-lg max-w-2xl text-xl text-scheme-foreground">{ settings.body }</p>
    {#if blocks.length}
      <div class="mt-space-xl flex flex-wrap gap-space-sm">
        {#for block in blocks}
          <Button href={ block.settings.href } tone={ block.settings.tone } editor_id={ block.editor_id }>{ block.settings.label }</Button>
        {/for}
      </div>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Hero",
  "kind": "Hero",
  "icon": "image",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A new site" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Say what this page is for, in one sentence." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme",
      "info": "The surface this section is rendered on. Schemes are declared in settings/design.json under schemes." }
  ],
  "blocks": [
    { "type": "link", "name": "Link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Read on" },
      { "type": "url", "id": "href", "label": "URL", "default": "/" },
      { "type": "select", "id": "tone", "label": "Tone", "default": "primary",
        "options": [
          { "value": "primary", "label": "Primary" },
          { "value": "secondary", "label": "Secondary" }
        ] }
    ] }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Default",
      "settings": { "heading": "A new site", "body": "Say what this page is for, in one sentence.", "color_scheme": "default" },
      "blocks": [{ "type": "link", "settings": { "label": "Read on", "href": "/about", "tone": "primary" } }] }
  ]
}
</schema>
