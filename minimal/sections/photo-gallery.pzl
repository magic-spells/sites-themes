<section class="bg-scheme-background text-scheme-foreground">
  <div class="mx-auto max-w-5xl px-space-lg py-space-xl">
  {#if settings.heading}
    <h2 class="font-heading text-3xl tracking-tight text-scheme-heading">{ settings.heading }</h2>
  {/if}
  {#if settings.gallery}
    <!-- Whole class names, not built up: Tailwind only generates what it can read. -->
    <ul class="mt-space-lg grid grid-cols-2 gap-space-md { settings.columns == '4' ? 'sm:grid-cols-4' : settings.columns == '2' ? 'sm:grid-cols-2' : 'sm:grid-cols-3' }">
      {#for item in settings.gallery.items}
        <li>
          <figure>
            {#if item.video}
              <video class="aspect-square w-full rounded-md object-cover" controls preload="metadata" src="{ item.asset.url }"></video>
            {:else}
              { image_tag(item.asset, {class: 'aspect-square w-full rounded-md object-cover', alt: item.alt}) }
            {/if}
            {#if item.caption}
              <figcaption class="mt-space-xs text-sm text-scheme-foreground">{ item.caption }</figcaption>
            {/if}
          </figure>
        </li>
      {/for}
    </ul>
  {/if}
  </div>
</section>

<schema>
{
  "name": "Photo gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gallery" },
    { "type": "gallery", "id": "gallery", "label": "Gallery",
      "info": "Pick a gallery; its items render in the order you arranged them." },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default",
      "info": "The surface this section is rendered on. Schemes are declared in settings/design.json under schemes." }
  ],
  "presets": [
    { "name": "Default", "settings": { "heading": "Gallery", "columns": "3", "color_scheme": "default" } }
  ]
}
</schema>
