<section class="bg-scheme-background text-scheme-foreground">
  <div class="mx-auto px-space-lg py-space-xl { settings.width == 'wide' ? 'max-w-5xl' : 'max-w-3xl' }">
    <div class="sites-prose">{ settings.body || page.content }</div>
  </div>
</section>

<schema>
{
  "name": "Rich text",
  "kind": "Content",
  "icon": "align-left",
  "settings": [
    { "type": "richtext", "id": "body", "label": "Body", "default": "",
      "info": "Leave this empty and the section shows the page's own writing." },
    { "type": "select", "id": "width", "label": "Width", "default": "narrow",
      "info": "Narrow keeps a comfortable reading measure.",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "wide", "label": "Wide" }
      ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme",
      "info": "The surface this section is rendered on. Schemes are declared in settings/design.json under schemes." }
  ],
  "presets": [
    { "name": "Default", "settings": { "body": "", "width": "narrow", "color_scheme": "default" } },
    { "name": "Wide", "settings": { "body": "", "width": "wide", "color_scheme": "default" } }
  ]
}
</schema>
