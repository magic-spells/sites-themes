<!-- component: LightboxCompanion -->
<!-- props: items id poster -->
<!-- The lightbox opens from a carousel slide, so a strip, grid or columns renders its photographs again in this visually hidden, inert carousel (inert, not aria-hidden: tarot moves focus into it while it opens the lightbox on the page body); each tile asks theme.ts to open it at its index. A video item opens as a player with its controls. A component holds no <script>, so the section passes the carousel's options block in as its children. -->
<tarot-carousel class="sr-only" id={ id } inert>
  <Children/>
  <tarot-viewport>
    <tarot-track>
      {#for item in items}
        <tarot-slide>
          {#if item.video}
            <video src="{ item.asset.url }" controls playsinline preload="none" poster={ poster ? image_url(poster, 1280) : null } width={ item.asset.width } height={ item.asset.height }><a href="{ item.asset.url }">{ t('open_video') }</a></video>
          {:else}
            <img src="{ image_url(item.asset, 480) }" data-tarot-lightbox-src="{ image_url(item.asset, 2560) }" alt="{ item.alt }" loading="lazy" width={ item.asset.width } height={ item.asset.height } />
          {/if}
          {#if item.caption}<p data-caption data-tarot-lightbox-fade>{ item.caption }</p>{/if}
        </tarot-slide>
      {/for}
    </tarot-track>
  </tarot-viewport>
</tarot-carousel>
