<!-- component: PostRow -->
<!-- props: entry href reveal image -->
<!-- A post as a row on a hairline: an 80 square picture, the place tag over
     the title, and the date over the minutes at the right in mono (under the
     title on a phone). -->
{#let f = entry.fields}
<li class="border-b border-scheme-rule { reveal ? 'reveal reveal-fade-up' : '' }">
  <article class="group relative flex items-center gap-space-md py-space-sm">
    {#if image !== false}<span class="block size-thumb-lg shrink-0 overflow-hidden rounded-sm bg-scheme-surface-2">{#if f.image}<img class="size-full object-cover transition-transform duration-hover ease-out-soft group-hover:scale-hover" data-zoom src="{ image_url(f.image, 160, { height: 160 }) }" alt="" loading="lazy" width="160" height="160" />{/if}</span>{/if}
    <div class="grid flex-1 gap-1 md:flex md:items-center md:justify-between md:gap-space-md">
      <div class="grid gap-1">
        {#if f.place}<PlaceTag place={ f.place } />{/if}
        <h3 class="font-heading text-h4 font-medium text-scheme-heading"><a class="decoration-1 underline-offset-4 after:absolute after:inset-0 hover:underline" href={ href }>{ entry.title }</a></h3>
      </div>
      <p class="flex gap-space-xs font-mono text-meta font-medium text-scheme-meta uppercase md:grid md:shrink-0 md:justify-items-end md:gap-0.5">{#if f.date}<time datetime={ date(f.date, 'iso') }>{ date(f.date) }</time>{/if}{#if f.reading_minutes}<span class="md:hidden" aria-hidden="true">·</span><span>{ t('minutes_short', { count: f.reading_minutes }) }</span>{/if}</p>
    </div>
  </article>
</li>
