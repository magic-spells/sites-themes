{
  "label": "Place",
  "description": "A place: its cover and stamps, its posts, its photographs, what a month cost and its notes.",
  "layout": "default",
  "sections": [
    {
      "id": "s_header",
      "type": "place-header",
      "preset": "Default",
      "settings": {
        "show_facts": true,
        "show_stamps": true,
        "show_local_time": false,
        "color_scheme": "night"
      },
      "blocks": []
    },
    {
      "id": "s_notes",
      "type": "rich-text",
      "preset": "Entry body",
      "settings": {
        "heading": "",
        "source": "entry",
        "width": "reading"
      },
      "blocks": []
    },
    {
      "id": "s_posts",
      "type": "post-list",
      "preset": "From this place",
      "settings": {
        "heading": "From {place}",
        "collection": "posts",
        "scope": "current_place",
        "layout": "grid",
        "featured_first": false,
        "columns": "2",
        "limit": 6,
        "view_all_label": ""
      },
      "blocks": []
    },
    {
      "id": "s_photos",
      "type": "gallery",
      "preset": "Place photos",
      "settings": {
        "source": "entry",
        "heading": "",
        "layout": "carousel",
        "height": "medium",
        "show_captions": true,
        "link_label": "",
        "link": ""
      },
      "blocks": []
    },
    {
      "id": "s_costs",
      "type": "cost-table",
      "preset": "Place",
      "settings": {
        "scope": "place",
        "heading": "What a month here cost",
        "show_notes": true
      },
      "blocks": []
    },
    {
      "id": "s_newsletter",
      "type": "newsletter",
      "preset": "Postcards",
      "settings": {
        "heading": "Postcards from the road",
        "text": "One email when I move, with what the last place cost. About once a month.",
        "placeholder": "Your email",
        "proof": "",
        "note": "No tracking pixels. Unsubscribe in one click.",
        "form": "newsletter",
        "color_scheme": "dusk"
      },
      "blocks": []
    }
  ]
}