<!-- What a month here cost (Figma): one box at 50rem, at the column's left edge (centred on a post, by setting), a ticket strip for its head (the month as a box stamp, the place, the currency code), then the rows on surface-2 on hairlines, from 48rem one line of three columns as in Figma (the category, its note in muted, never meta on surface-2, the amount in mono at the right), on a phone the amount on the category's line and the note across the box under it; at most 12 rows; the total from sum on a heavier rule. A place shows its latest month; a post shows the costs that point at it. Renders nothing when there are no rows. -->
{#let
  entry = page.entry
  all = content.costs.entries
  scoped = settings.scope == 'post' ? (all | where('fields.post.handle', entry.handle)) : (all | where('fields.place.handle', entry.handle))
  month = (scoped | sort('fields.month') | last).fields.month
  month_rows = scoped | where('fields.month', month)
  rows = month_rows | slice(0, 12)
  first_row = month_rows | first
  place = first_row.fields.place
  currency = first_row.fields.currency
  total = sum(month_rows, 'fields.amount')
}
{#if entry && rows.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" aria-labelledby="{ section.id }-title">
  <div class="mx-auto max-w-column"><div class="grid max-w-table gap-space-md { settings.align == 'center' ? 'mx-auto' : '' }">
    <h2 class="font-heading text-h2 font-semibold text-scheme-heading" id="{ section.id }-title">{ settings.heading }</h2>
    <div class="overflow-hidden rounded-lg">
      <div class="flex items-center gap-space-md bg-tag px-space-lg py-space-sm text-tag-ink ticket-notch-ends">
        <DateStamp value={ month } month={ true } />
        <p class="flex-1 font-heading text-h4 font-medium">{#if place}{ place.title }{#if place.fields.country}, { place.fields.country }{/if}{/if}</p>
        <p class="font-mono text-meta font-medium uppercase">{ currency }</p>
      </div>
      <table class="w-full bg-scheme-surface-2 text-left">
        <caption class="sr-only">{ settings.heading } · { date(month) | slice(0, 3) } { date(month, 'iso') | slice(0, 4) }</caption>
        <thead class="sr-only"><tr><th scope="col">{ t('cost_category') }</th>{#if settings.show_notes}<th class="hidden md:table-cell" scope="col">{ t('cost_note') }</th>{/if}<th scope="col">{ t('cost_amount') }</th></tr></thead>
        <tbody>
          {#for row in rows}
            <tr class="border-b border-scheme-rule">
              <th class="py-space-sm ps-space-lg pe-space-lg text-left align-top font-normal md:pe-space-md md:align-baseline md:whitespace-nowrap" scope="row">
                <span class="flex items-baseline justify-between gap-space-md text-body text-scheme-foreground"><span>{ t('cost.' + row.fields.category) }</span><span class="font-mono whitespace-nowrap tabular-nums md:hidden">{ row.fields.amount | number_with_delimiter }</span></span>
                {#if settings.show_notes && row.fields.note}<span class="block text-body-sm text-scheme-muted md:hidden">{ row.fields.note }</span>{/if}
              </th>
              {#if settings.show_notes}<td class="hidden w-full py-space-sm pe-space-md align-baseline text-body-sm text-scheme-muted md:table-cell">{ row.fields.note }</td>{/if}
              <td class="hidden py-space-sm ps-space-md pe-space-lg text-right align-baseline font-mono text-body whitespace-nowrap text-scheme-foreground tabular-nums md:table-cell">{ row.fields.amount | number_with_delimiter }</td>
            </tr>
          {/for}
        </tbody>
        <tfoot>
          <tr class="border-t-2 border-scheme-foreground">
            <th class="py-space-md ps-space-lg pe-space-lg text-left font-heading text-h5 font-medium md:pe-space-md" scope="row"><span class="flex items-baseline justify-between gap-space-md"><span>{ t('total') }</span><span class="font-mono text-body font-medium whitespace-nowrap tabular-nums md:hidden">{ total | number_with_delimiter } { currency }</span></span></th>
            {#if settings.show_notes}<td class="hidden md:table-cell"></td>{/if}
            <td class="hidden py-space-md ps-space-md pe-space-lg text-right whitespace-nowrap font-mono text-body font-medium tabular-nums md:table-cell">
{ total | number_with_delimiter } { currency }</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div></div>
</section>
{/if}

<schema>
{
  "name": "Cost table",
  "description": "What a month cost: a ticket-headed table of rent, coworking, food and the rest, with its total.",
  "kind": "Content",
  "icon": "receipt",
  "templates": ["place", "post"],
  "settings": [
    { "type": "select", "id": "scope", "label": "Costs of", "default": "place", "options": [ { "value": "place", "label": "This place (its latest month)" }, { "value": "post", "label": "This post" } ], "info": "Reads costs entries: place, post, month (the 1st), category, amount, currency, note. Hidden when there are none." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What a month here cost" },
    { "type": "checkbox", "id": "show_notes", "label": "Show the notes", "default": true },
    { "type": "select", "id": "align", "label": "Align", "default": "left", "options": [ { "value": "left", "label": "At the column's edge" }, { "value": "center", "label": "Centred (a post's reading column)" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Place", "settings": { "scope": "place", "heading": "What a month here cost", "show_notes": true, "align": "left" } },
    { "name": "Post", "settings": { "scope": "post", "heading": "What a month here cost", "show_notes": true, "align": "center" } }

  ]
}
</schema>
