<!-- Galleries, in four layouts. Carousel: a tarot carousel of equal-width slides (Cory: "the image carousels need to have the same width. they can all either be different heights or cropped to 1/1 or a different setting"): 1.2 across on a phone, 2.5 from 48rem, 3.2 from 64rem and 4 from 80rem, starting at the column edge and bleeding off the right; slide_ratio crops each well to 1:1, 4:3 or 3:2, or natural keeps each photograph's height, top-aligned. The head's arrows drive it. Grid: 3:2 tiles, 3 / 2 / 1 across. Columns: natural ratios in CSS columns. One-up: a tarot carousel of 3:2 frames with a caption and a "04 / 12" counter, the next frame peeking on a phone. Every layout opens the tarot lightbox (strip, grid and columns through a hidden companion carousel). Video items loop muted with a LOOP badge, started by theme.ts in view and never under reduced motion. The heading row and its rule stay inside the gutters. -->
{#let
  gallery = settings.source == 'entry' ? page.entry.fields.photos : settings.gallery
  items = (gallery.items ?? []) | slice(0, 12)
  cover = (items | reject('video') | first).asset
  id = 'gallery-' + section.id
  lb = 'lightbox-' + section.id
  layout = settings.layout
  heading = settings.heading || gallery.title
  ratio = settings.slide_ratio ?? 'square'
  well = ratio == 'landscape' ? 'aspect-4/3' : (ratio == 'wide' ? 'aspect-3/2' : (ratio == 'natural' ? '' : 'aspect-square'))
  strip = { lightbox: false, slidesPerView: 1.2, gap: '1rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: true, showPagination: false }, breakpoints: { '768': { slidesPerView: 2.5, gap: '1.5rem' }, '1024': { slidesPerView: 3.2, gap: '1.5rem' }, '1280': { slidesPerView: 4, gap: '1.5rem' } } }
  companion = { lightbox: true, navigation: { showButtons: false, showPagination: false } }
  oneup = { lightbox: true, slidesPerView: 1.15, gap: '1rem', paddingLeft: '1rem', paddingRight: 0, navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { lightbox: true, slidesPerView: 1, gap: '1.5rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: true, showPagination: false } } } }
  caption_class = 'font-mono text-coord text-scheme-meta'
}
{#if items.length}
<section class="bg-scheme-background py-section text-scheme-foreground" aria-labelledby={ heading ? id + '-title' : null } aria-label={ heading ? null : t('photos') }>
  {#if layout == 'one-up'}
    <div class="md:px-gutter"><tarot-carousel class="mx-auto block max-w-panel" id={ id } data-track="frames">
      <script type="application/json" data-tarot-options>{ oneup | json }</script>
      <div class="mb-space-md px-gutter md:px-0">
        <SectionHead heading={ heading } id="{ id }-title" link_label={ settings.link_label } link={ settings.link } rule={ true }><div slot="actions" class="flex shrink-0 items-center gap-space-md"><p class="font-mono text-coord text-scheme-meta tabular-nums" data-counter-for={ id }><span data-counter-index>01</span> / { items.length < 10 ? '0' : '' }{ items.length }</p><Arrows /></div></SectionHead>
      </div>
      <tarot-viewport>
        <tarot-track>
          {#for item in items, i}
            <tarot-slide>
              <figure class="grid gap-space-xs">
                {#if item.video}
                  <div class="relative aspect-3/2 overflow-hidden rounded-sm bg-scheme-surface-2"><GalleryMedia item={ item } fit="cover" poster={ cover } /></div>
                {:else}
                  <a class="block aspect-3/2 cursor-zoom-in overflow-hidden rounded-sm bg-scheme-surface-2" href="{ image_url(item.asset, 2560) }" data-tarot-lightbox aria-label="{ t('open_photo', { index: i + 1 }) }"><img class="size-full object-cover" src="{ image_url(item.asset, 1280) }" srcset="{ image_srcset(item.asset, [640, 1024, 1280, 1600, 2000]) }" sizes="(min-width: 60rem) 60rem, 90vw" data-tarot-lightbox-src="{ image_url(item.asset, 2560) }" alt="{ item.alt }" loading={ i == 0 ? 'eager' : 'lazy' } width={ item.asset.width } height={ item.asset.height } /></a>
                {/if}
                {#if settings.show_captions && item.caption}<figcaption class="text-body-sm text-scheme-muted" data-caption data-tarot-lightbox-fade>{ item.caption }</figcaption>{/if}
              </figure>
            </tarot-slide>
          {/for}
        </tarot-track>
      </tarot-viewport>
    </tarot-carousel></div>
  {:else if layout == 'carousel'}
    <tarot-carousel class="block" id={ id } data-track="photos">
      <script type="application/json" data-tarot-options>{ strip | json }</script>
      <div class="px-gutter"><div class="mx-auto mb-space-md max-w-column">
        <SectionHead heading={ heading } id="{ id }-title" link_label={ settings.link_label } link={ settings.link } rule={ true }><Arrows slot="actions" /></SectionHead>
      </div></div>
      <div class="ps-gutter md:ps-edge">
        <tarot-viewport>
          <tarot-track>
            {#for item in items, i}
              <tarot-slide>
                <figure class="grid gap-space-xs">
                  <button class="group relative block w-full overflow-hidden rounded-sm bg-scheme-surface-2 { well }" type="button" data-lightbox-open={ lb } data-index="{ i }" aria-label="{ t('open_photo', { index: i + 1 }) }">
                    <GalleryMedia item={ item } fit={ ratio == 'natural' ? 'natural' : 'cover' } sizes="(min-width: 80rem) 25vw, (min-width: 48rem) 40vw, 80vw" eager={ i < 2 } poster={ cover } zoom={ true } />
                  </button>
                  {#if settings.show_captions && item.caption}<figcaption class={ caption_class }>{ item.caption }</figcaption>{/if}
                </figure>
              </tarot-slide>
            {/for}
          </tarot-track>
        </tarot-viewport>
      </div>
    </tarot-carousel>
    <LightboxCompanion id={ lb } items={ items } poster={ cover }><script type="application/json" data-tarot-options>{ companion | json }</script></LightboxCompanion>
  {:else}
    <div class="px-gutter"><div class="mx-auto mb-space-md max-w-column">
      <SectionHead heading={ heading } id="{ id }-title" link_label={ settings.link_label } link={ settings.link } rule={ true } />
    </div></div>
    {#if layout == 'grid'}
      <div class="px-gutter"><ul class="mx-auto grid max-w-column gap-space-md md:grid-cols-2 lg:grid-cols-3">
        {#for item in items, i}
          <li class="{ site.settings.reveal_on_scroll ? 'reveal reveal-fade-up' : '' }">
            <figure class="grid gap-space-xs">
              <button class="group relative block aspect-3/2 w-full overflow-hidden rounded-sm bg-scheme-surface-2" type="button" data-lightbox-open={ lb } data-index="{ i }" aria-label="{ t('open_photo', { index: i + 1 }) }">
                <GalleryMedia item={ item } fit="cover" sizes="(min-width: 64rem) 26rem, (min-width: 48rem) 45vw, 100vw" poster={ cover } zoom={ true } />
              </button>
              {#if settings.show_captions && item.caption}<figcaption class={ caption_class }>{ item.caption }</figcaption>{/if}
            </figure>
          </li>
        {/for}
      </ul></div>
    {:else}
      <div class="px-gutter"><ul class="mx-auto max-w-column columns-1 gap-space-md md:columns-2 lg:columns-3">
        {#for item in items, i}
          <li class="mb-space-md break-inside-avoid { site.settings.reveal_on_scroll ? 'reveal reveal-fade-up' : '' }">
            <figure class="grid gap-space-xs">
              <button class="group relative block w-full overflow-hidden rounded-sm bg-scheme-surface-2" type="button" data-lightbox-open={ lb } data-index="{ i }" aria-label="{ t('open_photo', { index: i + 1 }) }">
                <GalleryMedia item={ item } fit="natural" sizes="(min-width: 64rem) 26rem, (min-width: 48rem) 45vw, 100vw" poster={ cover } zoom={ true } />
              </button>
              {#if settings.show_captions && item.caption}<figcaption class={ caption_class }>{ item.caption }</figcaption>{/if}
            </figure>
          </li>
        {/for}
      </ul></div>
    {/if}
    <LightboxCompanion id={ lb } items={ items } poster={ cover }><script type="application/json" data-tarot-options>{ companion | json }</script></LightboxCompanion>
  {/if}
</section>
{/if}

<schema>
{
  "name": "Gallery",
  "description": "A gallery as a bleeding strip, an even grid, ragged columns or a one-up carousel. Every layout opens the lightbox.",
  "kind": "Content",
  "icon": "images",
  "settings": [
    { "type": "select", "id": "source", "label": "Photographs from", "default": "setting", "options": [ { "value": "setting", "label": "The gallery chosen below" }, { "value": "entry", "label": "The page's own photos" } ], "info": "The page's own photos: the photos gallery field of the post or place the page shows." },
    { "type": "gallery", "id": "gallery", "label": "Gallery", "info": "Reads gallery items: asset, caption, alt and video." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the road", "info": "Empty uses the gallery's title." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "carousel", "options": [ { "value": "carousel", "label": "Carousel" }, { "value": "grid", "label": "Grid (3:2)" }, { "value": "columns", "label": "Columns" }, { "value": "one-up", "label": "One at a time" } ] },
    { "type": "select", "id": "slide_ratio", "label": "Carousel slides", "default": "square", "options": [ { "value": "square", "label": "Square (1:1)" }, { "value": "landscape", "label": "Landscape (4:3)" }, { "value": "wide", "label": "Wide (3:2)" }, { "value": "natural", "label": "Natural (each photograph at its own height)" } ], "info": "Every slide is the same width: 1.2 across on a phone, 2.5 from 48rem, 4 from 80rem. The fixed ratios crop to fill." },
    { "type": "checkbox", "id": "show_captions", "label": "Show captions", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All photos" },
    { "type": "url", "id": "link", "label": "Link", "default": "/photos" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "From the road", "settings": { "source": "setting", "gallery": "from-the-road", "heading": "From the road", "layout": "carousel", "slide_ratio": "square", "show_captions": true, "link_label": "All photos", "link": "/photos" } },
    { "name": "Post photos", "settings": { "source": "entry", "heading": "Photos", "layout": "one-up", "show_captions": true, "link_label": "", "link": "" } },
    { "name": "Place photos", "settings": { "source": "entry", "heading": "", "layout": "carousel", "slide_ratio": "square", "show_captions": true, "link_label": "", "link": "" } },
    { "name": "Contact sheet", "settings": { "source": "setting", "gallery": "from-the-road", "heading": "", "layout": "columns", "show_captions": true, "link_label": "", "link": "" } }
  ]
}
</schema>
