<!-- One line on Sand: the wordmark in Besley 800, the "Now in Oaxaca, Mexico" line with the current pin (no time, ever), and the main menu as plain text at the right edge. The menu item that points at the places path opens a <dropdown-panel> of six recent places, hung from the header (wide) and aligned to the column's right edge so it never runs off the page. Below 48rem: the wordmark with the Now line under it, and "Menu" opening the drawer. -->
{#let
  wordmark = settings.logo_text || site.settings.wordmark || site.name
  places_path = site.settings.places_path || '/places'
  newest = content.posts.entries | sort('fields.date') | last
  current = (site.settings.current_place ? (content.places.entries | find('handle', site.settings.current_place)) : null) ?? newest.fields.place
  recent = content.stops.entries | reject('fields.next') | sort('fields.arrive') | reverse | map('fields.place.handle') | uniq | slice(0, 6)
}
<sticky-header class="block" settle-overshoot="0" disabled={ !settings.sticky }>
  <header class="relative border-b border-scheme-rule bg-scheme-background px-gutter py-space-sm text-scheme-foreground">
    <div class="mx-auto flex max-w-column items-center justify-between gap-space-md">
      <div class="grid gap-0.5 md:flex md:items-center md:gap-space-md">
        <a class="font-heading text-h4 font-extrabold whitespace-nowrap text-scheme-heading" href="/">{#if settings.logo}<img class="h-control w-auto" src="{ image_url(settings.logo, 320) }" alt="{ wordmark }" width={ settings.logo.width } height={ settings.logo.height } />{:else}{ wordmark }{/if}</a>
        {#if settings.show_now && current}
          <a class="flex items-center gap-1.5 font-mono text-meta font-medium text-scheme-meta uppercase hover:text-scheme-foreground" href="{ places_path }/{ current.handle }"><span class="flex size-icon-sm items-center justify-center"><span class="size-dot rounded-full bg-scheme-stamp" aria-hidden="true"></span></span>{ t('now_in') } { current.title }{#if current.fields.country}, { current.fields.country }{/if}</a>
        {/if}
      </div>
      {#if settings.menu.items.length}
        <nav class="hidden md:block" aria-label="{ t('main_navigation') }">
          <ul class="-me-space-xs flex items-center text-nav font-medium">
            {#for item in settings.menu.items}
              {#if item.href == places_path && recent.length}
                <li>
                  <dropdown-component trigger="both" close-delay="150">
                    <dropdown-trigger class="flex cursor-pointer items-center gap-1 px-space-xs py-space-xs { item.active ? 'text-scheme-foreground' : '' }">{ item.label }<span class="sites-icon size-icon-sm rotate-90" aria-hidden="true">{#svg 'icons/angle-right.svg'}</span></dropdown-trigger>
                    <dropdown-panel class="right-gutter left-auto w-max max-w-panel border border-t-0 border-scheme-rule bg-scheme-background p-space-lg text-scheme-foreground md:right-edge md:rounded-b-sm" wide effect="fade">
                      <ul class="grid gap-x-space-lg gap-y-space-md md:grid-cols-3">
                        {#for h in recent}
                          {#let p = content.places.entries | find('handle', h)}
                          {#if p}
                            <li>
                              <a class="group flex items-center gap-space-sm" href="{ places_path }/{ p.handle }">
                                <span class="block size-thumb shrink-0 overflow-hidden rounded-sm bg-scheme-surface-2">{#if p.fields.image}<img class="size-full object-cover" src="{ image_url(p.fields.image, 160, { height: 160 }) }" alt="" loading="lazy" width="160" height="160" />{/if}</span>
                                <span class="grid gap-0.5">
                                  <span class="font-heading text-h5 font-medium decoration-1 underline-offset-4 group-hover:underline">{ p.title }</span>
                                  <span class="font-mono text-meta font-medium text-scheme-meta uppercase">{ p.fields.country }</span>
                                </span>
                              </a>
                            </li>
                          {/if}
                        {/for}
                      </ul>
                      <a class="mt-space-md inline-flex items-center gap-1 text-body-sm text-scheme-links hover:underline" href="{ places_path }">{ t('all_places', { count: size(content.places.entries) }) }<span class="sites-icon size-icon-sm" aria-hidden="true">{#svg 'icons/arrow-right.svg'}</span></a>
                    </dropdown-panel>
                  </dropdown-component>
                </li>
              {:else}
                <li><a class="block px-space-xs py-space-xs decoration-1 underline-offset-4 hover:underline" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null } aria-current={ item.active ? 'page' : null }>{ item.label }</a></li>
              {/if}
            {/for}
          </ul>
        </nav>
      {/if}
      <button class="-m-space-xs flex min-h-icon-button items-center gap-space-xs px-space-xs text-nav font-medium md:hidden" type="button" data-panel-open="mobile-menu" aria-haspopup="dialog" aria-controls="mobile-menu">{ t('menu') }<span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/menu.svg'}</span></button>
    </div>
  </header>
</sticky-header>

<schema>
{
  "name": "Header",
  "description": "The wordmark, where you are now, and the main menu with a panel of recent places.",
  "kind": "Header",
  "icon": "panel-top",
  "settings": [
    { "type": "image", "id": "logo", "label": "Logo", "info": "Optional. Without one the wordmark is set in the heading face." },
    { "type": "text", "id": "logo_text", "label": "Wordmark text", "default": "", "info": "Empty uses the Brand wordmark." },
    { "type": "menu", "id": "menu", "label": "Menu", "info": "The item that links to the Places path opens a panel of six recent places." },
    { "type": "checkbox", "id": "show_now", "label": "Show where you are now", "default": true, "info": "Reads the Current place theme setting. A place name only: never a time." },
    { "type": "checkbox", "id": "sticky", "label": "Sticky", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": { "logo_text": "", "menu": "main", "show_now": true, "sticky": true } }
  ]
}
</schema>
