<!-- "Currently in", the first view. The current place's photograph (or a muted loop) full-bleed under the Night scrim, stopping 3rem short of the bottom so the last band is Night Train and the luggage tag crosses from the photo into the map band below. The place name at display size bottom-left with one line and two actions; the tag at the column's right edge (under the actions on a phone), tilted 3° clockwise (Cory) and held 0.5rem in from the column edge and the section's bottom so its rotated corners are never clipped, so it still crosses the 3rem band into the map below (the route map's top padding clears it). The loop starts from theme.ts only, never under reduced motion, and pauses off-screen; the poster stands otherwise, and a video over 15 MB is skipped for the image. Nothing here moves on load. The loop's pause control sits at the photo's top-right at every width (a round icon button below 48rem), clear of the heading and the tag. -->
<!-- current place: see components/CurrentPlace.pzl -->
{#let
  places_path = site.settings.places_path || '/places'
  current = (site.settings.current_place ? (content.places.entries | find('handle', site.settings.current_place)) : null) ?? (content.posts.entries | sort('fields.date') | last).fields.place
  place = settings.place ?? current
  image = settings.image ?? place.fields.image
  loop = settings.video && settings.video.byte_size <= 15728640 ? settings.video : null
  stay = place ? (content.stops.entries | where('fields.place.handle', place.handle) | reject('fields.next') | sort('fields.arrive') | last) : null
  heading = settings.heading || place.title
  primary_label = settings.primary_label || t('read_from', { place: place.title })
  primary_link = settings.primary_link || places_path + '/' + place.handle
  tall = settings.height == 'tall'
}
<section data-notice-avoid class="relative isolate flex min-h-hero flex-col justify-end overflow-hidden bg-scheme-background px-gutter pt-section text-scheme-foreground { tall ? 'md:min-h-hero-tall' : '' }" aria-label="{ heading }">
  <div class="absolute inset-x-0 top-0 bottom-band -z-10 bg-scheme-surface-2">
    {#if image}<img class="size-full object-cover" src="{ image_url(image, 1600) }" srcset="{ image_srcset(image, [768, 1024, 1280, 1600, 2000, 2560]) }" sizes="100vw" alt="{ settings.image ? settings.image.alt : place.fields.image_alt }" loading="eager" fetchpriority="high" width={ image.width } height={ image.height } />{/if}
    {#if loop}<video class="absolute inset-0 size-full object-cover" muted loop playsinline preload="none" poster={ image ? image_url(image, 1600) : null } data-loop aria-hidden="true"><source src="{ loop.url }" type="{ loop.mime }" /><a href="{ loop.url }">{ t('open_video') }</a></video>{/if}
    <div class="absolute inset-0 bg-linear-to-t from-scrim via-scrim/40 via-30% to-transparent to-55%" aria-hidden="true"></div>
  </div>
  {#if loop}<button class="absolute top-space-md right-gutter z-10 inline-flex size-icon-button items-center justify-center gap-space-xs rounded-full bg-scrim font-mono text-meta font-medium text-on-photo uppercase md:top-section md:size-auto md:px-space-sm md:py-chip" type="button" data-loop-toggle data-play-label="{ t('play_loop') }" aria-pressed="false"><span class="sites-icon size-icon-sm" aria-hidden="true">{#svg 'icons/pause.svg'}</span><span class="sr-only md:not-sr-only" data-loop-label>{ t('pause_loop') }</span></button>{/if}
  <div class="mx-auto flex w-full max-w-column flex-wrap items-end justify-between gap-x-space-xl gap-y-space-lg">
    <div class="grid max-w-copy min-w-0 flex-1 basis-col gap-space-md pb-space-lg md:pb-hero-copy">
      <h1 class="font-heading text-display font-semibold text-balance text-on-photo">{ heading }</h1>
      {#if settings.text}<p class="max-w-copy text-body-lg text-pretty text-on-photo">{ settings.text }</p>{/if}
      <div class="flex flex-wrap gap-space-sm">
        {#if place}<Button href={ primary_link }>{ primary_label }</Button>{/if}
        {#if settings.secondary_label}<Button href={ settings.secondary_link || '#route' } tone="photo">{ settings.secondary_label }</Button>{/if}
      </div>
    </div>
    {#if settings.show_tag && place}
      <div class="pb-tilt-clear md:me-tilt-clear">
        <Tag
 place={ place } arrived={ stay ? stay.fields.arrive : null } since={ site.settings.on_road_since } href="{ places_path }/{ place.handle }" />
      </div>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Hero",
  "description": "Currently in: where you are now, full-bleed, with the luggage tag crossing into the next band.",
  "kind": "Hero",
  "icon": "image",
  "settings": [
    { "type": "image", "id": "image", "label": "Image", "info": "Empty uses the place's own image. Landscape works best; it is cropped to the screen." },
    { "type": "video", "id": "video", "label": "Video loop", "info": "Optional. MP4 (H.264), 10 to 20 seconds, under 8 MB, no sound needed. It plays muted, never under reduced motion, and the image is its poster. Files over 15 MB are skipped for the image." },
    { "type": "entry", "id": "place", "label": "Place", "info": "A place entry (title, country, latitude, longitude, image, image_alt). Empty uses the Current place theme setting, then the place of the newest post." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Empty uses the place name." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Two months above a tortillería in Jalatlaco: mornings at a borrowed desk, weekends walking the Sierra Norte." },
    { "type": "checkbox", "id": "show_tag", "label": "Show the Currently in tag", "default": true, "info": "The tag reads the place's coordinates, its arrival from the stops, and On the road since." },
    { "type": "checkbox", "id": "show_local_time", "label": "Show the local time", "default": false, "info": "Reserved: a page never reads the clock, so the local time is not drawn in this version." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "", "info": "Empty reads Read from and the place name." },
    { "type": "url", "id": "primary_link", "label": "Primary link", "default": "", "info": "Empty links to the place page." },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "See the route" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link", "default": "#route", "info": "#route jumps to the route map on the same page." },
    { "type": "select", "id": "height", "label": "Height", "default": "tall", "options": [ { "value": "content", "label": "Content" }, { "value": "tall", "label": "Tall (85% of the screen)" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "night" }
  ],
  "presets": [
    { "name": "Currently in", "settings": { "heading": "", "text": "Two months above a tortillería in Jalatlaco: mornings at a borrowed desk, weekends walking the Sierra Norte.", "show_tag": true, "show_local_time": false, "primary_label": "", "primary_link": "", "secondary_label": "See the route", "secondary_link": "#route", "height": "tall", "color_scheme": "night" } }
  ]
}
</schema>
