<!-- The route as tickets. Spine (a trip page): the trip's name, its dates and counts, then one ticket per stop in arrival order down a dashed route in the left gutter, each with its pin beside the stub (the current one lit, the next hollow on a dotted leg, with a NEXT badge); numbered because the order is real. Ribbon (Where next, home): a tarot carousel of tickets that runs off the right edge at every width: now, next, then the earlier stops. The server cannot tell upcoming from past, so "next" is the stop's own checkbox. -->
{#let
  posts_path = site.settings.posts_path || '/journal'
  places_path = site.settings.places_path || '/places'
  trips_path = site.settings.trips_path || '/trips'
  newest = content.posts.entries | sort('fields.date') | last
  current = (site.settings.current_place ? (content.places.entries | find('handle', site.settings.current_place)) : null) ?? newest.fields.place
  all_stops = content.stops.entries | sort('fields.arrive')
  now_stop = current ? (all_stops | where('fields.place.handle', current.handle) | reject('fields.next') | last) : null
  trip = settings.trip ?? (template.type == 'trip' ? page.entry : (now_stop ? now_stop.fields.trip : null))
  stops = trip ? (all_stops | where('fields.trip.handle', trip.handle)) : all_stops
  countries = stops | map('fields.place.fields.country') | uniq
  next_stops = all_stops | where('fields.next')
  earlier = all_stops | reject('fields.next') | reverse | reject('fields.place.handle', current ? current.handle : '') | slice(0, 10)
  heading = (settings.heading || '') | replace('{trip}', trip ? trip.title : '')
  ribbon = settings.layout == 'ribbon'
  id = 'itinerary-' + section.id
  reveal = site.settings.reveal_on_scroll
  options = { slidesPerView: 1.2, gap: '1rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { slidesPerView: 2.2, gap: '1rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: true, showPagination: false } }, '1024': { slidesPerView: 3.2, gap: '1rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: true, showPagination: false } } } }
}
{#if stops.length}
<section class="bg-scheme-background py-section text-scheme-foreground" aria-labelledby="{ id }-title">
  {#if ribbon}
    <tarot-carousel class="block" id={ id } data-track="tickets">
      <script type="application/json" data-tarot-options>{ options | json }</script>
      <div class="px-gutter">
        <div class="mx-auto mb-space-md flex max-w-column items-end justify-between gap-space-md border-b border-scheme-rule pb-space-sm">
          <div class="flex flex-wrap items-baseline gap-x-space-sm gap-y-1">
            <h2 class="font-heading text-h2 font-semibold text-scheme-heading" id="{ id }-title">{ heading || t('where_next') }</h2>
            {#if trip}<p class="font-mono text-meta font-medium text-scheme-meta uppercase">{ trip.title }{#unless trip.fields.end_date} · { t('under_way') }{/unless}</p>{/if}
          </div>
          <div class="flex items-center gap-space-md">
            <Arrows />
            {#if trip}<a class="text-body-sm whitespace-nowrap text-scheme-links hover:underline" href="{ trips_path }/{ trip.handle }">{ t('full_route') }</a>{/if}
          </div>
        </div>
      </div>
      <div class="pl-gutter md:pl-edge">
        <tarot-viewport>
          <tarot-track>
            {#if now_stop}<tarot-slide><Ticket stop={ now_stop } label={ t('now') } show_posts={ settings.show_posts } show_notes={ settings.show_notes } posts_path={ posts_path } places_path={ places_path } /></tarot-slide>{/if}
            {#for stop in next_stops}<tarot-slide><Ticket stop={ stop } label={ t('next') } show_posts={ settings.show_posts } show_notes={ settings.show_notes } posts_path={ posts_path } places_path={ places_path } /></tarot-slide>{/for}
            {#for stop in earlier}<tarot-slide><Ticket stop={ stop } label={ t('earlier') } show_posts={ settings.show_posts } show_notes={ settings.show_notes } posts_path={ posts_path } places_path={ places_path } /></tarot-slide>{/for}
          </tarot-track>
        </tarot-viewport>
      </div>
    </tarot-carousel>
  {:else}
    <div class="px-gutter">
      <div class="mx-auto grid max-w-column gap-space-lg">
        <div class="grid gap-space-xs">
          <h2 class="font-heading text-h2 font-semibold text-scheme-heading" id="{ id }-title">{ heading || (trip ? t('stop_by_stop', { trip: trip.title }) : t('the_route')) }</h2>
          {#if trip}<p class="font-mono text-meta font-medium text-scheme-meta uppercase">{ date(trip.fields.start_date) } – { trip.fields.end_date ? date(trip.fields.end_date) : t('under_way') } · { stops.length | pluralize(t('stop_one'), t('stop_many')) } · { countries.length | pluralize(t('country_one'), t('country_many')) }</p>{/if}
        </div>
        <ol class="relative grid max-w-ticket gap-space-md pl-space-xl">
          <span class="absolute top-space-xl bottom-space-xl left-3.5 w-0 border-r-2 border-dashed border-scheme-route" aria-hidden="true"></span>
          {#for stop in stops, i}
            {#let
              is_now = now_stop && stop.id == now_stop.id
              is_next = stop.fields.next
            }
            <li class="relative { reveal ? 'reveal reveal-fade-up' : '' }">
              <span class="absolute top-1/2 -left-space-xl flex w-7 -translate-y-1/2 justify-center"><Pin type={ is_now ? 'now' : (is_next ? 'next' : 'place') } /></span>
              <Ticket stop={ stop } label={ t('stop_n', { n: i + 1 }) } badge={ is_next ? t('next') : null } show_posts={ settings.show_posts } show_notes={ settings.show_notes } posts_path={ posts_path } places_path={ places_path } />
            </li>
          {/for}
        </ol>
      </div>
    </div>
  {/if}
</section>
{/if}

<schema>
{
  "name": "Itinerary",
  "description": "The route as ticket stubs: a vertical spine for a trip, or a ribbon of where next.",
  "kind": "Collections",
  "icon": "route",
  "settings": [
    { "type": "entry", "id": "trip", "label": "Trip", "info": "A trips entry. Empty: on a trip page that trip, elsewhere the trip of the current place. Stops come from the stops content type (trip, place, arrive, nights, post, note, next)." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "spine", "options": [ { "value": "spine", "label": "Spine (every stop of the trip)" }, { "value": "ribbon", "label": "Ribbon (now, next, then earlier)" } ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Empty reads The Americas, stop by stop (spine) or Where next (ribbon). {trip} is replaced with the trip's name." },
    { "type": "checkbox", "id": "show_posts", "label": "Link each stop's post", "default": true },
    { "type": "checkbox", "id": "show_notes", "label": "Show each stop's note", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Full route", "settings": { "layout": "spine", "heading": "", "show_posts": true, "show_notes": true } },
    { "name": "Where next", "settings": { "layout": "ribbon", "heading": "Where next", "show_posts": true, "show_notes": true } }
  ]
}
</schema>
