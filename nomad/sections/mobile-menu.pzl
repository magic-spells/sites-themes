<!-- The mobile menu: a @magic-spells <dialog-panel>, a left drawer over the page dimmed by the text colour at 50% with a small blur. It closes on the scrim, Escape and its × and hands focus back to the header's Menu button. The main menu in Besley, the "Now in" mini tag, then the secondary menu and the socials. -->
{#let
  places_path = site.settings.places_path || '/places'
  newest = content.posts.entries | sort('fields.date') | last
  current = (site.settings.current_place ? (content.places.entries | find('handle', site.settings.current_place)) : null) ?? newest.fields.place
}
<dialog-panel id="mobile-menu" position="left">
  <dialog-backdrop class="bg-scheme-backdrop backdrop-blur-sm"></dialog-backdrop>
  <dialog class="h-dvh w-full max-w-drawer overflow-y-auto bg-scheme-background text-scheme-foreground shadow-none" aria-label="{ t('menu') }">
    <div class="grid gap-space-lg p-space-lg">
      <div class="flex items-center justify-between gap-space-md">
        <a class="font-heading text-h4 font-extrabold text-scheme-heading" href="/">{ site.settings.wordmark || site.name }</a>
        <button class="flex size-icon-button items-center justify-center rounded-full bg-scheme-surface-2 text-scheme-foreground hover:text-scheme-links" type="button" data-action-hide-dialog><span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/close.svg'}</span><span class="sr-only">{ t('close') }</span></button>
      </div>
      {#if settings.menu.items.length}
        <nav aria-label="{ t('main_navigation') }">
          <ul class="grid gap-space-sm">
            {#for item in settings.menu.items}
              <li><a class="font-heading text-h2 font-semibold text-scheme-heading hover:text-scheme-links" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null } aria-current={ item.active ? 'page' : null }>{ item.label }</a></li>
            {/for}
          </ul>
        </nav>
      {/if}
      {#if settings.show_now && current}<div class="py-space-xs"><Tag place={ current } mini={ true } href="{ places_path }/{ current.handle }" /></div>{/if}
      {#if settings.menu_secondary.items.length || settings.menu_social.items.length}
        <div class="grid gap-space-md border-t border-scheme-rule pt-space-md">
          {#if settings.menu_secondary.items.length}
            <ul class="grid gap-space-xs" aria-label="{ settings.menu_secondary.title }">
              {#for item in settings.menu_secondary.items}<li><a class="text-body text-scheme-muted hover:text-scheme-foreground" href="{ item.href }">{ item.label }</a></li>{/for}
            </ul>
          {/if}
          {#if settings.menu_social.items.length}
            <ul class="flex flex-wrap gap-x-space-md gap-y-space-xs text-body-sm" aria-label="{ settings.menu_social.title }">
              {#for item in settings.menu_social.items}<li><a class="hover:text-scheme-links" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null }>{ item.label }</a></li>{/for}
            </ul>
          {/if}
        </div>
      {/if}
    </div>
  </dialog>
</dialog-panel>

<schema>
{
  "name": "Mobile menu",
  "description": "A left drawer with the main menu, where you are now, and the smaller links.",
  "kind": "Panels",
  "icon": "menu",
  "settings": [
    { "type": "menu", "id": "menu", "label": "Menu" },
    { "type": "menu", "id": "menu_secondary", "label": "Secondary menu" },
    { "type": "menu", "id": "menu_social", "label": "Social menu" },
    { "type": "checkbox", "id": "show_now", "label": "Show where you are now", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": { "menu": "main", "menu_secondary": "legal", "menu_social": "social", "show_now": true } }
  ]
}
</schema>
