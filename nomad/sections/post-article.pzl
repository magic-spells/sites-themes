<!-- One post (Folio's id and settings). The head in the 40rem reading column: the topic chip, the title, the standfirst, then the place tag, the date stamp and "BY ILSE VARGA · 6 MIN READ". The cover (16:9, or the post's video as a muted loop or a player) breaks out to the full column; under it on a hairline the place with its coordinates and a 6rem drawn locator that opens the full map in a <dialog-panel>, then the image caption. The prose at 40rem (a drop cap only when the setting asks; Figma draws none) and an end rule in stamp ink. -->
{#let
  entry = page.entry
  f = entry.fields
  place = f.place
  places_path = site.settings.places_path || '/places'
  image = f.image
  film = f.video && f.video.byte_size <= 15728640 ? f.video : null
  trip_stops = f.trip ? (content.stops.entries | where('fields.trip.handle', f.trip.handle) | sort('fields.arrive')) : []
  map_id = 'map-' + section.id
}
<article class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-xl">
    <header class="mx-auto grid w-full max-w-reading gap-space-md">
      {#if settings.show_meta && f.topic}<a class="w-fit rounded-full border border-scheme-rule bg-scheme-surface-2 px-space-sm py-tiny text-body-sm font-medium hover:border-scheme-foreground" href="{ site.settings.posts_path || '/journal' }?topic={ encodeURIComponent(f.topic) }">{ f.topic }</a>{/if}
      <h1 class="font-heading text-h1 font-semibold text-balance text-scheme-heading">{ entry.title ?? page.title }</h1>
      {#if f.standfirst}<p class="text-body-lg text-pretty text-scheme-muted">{ f.standfirst }</p>{/if}
      {#if settings.show_meta}
        <div class="flex flex-wrap items-center gap-x-space-md gap-y-space-sm pt-space-xs">
          {#if place}<PlaceTag place={ place } href="{ places_path }/{ place.handle }" />{/if}
          {#if f.date}<DateStamp value={ f.date } />{/if}
          <p class="font-mono text-meta font-medium text-scheme-meta uppercase">{#if settings.show_byline && f.author}{ t('by_line', { name: f.author }) }{/if}{#if settings.show_byline && f.author && f.reading_minutes} · {/if}{#if f.reading_minutes}{ t('minutes_read', { count: f.reading_minutes }) }{/if}</p>
        </div>
      {/if}
    </header>

    {#if settings.show_image && (image || film)}
      <figure class="grid gap-space-sm">
        <div class="relative aspect-video overflow-hidden rounded-sm bg-scheme-surface-2">
          {#if image}<img class="size-full object-cover" src="{ image_url(image, 1600) }" srcset="{ image_srcset(image, [640, 1024, 1280, 1600, 2000, 2560]) }" sizes="(min-width: 85rem) 85rem, 100vw" alt="{ f.image_alt }" loading="eager" fetchpriority="high" width={ image.width } height={ image.height } />{/if}
          {#if film && settings.cover_video == 'player'}
            <video class="absolute inset-0 size-full object-cover" controls playsinline preload="none" poster={ image ? image_url(image, 1600) : null }><source src="{ film.url }" type="{ film.mime }" /><a href="{ film.url }">{ t('open_video') }</a></video>
          {:else if film}
            <video class="absolute inset-0 size-full object-cover" muted loop playsinline preload="none" poster={ image ? image_url(image, 1600) : null } data-loop aria-hidden="true"><source src="{ film.url }" type="{ film.mime }" /><a href="{ film.url }">{ t('open_video') }</a></video>
            <button class="absolute top-space-sm right-space-sm inline-flex items-center gap-space-xs rounded-full bg-scrim px-space-sm py-chip font-mono text-meta font-medium text-on-photo uppercase" type="button" data-loop-toggle data-play-label="{ t('play_loop') }" aria-pressed="false"><span class="sites-icon size-icon-sm" aria-hidden="true">{#svg 'icons/pause.svg'}</span><span data-loop-label>{ t('pause_loop') }</span></button>
          {/if}
        </div>
        {#if place || f.image_caption}
          <figcaption class="grid gap-space-xs">
            {#if place}
              <div class="flex items-center justify-between gap-space-md border-t border-scheme-rule pt-space-sm">
                <div class="flex flex-wrap items-center gap-x-space-sm gap-y-tiny">
                  <PlaceTag place={ place } href="{ places_path }/{ place.handle }" />
                  {#if place.fields.latitude != null}<span class="font-mono text-coord text-scheme-meta"><Coord lat={ place.fields.latitude } lon={ place.fields.longitude } /></span>{/if}
                </div>
                {#if settings.show_locator && place.fields.latitude != null}
                  <button class="group flex shrink-0 items-center gap-space-sm text-body-sm text-scheme-links" type="button" data-panel-open={ map_id } aria-haspopup="dialog" aria-controls={ map_id } aria-label="{ t('open_map') }: { place.title }">
                    <span class="hidden group-hover:underline sm:inline" aria-hidden="true">{ t('open_map') }</span>
                    <span class="block size-locator overflow-hidden rounded-sm border border-scheme-rule bg-scheme-surface-2"><WorldMap places={ [place] } stops={ [] } now={ place.handle } fit="point" ratio="square" route={ false } base={ places_path } still={ true } /></span>
                  </button>
                {/if}
              </div>
            {/if}
            {#if f.image_caption}<p class="text-body-sm text-scheme-muted">{ f.image_caption }</p>{/if}
          </figcaption>
        {/if}
      </figure>
    {/if}

    <div class="mx-auto grid w-full max-w-reading gap-space-xl">
      <div class="sites-prose { settings.drop_cap ? 'nomad-drop-cap' : '' }">{ f.body }</div>
      {#if settings.show_end_rule}<hr class="mx-auto h-micro w-rule border-0 bg-scheme-stamp" />{/if}
    </div>
  </div>

  {#if settings.show_locator && place && place.fields.latitude != null}
    <dialog-panel id={ map_id }>
      <dialog-backdrop class="bg-scheme-backdrop backdrop-blur-sm"></dialog-backdrop>
      <dialog class="m-auto h-dvh w-full max-w-panel bg-scheme-background text-scheme-foreground md:h-auto md:rounded-lg" aria-label="{ place.title }">
        <div class="grid gap-space-md p-space-lg">
          <div class="flex items-start justify-between gap-space-md">
            <div class="grid gap-tiny">
              <h2 class="font-heading text-h3 font-semibold text-scheme-heading">{ place.title }{#if place.fields.country}, { place.fields.country }{/if}</h2>
              <p class="font-mono text-coord text-scheme-meta"><Coord lat={ place.fields.latitude } lon={ place.fields.longitude } /></p>
            </div>
            <button class="flex size-icon-button shrink-0 items-center justify-center rounded-full bg-scheme-surface-2 hover:text-scheme-links" type="button" data-action-hide-dialog><span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/close.svg'}</span><span class="sr-only">{ t('close') }</span></button>
          </div>
          <div class="overflow-hidden rounded-sm bg-scheme-surface"><WorldMap places={ trip_stops.length ? (trip_stops | map('fields.place') | compact) : [place] } stops={ trip_stops } now={ place.handle } fit={ trip_stops.length ? 'trip' : 'point' } ratio="4/3" route="stops" labels={ false } base={ places_path } /></div>
        </div>
      </dialog>
    </dialog-panel>
  {/if}
</article>

<schema>
{
  "name": "Post",
  "description": "One post: its place and date up front, a cover that breaks out of the column, a locator map, and the writing.",
  "kind": "Content",
  "icon": "file-text",
  "templates": ["post"],
  "settings": [
    { "type": "checkbox", "id": "show_meta", "label": "Show the topic, place, date and reading time", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show the cover", "default": true },
    { "type": "checkbox", "id": "show_byline", "label": "Show the byline", "default": true },
    { "type": "checkbox", "id": "drop_cap", "label": "Show a drop cap", "default": false },
    { "type": "checkbox", "id": "show_end_rule", "label": "Show the end rule", "default": true },
    { "type": "checkbox", "id": "show_locator", "label": "Show the locator map", "default": true, "info": "A small drawn map of the post's place; it opens the trip's route full size." },
    { "type": "select", "id": "cover_video", "label": "A post's video plays as", "default": "loop", "options": [ { "value": "loop", "label": "A muted loop" }, { "value": "player", "label": "A player with sound" } ], "info": "Reads the post's optional video field; the image is its poster. Files over 15 MB are skipped for the image." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": { "show_meta": true, "show_image": true, "show_byline": true, "drop_cap": false, "show_end_rule": true, "show_locator": true, "cover_video": "loop" } }
  ]
}
</schema>
