<!-- The signature: where I've been. On Night Train, the place list at the column's left edge and the drawn map bleeding off the right edge, one pin per place, the route dashed through the stops in arrival order (the leg to the next stop dotted), the current pin lit with one slow pulse. A row and its pin light each other on hover (theme.ts); a pin links to its place. The country filter (a <dropdown-panel>) hides rows and pins by data-country; without JavaScript the list and links all work. Below 48rem the list stacks above the map, which shows at a fixed scale framed on the current and next stops. -->
{#let
  places_path = site.settings.places_path || '/places'
  places = settings.places.entries ?? content.places.entries
  trip = settings.trip ?? (template.type == 'trip' ? page.entry : null)
  all_stops = content.stops.entries | sort('fields.arrive')
  stops = trip ? (all_stops | where('fields.trip.handle', trip.handle)) : all_stops
  posts = content.posts.entries
  route_points = settings.show_route == 'posts' ? (posts | sort('fields.date')) : stops
  newest = posts | sort('fields.date') | last
  current = (site.settings.current_place ? (places | find('handle', site.settings.current_place)) : null) ?? newest.fields.place
  next_stop = stops | where('fields.next') | first
  trip_handles = trip ? (stops | map('fields.place.handle') | uniq) : null
  row_handles = stops | reject('fields.next') | reverse | map('fields.place.handle') | uniq
  rows = row_handles.length ? row_handles : (places | sort('title') | map('handle'))
  shown = rows | slice(0, settings.list_limit)
  countries = places | map('fields.country') | uniq | sort
  since = site.settings.on_road_since
  fit = trip && settings.fit == 'trip' ? 'trip' : 'world'
}
<section class="bg-scheme-background py-section pl-gutter text-scheme-foreground md:pl-edge" id={ section.index == 0 || settings.anchor ? 'route' : null } aria-labelledby="{ section.id }-title" data-country-scope>
  <div class="flex flex-wrap items-start gap-x-space-xl gap-y-space-lg">
    {#if settings.show_list}
      <div class="grid w-full max-w-list min-w-0 flex-1 basis-80 gap-space-md pr-gutter md:pr-0">
        <div class="grid gap-space-xs">
          <h2 class="font-heading text-h2 font-semibold text-scheme-heading" id="{ section.id }-title">{ trip ? (settings.heading || trip.title) : settings.heading }</h2>
          {#if settings.show_count}<p class="text-body text-scheme-muted">{#if trip}{ t('trip_count', { stops: stops.length, countries: size(stops | map('fields.place.fields.country') | uniq) }) }{:else}{ t('places_count', { places: places.length, countries: countries.length }) }{#if since} { t('since_date', { date: date(since) }) }{/if}{/if}</p>{/if}
        </div>
        {#if settings.country_filter && countries.length > 1}
          <dropdown-component class="w-fit" close-delay="150">
            <dropdown-trigger class="inline-flex min-h-control-small cursor-pointer items-center gap-space-xs rounded-button border border-scheme-rule px-space-sm text-body-sm"><span data-country-label>{ t('all_countries') }</span><span class="sites-icon size-icon-sm rotate-90" aria-hidden="true">{#svg 'icons/angle-right.svg'}</span></dropdown-trigger>
            <dropdown-panel class="z-30 mt-1 rounded-sm border border-scheme-rule bg-scheme-background p-space-xs" effect="fade">
              <ul class="grid min-w-48 text-body-sm">
                <li><button class="w-full rounded-sm px-space-sm py-1.5 text-left hover:bg-scheme-surface-2 current:font-semibold" type="button" data-country-set="" aria-current="true">{ t('all_countries') }</button></li>
                {#for country in countries}<li><button class="w-full rounded-sm px-space-sm py-1.5 text-left hover:bg-scheme-surface-2 current:font-semibold" type="button" data-country-set={ country }>{ country }</button></li>{/for}
              </ul>
            </dropdown-panel>
          </dropdown-component>
        {/if}
        <ul class="border-t border-scheme-rule">
          {#for h in shown}
            {#let
              p = places | find('handle', h)
              stay = stops | where('fields.place.handle', h) | reject('fields.next') | last
            }
            {#if p}<PlaceRow place={ p } href="{ places_path }/{ p.handle }" count={ size(posts | where('fields.place.handle', h)) } arrived={ stay ? stay.fields.arrive : null } now={ current && current.handle == h } next={ false } />{/if}
          {/for}
        </ul>
        {#if settings.link_label}<a class="inline-flex w-fit items-center gap-1 text-body-sm text-scheme-links hover:underline" href={ settings.link || places_path }>{ settings.link_label | replace('{count}', `${places.length}`) }<span class="sites-icon size-icon-sm" aria-hidden="true">{#svg 'icons/arrow-right.svg'}</span></a>{/if}
      </div>
    {/if}
    <figure class="grid min-w-0 flex-2 basis-96 gap-space-sm">
      <WorldMap places={ places } stops={ route_points } now={ current ? current.handle : null } next={ next_stop ? next_stop.fields.place.handle : null } fit={ fit } route={ settings.show_route == 'none' ? false : settings.show_route } labels={ true } base={ places_path } caption={ next_stop ? date(next_stop.fields.arrive) : null } pins={ trip_handles } pan={ fit == 'world' } />
      <figcaption class="flex flex-wrap gap-x-space-md gap-y-1 pr-gutter font-mono text-meta font-medium text-scheme-meta uppercase">
        <span class="inline-flex items-center gap-1.5"><span class="size-dot rounded-full bg-scheme-stamp" aria-hidden="true"></span>{ t('now') }</span>
        {#if next_stop}<span class="inline-flex items-center gap-1.5"><span class="size-dot rounded-full border border-scheme-foreground" aria-hidden="true"></span>{ t('next') }</span>{/if}
        {#if settings.show_route != 'none'}<span class="inline-flex items-center gap-1.5"><span class="w-4 border-t-2 border-dashed border-scheme-route" aria-hidden="true"></span>{ settings.show_route == 'posts' ? t('route_by_post') : t('route_by_arrival') }</span>{/if}
      </figcaption>
    </figure>
  </div>
</section>

<schema>
{
  "name": "Route map",
  "description": "The signature: a drawn world with a pin per place, the route through the stops, and the place list.",
  "kind": "Collections",
  "icon": "map",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where I've been", "info": "On a trip, empty uses the trip's name." },
    { "type": "checkbox", "id": "show_count", "label": "Show the count line", "default": true, "info": "Computed: places, countries and On the road since. Nothing is invented." },
    { "type": "collection", "id": "places", "label": "Places", "info": "Reads places entries: title, handle, country, latitude, longitude, image. Empty uses every place." },
    { "type": "select", "id": "show_route", "label": "Route line", "default": "stops", "options": [ { "value": "none", "label": "None" }, { "value": "stops", "label": "Through the stops, by arrival" }, { "value": "posts", "label": "Through the posts, by date" } ], "info": "Stops come from the stops content type (trip, place, arrive, nights, next)." },
    { "type": "entry", "id": "trip", "label": "Trip", "info": "A trips entry. Empty shows every stop; on a trip page it uses that trip." },
    { "type": "select", "id": "fit", "label": "Frame", "default": "world", "options": [ { "value": "world", "label": "The world" }, { "value": "trip", "label": "The trip's stops" } ], "info": "The trip's stops frame only when a trip is chosen or the page is a trip." },
    { "type": "checkbox", "id": "show_list", "label": "Show the place list", "default": true },
    { "type": "range", "id": "list_limit", "label": "Places in the list", "min": 1, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "country_filter", "label": "Show the country filter", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All {count} places", "info": "{count} is replaced with the number of places." },
    { "type": "url", "id": "link", "label": "Link", "default": "", "info": "Empty uses the Places path." },
    { "type": "checkbox", "id": "anchor", "label": "Answer the #route link", "default": false, "info": "The first route map on a page always does." },
    { "type": "select", "id": "map_style", "label": "Map style", "default": "drawn", "options": [ { "value": "drawn", "label": "Drawn" }, { "value": "tiles", "label": "Tiles (coming later)" } ], "info": "Tiles from an outside service are not connected yet; both draw the drawn map." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "night" }
  ],
  "presets": [
    { "name": "Everywhere", "settings": { "heading": "Where I've been", "show_count": true, "places": "places", "show_route": "stops", "fit": "world", "show_list": true, "list_limit": 6, "country_filter": true, "link_label": "All {count} places", "link": "", "anchor": false, "map_style": "drawn", "color_scheme": "night" } },
    { "name": "This trip", "settings": { "heading": "", "show_count": true, "places": "places", "show_route": "stops", "fit": "trip", "show_list": true, "list_limit": 12, "country_filter": false, "link_label": "", "link": "", "anchor": false, "map_style": "drawn", "color_scheme": "night" } },
    { "name": "Compact", "settings": { "heading": "Where I've been", "show_count": true, "places": "places", "show_route": "stops", "fit": "world", "show_list": false, "list_limit": 6, "country_filter": false, "link_label": "", "link": "", "anchor": false, "map_style": "drawn", "color_scheme": "night" } }
  ]
}
</schema>
