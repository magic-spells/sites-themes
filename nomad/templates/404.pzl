<!-- template: 404 -->
<!-- layout: default -->
<!-- Off the map (Figma): on the contour texture, a centred column with the heading and the line at the left and a postmark that reads Nowhere at 0° 0° at the right, then three real posts as rows (the newest three: no invented titles) and a button to every place you have been to. -->
{#let
  posts = content.posts.entries | sort('fields.date') | reverse | slice(0, 3)
  posts_path = site.settings.posts_path || '/journal'
  places_path = site.settings.places_path || '/places'
  visited = content.stops.entries | reject('fields.next')
  n_places = visited.length ? size(visited | map('fields.place.handle') | compact | uniq) : size(content.places.entries)
}
<section class="relative isolate overflow-hidden bg-scheme-background px-gutter py-section text-scheme-foreground md:py-space-2xl">
  <span class="sites-fill texture-contour absolute inset-0 -z-10 text-scheme-foreground" aria-hidden="true">{#svg 'decor/contours.svg'}</span>
  <div class="mx-auto grid max-w-ticket gap-space-xl">
    <div class="flex flex-wrap items-center justify-between gap-space-lg">
      <div class="grid max-w-reading justify-items-start gap-space-sm">
        <h1 class="font-heading text-h1 font-semibold text-balance text-scheme-heading">{ t('not_found_title') }</h1>
        <p class="text-body-lg text-pretty">{ t('not_found_body') }</p>
      </div>
      <div class="me-space-xl"><Postmark name={ t('nowhere') } country="" lat={ 0 } lon={ 0 } line="0° N, 0° E" /></div>
    </div>
    {#if posts.length}
      <ul aria-label="{ t('latest_posts') }">
        {#for post in posts}<PostRow entry={ post } href="{ posts_path }/{ post.handle }" />{/for}
      </ul>
    {/if}
    <div><Button href={ places_path } tone="secondary">{ t('all_places', { count: n_places }) }</Button></div>
  </div>
</section>
