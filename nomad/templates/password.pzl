<!-- template: Password -->
<!-- layout: default -->
<!-- A photograph from the road behind the scrim, and on it a luggage tag: the wordmark, the line, the password field and Enter. data-bare hides the header, footer and panel groups (styles/theme.css). -->
{#let photo = galleries['from-the-road'] ? galleries['from-the-road'].items[0] : null}
<section class="relative isolate grid min-h-dvh flex-1 place-items-center bg-scheme-surface-2 px-gutter py-section" data-bare>
  {#if photo}<img class="absolute inset-0 -z-10 size-full object-cover" src="{ image_url(photo.asset, 2000) }" srcset="{ image_srcset(photo.asset, [768, 1280, 2000, 2560]) }" sizes="100vw" alt="" width={ photo.asset.width } height={ photo.asset.height } />{/if}
  <span class="absolute inset-0 -z-10 bg-scrim" aria-hidden="true"></span>
  <div class="relative grid w-full max-w-tag gap-space-md rounded-lg bg-tag px-space-md pt-space-lg pb-space-md text-tag-ink shadow-sm">
    <span class="absolute top-space-sm left-1/2 size-eyelet -translate-x-1/2 rounded-full border-2 border-tag-ink bg-scheme-surface-2" aria-hidden="true"></span>
    <div class="grid gap-space-xs pt-space-sm text-center">
      <h1 class="font-heading text-h3 font-semibold text-balance">{ site.settings.wordmark || site.name }</h1>
      <p class="text-body-sm text-pretty">{ t('password_body') }</p>
    </div>
    <!-- The unlock endpoint reads `password` and redirects to the `to` path. -->
    <form class="grid gap-space-sm text-left" method="post" action="/_sites/unlock">
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}<p class="font-mono text-meta text-tag-stamp" role="alert">{ request.query.password_error }</p>{/if}
      <Field name="password" label="{ t('password_label') }" type="password" required={ true } placeholder={ t('password_label') } prefix="password" />
      <Submit wide={ true }>{ t('password_submit') }</Submit>
    </form>
    <p class="border-t border-dashed border-tag-ink pt-space-sm text-center font-mono text-meta font-medium uppercase">{ t('password_help') }</p>
  </div>
</section>
