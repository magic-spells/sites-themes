<!-- template: Password -->
<!-- layout: default -->
<!-- The password wall (Figma): Night Train behind a luggage tag of plain paper, the tag's hole at its top-left, BY INVITATION in stamp ink, the wordmark, the password field under its visible label (the field pinned to Sand, so it reads as paper on paper) and Enter as the Night Train button. data-bare hides the header, footer and panel groups (styles/theme.css). -->
<section class="sites-scheme-night relative isolate grid min-h-dvh flex-1 place-items-center bg-scheme-background px-gutter py-section" data-bare>
  <div class="relative grid w-full max-w-pass gap-space-sm rounded-md bg-tag p-space-lg text-tag-ink shadow-sm">
    <span class="size-eyelet rounded-full bg-scheme-background" aria-hidden="true"></span>
    <p class="pt-space-xs font-mono text-meta font-medium text-tag-stamp uppercase">{ t('password_eyebrow') }</p>
    <h1 class="font-heading text-h4 font-extrabold">{ site.settings.wordmark || site.name }</h1>
    <!-- The unlock endpoint reads `password` and redirects to the `to` path. -->
    <form class="grid justify-items-start gap-space-md text-left" method="post" action="/_sites/unlock">
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}<p class="font-mono text-meta text-tag-stamp" role="alert">{ request.query.password_error }</p>{/if}
      <div class="sites-scheme-sand w-full"><Field name="password" label="{ t('password_label') }" type="password" required={ true } placeholder={ t('password_placeholder') } prefix="password" visible_label={ true } /></div>
      <Submit>{ t('password_submit') }</Submit>
    </form>
  </div>
</section>
