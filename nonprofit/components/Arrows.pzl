<!-- component: Arrows -->
<!-- A carousel's chrome under its track: bar-<section id> holds tarot's progress bar across the row (the carousel's progressBar option names it: { selector: '#bar-' + section.id }), and the previous and next buttons sit at its right end: round, a hairline in the text colour, the text at 8% on hover, hidden below 48rem. Tarot finds the buttons by their data-action attributes. sides puts the two buttons at the sides of a relative group instead, with no bar, shown from 64rem on hover or keyboard focus (the centred quote carousel). -->
<div class="{ sides ? 'pointer-events-none absolute inset-0 hidden items-center justify-between opacity-0 transition-opacity duration-150 group-hover:opacity-100 has-focus-visible:opacity-100 lg:flex *:pointer-events-auto' : 'mt-space-md flex items-center justify-end gap-space-xs' }">
  {#unless sides}<div class="me-space-md flex-1" id="bar-{ section.id }"></div>{/unless}
  <button class="flex size-tap items-center justify-center rounded-full border border-scheme-foreground transition-colors duration-150 hover:bg-scheme-outline-hover disabled:pointer-events-none disabled:opacity-40 max-md:hidden" type="button" data-action-tarot-previous aria-label="{ t('previous') }"><Glyph name="arrow-left" /></button>
  <button class="flex size-tap items-center justify-center rounded-full border border-scheme-foreground transition-colors duration-150 hover:bg-scheme-outline-hover disabled:pointer-events-none disabled:opacity-40 max-md:hidden" type="button" data-action-tarot-next aria-label="{ t('next') }"><Glyph name="arrow-right" /></button>
</div>
