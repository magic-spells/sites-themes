<!-- component: EventCard -->
<!-- An event, one link to its page. Card: the 3:2 well with the day stamped at its top left, the title in h4 and the place with its pin. row (the Events page): the day and weekday at the left, the title, the time and place with the pin, and a thumbnail at the right from 48rem, on a hairline. -->
{#let f = entry.fields}
{#if row}
<article class="group relative flex items-center gap-space-md border-b border-scheme-border py-space-md">
  <Day value={ f.date } view="day" />
  <div class="grid flex-1 gap-space-2xs">
    <h3 class="font-heading text-h4 text-balance text-scheme-heading"><a class="link-quiet after:absolute after:inset-0" href="{ href }">{ entry.title }</a></h3>
    <Place text={ f.time && f.location ? f.time + ' · ' + f.location : f.time || f.location } />
  </div>
  <Well asset={ f.image } ratio="aspect-3/2" cls="w-thumb-lg shrink-0 max-md:hidden" width={ 320 } sizes="8rem" />
</article>
{:else}
<article class="group relative grid content-start gap-space-sm { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
  <Well asset={ f.image } alt={ f.image_alt } ratio="aspect-3/2" width={ 800 } sizes="(min-width: 48rem) 24rem, 85vw"><Day value={ f.date } view="stamp" /></Well>
  <div class="grid gap-space-2xs">
    <h3 class="font-heading text-h4 text-balance text-scheme-heading"><a class="link-quiet after:absolute after:inset-0" href="{ href }">{ entry.title }</a></h3>
    <Place text={ f.location } />
  </div>
</article>
{/if}
