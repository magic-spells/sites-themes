<!-- component: Logo -->
<!-- A partner from a logo block: its picture at the logo height, or without one its name in the heading face. A link when the block has one, otherwise a placeholder anchor that takes no focus. -->
<a class="flex min-h-logo items-center justify-center text-center font-heading text-h4 text-balance text-scheme-heading" href={ logo.link || null } data-block={ editor_id }>{#if logo.image}<img class="h-logo w-auto max-w-full object-contain" src="{ image_url(logo.image, 640) }" alt="{ logo.name }" loading="lazy" width={ logo.image.width } height={ logo.image.height } />{:else}{ logo.name }{/if}</a>
