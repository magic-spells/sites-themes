<!-- component: Logo -->
<!-- A partner from a logo block: its picture at the logo height (large: the larger one), or without one its name in the heading face, a step larger when large. The picture's alt is the asset's own, or the name when it has none. A link when the block has one, otherwise a placeholder anchor that takes no focus. -->
<a class="flex items-center justify-center text-center font-heading text-balance text-scheme-heading { large ? 'min-h-logo-lg text-h3' : 'min-h-logo text-h4' }" href={ logo.link || null } data-block={ editor_id }>{#if logo.image}<img class="w-auto max-w-full object-contain { large ? 'h-logo-lg' : 'h-logo' }" src="{ image_url(logo.image, 640) }" alt="{ logo.image.alt || logo.name }" loading="lazy" width={ logo.image.width } height={ logo.image.height } />{:else}{ logo.name }{/if}</a>
