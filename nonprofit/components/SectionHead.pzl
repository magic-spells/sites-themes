<!-- component: SectionHead -->
<!-- A section's head: the h2, the standfirst under it in the lede size, and at the right, level with the heading, the outlined "All …" pill (link_label, link_href). centred centres the heading and standfirst and moves the pill under the content the head wraps. Stacks on phones. -->
{#if heading}
<div class="mb-space-xl flex flex-wrap gap-x-space-xl gap-y-space-md { centred ? 'flex-col items-center text-center' : 'items-start justify-between' }">
  <div class="grid max-w-reading gap-space-sm">
    <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ heading } /></h2>
    {#if text}<p class="text-lede text-pretty">{ text }</p>{/if}
  </div>
  {#if link_label && link_href && !centred}<Button href={ link_href } tone="outline" small>{ link_label }</Button>{/if}
</div>
{/if}
<Children/>
{#if link_label && link_href && centred}<p class="mt-space-xl text-center"><Button href={ link_href } tone="outline" small>{ link_label }</Button></p>{/if}
