<!-- component: TeamCard -->
<!-- A person: the 4:5 portrait, then the role in small type over the name. Nothing else, and not a link. -->
{#let f = entry.fields}
<article class="grid content-start gap-space-sm { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
  <Well asset={ f.image } alt={ f.image_alt } ratio="aspect-portrait" width={ 640 } sizes="(min-width: 64rem) 18rem, (min-width: 48rem) 33vw, 50vw" />
  <div class="grid gap-space-2xs">
    {#if f.role}<p class="text-small text-scheme-muted">{ f.role }</p>{/if}
    <h3 class="font-heading text-h4 text-balance text-scheme-heading">{ entry.title }</h3>
  </div>
</article>
