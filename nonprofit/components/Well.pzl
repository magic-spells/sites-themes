<!-- component: Well -->
<!-- A picture well: rounded on all four corners (1rem), on the scheme's surface, clipping its picture. ratio is the aspect utility (aspect-landscape by default; aspect-portrait, aspect-square, aspect-video, aspect-capsule), and can carry a breakpoint (aspect-landscape md:aspect-portrait). alt replaces the asset's own alt text (an entry's or a block's image_alt). round rounds it fully: a capsule, or a round thumbnail. Without a picture the well stays as a placeholder of the same shape. Children sit over the picture (the date stamp). cls adds classes (a width, a margin; a radius there loses to the well's own). -->
<span class="relative block overflow-hidden { round ? 'rounded-full' : 'rounded-well' } bg-scheme-surface { ratio ?? 'aspect-landscape' } { cls ?? '' }">
  {#if asset}<img class="size-full object-cover" src="{ image_url(asset, width ?? 800) }" srcset="{ image_srcset(asset, [480, 768, 1024, 1600]) }" sizes="{ sizes ?? '100vw' }" alt="{ alt ?? asset.alt }" loading="{ eager ? 'eager' : 'lazy' }" fetchpriority={ eager ? 'high' : null } width={ asset.width } height={ asset.height } />{/if}
  <Children/>
</span>
