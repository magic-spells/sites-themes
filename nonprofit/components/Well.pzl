<!-- component: Well -->
<!-- A picture well: rounded on all four corners (1rem), on the scheme's surface, clipping its picture. ratio is the aspect utility (aspect-landscape by default; aspect-portrait, aspect-square, aspect-video, aspect-capsule), and can carry a breakpoint (aspect-landscape md:aspect-portrait). The alt text is the asset's own. Without a picture the well stays as a placeholder of the same shape. Children sit over the picture (the date stamp). cls adds classes (rounded-full for a capsule, rounded-sm for a thumbnail). -->
<span class="relative block overflow-hidden rounded-well bg-scheme-surface { ratio ?? 'aspect-landscape' } { cls ?? '' }">
  {#if asset}<img class="size-full object-cover" src="{ image_url(asset, width ?? 800) }" srcset="{ image_srcset(asset, [480, 768, 1024, 1600]) }" sizes="{ sizes ?? '100vw' }" alt="{ asset.alt }" loading="{ eager ? 'eager' : 'lazy' }" fetchpriority={ eager ? 'high' : null } width={ asset.width } height={ asset.height } />{/if}
  <Children/>
</span>
