<!-- The closing ask: the heading at H2, a line and up to two buttons (the first as its style says, solid or outline), centred in the inset rounded panel on its scheme, the page ground around it, at every width. -->
<section class="px-gutter py-section">
  <div class="mx-auto max-w-page">
    <Panel cls="grid justify-items-center gap-space-md text-center">
      <h2 class="max-w-reading font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>
      {#if settings.text}<p class="max-w-reading text-lede text-pretty">{ settings.text }</p>{/if}
      {#if blocks.length}
        <div class="flex flex-wrap justify-center gap-space-sm pt-space-xs">
          {#for block in blocks}<Button href={ block.settings.link } tone={ block.settings.style == 'outline' ? 'outline' : null } editor_id={ block.editor_id }>{ block.settings.label }</Button>{/for}
        </div>
      {/if}
    </Panel>
  </div>
</section>

<schema>
{
  "name": "Ask panel",
  "description": "The closing ask: a heading, a line and two buttons in the inset rounded panel.",
  "kind": "Call to action",
  "icon": "square-round-corner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Help us keep the kitchen open" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "deep" }
  ],
  "blocks": [
    { "type": "button", "name": "Button", "limit": 2, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Donate" },
      { "type": "url", "id": "link", "label": "Link", "default": "/donate" },
      { "type": "select", "id": "style", "label": "Style", "default": "primary", "options": [
        { "value": "primary", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ] }
    ] }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "deep" }, "blocks": [
      { "type": "button", "settings": { "label": "Donate", "link": "/donate", "style": "primary" } },
      { "type": "button", "settings": { "label": "Volunteer", "link": "/get-involved", "style": "outline" } }
    ] }
  ]
}
</schema>
