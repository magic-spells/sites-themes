<!-- Write to us: the heading, the standfirst and the Contact email, phone and address in five parts of twelve; the form, labels kept, in seven from 64rem. -->
{#let s = site.settings}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-page gap-space-xl lg:grid-cols-12">
    <div class="grid content-start justify-items-start gap-space-md lg:col-span-5">
      {#if settings.heading}<h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>{/if}
      {#if settings.text}<p class="max-w-reading text-lede text-pretty">{ settings.text }</p>{/if}
      {#if s.email}<a class="inline-flex items-center gap-space-sm text-link link" href="mailto:{ s.email }"><Glyph name="mail" />{ s.email }</a>{/if}
      {#if s.phone}<a class="inline-flex items-center gap-space-sm tnum text-link link" href="tel:{ s.phone | replace(' ', '') }"><Glyph name="phone" />{ s.phone }</a>{/if}
      {#if s.address}<p class="flex gap-space-sm"><Glyph name="pin" cls="mt-space-2xs size-icon" /><span class="whitespace-pre-line">{ s.address }</span></p>{/if}
    </div>
    <div class="lg:col-span-7"><FormFields handle={ settings.form } prefix="contact-{ section.id }" /></div>
  </div>
</section>

<schema>
{
  "name": "Contact",
  "description": "How to reach you beside a contact form.",
  "kind": "Contact",
  "icon": "mail",
  "settings": [
    { "type": "paragraph", "content": "The email, phone and address come from the Contact settings." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Write to us" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "form", "id": "form", "label": "Form", "default": "contact" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
