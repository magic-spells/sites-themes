<!-- Volunteer: the head and the roles as rows that open and close, beside the volunteer form on a surface card with a hairline edge (on Clay, Moss and Lake the surface is the ground), its labels kept. Stacked on phones, the submit full width; rows in five parts of twelve and the form in seven from 64rem. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-page gap-space-xl lg:grid-cols-12">
    <div class="lg:col-span-5">
      <SectionHead heading={ settings.heading } text={ settings.text }><Rows items={ blocks } /></SectionHead>
    </div>
    <div class="grid content-start gap-space-lg rounded-well border border-scheme-border bg-scheme-surface p-space-md md:p-space-xl lg:col-span-7">
      {#if settings.form_heading}<h3 class="font-heading text-h3 text-scheme-heading">{ settings.form_heading }</h3>{/if}
      <FormFields handle={ settings.form } prefix="volunteer-{ section.id }" />
    </div>
  </div>
</section>

<schema>
{
  "name": "Get involved",
  "description": "Volunteer roles that open and close, beside the volunteer form.",
  "kind": "Contact",
  "icon": "user-round",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get involved" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Sign up to volunteer" },
    { "type": "form", "id": "form", "label": "Form", "default": "volunteer", "info": "Its role choices are the form's own, so keep them in step with the roles here." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "blocks": [
    { "type": "role", "name": "Role", "limit": 8, "settings": [
      { "type": "text", "id": "title", "label": "Role", "default": "Pantry shifts" },
      { "type": "richtext", "id": "body", "label": "What it involves", "default": "" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Default", "settings": {}, "blocks": [
      { "type": "role", "settings": { "title": "Pantry shifts", "body": "<p>Stock the shelves and help neighbours shop. Morning and afternoon shifts, Monday to Saturday.</p>" } },
      { "type": "role", "settings": { "title": "Breakfast kitchen", "body": "<p>Cook and serve the community breakfast, Tuesday and Thursday from 7:30 to 10:00.</p>" } },
      { "type": "role", "settings": { "title": "Delivery drivers", "body": "<p>Take grocery boxes to homes on Friday mornings. You need a licence; we have the van.</p>" } }
    ] }
  ]
}
</schema>
