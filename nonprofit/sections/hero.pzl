<!-- The first screen: the h1, the standfirst and up to two buttons (a Donate button to the giving page, or a link; the first solid, the second outline), in seven parts of twelve beside the picture in five from 64rem; the picture comes after the type on phones, 4:3, then 4:5. Panel: the inset rounded panel on its scheme, the page ground around it. Band: the same on a full-width band. Cover: the picture fills the panel behind the type under a wash of the panel's ground. align centres the type. -->
{#let
  layout = settings.layout
  band = layout == 'band'
  cover = layout == 'cover'
  centre = settings.align == 'center'
  side = settings.image && !cover
}
<section class="px-gutter { band ? 'bg-scheme-background py-section text-scheme-foreground' : 'pt-space-sm pb-gutter md:pt-space-md' }">
  <div class="mx-auto max-w-page">
    <Panel bare={ band } cls="grid items-center gap-space-xl lg:grid-cols-12 { cover ? 'relative isolate overflow-hidden md:min-h-cover' : '' }">
      {#if cover && settings.image}{ image_tag(settings.image, { class: 'absolute inset-0 -z-10 size-full object-cover', sizes: '(min-width: 80rem) 75rem, 100vw', loading: 'eager', fetchpriority: 'high' }) }<span class="absolute inset-0 -z-10 { centre ? 'bg-scheme-background/75' : 'bg-linear-to-r from-scheme-background/90 via-scheme-background/70 to-scheme-background/10' }"></span>{/if}
      <div class="grid gap-space-md { side || !centre ? 'lg:col-span-7' : 'lg:col-span-12' } { centre ? 'justify-items-center text-center' : 'justify-items-start' }">
        <h1 class="max-w-reading font-heading text-h1 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h1>
        {#if settings.text}<p class="max-w-reading text-lede text-pretty">{ settings.text }</p>{/if}
        {#if blocks.length}
          <div class="flex flex-wrap gap-space-sm pt-space-xs">
            {#for block in blocks | slice(0, 2), i}
              {#if block.type == 'give'}<Button give tone={ i ? 'outline' : null } editor_id={ block.editor_id }>{ block.settings.label }</Button>
              {:else}<Button href={ block.settings.link } tone={ i ? 'outline' : null } editor_id={ block.editor_id }>{ block.settings.label }</Button>{/if}
            {/for}
          </div>
        {/if}
      </div>
      {#if side}<div class="lg:col-span-5"><Well asset={ settings.image } ratio="aspect-landscape lg:aspect-portrait" width={ 1200 } sizes="(min-width: 64rem) 30rem, 100vw" eager /></div>{/if}
    </Panel>
  </div>
</section>

<schema>
{
  "name": "Hero",
  "description": "The first screen: a heading, a line and two buttons beside a picture, in the inset rounded panel or on a band.",
  "kind": "Hero",
  "icon": "panel-top",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "panel", "options": [
      { "value": "panel", "label": "Inset panel" },
      { "value": "band", "label": "Band" },
      { "value": "cover", "label": "Picture behind the type" }
    ] },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Centred" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good food for every neighbour" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "image", "id": "image", "label": "Picture", "info": "4:5 beside the type from 64rem, 4:3 on smaller screens. The alt text is the picture's own." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "cream" }
  ],
  "blocks": [
    { "type": "give", "name": "Donate button", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Links to the Organisation giving page, and hides while it is empty." },
      { "type": "text", "id": "label", "label": "Label", "default": "Donate" }
    ] },
    { "type": "link", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Get involved" },
      { "type": "url", "id": "link", "label": "Link", "default": "/get-involved" }
    ] }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Panel", "settings": {}, "blocks": [
      { "type": "give", "settings": { "label": "Donate" } },
      { "type": "link", "settings": { "label": "Get involved", "link": "/get-involved" } }
    ] },
    { "name": "Band", "settings": { "layout": "band" }, "blocks": [
      { "type": "give", "settings": { "label": "Donate" } }
    ] }
  ]
}
</schema>
