<!-- Where to find you, on Chalk: for each place its name in h4 after a pin, the address, the hours on hairlines one line each as typed (tabular figures), a note, and Directions when it has a map link. Stacked on phones, two across from 48rem. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-page">
    <SectionHead heading={ settings.heading } text={ settings.text }>
      <div class="grid gap-space-xl md:grid-cols-2">
        {#for block in blocks}
          {#let b = block.settings}
          <div class="grid content-start justify-items-start gap-space-md" data-block={ block.editor_id }>
            <h3 class="flex items-center gap-space-sm font-heading text-h4 text-scheme-heading"><Glyph name="pin" />{ b.name }</h3>
            {#if b.address}<p class="whitespace-pre-line">{ b.address }</p>{/if}
            {#if b.hours}<ul class="w-full border-t border-scheme-border tnum">{#for line in b.hours | strip | split('\n')}<li class="border-b border-scheme-border py-space-xs">{ line }</li>{/for}</ul>{/if}
            {#if b.note}<p class="text-small text-pretty text-scheme-muted">{ b.note }</p>{/if}
            {#if b.map_link}<a class="text-link link" href="{ b.map_link }">{ t('hours_location.directions') }</a>{/if}
          </div>
        {/for}
      </div>
    </SectionHead>
  </div>
</section>

<schema>
{
  "name": "Hours and location",
  "description": "Each place you work from, with its address, hours and directions.",
  "kind": "Location",
  "icon": "map-pin",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "chalk" }
  ],
  "blocks": [
    { "type": "location", "name": "Location", "limit": 4, "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Mill Hall" },
      { "type": "textarea", "id": "address", "label": "Address", "default": "" },
      { "type": "textarea", "id": "hours", "label": "Hours", "default": "", "info": "One line each, printed as you type them: Pantry: Mon, Wed, Fri 10:00–14:00." },
      { "type": "text", "id": "note", "label": "Note", "default": "", "info": "Access, parking or a closure." },
      { "type": "url", "id": "map_link", "label": "Map link", "default": "", "info": "A Directions link shows when it is set." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "chalk" } }
  ]
}
</schema>
