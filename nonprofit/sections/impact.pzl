<!-- What the year added up to, in plain dated figures: the head (its standfirst carries the period) with the report pill, then the figures, each the number in the heading face at H1 over its label, on a hairline: stacked on phones, two across from 48rem, and from 64rem all in one row, or two across beside the split. The split, when it has a heading and rows: each share's label and percent over a <meter> bar, under the figures, and beside them from 64rem (figures 7 / split 5). No count-up. -->
{#let
  figures = blocks | where('type', 'figure')
  shares = blocks | where('type', 'split')
  split = settings.split_heading && shares.length
  reveal = site.settings.reveal ? 'reveal reveal-fade-up' : ''
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-page">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link }>
      <div class="grid items-start gap-space-xl lg:grid-cols-12">
        <ul class="grid gap-space-lg { figures.length > 1 ? 'md:grid-cols-2' : '' } { split ? 'lg:col-span-7' : 'lg:col-span-12 lg:grid-flow-col lg:grid-cols-none lg:auto-cols-fr' }">
          {#for block in figures}
            <li class="grid content-start gap-space-2xs border-t border-scheme-border pt-space-md { reveal }" data-block={ block.editor_id }>
              <p class="font-heading text-h1 text-scheme-heading">{ block.settings.figure }</p>
              <p>{ block.settings.label }</p>
            </li>
          {/for}
        </ul>
        {#if split}
          <div class="grid content-start gap-space-md lg:col-span-5">
            <h3 class="font-heading text-h4 text-scheme-heading">{ settings.split_heading }</h3>
            <ul class="grid gap-space-md">
              {#for block in shares}
                <li class="grid gap-space-xs" data-block={ block.editor_id }>
                  <p class="flex justify-between gap-space-md"><span>{ block.settings.label }</span><span class="tnum">{ block.settings.percent | percentage }</span></p>
                  <meter class="block h-space-2xs w-full appearance-none rounded-full bg-scheme-border" min="0" max="100" value="{ block.settings.percent }" aria-hidden="true"></meter>
                </li>
              {/for}
            </ul>
          </div>
        {/if}
      </div>
    </SectionHead>
  </div>
</section>

<schema>
{
  "name": "Impact",
  "description": "Dated figures for the year, and where a gift goes.",
  "kind": "Content",
  "icon": "hash",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our impact" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "", "info": "Name the period the figures cover: Between July 2025 and June 2026." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "", "info": "A pill beside the heading: Annual report." },
    { "type": "url", "id": "link", "label": "Button link", "default": "" },
    { "type": "text", "id": "split_heading", "label": "Split heading", "default": "Where a gift goes", "info": "Heads the split rows. Leave empty to hide the split." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "blocks": [
    { "type": "figure", "name": "Figure", "limit": 4, "settings": [
      { "type": "text", "id": "figure", "label": "Figure", "default": "41,200" },
      { "type": "text", "id": "label", "label": "Label", "default": "meals served" }
    ] },
    { "type": "split", "name": "Split row", "limit": 5, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Food and meals" },
      { "type": "range", "id": "percent", "label": "Share", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
    ] }
  ],
  "presets": [
    { "name": "Figures", "settings": { "split_heading": "" }, "blocks": [
      { "type": "figure", "settings": { "figure": "41,200", "label": "meals served" } },
      { "type": "figure", "settings": { "figure": "3,150", "label": "households at the pantry" } },
      { "type": "figure", "settings": { "figure": "620", "label": "volunteers" } }
    ] },
    { "name": "Figures and split", "settings": {}, "blocks": [
      { "type": "figure", "settings": { "figure": "41,200", "label": "meals served" } },
      { "type": "figure", "settings": { "figure": "3,150", "label": "households at the pantry" } },
      { "type": "figure", "settings": { "figure": "620", "label": "volunteers" } },
      { "type": "split", "settings": { "label": "Food and meals", "percent": 78 } },
      { "type": "split", "settings": { "label": "Running the kitchen", "percent": 13 } },
      { "type": "split", "settings": { "label": "Fundraising", "percent": 6 } },
      { "type": "split", "settings": { "label": "Office", "percent": 3 } }
    ] }
  ]
}
</schema>
