<!-- News, newest first; on a post's page it leaves that post out, and with no other post the section shows nothing. Grid: cards with the day stamped on the well, two across from 48rem and three from 64rem. Feature: the newest across the row, its picture beside the title and standfirst from 64rem, then two across. List: the topic and date over each title, on hairlines. Topics: a row of links, All then each topic, each reloading the page with ?topic= so it works without JavaScript; the current one underlined. -->
{#let
  all = content.posts.entries | sort('fields.date') | reverse | reject('id', page.entry.id)
  topic = settings.topics ? request.query.topic : null
  posts = (topic ? all | where('fields.topic', topic) : all) | slice(0, settings.limit)
  view = settings.view
}
{#if all.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-page">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link }>
      {#if settings.topics}
        <nav class="mb-space-xl flex flex-wrap gap-x-space-md gap-y-space-xs text-label" aria-label="{ t('journal_list.topics') }">
          <a class="link-quiet" href="{ page.path }" aria-current={ topic ? null : 'page' }>{ t('journal_list.all') }</a>
          {#for name in all | map('fields.topic') | compact | uniq | sort}<a class="link-quiet" href="{ page.path }?topic={ encodeURIComponent(name) }" aria-current={ topic == name ? 'page' : null }>{ name }</a>{/for}
        </nav>
      {/if}
      <ul class="{ view == 'list' ? 'border-t border-scheme-border' : 'grid gap-x-space-md gap-y-space-xl md:grid-cols-2' } { view == 'grid' ? 'lg:grid-cols-3' : '' }">
        {#for entry in posts, i}<li class="{ view == 'feature' && i == 0 ? 'md:col-span-2' : '' }"><PostCard entry={ entry } href="{ settings.base_path }/{ entry.handle }" feature={ view == 'feature' && i == 0 } row={ view == 'list' } /></li>{/for}
      </ul>
    </SectionHead>
  </div>
</section>
{/if}

<schema>
{
  "name": "News list",
  "description": "Posts, newest first: a grid, a feature then a grid, or a list, with topic links.",
  "kind": "Collections",
  "icon": "newspaper",
  "settings": [
    { "type": "select", "id": "view", "label": "View", "default": "grid", "options": [
      { "value": "grid", "label": "Grid" },
      { "value": "feature", "label": "The newest large, then a grid" },
      { "value": "list", "label": "List" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "News" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "topics", "label": "Topic links", "default": false, "info": "A row of links, All then each topic, over the posts. Each reloads the page with ?topic= in the address." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "All news" },
    { "type": "url", "id": "link", "label": "Button link", "default": "/news" },
    { "type": "url", "id": "base_path", "label": "Post pages", "default": "/news", "info": "Each post links to this path and its handle." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Grid", "settings": {} },
    { "name": "News page", "settings": { "heading": "", "limit": 12, "topics": true, "link_label": "" } }
  ]
}
</schema>
