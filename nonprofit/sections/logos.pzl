<!-- Partners and funders, each a logo at one height or its name in the heading face. Grid: hairline tiles two across, three from 48rem, four from 64rem. Marquee: one row on a slow marquee with a pause button, standing still for visitors who ask for less motion. -->
{#let marquee = settings.layout == 'marquee'}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" data-ticker={ marquee }>
  <div class="mx-auto max-w-page">
    <SectionHead heading={ settings.heading }>
      {#if marquee}
        <div class="flex items-center gap-space-xs">
          <scrolling-content class="block min-w-0 flex-1" speed="30" fade>
            <scrolling-track class="gap-space-xl">
              <scrolling-item class="gap-space-xl whitespace-nowrap">{#for block in blocks}<Logo logo={ block.settings } editor_id={ block.editor_id } />{/for}</scrolling-item>
            </scrolling-track>
          </scrolling-content>
          <button class="-me-space-xs flex size-tap shrink-0 items-center justify-center rounded-full hover:bg-scheme-outline-hover" type="button" data-ticker-toggle aria-pressed="false"><Glyph name="pause" cls="size-icon-sm" /><span class="sr-only">{ t('pause') }</span></button>
        </div>
      {:else}
        <ul class="grid grid-cols-2 gap-space-sm md:grid-cols-3 md:gap-space-md lg:grid-cols-4">
          {#for block in blocks}<li class="flex items-center justify-center rounded-well border border-scheme-border p-space-md md:p-space-lg"><Logo logo={ block.settings } editor_id={ block.editor_id } /></li>{/for}
        </ul>
      {/if}
    </SectionHead>
  </div>
</section>

<schema>
{
  "name": "Partners",
  "description": "The logos of your partners and funders, as a grid or a slow marquee.",
  "kind": "Collections",
  "icon": "handshake",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our partners" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [
      { "value": "grid", "label": "Grid" },
      { "value": "marquee", "label": "Marquee" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "blocks": [
    { "type": "logo", "name": "Logo", "limit": 12, "settings": [
      { "type": "image", "id": "image", "label": "Logo", "info": "Shown at one height. Without one, the name is set in the heading face." },
      { "type": "text", "id": "name", "label": "Name", "default": "Partner", "info": "The logo's alt text." },
      { "type": "url", "id": "link", "label": "Link", "default": "" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Grid", "settings": { "layout": "grid" } },
    { "name": "Marquee", "settings": { "layout": "marquee" } }
  ]
}
</schema>
