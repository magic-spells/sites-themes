<!-- The newsletter, centred on Chalk: the heading and a line over one field whose label is its placeholder (the label stays for screen readers) beside the button, stacked on phones; the sent and error states in its place. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-page justify-items-center gap-space-lg text-center">
    <div class="grid max-w-reading gap-space-sm">
      <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>
      {#if settings.text}<p class="text-lede text-pretty">{ settings.text }</p>{/if}
    </div>
    <Form handle={ site.settings.newsletter_form } class="grid w-full max-w-form gap-space-sm" id="form-news-{ section.id }">
      {#if form.sent}
        <p class="text-lede" role="status">{ form.success_message || t('form_success') }</p>
      {:else}
        <div class="flex flex-col gap-space-sm text-left md:flex-row md:items-start">
          {#for field in form.fields}<Field field={ field } prefix="news-{ section.id }" cls="min-w-0 flex-1" bare />{/for}
          <Button type="submit">{ form.submit_label || t('sign_up') }</Button>
        </div>
        {#if form.error}<p class="text-small text-scheme-error" role="alert">{ t('form_error') }</p>{/if}
        <noscript><p class="text-small text-scheme-muted">{ t('form_requires_javascript') }</p></noscript>
      {/if}
    </Form>
  </div>
</section>

<schema>
{
  "name": "Newsletter",
  "description": "A heading, a line and one email field.",
  "kind": "Contact",
  "icon": "mail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "chalk" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "chalk" } }
  ]
}
</schema>
