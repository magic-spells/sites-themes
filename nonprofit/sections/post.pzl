<!-- A post's page: the h1, one line with the topic and the date, the standfirst in the lede size, the picture across the page column (4:3, 16:9 from 48rem) when it has one, then the body in the reading column. No author line, no reading time. -->
{#let f = page.entry.fields}
<article class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-page gap-space-xl">
    <div class="grid max-w-reading gap-space-md">
      <h1 class="font-heading text-h1 text-balance text-scheme-heading"><Rise text={ page.entry.title } /></h1>
      <p class="text-scheme-muted tnum">{#if f.topic}{ f.topic } · {/if}<Day value={ f.date } /></p>
      {#if f.standfirst}<p class="text-lede text-pretty">{ f.standfirst }</p>{/if}
    </div>
    {#if f.image}<Well asset={ f.image } ratio="aspect-landscape md:aspect-video" width={ 1600 } sizes="(min-width: 80rem) 75rem, 100vw" eager />{/if}
    <div class="prose max-w-reading text-body">{ f.body }</div>
  </div>
</article>

<schema>
{
  "name": "Post",
  "description": "A post's title, topic and date, standfirst, picture and body.",
  "kind": "Content",
  "icon": "file-text",
  "templates": ["post"],
  "settings": [
    { "type": "paragraph", "content": "Everything here comes from the post." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
