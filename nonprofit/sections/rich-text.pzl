<!-- Prose in the 40rem reading column, at the left of the page column so it lines up with the page header: an optional heading, then the rich text, or the page's own body when the text is empty. -->
{#let body = settings.text || page.content}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-page">
    <div class="grid max-w-reading gap-space-md">
      {#if settings.heading}<h2 class="font-heading text-h2 text-balance text-scheme-heading"><Rise text={ settings.heading } /></h2>{/if}
      {#if body}<div class="prose text-body">{ body }</div>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Rich text",
  "description": "A heading and prose in a reading column; the page's own body when the text is empty.",
  "kind": "Content",
  "icon": "text-align-start",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "", "info": "Leave empty to show the page's own body." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Default", "settings": {} }
  ]
}
</schema>
