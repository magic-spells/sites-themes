<!-- The people in their order, all or one group (the entry's group field), as portrait cards: two across on phones, three from 48rem, four from 64rem. -->
{#let
  all = content.team.entries | sort('fields.order')
  people = (settings.group == 'all' ? all : all | where('fields.group', settings.group)) | slice(0, settings.limit)
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-page">
    <SectionHead heading={ settings.heading } text={ settings.text }>
      <ul class="grid grid-cols-2 gap-x-space-sm gap-y-space-xl md:grid-cols-3 md:gap-x-space-md lg:grid-cols-4">
        {#for entry in people}<li><TeamCard entry={ entry } /></li>{/for}
      </ul>
    </SectionHead>
  </div>
</section>

<schema>
{
  "name": "Team",
  "description": "Your staff, board or volunteers as portraits with their roles.",
  "kind": "Collections",
  "icon": "users",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our team" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "group", "label": "People", "default": "all", "options": [
      { "value": "all", "label": "All" },
      { "value": "Staff", "label": "Staff" },
      { "value": "Board", "label": "Board" },
      { "value": "Volunteers", "label": "Volunteers" }
    ], "info": "The group set on each person." },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 12 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "presets": [
    { "name": "Staff", "settings": { "group": "Staff" } },
    { "name": "Board", "settings": { "group": "Board", "heading": "Our board" } }
  ]
}
</schema>
