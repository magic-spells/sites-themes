<!-- Every way to give besides the card: the head in five parts of twelve beside the rows in seven from 64rem, stacked on phones. Each row opens to its text and link, and carries its anchor as its id, so /donate#food lands on that row and opens it. Under the rows, the Organisation tax line and the Contact address for cheques, one short line each. -->
{#let s = site.settings}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-page gap-x-space-xl lg:grid-cols-12">
    <div class="lg:col-span-5"><SectionHead heading={ settings.heading } text={ settings.text } /></div>
    <div class="grid content-start gap-space-md lg:col-span-7">
      <Rows items={ blocks } />
      {#if s.tax_line || s.address}
        <div class="grid gap-space-2xs text-small text-scheme-muted">
          {#if s.tax_line}<p>{ s.tax_line }</p>{/if}
          {#if s.address}<p>{ t('ways_to_give.cheques', { address: s.address | split('\n') | join(', ') }) }</p>{/if}
        </div>
      {/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Ways to give",
  "description": "Every other way to give, as rows that open and close.",
  "kind": "Content",
  "icon": "list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Other ways to give" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "paragraph", "content": "The tax line and the cheque address under the rows come from the Organisation and Contact settings." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" }
  ],
  "blocks": [
    { "type": "way", "name": "Way to give", "limit": 10, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Give monthly" },
      { "type": "richtext", "id": "body", "label": "Text", "default": "" },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "" },
      { "type": "url", "id": "link", "label": "Link", "default": "" },
      { "type": "text", "id": "anchor", "label": "Anchor", "default": "", "info": "One lowercase word, so a link to /donate#food opens this row." }
    ] }
  ],
  "max_blocks": 10,
  "presets": [
    { "name": "Default", "settings": {}, "blocks": [
      { "type": "way", "settings": { "title": "Give monthly", "body": "<p>A monthly gift lets us order food weeks ahead. Change or stop it at any time.</p>", "anchor": "monthly" } },
      { "type": "way", "settings": { "title": "Donate food", "body": "<p>We take tins, dry goods and toiletries at Mill Hall on any pantry day.</p>", "anchor": "food" } },
      { "type": "way", "settings": { "title": "Leave a gift in your will", "body": "<p>Our registration number is in the footer. Write to us and we will send the wording.</p>", "anchor": "will" } }
    ] }
  ]
}
</schema>
