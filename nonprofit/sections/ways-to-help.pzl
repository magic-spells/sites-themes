<!-- Ways to help, money one card among them: the head, then up to four cards, each a single link holding its picture, title and one line. On phones a column of rows, the square thumbnail beside the title; from 48rem two across with 4:3 wells over the text; from 64rem four across, or three when there are three. -->
{#let reveal = site.settings.reveal ? 'reveal reveal-fade-up' : ''}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-page">
    <SectionHead heading={ settings.heading } text={ settings.text }>
      <ul class="grid gap-space-md md:grid-cols-2 md:gap-x-space-lg md:gap-y-space-xl { blocks.length == 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4' }">
        {#for block in blocks}
          {#let b = block.settings}
          <li class="{ reveal }" data-block={ block.editor_id }>
            <a class="group flex items-center gap-space-sm md:flex-col md:items-stretch" href="{ b.link }">
              <Well asset={ b.image } ratio="aspect-square md:aspect-landscape" cls="w-thumb shrink-0 md:w-full" sizes="(min-width: 64rem) 18rem, (min-width: 48rem) 45vw, 5rem" />
              <div class="grid gap-space-2xs">
                <h3 class="font-heading text-h4 text-balance text-scheme-heading decoration-1 underline-offset-4 group-hover:underline">{ b.title }</h3>
                {#if b.text}<p class="text-scheme-muted">{ b.text }</p>{/if}
              </div>
            </a>
          </li>
        {/for}
      </ul>
    </SectionHead>
  </div>
</section>

<schema>
{
  "name": "Ways to help",
  "description": "Up to four cards: volunteer, give food, fundraise, give money.",
  "kind": "Collections",
  "icon": "list-checks",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ways to help" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "chalk" }
  ],
  "blocks": [
    { "type": "way", "name": "Way to help", "limit": 4, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Volunteer" },
      { "type": "text", "id": "text", "label": "Line", "default": "" },
      { "type": "image", "id": "image", "label": "Picture", "info": "Square on phones, 4:3 from tablets." },
      { "type": "url", "id": "link", "label": "Link", "default": "/get-involved" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "chalk" }, "blocks": [
      { "type": "way", "settings": { "title": "Volunteer", "text": "Cook, stock shelves or drive the van.", "link": "/get-involved" } },
      { "type": "way", "settings": { "title": "Donate food", "text": "Bring tins and dry goods to Mill Hall.", "link": "/donate#food" } },
      { "type": "way", "settings": { "title": "Fundraise", "text": "Run, bake or host a supper for us.", "link": "/donate#fundraise" } },
      { "type": "way", "settings": { "title": "Give money", "text": "Once or monthly, through our giving page.", "link": "/donate" } }
    ] }
  ]
}
</schema>
