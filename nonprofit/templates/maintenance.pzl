<!-- template: Maintenance -->
<!-- layout: default -->
<!-- The site paused, on the base scheme with no header or footer: the wordmark, "Back soon." and one line with the email for anything urgent. -->
<Utility bare>
  <p class="font-heading text-h3">{ site.settings.wordmark || site.name }</p>
  <h1 class="font-heading text-h2 text-balance text-scheme-heading">{ t('maintenance_title') }</h1>
  {#if site.settings.email}<p class="text-body text-pretty">{ t('maintenance_body', { email: site.settings.email }) }</p>{/if}
</Utility>
