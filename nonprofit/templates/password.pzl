<!-- template: Password -->
<!-- layout: default -->
<!-- The site behind a password, on the base scheme with no header or footer: the wordmark, the line, then the password field over Enter in the form column. -->
<Utility bare>
  <div class="grid w-full max-w-form gap-space-md text-left">
    <p class="font-heading text-h3">{ site.settings.wordmark || site.name }</p>
    <h1 class="text-body">{ t('password_body') }</h1>
    <form class="grid gap-space-md" method="post" action="/_sites/unlock">
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}<p class="text-small text-scheme-error" role="alert">{ request.query.password_error }</p>{/if}
      <Field field={ { id: 'password', label: t('password_label'), type: 'password', required: true } } autocomplete="current-password" prefix="password" />
      <Button type="submit">{ t('password_submit') }</Button>
    </form>
  </div>
</Utility>
