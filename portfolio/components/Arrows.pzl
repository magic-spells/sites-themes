<!-- component: Arrows -->
<!-- props: bar -->
<!-- A carousel's chrome under its track: bar (an id) holds tarot's progress hairline across the row, and the previous and next buttons sit at its right end: round and transparent, a hairline in the border colour around a glyph in the text colour, surface-2 on hover, hidden below 48rem. Tarot finds the buttons by their data-action attributes. -->
{#let classes = 'flex size-control max-md:hidden items-center justify-center rounded-full border border-scheme-border transition-colors duration-fast hover:bg-scheme-surface-2 disabled:pointer-events-none disabled:opacity-40'}
<div class="mt-space-md flex items-center justify-end gap-space-xs">
  {#if bar}<div class="me-space-md flex-1" id="{ bar }"></div>{/if}
  <button class="{ classes }" type="button" data-action-tarot-previous aria-label="{ t('previous') }"><Glyph name="arrow-left" /></button>
  <button class="{ classes }" type="button" data-action-tarot-next aria-label="{ t('next') }"><Glyph name="arrow-right" /></button>
</div>
