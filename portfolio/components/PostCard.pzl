<!-- component: PostCard -->
<!-- props: entry base_path layout -->
<!-- A post, one link. list (the default): a row on a hairline, the title at h3, the standfirst in muted and "Topic · Sep 14, 2026" in meta. card: the 3:2 picture, then the title, the meta line and the standfirst. Dates only, no reading time. -->
{#let
  f = entry.fields
  meta = [f.topic || null, f.date ? f.date | date : null] | compact | join(' · ')
  href = (base_path ?? '/writing') + '/' + entry.handle
}
<article class="group grid gap-space-xs { layout == 'card' ? 'content-start' : 'border-b border-scheme-border py-space-md' } { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
  {#if layout == 'card'}<a class="mb-space-xs block" href="{ href }" tabindex="-1" aria-hidden="true"><Picture asset={ f.image } alt="" ratio="aspect-photo" sizes="(min-width: 48rem) 50vw, 100vw" /></a>{/if}
  <h3 class="text-h3 text-balance"><a class="underline-offset-4 hover:underline" href="{ href }">{ entry.title }</a></h3>
  {#if f.standfirst}<p class="text-body text-pretty text-scheme-muted">{ f.standfirst }</p>{/if}
  <p class="text-body-sm text-scheme-meta">{ meta }</p>
</article>
