<!-- TODO sync with Figma -->
<!-- The collections: one card per category in order, each its first works' covers in a tight row with its name and line below them, linking to the work index filtered to it. Two cards across from 64rem, one below. -->
{#let
  cats = content.categories.entries | sort('fields.order')
  handles = (settings.source == 'handles' ? settings.handles | replace(' ', '') | split(',') : cats | map('handle')) | slice(0, settings.limit)
  works = content.works.entries | sort('fields.order')
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } />
    <ul class="grid gap-x-grid gap-y-space-xl lg:grid-cols-2">
      {#for handle in handles}
        {#let category = cats | find('handle', handle)}
        {#if category}<li><CollectionCard category={ category } works={ works | where('fields.category.handle', handle) } covers={ settings.covers == '4' ? 4 : 3 } arrangement={ settings.arrangement } base_path={ settings.base_path } /></li>{/if}
      {/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Collections",
  "description": "One card per category: its first works' covers in a row, then its name and a line.",
  "kind": "Collections",
  "icon": "gallery-thumbnails",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All work" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/work" },
    { "type": "select", "id": "source", "label": "Collections", "default": "all", "options": [
      { "value": "all", "label": "All, in order" },
      { "value": "handles", "label": "Chosen" }
    ] },
    { "type": "text", "id": "handles", "label": "Chosen collections", "default": "", "info": "For Chosen: category handles, comma separated, in the order to show them (identity, books)." },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "select", "id": "covers", "label": "Covers", "default": "3", "options": [
      { "value": "3", "label": "Three" },
      { "value": "4", "label": "Four" }
    ] },
    { "type": "select", "id": "arrangement", "label": "Arrangement", "default": "row", "options": [
      { "value": "row", "label": "A row of squares" },
      { "value": "lead", "label": "One tall, two stacked" }
    ] },
    { "type": "url", "id": "base_path", "label": "Work page path", "default": "/work", "info": "Each card links here, filtered to its category." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Row", "settings": { "color_scheme": "paper" } },
    { "name": "Lead", "settings": { "arrangement": "lead", "color_scheme": "paper" } }
  ]
}
</schema>
