<!-- TODO sync with Figma -->
<!-- The usual close: the heading, one line, the email from Person large (h3 size) and underlined, the social links as text in a row. -->
{#let s = site.settings}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column justify-items-start gap-space-md">
    <h2 class="text-h2 text-balance text-scheme-heading">{ settings.heading }</h2>
    {#if settings.text}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
    {#if s.email}<a class="text-h3 break-all text-link underline decoration-1 underline-offset-4" href="mailto:{ s.email }">{ s.email }</a>{/if}
    {#if settings.social_menu.items.length}
      <ul class="flex flex-wrap gap-x-space-md gap-y-space-xs text-body">
        {#for item in settings.social_menu.items}<li><a class="text-link underline decoration-1 underline-offset-4" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null }>{ item.label }</a></li>{/for}
      </ul>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Contact band",
  "description": "A heading, a line, your email large and the social links.",
  "kind": "Contact",
  "icon": "mail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
    { "type": "text", "id": "text", "label": "Text", "default": "For commissions, talks and collaborations." },
    { "type": "menu", "id": "social_menu", "label": "Social menu" },
    { "type": "paragraph", "content": "The email is Person's." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "stone" }
  ],
  "presets": [
    { "name": "Stone", "settings": { "social_menu": "social", "color_scheme": "stone" } },
    { "name": "Cobalt", "settings": { "social_menu": "social", "color_scheme": "cobalt" } }
  ]
}
</schema>
