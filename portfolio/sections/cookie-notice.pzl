<!-- TODO sync with Figma -->
<!-- A non-modal notice: the page stays usable behind it. It renders hidden; theme.ts shows it once per key, both buttons hide it and the choice is remembered. Square, on surface-2 with a hairline: full width on a phone, bottom right from 48rem. -->
<section class="fixed inset-x-0 bottom-0 z-40 border-t border-scheme-border bg-scheme-surface-2 text-scheme-foreground md:inset-x-auto md:right-gutter md:bottom-gutter md:w-full md:max-w-notice md:border" id="cookie-notice" data-notice="{ settings.key }" role="region" aria-label="{ t('cookie_notice') }" hidden>
  <div class="grid gap-space-md p-space-md md:p-space-lg">
    <div class="sites-prose text-body-sm">{ settings.body }</div>
    <div class="flex flex-wrap items-center gap-space-xs">
      <Button type="button">{ settings.accept_label }</Button>
      {#if settings.decline_label}<Button type="button">{ settings.decline_label }</Button>{/if}
      {#if settings.link_label}<a class="ms-space-xs text-body-sm text-link underline decoration-1 underline-offset-4" href="{ settings.link_href }">{ settings.link_label }</a>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Cookie notice",
  "description": "A short notice shown once per visitor.",
  "kind": "Panels",
  "icon": "cookie",
  "settings": [
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>A few cookies keep the site working. Nothing is sold.</p>" },
    { "type": "text", "id": "accept_label", "label": "Accept label", "default": "Accept" },
    { "type": "text", "id": "decline_label", "label": "Decline label", "default": "Decline" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Privacy" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/privacy" },
    { "type": "text", "id": "key", "label": "Key", "default": "portfolio-notice", "info": "Change the key to show the notice again to everyone." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
