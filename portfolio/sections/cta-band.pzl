<!-- A centred h2, a line and one or two outlined buttons, on any scheme. The contact band is the usual close; this is for the rare page that wants a call. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading justify-items-center gap-space-md text-center">
    <h2 class="text-h2 text-balance text-scheme-heading">{ settings.heading }</h2>
    {#if settings.text}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
    <div class="flex flex-wrap justify-center gap-space-xs pt-space-xs">
      {#if settings.link_label && settings.link_href}<Button href={ settings.link_href }>{ settings.link_label }</Button>{/if}
      {#if settings.second_label && settings.second_href}<Button href={ settings.second_href }>{ settings.second_label }</Button>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Call to action",
  "description": "A centred heading, a line and one or two buttons.",
  "kind": "Content",
  "icon": "mouse-pointer-click",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Commissions" },
    { "type": "text", "id": "text", "label": "Text", "default": "A few a year, from January." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Contact" },
    { "type": "url", "id": "link_href", "label": "Button link", "default": "/contact" },
    { "type": "text", "id": "second_label", "label": "Second button label", "default": "" },
    { "type": "url", "id": "second_href", "label": "Second button link", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "stone" }
  ],
  "presets": [
    { "name": "Stone", "settings": { "color_scheme": "stone" } },
    { "name": "Cobalt", "settings": { "color_scheme": "cobalt" } }
  ]
}
</schema>
