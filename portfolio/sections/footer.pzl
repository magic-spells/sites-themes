<!-- TODO sync with Figma -->
<!-- The colophon: the wordmark and the status line small under it at the left; the main menu, then the social and legal menus, as text links at the right edge. No year, no form. -->
<footer class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto flex max-w-column flex-wrap items-start justify-between gap-x-space-2xl gap-y-space-xl">
    <div class="grid gap-space-xs">
      <a class="justify-self-start text-h4" href="/">{ site.settings.wordmark || site.name }</a>
      {#if settings.show_status}<Status cls="text-scheme-muted" />{/if}
    </div>
    <div class="flex flex-wrap gap-x-space-2xl gap-y-space-lg">
      {#for menu in [settings.menu, settings.social_menu, settings.legal_menu], i}
        {#if menu && menu.items.length}
          <nav aria-label="{ menu.title }">
            <ul class="grid gap-space-xs { i ? 'text-body-sm text-scheme-muted' : 'text-body' }">
              {#for item in menu.items}<li><a class="underline-offset-4 hover:text-scheme-foreground hover:underline" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null }>{ item.label }</a></li>{/for}
            </ul>
          </nav>
        {/if}
      {/for}
    </div>
  </div>
</footer>

<schema>
{
  "name": "Footer",
  "description": "The colophon: the wordmark, the status line and the menus as text links.",
  "kind": "Footer",
  "icon": "panel-bottom",
  "settings": [
    { "type": "menu", "id": "menu", "label": "Menu" },
    { "type": "menu", "id": "social_menu", "label": "Social menu", "info": "Text links." },
    { "type": "menu", "id": "legal_menu", "label": "Legal menu" },
    { "type": "checkbox", "id": "show_status", "label": "Status line", "default": true, "info": "The availability dot and line from Person." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "ink", "info": "Pick a scheme that differs from the band above." }
  ],
  "presets": [
    { "name": "Ink", "settings": { "menu": "main", "social_menu": "social", "legal_menu": "legal", "color_scheme": "ink" } }
  ]
}
</schema>
