<!-- TODO sync with Figma -->
<!-- STUB (code B builds it): the head, then the gallery's photos as an equal grid with their captions under them. -->
{#let items = settings.gallery ? settings.gallery.items : []}
{#if items.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid grid-cols-2 gap-grid lg:grid-cols-3">
      {#for item in items | slice(0, 12)}<li><Picture asset={ item.asset } alt={ item.alt } ratio="aspect-square" caption={ settings.caption ? item.caption : '' } /></li>{/for}
    </ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Gallery grid",
  "description": "A gallery's photos as an equal grid that opens a lightbox.",
  "kind": "Content",
  "icon": "images",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "gallery", "id": "gallery", "label": "Gallery" },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3", "options": [
      { "value": "2", "label": "Two" },
      { "value": "3", "label": "Three" },
      { "value": "4", "label": "Four" }
    ] },
    { "type": "select", "id": "ratio", "label": "Ratio", "default": "1:1", "options": [
      { "value": "1:1", "label": "1:1" },
      { "value": "4:5", "label": "4:5" },
      { "value": "3:2", "label": "3:2" }
    ] },
    { "type": "checkbox", "id": "caption", "label": "Captions", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
