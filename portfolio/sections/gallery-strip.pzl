<!-- TODO sync with Figma -->
<!-- STUB (code B builds it): the head, then a tarot row of equal photos with their captions under them, the progress hairline and the arrows under the track. -->
{#let
  items = settings.gallery ? settings.gallery.items | slice(0, 12) : []
  id = 'strip-' + section.id
}
{#if items.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <tarot-carousel class="mx-auto block max-w-column" id={ id } data-track>
    <script type="application/json" data-tarot-options>{ { progressBar: { selector: '#bar-' + id }, slidesPerView: 1.2, gap: '1rem', navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { slidesPerView: 2.5, gap: '1.5rem', navigation: { showButtons: true, showPagination: false } } } } | json }</script>
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } />
    <tarot-viewport>
      <tarot-track>
        {#for item in items}<tarot-slide><Picture asset={ item.asset } alt={ item.alt } ratio="aspect-portrait" caption={ item.caption } /></tarot-slide>{/for}
      </tarot-track>
    </tarot-viewport>
    <Arrows bar="bar-{ id }" />
  </tarot-carousel>
</section>
{/if}

<schema>
{
  "name": "Gallery strip",
  "description": "A row of photos from a gallery, equal widths, captions under them.",
  "kind": "Content",
  "icon": "gallery-horizontal",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "" },
    { "type": "gallery", "id": "gallery", "label": "Gallery" },
    { "type": "select", "id": "slide_ratio", "label": "Slide ratio", "default": "4:5", "options": [
      { "value": "1:1", "label": "1:1" },
      { "value": "4:5", "label": "4:5" },
      { "value": "3:2", "label": "3:2" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
