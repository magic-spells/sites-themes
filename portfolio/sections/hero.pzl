<!-- The opening band, three ways. name: the role and location line, then after md the name as the h1 at 110% width, blooming in word by word. statement: the two-tone statement at h1 size, the name kept as a hidden h1. picture: a photo (4:5 on a phone) with the name, a line and the buttons below it or above it, never on it; inset draws the photo inside the gutters, off bleeds it to the screen edges. -->
{#let
  s = site.settings
  name = settings.heading || s.wordmark || site.name
  line = [s.role_line || null, s.location || null] | compact | join(' · ')
  bloom = s.reveal
}
<section class="bg-scheme-background py-section text-scheme-foreground { settings.layout == 'picture' ? '' : 'px-gutter' }">
  {#case settings.layout}
    {:when 'statement'}
      <div class="mx-auto grid max-w-column gap-space-xl">
        <h1 class="sr-only">{ name }</h1>
        <Statement text={ settings.statement } muted={ settings.statement_muted } size="h1" align={ settings.align } />
        {#if settings.show_status}<Status cls="{ settings.align == 'centre' ? 'justify-center' : '' }" />{/if}
      </div>
    {:when 'picture'}
      <div class="flex flex-col gap-space-xl">
        <div class="px-gutter">
          <div class="mx-auto grid max-w-column justify-items-start gap-space-sm">
            <h1 class="font-wide text-h1 text-balance">{#if bloom}<split-text effect="bloom" split="words" stagger="40">{ name }</split-text>{:else}{ name }{/if}</h1>
            {#if settings.text}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
            {#if settings.show_status}<Status />{/if}
            <div class="flex flex-wrap gap-space-xs pt-space-xs empty:hidden">
              {#if settings.link_label && settings.link_href}<Button href={ settings.link_href }>{ settings.link_label }</Button>{/if}
              {#if settings.show_cv && s.cv_link.href}<Button href={ s.cv_link.href } external={ true }>{ s.cv_link.label }</Button>{/if}
            </div>
          </div>
        </div>
        <div class="{ settings.type == 'above' ? '' : 'order-first' } { settings.inset ? 'px-gutter' : '' }">
          <div class="mx-auto overflow-hidden bg-scheme-surface-2 aspect-portrait { settings.ratio } { settings.inset ? 'max-w-column' : '' }">{#if settings.image}<img class="size-full object-cover" src="{ image_url(settings.image, 2000) }" srcset="{ image_srcset(settings.image, [768, 1280, 2000, 2560]) }" sizes="(min-width: 82.5rem) 82.5rem, 100vw" alt="{ settings.image_alt || settings.image.alt }" fetchpriority="high" width={ settings.image.width } height={ settings.image.height } />{/if}</div>
        </div>
      </div>
    {:else}
      <div class="mx-auto grid max-w-column gap-space-md">
        <p class="text-body-sm text-scheme-muted">{ line }</p>
        <h1 class="font-wide text-h1 text-balance">{#if bloom}<split-text effect="bloom" split="words" stagger="40">{ name }</split-text>{:else}{ name }{/if}</h1>
      </div>
  {/case}
</section>

<schema>
{
  "name": "Hero",
  "description": "The opening band: the name, a two-tone statement, or a picture with the name under it.",
  "kind": "Hero",
  "icon": "heading-1",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "name", "options": [
      { "value": "name", "label": "Name" },
      { "value": "statement", "label": "Statement" },
      { "value": "picture", "label": "Picture" }
    ], "info": "Name: your role line, then your name large. Statement: two sentences in two tones. Picture: a photo with your name below or above it, never on it." },
    { "type": "text", "id": "heading", "label": "Name", "default": "", "info": "Leave empty to use the Brand wordmark." },
    { "type": "checkbox", "id": "show_status", "label": "Status line", "default": true, "info": "The availability dot and line from Person, in the statement and picture layouts." },
    { "type": "header", "content": "Statement" },
    { "type": "text", "id": "statement", "label": "First sentence", "default": "Identities, books and drawings for people who make things.", "info": "In the text colour. Up to twenty words." },
    { "type": "text", "id": "statement_muted", "label": "Second sentence", "default": "Working from a small studio in Lisbon since 2016.", "info": "In the muted tone." },
    { "type": "select", "id": "align", "label": "Align", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "centre", "label": "Centre" }
    ] },
    { "type": "header", "content": "Picture" },
    { "type": "image", "id": "image", "label": "Photo", "info": "Cropped to the ratio from 48rem and to 4:5 on a phone." },
    { "type": "text", "id": "image_alt", "label": "Photo alt text", "default": "" },
    { "type": "select", "id": "ratio", "label": "Ratio", "default": "md:aspect-wide", "options": [
      { "value": "md:aspect-wide", "label": "16:9" },
      { "value": "md:aspect-photo", "label": "3:2" },
      { "value": "md:aspect-portrait", "label": "4:5" }
    ] },
    { "type": "checkbox", "id": "inset", "label": "Inside the gutters", "default": true, "info": "Off: the photo runs to the screen edges; the type stays inside the gutters." },
    { "type": "select", "id": "type", "label": "Type", "default": "below", "options": [
      { "value": "below", "label": "Below the photo" },
      { "value": "above", "label": "Above the photo" }
    ] },
    { "type": "text", "id": "text", "label": "Line", "default": "Identities, books and drawings." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Selected work" },
    { "type": "url", "id": "link_href", "label": "Button link", "default": "/work" },
    { "type": "checkbox", "id": "show_cv", "label": "CV button", "default": true, "info": "The CV download from Person." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Name", "settings": { "layout": "name", "color_scheme": "paper" } },
    { "name": "Statement", "settings": { "layout": "statement", "color_scheme": "paper" } },
    { "name": "Picture", "settings": { "layout": "picture", "color_scheme": "paper" } }
  ]
}
</schema>
