<!-- TODO sync with Figma -->
<!-- A picture beside prose on a twelve-column grid: the heading, text and a text link in seven parts, the 4:5 picture in five with its caption under it, one 3xl gap between. picture sets its side; on a phone the picture comes first. -->
{#let left = settings.picture == 'left'}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl md:gap-space-3xl { left ? 'md:grid-cols-picture-text' : 'md:grid-cols-text-picture' }">
    <div class="{ left ? '' : 'md:order-last' }"><Picture asset={ settings.image } alt={ settings.image_alt } ratio="aspect-portrait" width={ 1200 } sizes="(min-width: 48rem) 40vw, 100vw" caption={ settings.caption } /></div>
    <div class="grid justify-items-start gap-space-md">
      <h2 class="text-h2 text-balance text-scheme-heading">{ settings.heading }</h2>
      {#if settings.body}<div class="sites-prose text-body-lg">{ settings.body }</div>{/if}
      {#if settings.link_label && settings.link_href}<a class="text-body text-link underline decoration-1 underline-offset-link" href="{ settings.link_href }">{ settings.link_label }</a>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Image with text",
  "description": "A picture beside a heading, text and a link.",
  "kind": "Content",
  "icon": "image",
  "settings": [
    { "type": "image", "id": "image", "label": "Picture", "info": "4:5." },
    { "type": "text", "id": "image_alt", "label": "Picture alt text", "default": "" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "", "info": "Under the picture, in meta." },
    { "type": "select", "id": "picture", "label": "Picture", "default": "right", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The studio" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>A room over a print shop in Alfama, with north light and a long table.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "About" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/about" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
