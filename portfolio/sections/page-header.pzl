<!-- TODO sync with Figma -->
<!-- A page's opening: the title as the h1 at 110% width and an optional standfirst in muted. Its bottom padding is xl, so the seam to the first section reads as one step. -->
<section class="bg-scheme-background px-gutter pt-section pb-space-xl text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-sm">
    <h1 class="font-wide text-h1 text-balance text-scheme-heading">{ settings.heading || page.title }</h1>
    {#if settings.text}<p class="max-w-reading text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
  </div>
</section>

<schema>
{
  "name": "Page header",
  "description": "A page's title and an optional standfirst.",
  "kind": "Hero",
  "icon": "heading",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
