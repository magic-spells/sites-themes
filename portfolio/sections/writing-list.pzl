<!-- TODO sync with Figma -->
<!-- Posts, newest first. list: rows on hairlines, the title and the standfirst, "Topic · Sep 14, 2026" in meta at the right. cards: the newest across the column, then two per row, each with a 3:2 picture. On a post's page it leaves that post out. -->
{#let
  posts = content.posts.entries | sort('fields.date') | reverse | reject('id', page.entry.id) | slice(0, settings.limit)
  cards = settings.layout == 'cards'
}
{#if posts.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } />
    <ul class="{ cards ? 'grid gap-x-grid gap-y-space-xl md:grid-cols-2' : '' }">
      {#for entry in posts, i}<li class="{ cards && !i ? 'md:col-span-2' : '' }"><PostCard entry={ entry } base_path={ settings.base_path } layout={ cards ? 'card' : 'list' } /></li>{/for}
    </ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Writing list",
  "description": "Posts, newest first, as rows or cards.",
  "kind": "Writing",
  "icon": "newspaper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Writing" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "list", "options": [
      { "value": "list", "label": "List" },
      { "value": "cards", "label": "Cards" }
    ], "info": "Cards: the newest wide, then two per row with a picture." },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All writing" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/writing" },
    { "type": "url", "id": "base_path", "label": "Post page path", "default": "/writing" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "List", "settings": { "color_scheme": "paper" } },
    { "name": "Cards", "settings": { "layout": "cards", "color_scheme": "paper" } }
  ]
}
</schema>
