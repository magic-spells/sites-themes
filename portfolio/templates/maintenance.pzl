<!-- layout: default -->
<!-- A short pause, on paper with no header or footer: the wordmark, the line and the email meanwhile. -->
{#let s = site.settings}
<section class="sites-scheme-paper flex flex-1 items-center bg-scheme-background px-gutter py-section text-scheme-foreground" data-bare>
  <div class="mx-auto grid w-full max-w-reading justify-items-start gap-space-lg">
    <p class="text-h4">{ s.wordmark || site.name }</p>
    <h1 class="text-h2 text-balance">{ t('maintenance_title') }</h1>
    {#if s.email}<a class="text-body text-link underline decoration-1 underline-offset-4" href="mailto:{ s.email }">{ s.email }</a>{/if}
  </div>
</section>
