<!-- layout: default -->
<!-- The site behind a password, on paper with no header or footer: the wordmark, one line, the password field and Enter, in a narrow column at the left, centred top to bottom. -->
<section class="sites-scheme-paper flex flex-1 items-center bg-scheme-background px-gutter py-section text-scheme-foreground" data-bare>
  <div class="grid w-full max-w-utility gap-space-xl">
    <p class="font-heading text-h4">{ site.settings.wordmark || site.name }</p>
    <form class="grid gap-space-lg" method="post" action="/_sites/unlock">
      <h1 class="text-body-lg text-pretty">{ t('password_title') }</h1>
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}<p class="text-body-sm text-scheme-error" role="alert">{ request.query.password_error }</p>{/if}
      <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" prefix="password" />
      <Button type="submit">{ t('password_submit') }</Button>
    </form>
  </div>
</section>
