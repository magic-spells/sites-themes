<!-- layout: default -->
<!-- The site behind a password, on paper with no header or footer: the wordmark, one line, the password field and Enter. -->
<section class="sites-scheme-paper flex flex-1 items-center bg-scheme-background px-gutter py-section text-scheme-foreground" data-bare>
  <div class="mx-auto grid w-full max-w-reading justify-items-start gap-space-lg">
    <p class="text-h4">{ site.settings.wordmark || site.name }</p>
    <h1 class="text-h2 text-balance">{ t('password_title') }</h1>
    <form class="grid w-full gap-space-sm" method="post" action="/_sites/unlock">
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}<p class="text-body-sm text-scheme-error" role="alert">{ request.query.password_error }</p>{/if}
      <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" required={ true } prefix="password" />
      <div><Button type="submit">{ t('password_submit') }</Button></div>
    </form>
  </div>
</section>
