<!-- component: Button -->
<!-- props: href tone size wide booking -->
<!-- The pill button as a link. tone: primary (the scheme's button), outline
     (the secondary button: a hairline in the text colour, no fill), photo
     (a light hairline for a button laid over a photograph), overlay (the
     primary, filled light while the header lies over a Cover hero). size
     "small" is the 36 high button. With booking set it is a Book a table:
     it links to the booking URL when one is set and otherwise to the
     reservations page, which theme.ts turns into opening the booking sheet. -->
{#let
  url = booking ? (site.settings.booking_url || site.settings.reservations_path || '/reservations') : href
  sheet = booking && !site.settings.booking_url ? 'booking' : null
}
<a class="inline-flex items-center justify-center gap-step-xs rounded-button border font-body font-semibold whitespace-nowrap transition-colors duration-panel ease-out-soft { size == 'small' ? 'min-h-control-small px-step-md text-control-small' : 'min-h-control px-button-x text-control' } { tone == 'photo' ? 'border-on-photo bg-transparent text-on-photo hover:bg-on-photo hover:text-backdrop' : tone == 'outline' ? 'border-scheme-secondary-button-foreground bg-scheme-secondary-button-background text-scheme-secondary-button-foreground hover:border-scheme-secondary-button-hover-background hover:bg-scheme-secondary-button-hover-background hover:text-scheme-secondary-button-hover-foreground' : 'border-scheme-button-background bg-scheme-button-background text-scheme-button-foreground hover:border-scheme-button-hover-background hover:bg-scheme-button-hover-background hover:text-scheme-button-hover-foreground' } { tone == 'overlay' ? 'overlaid:border-on-photo overlaid:bg-on-photo overlaid:text-backdrop' : '' } { wide ? 'w-full' : '' }" href="{ url }" data-panel-open={ sheet } aria-haspopup={ sheet ? 'dialog' : null }><Children/></a>
