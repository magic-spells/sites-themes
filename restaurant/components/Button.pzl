<!-- component: Button -->
<!-- props: href tone wide -->
<a class="inline-flex min-h-control items-center justify-center rounded-button px-button-x py-button-y font-body text-control font-semibold transition-colors duration-hover ease-out-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-scheme-links { tone == 'secondary' ? 'bg-scheme-secondary-button-background text-scheme-secondary-button-foreground hover:bg-scheme-secondary-button-hover-background hover:text-scheme-secondary-button-hover-foreground' : tone == 'outline' ? 'border border-scheme-foreground bg-transparent text-scheme-foreground hover:bg-scheme-foreground hover:text-scheme-background' : 'bg-scheme-button-background text-scheme-button-foreground hover:bg-scheme-button-hover-background hover:text-scheme-button-hover-foreground' } { wide ? 'w-full' : '' }" href="{ href }"><Children/></a>
