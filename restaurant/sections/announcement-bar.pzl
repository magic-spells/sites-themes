<!-- One line on the tomato band: the message, a link from 48rem, and a ×
     that hides the bar for good for this key (theme.ts). -->
<aside class="bg-scheme-background px-gutter py-step-sm text-scheme-foreground" data-dismiss-key="{ settings.key }" aria-label="{ t('announcement') }">
  <div class="mx-auto flex max-w-column items-center gap-step-md">
    <p class="flex-1 text-body-sm text-pretty">
      { settings.text }
      {#if settings.link_label && settings.link}<a class="ml-step-2xs hidden font-semibold underline decoration-1 underline-offset-4 md:inline" href="{ settings.link }">{ settings.link_label }</a>{/if}
    </p>
    {#if settings.show_close}<button class="-m-step-xs flex size-icon-button shrink-0 items-center justify-center" type="button" data-dismiss><span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/close.svg'}</span><span class="sr-only">{ t('dismiss') }</span></button>{/if}
  </div>
</aside>

<schema>
{
  "name": "Announcement bar",
  "description": "A dismissible announcement with an optional link.",
  "kind": "Header",
  "icon": "megaphone",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Closed Monday 23 November for a private event. Book the weekend early."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Book a table"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/reservations"
    },
    {
      "type": "text",
      "id": "key",
      "label": "Key",
      "default": "restaurant-announcement-2026-11"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show close",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "tomato"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "text": "Closed Monday 23 November for a private event. Book the weekend early.",
        "link_label": "Book a table",
        "link": "/reservations",
        "key": "restaurant-announcement-2026-11",
        "show_close": true,
        "color_scheme": "tomato"
      }
    }
  ]
}
</schema>
