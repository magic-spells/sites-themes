<section>Dish carousel</section>

<schema>
{
  "name": "Dish carousel",
  "description": "A carousel of dishes from one category or the kitchen’s favourites.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Small plates"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "A few things for the middle of the table."
    },
    {
      "type": "entry",
      "id": "category",
      "label": "Category",
      "info": "Select a menu_categories entry; reads title, handle, description and tint."
    },
    {
      "type": "checkbox",
      "id": "featured_only",
      "label": "Featured only",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Reads menu_items entries: title, handle, description, ingredients, price, category, dietary, image, image_alt, featured, tag and photos."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Base path",
      "default": "/dishes"
    },
    {
      "type": "url",
      "id": "menu_path",
      "label": "Menu path",
      "default": "/menu"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "featured_first",
      "label": "Featured first",
      "default": true
    },
    {
      "type": "select",
      "id": "emphasis",
      "label": "Emphasis",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "centre",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "select",
      "id": "photo_style",
      "label": "Photo style",
      "default": "photo",
      "options": [
        {
          "value": "photo",
          "label": "Photo"
        },
        {
          "value": "cutout",
          "label": "Cutout"
        }
      ]
    },
    {
      "type": "select",
      "id": "info_style",
      "label": "Info style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "text",
      "id": "see_all_label",
      "label": "See all label",
      "default": "See all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Category",
      "settings": {
        "heading": "Small plates",
        "text": "A few things for the middle of the table.",
        "featured_only": false,
        "base_path": "/dishes",
        "menu_path": "/menu",
        "limit": 6,
        "featured_first": true,
        "emphasis": "none",
        "photo_style": "photo",
        "info_style": "plain",
        "show_dots": false,
        "see_all_label": "See all",
        "color_scheme": "paper",
        "category": "cat_small_plates",
        "collection": "menu_items"
      }
    },
    {
      "name": "Chef's favourites",
      "settings": {
        "heading": "Chef's favourites",
        "text": "The plates we come back to.",
        "featured_only": true,
        "base_path": "/dishes",
        "menu_path": "/menu",
        "limit": 6,
        "featured_first": true,
        "emphasis": "centre",
        "photo_style": "photo",
        "info_style": "plain",
        "show_dots": false,
        "see_all_label": "See all",
        "color_scheme": "paper",
        "collection": "menu_items"
      }
    }
  ]
}
</schema>
