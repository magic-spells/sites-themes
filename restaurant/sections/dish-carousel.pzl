<!-- The pass: one category's dishes (or the featured dishes from every
     category) as a carousel of dish cards, 1.3 / 2.5 / 4 across. Below 48rem
     the track keeps the left gutter and runs off the right edge with the
     next card cut, with no arrows; from 48rem it sits in the column and the
     arrows show in the heading row. Centre emphasis centres the shown card
     and raises it. -->
{#let
  all = settings.collection.entries | sort('fields.order')
  pool = settings.featured_only ? (all | where('fields.featured')) : (settings.category ? (all | where('fields.category.id', settings.category.id)) : all)
  first = settings.featured_first ? (pool | where('fields.featured') | slice(0, settings.limit)) : (pool | slice(0, settings.limit))
  rest = settings.featured_first ? (pool | reject('fields.featured') | slice(0, Math.max(0, settings.limit - first.length))) : []
  centre = settings.emphasis == 'centre'
  align = centre ? 'center' : 'start'
  dots = settings.show_dots
  id = 'dishes-' + section.id
  heading = settings.heading || settings.category.title
  see_all = settings.featured_only || !settings.category ? settings.menu_path : settings.menu_path + '#' + settings.category.handle
  options = { slidesPerView: 1.3, gap: '1rem', paddingLeft: '1rem', paddingRight: 0, align, loop: centre, navigation: { showButtons: false, showPagination: dots }, breakpoints: { '768': { slidesPerView: 2.5, gap: '1.5rem', paddingLeft: 0, paddingRight: 0, align, loop: centre, navigation: { showButtons: true, showPagination: dots } }, '1024': { slidesPerView: 4, gap: '1.5rem', paddingLeft: 0, paddingRight: 0, align, loop: centre, navigation: { showButtons: true, showPagination: dots } } } }
}
{#if first.length}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter" aria-labelledby="{ id }-title">
  <tarot-carousel class="mx-auto block max-w-column" id={ id } data-track="cards">
    <script type="application/json" data-tarot-options>{ options | json }</script>
    <div class="mb-step-xl flex items-end justify-between gap-step-lg px-gutter md:px-0">
      <div class="grid gap-step-xs">
        <h2 class="font-heading text-h2 font-bold text-scheme-heading" id="{ id }-title">{ heading }</h2>
        {#if settings.text}<p class="text-body text-scheme-muted">{ settings.text }</p>{/if}
      </div>
      <div class="flex shrink-0 items-center gap-step-md">
        {#if settings.see_all_label}<a class="-my-step-sm inline-block py-step-sm font-mono text-code font-medium tracking-code whitespace-nowrap text-scheme-links uppercase hover:underline" href="{ see_all }">{ settings.see_all_label }</a>{/if}
        <Arrows />
      </div>
    </div>
    <tarot-viewport class="{ centre ? 'py-step-sm' : '' }">
      <tarot-track>
        {#for entry in first}<tarot-slide><DishCard entry={ entry } href="{ settings.base_path }/{ entry.handle }" photo_style={ settings.photo_style } info_style={ settings.info_style } emphasis={ settings.emphasis } /></tarot-slide>{/for}
        {#for entry in rest}<tarot-slide><DishCard entry={ entry } href="{ settings.base_path }/{ entry.handle }" photo_style={ settings.photo_style } info_style={ settings.info_style } emphasis={ settings.emphasis } /></tarot-slide>{/for}
      </tarot-track>
    </tarot-viewport>
  </tarot-carousel>
</section>
{/if}

<schema>
{
  "name": "Dish carousel",
  "description": "A carousel of dishes from one category or the kitchen’s favourites.",
  "kind": "Collections",
  "icon": "gallery-horizontal-end",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Small plates"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "A few things for the middle of the table."
    },
    {
      "type": "entry",
      "id": "category",
      "label": "Category",
      "info": "Select a menu_categories entry; reads title, handle, description and tint."
    },
    {
      "type": "checkbox",
      "id": "featured_only",
      "label": "Featured only",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Reads menu_items entries: title, handle, description, ingredients, price, category, dietary, image, image_alt, featured, tag and photos."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Base path",
      "default": "/dishes"
    },
    {
      "type": "url",
      "id": "menu_path",
      "label": "Menu path",
      "default": "/menu"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "featured_first",
      "label": "Featured first",
      "default": true
    },
    {
      "type": "select",
      "id": "emphasis",
      "label": "Emphasis",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "centre",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "select",
      "id": "photo_style",
      "label": "Photo style",
      "default": "photo",
      "options": [
        {
          "value": "photo",
          "label": "Photo"
        },
        {
          "value": "cutout",
          "label": "Cutout"
        }
      ]
    },
    {
      "type": "select",
      "id": "info_style",
      "label": "Info style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "text",
      "id": "see_all_label",
      "label": "See all label",
      "default": "See all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Category",
      "settings": {
        "heading": "Small plates",
        "text": "A few things for the middle of the table.",
        "featured_only": false,
        "base_path": "/dishes",
        "menu_path": "/menu",
        "limit": 6,
        "featured_first": true,
        "emphasis": "none",
        "photo_style": "photo",
        "info_style": "plain",
        "show_dots": false,
        "see_all_label": "See all",
        "color_scheme": "paper",
        "category": "cat_small_plates",
        "collection": "menu_items"
      }
    },
    {
      "name": "Chef's favourites",
      "settings": {
        "heading": "Chef's favourites",
        "text": "The plates we come back to.",
        "featured_only": true,
        "base_path": "/dishes",
        "menu_path": "/menu",
        "limit": 6,
        "featured_first": true,
        "emphasis": "centre",
        "photo_style": "photo",
        "info_style": "plain",
        "show_dots": false,
        "see_all_label": "See all",
        "color_scheme": "paper",
        "collection": "menu_items"
      }
    }
  ]
}
</schema>
