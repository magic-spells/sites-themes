<!-- The dish page's opening: the dish's photographs as a one-up carousel
     with the lightbox (or its single photo), its category pill on top; beside
     it the category, the name as the page's <h1>, the price, the dietary
     codes, the description, the ingredients as chips, the tag line and Book
     a table / Back to menu. Under both, a strip of the photographs that
     moves the carousel above. Stacked below 48rem, the photo first. -->
{#let
  dish = page.entry
  f = dish.fields
  category = f.category
  photos = f.photos.items ?? []
  main = 'dish-' + section.id
  arch = settings.well_shape == 'arch'
  options = { lightbox: true, navigation: { showButtons: false, showPagination: false } }
  strip_options = { asNavFor: '#' + main, slidesPerView: 1.3, gap: '1rem', paddingLeft: '1rem', paddingRight: 0, navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { asNavFor: '#' + main, slidesPerView: 2.5, gap: '1rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: false, showPagination: false } }, '1024': { asNavFor: '#' + main, slidesPerView: 3.2, gap: '1rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: false, showPagination: false } } } }
}
{#if dish}
<section class="bg-scheme-background py-section text-scheme-foreground" data-tint={ category.fields.tint }>
  <div class="mx-auto grid max-w-column gap-step-2xl md:px-gutter">
    <div class="grid items-center gap-x-step-3xl gap-y-step-xl px-gutter md:grid-cols-2 md:px-0">
      <div class="relative min-w-0 overflow-hidden bg-scheme-surface-2 { arch ? 'rounded-t-full' : 'rounded-lg' }">
        {#if photos.length}
          <tarot-carousel class="block" id={ main } aria-label="{ dish.title }">
            <script type="application/json" data-tarot-options>{ options | json }</script>
            <tarot-viewport>
              <tarot-track>
                {#for item in photos, i}
                  <tarot-slide><a class="block cursor-zoom-in" href="{ image_url(item.asset, 2560) }" data-tarot-lightbox aria-label="{ t('open_photo', { index: i + 1 }) }"><img class="aspect-4/5 w-full object-cover" src="{ image_url(item.asset, 1280) }" srcset="{ image_srcset(item.asset, [480, 768, 1024, 1280]) }" sizes="(min-width: 48rem) 45vw, 100vw" data-tarot-lightbox-src="{ image_url(item.asset, 2560) }" alt="{ item.alt }" loading={ i == 0 ? 'eager' : 'lazy' } width={ item.asset.width } height={ item.asset.height } /></a>{#if item.caption}<p class="sr-only" data-caption data-tarot-lightbox-fade>{ item.caption }</p>{/if}</tarot-slide>
                {/for}
              </tarot-track>
            </tarot-viewport>
          </tarot-carousel>
        {:else if f.image}
          <img class="aspect-4/5 w-full object-cover" src="{ image_url(f.image, 1280) }" srcset="{ image_srcset(f.image, [480, 768, 1024, 1280]) }" sizes="(min-width: 48rem) 45vw, 100vw" alt="{ f.image_alt || dish.title }" width={ f.image.width } height={ f.image.height } />
        {:else}
          <span class="block aspect-4/5"></span>
        {/if}
        {#if settings.show_tag && (f.tag || category)}<span class="pointer-events-none absolute top-step-sm left-step-sm rounded-full bg-tint px-step-xs py-step-2xs font-mono text-code font-medium tracking-code text-tint-ink uppercase">{ f.tag || category.title }</span>{/if}
      </div>
      <div class="grid content-center justify-items-start gap-step-lg md:max-w-panel">
        <div class="grid justify-items-start gap-step-sm">
          {#if category}<a class="font-mono text-code font-medium tracking-code text-scheme-links uppercase hover:underline" href="{ settings.menu_path }#{ category.handle }">{ category.title }</a>{/if}
          <h1 class="font-heading text-h1 font-bold text-balance text-scheme-heading">{ dish.title }</h1>
          {#if f.price != null}<Price value={ f.price } tone="text-scheme-foreground" />{/if}
        </div>
        {#if settings.show_dietary && f.dietary}<DietaryBadges dietary={ f.dietary } />{/if}
        {#if f.description}<p class="text-body-lg text-pretty">{ f.description }</p>{/if}
        {#if settings.show_ingredients && f.ingredients}
          <div class="grid gap-step-xs">
            <h2 class="font-mono text-code font-medium tracking-code text-scheme-meta uppercase">{ t('ingredients') }</h2>
            <ul class="flex flex-wrap gap-step-xs">
              {#for ingredient in f.ingredients | split(',')}<li><Chip>{ ingredient | strip }</Chip></li>{/for}
            </ul>
          </div>
        {/if}
        {#if settings.show_tag && f.tag}<p class="font-mono text-code font-medium tracking-code text-scheme-meta uppercase">{ f.tag }</p>{/if}
        {#if settings.book_label || settings.back_label}
          <div class="flex flex-wrap gap-step-sm">
            {#if settings.book_label}<Button booking={ true }>{ settings.book_label }</Button>{/if}
            {#if settings.back_label}<Button href="{ settings.menu_path }{ category ? '#' + category.handle : '' }" tone="outline">{ settings.back_label }</Button>{/if}
          </div>
        {/if}
      </div>
    </div>
    {#if settings.show_photos && photos.length > 1}
      <tarot-carousel class="block min-w-0" data-track="photos" aria-label="{ t('photos_of', { name: dish.title }) }">
        <script type="application/json" data-tarot-options>{ strip_options | json }</script>
        <tarot-viewport>
          <tarot-track>
            {#for item in photos}
              <tarot-slide><img class="aspect-4/3 w-full cursor-pointer rounded-md bg-scheme-surface-2 object-cover" src="{ image_url(item.asset, 640) }" srcset="{ image_srcset(item.asset, [320, 480, 640, 768]) }" sizes="(min-width: 64rem) 27rem, (min-width: 48rem) 40vw, 80vw" alt="" loading="lazy" width={ item.asset.width } height={ item.asset.height } /></tarot-slide>
            {/for}
          </tarot-track>
        </tarot-viewport>
      </tarot-carousel>
    {/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Dish detail",
  "description": "The current dish’s photographs, ingredients and dietary information.",
  "kind": "Content",
  "icon": "chef-hat",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_photos",
      "label": "Show photos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ingredients",
      "label": "Show ingredients",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dietary",
      "label": "Show dietary",
      "default": true
    },
    {
      "type": "text",
      "id": "book_label",
      "label": "Book label",
      "default": "Book a table"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back label",
      "default": "Back to menu"
    },
    {
      "type": "url",
      "id": "menu_path",
      "label": "Menu path",
      "default": "/menu"
    },
    {
      "type": "select",
      "id": "well_shape",
      "label": "Well shape",
      "default": "rounded",
      "options": [
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "arch",
          "label": "Arch"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "Show tag",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "show_photos": true,
        "show_ingredients": true,
        "show_dietary": true,
        "book_label": "Book a table",
        "back_label": "Back to menu",
        "menu_path": "/menu",
        "well_shape": "rounded",
        "show_tag": true
      }
    }
  ],
  "templates": [
    "dish"
  ]
}
</schema>
