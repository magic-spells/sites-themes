<section>Dish grid</section>

<schema>
{
  "name": "Dish grid",
  "description": "The complete menu grouped by category with a category rail.",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Reads menu_items entries: title, handle, description, ingredients, price, category, dietary, image, image_alt, featured, tag and photos."
    },
    {
      "type": "collection",
      "id": "categories",
      "label": "Categories",
      "info": "Reads menu_categories entries: title, handle, description, image, image_alt and tint."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_rail",
      "label": "Show rail",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ingredients",
      "label": "Show ingredients",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dietary",
      "label": "Show dietary",
      "default": true
    },
    {
      "type": "select",
      "id": "photo_style",
      "label": "Photo style",
      "default": "photo",
      "options": [
        {
          "value": "photo",
          "label": "Photo"
        },
        {
          "value": "cutout",
          "label": "Cutout"
        }
      ]
    },
    {
      "type": "select",
      "id": "info_style",
      "label": "Info style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_legend",
      "label": "Show legend",
      "default": true
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Base path",
      "default": "/dishes"
    },
    {
      "type": "checkbox",
      "id": "show_category_description",
      "label": "Show category description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dietary_filter",
      "label": "Show dietary filter",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "columns": "3",
        "show_rail": true,
        "show_ingredients": true,
        "show_dietary": true,
        "photo_style": "photo",
        "info_style": "plain",
        "show_legend": true,
        "base_path": "/dishes",
        "show_category_description": true,
        "show_dietary_filter": false,
        "color_scheme": "paper",
        "collection": "menu_items",
        "categories": "menu_categories"
      }
    }
  ]
}
</schema>
