<!-- The tabbed carousel: a row of category chips over ONE carousel of dish
     cards. Every slide carries its category's class; a chip shows only that
     category (tarot's filterClass, theme.ts) and snaps back to the first
     card, All shows every card. The chips are a group of toggle buttons,
     not ARIA tabs: there is one carousel, not a panel per tab. At 375 the
     chips are one scrolling row. The track follows the mobile rule of every
     card carousel. -->
{#let
  all = settings.collection.entries | sort('fields.order')
  listed = settings.source == 'listed' && blocks.length
  categories = listed ? (blocks | map('settings.category') | compact) : (settings.categories.entries | sort('fields.order'))
  centre = settings.emphasis == 'centre'
  align = centre ? 'center' : 'start'
  id = 'tabs-' + section.id
  options = { slidesPerView: 1.3, gap: '1rem', paddingLeft: '1rem', paddingRight: 0, align, navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { slidesPerView: 2.5, gap: '1.5rem', paddingLeft: 0, paddingRight: 0, align, navigation: { showButtons: true, showPagination: false } }, '1024': { slidesPerView: 4, gap: '1.5rem', paddingLeft: 0, paddingRight: 0, align, navigation: { showButtons: true, showPagination: false } } } }
}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter" aria-labelledby="{ id }-title">
  <tarot-carousel class="mx-auto block max-w-column" id={ id } data-track="cards">
    <script type="application/json" data-tarot-options>{ options | json }</script>
    <div class="mb-step-lg flex items-end justify-between gap-step-lg px-gutter md:px-0">
      <h2 class="font-heading text-h2 font-bold text-scheme-heading" id="{ id }-title">{ settings.heading }</h2>
      {#if settings.full_menu_label}<a class="shrink-0 font-mono text-code font-medium tracking-code whitespace-nowrap text-scheme-links uppercase hover:underline" href="{ settings.menu_path }">{ settings.full_menu_label }</a>{/if}
    </div>
    <div class="mb-step-xl flex items-center justify-between gap-step-md">
      <div class="flex gap-step-2xs overflow-x-auto px-gutter md:flex-wrap md:px-0" role="group" aria-label="{ t('filter_by_category') }" data-filter-for={ id } data-strip>
        <FilterChip label={ settings.all_label || t('all') } filter="" pressed={ true } />
        {#if listed}
          {#for block in blocks}
            {#if block.settings.category}<FilterChip label={ block.settings.category.title } filter="cat-{ block.settings.category.handle }" tint={ block.settings.category.fields.tint || 'none' } editor_id={ block.editor_id } />{/if}
          {/for}
        {:else}
          {#for category in categories}<FilterChip label={ category.title } filter="cat-{ category.handle }" tint={ category.fields.tint || 'none' } />{/for}
        {/if}
      </div>
      <Arrows />
    </div>
    <tarot-viewport class="{ centre ? 'py-step-sm' : '' }">
      <tarot-track>
        {#for category in categories}
          {#for entry in all | where('fields.category.id', category.id) | slice(0, settings.limit_per_category)}
            <tarot-slide class="cat-{ category.handle }"><DishCard entry={ entry } href="{ settings.base_path }/{ entry.handle }" photo_style={ settings.photo_style } info_style={ settings.info_style } emphasis={ settings.emphasis } /></tarot-slide>
          {/for}
        {/for}
      </tarot-track>
    </tarot-viewport>
  </tarot-carousel>
</section>

<schema>
{
  "name": "Dish tabs",
  "description": "A single dish carousel filtered by category tabs.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular right now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Reads menu_items entries: title, handle, description, ingredients, price, category, dietary, image, image_alt, featured, tag and photos."
    },
    {
      "type": "collection",
      "id": "categories",
      "label": "Categories",
      "info": "Reads menu_categories entries: title, handle, description, image, image_alt and tint."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "listed",
          "label": "Listed"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit_per_category",
      "label": "Limit per category",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "select",
      "id": "photo_style",
      "label": "Photo style",
      "default": "photo",
      "options": [
        {
          "value": "photo",
          "label": "Photo"
        },
        {
          "value": "cutout",
          "label": "Cutout"
        }
      ]
    },
    {
      "type": "select",
      "id": "info_style",
      "label": "Info style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        }
      ]
    },
    {
      "type": "select",
      "id": "emphasis",
      "label": "Emphasis",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "centre",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "full_menu_label",
      "label": "Full menu label",
      "default": "Full menu"
    },
    {
      "type": "url",
      "id": "menu_path",
      "label": "Menu path",
      "default": "/menu"
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Base path",
      "default": "/dishes"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Popular right now",
        "source": "all",
        "limit_per_category": 6,
        "photo_style": "photo",
        "info_style": "plain",
        "emphasis": "none",
        "all_label": "All",
        "full_menu_label": "Full menu",
        "menu_path": "/menu",
        "base_path": "/dishes",
        "color_scheme": "paper",
        "collection": "menu_items",
        "categories": "menu_categories"
      }
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "entry",
          "id": "category",
          "label": "Category",
          "info": "Select a menu_categories entry; reads title, handle, description and tint."
        }
      ]
    }
  ],
  "max_blocks": 6
}
</schema>
