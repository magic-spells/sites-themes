<section>Dish tabs</section>

<schema>
{
  "name": "Dish tabs",
  "description": "A single dish carousel filtered by category tabs.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular right now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Reads menu_items entries: title, handle, description, ingredients, price, category, dietary, image, image_alt, featured, tag and photos."
    },
    {
      "type": "collection",
      "id": "categories",
      "label": "Categories",
      "info": "Reads menu_categories entries: title, handle, description, image, image_alt and tint."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "listed",
          "label": "Listed"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit_per_category",
      "label": "Limit per category",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "select",
      "id": "photo_style",
      "label": "Photo style",
      "default": "photo",
      "options": [
        {
          "value": "photo",
          "label": "Photo"
        },
        {
          "value": "cutout",
          "label": "Cutout"
        }
      ]
    },
    {
      "type": "select",
      "id": "info_style",
      "label": "Info style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "tinted",
          "label": "Tinted"
        }
      ]
    },
    {
      "type": "select",
      "id": "emphasis",
      "label": "Emphasis",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "centre",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "full_menu_label",
      "label": "Full menu label",
      "default": "Full menu"
    },
    {
      "type": "url",
      "id": "menu_path",
      "label": "Menu path",
      "default": "/menu"
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Base path",
      "default": "/dishes"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Popular right now",
        "source": "all",
        "limit_per_category": 6,
        "photo_style": "photo",
        "info_style": "plain",
        "emphasis": "none",
        "all_label": "All",
        "full_menu_label": "Full menu",
        "menu_path": "/menu",
        "base_path": "/dishes",
        "color_scheme": "paper",
        "collection": "menu_items",
        "categories": "menu_categories"
      }
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "entry",
          "id": "category",
          "label": "Category",
          "info": "Select a menu_categories entry; reads title, handle, description and tint."
        }
      ]
    }
  ],
  "max_blocks": 6
}
</schema>
