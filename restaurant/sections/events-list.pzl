<!-- What's on: the events by date, as cards (3 / 2 / 1 across) or as rows
     on hairlines. There is no clock, so past dates are not dropped; keep the
     collection current. A View all link sits in the heading row. -->
{#let
  items = settings.collection.entries | sort('fields.date') | slice(0, settings.limit)
  id = 'events-' + section.id
  rows = settings.layout == 'rows'
}
{#if items.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" aria-labelledby={ settings.heading ? id + '-title' : null }>
  <div class="mx-auto grid max-w-column gap-step-xl">
    {#if settings.heading && !settings.show_heading}<h2 class="sr-only" id="{ id }-title">{ settings.heading }</h2>{/if}
    {#if settings.show_heading || settings.view_all_label}
      <div class="flex items-end justify-between gap-step-lg">
        {#if settings.show_heading && settings.heading}<h2 class="font-heading text-h2 font-bold text-scheme-heading" id="{ id }-title">{ settings.heading }</h2>{:else}<span></span>{/if}
        {#if settings.view_all_label && settings.view_all_href && page.path != settings.view_all_href}<a class="-my-step-sm inline-block py-step-sm font-mono text-code font-medium tracking-code whitespace-nowrap text-scheme-links uppercase hover:underline" href="{ settings.view_all_href }">{ settings.view_all_label }</a>{/if}
      </div>
    {/if}
    {#if rows}
      <ul class="border-t border-scheme-rule">
        {#for entry in items}<li><EventCard entry={ entry } layout="rows" /></li>{/for}
      </ul>
    {:else}
      <ul class="grid gap-gap-lg md:grid-cols-2 lg:grid-cols-3">
        {#for entry in items}<li><EventCard entry={ entry } layout="cards" reveal={ site.settings.reveal } /></li>{/for}
      </ul>
    {/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Events list",
  "description": "Events as photographic cards or compact rows.",
  "kind": "Collections",
  "icon": "calendar-days",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's on"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Reads events entries: title, handle, date, time, description, image, image_alt and link."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "cards",
      "options": [
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "rows",
          "label": "Rows"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "default": 3,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "All events"
    },
    {
      "type": "url",
      "id": "view_all_href",
      "label": "View all href",
      "default": "/events"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Cards",
      "settings": {
        "heading": "What's on",
        "show_heading": true,
        "layout": "cards",
        "limit": 3,
        "view_all_label": "All events",
        "view_all_href": "/events",
        "color_scheme": "paper",
        "collection": "events"
      }
    },
    {
      "name": "Rows",
      "settings": {
        "heading": "What's on",
        "show_heading": true,
        "layout": "rows",
        "limit": 12,
        "view_all_label": "All events",
        "view_all_href": "/events",
        "color_scheme": "paper",
        "collection": "events"
      }
    }
  ]
}
</schema>
