<!-- Questions and answers: the heading and note on the left, the questions
     on the right as rows on hairlines that open and close (a plus, a minus
     when open), the first open if the setting says so. Without JavaScript
     every answer shows. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-step-xl md:grid-cols-3 md:gap-step-3xl">
    <div class="grid content-start gap-step-sm">
      <h2 class="font-heading text-h2 font-bold text-scheme-heading">{ settings.heading }</h2>
      {#if settings.note}<p class="text-body text-scheme-muted">{ settings.note }</p>{/if}
    </div>
    <ul class="border-t border-scheme-rule md:col-span-2">
      {#for block in blocks, i}
        {#let b = block.settings}
        <li class="border-b border-scheme-rule" data-block={ block.editor_id }>
          <collapsible-component>
            <h3><button class="group flex items-center justify-between gap-step-md py-step-md text-left text-body-lg font-medium text-scheme-heading" type="button">{ b.question }<span class="sites-icon size-icon shrink-0 group-aria-expanded:hidden" aria-hidden="true">{#svg 'icons/plus.svg'}</span><span class="sites-icon hidden size-icon shrink-0 group-aria-expanded:block" aria-hidden="true">{#svg 'icons/minus.svg'}</span></button></h3>
            <collapsible-content open={ settings.first_open && i == 0 }>
              <div class="sites-prose pb-step-md text-body text-scheme-muted">{ b.answer }</div>
            </collapsible-content>
          </collapsible-component>
        </li>
      {/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Faq",
  "description": "Answers to questions about visiting the restaurant.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "A few things before you visit."
    },
    {
      "type": "checkbox",
      "id": "first_open",
      "label": "First open",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Allergens",
      "settings": {
        "heading": "Allergens & dietary needs",
        "note": "A few things before you visit.",
        "first_open": true,
        "color_scheme": "paper"
      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Can you help with allergies?",
            "answer": "<p>Please speak to our team about allergies. Tell us when you book and again at the table.</p>"
          }
        }
      ]
    },
    {
      "name": "Private dining",
      "settings": {
        "heading": "A table for a few more",
        "note": "A few things before you visit.",
        "first_open": true,
        "color_scheme": "paper"
      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Do you take private dining bookings?",
            "answer": "<p>Yes. Write to us with a date and the number of people, and we will make a plan together.</p>"
          }
        }
      ]
    },
    {
      "name": "General",
      "settings": {
        "heading": "Good to know",
        "note": "A few things before you visit.",
        "first_open": true,
        "color_scheme": "paper"
      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Do you take private dining bookings?",
            "answer": "<p>Yes. Write to us with a date and the number of people, and we will make a plan together.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Can you help with allergies?",
            "answer": "<p>Please speak to our team about allergies. Tell us when you book and again at the table.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Is there parking nearby?",
            "answer": "<p>The harbour car park is a short walk along Quay Street.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Can we bring a dog?",
            "answer": "<p>Well-behaved dogs are welcome on the terrace.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Do you have gift cards?",
            "answer": "<p>Ask the team when you visit, or write to us.</p>"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": ""
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 12
}
</schema>
