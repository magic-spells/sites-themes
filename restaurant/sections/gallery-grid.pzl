<section>Gallery grid</section>

<schema>
{
  "name": "Gallery grid",
  "description": "A grid of photographs with an optional lightbox.",
  "settings": [
    {
      "type": "gallery",
      "id": "gallery",
      "label": "Gallery",
      "info": "Reads gallery items: asset, alt and caption."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The room"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "default": "4:3",
      "options": [
        {
          "value": "4:3",
          "label": "4:3"
        },
        {
          "value": "3:2",
          "label": "3:2"
        },
        {
          "value": "1:1",
          "label": "1:1"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "default": 8,
      "min": 1,
      "max": 24,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "lightbox",
      "label": "Lightbox",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "The room",
        "show_heading": true,
        "ratio": "4:3",
        "limit": 8,
        "lightbox": true,
        "color_scheme": "paper",
        "gallery": "the-room"
      }
    }
  ]
}
</schema>
