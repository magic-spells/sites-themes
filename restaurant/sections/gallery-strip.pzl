<!-- A strip of the room's photographs at their own ratios, 1.3 / 2.5 / 3.5
     across, with a counter in the heading row. Alternate drops every other
     photo from 48rem. With the lightbox on, each photo is a link that opens
     it full size, so it opens from the keyboard too. -->
{#let
  items = settings.gallery.items ?? []
  id = 'strip-' + section.id
  stagger = settings.stagger == 'alternate'
  options = { lightbox: settings.lightbox, slidesPerView: 1.3, gap: '1rem', paddingLeft: '1rem', paddingRight: 0, navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { lightbox: settings.lightbox, slidesPerView: 2.5, gap: '1.5rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: false, showPagination: false } }, '1024': { lightbox: settings.lightbox, slidesPerView: 3.5, gap: '1.5rem', paddingLeft: 0, paddingRight: 0, navigation: { showButtons: false, showPagination: false } } } }
}
{#if items.length}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter" aria-label="{ settings.heading }">
  <tarot-carousel class="mx-auto block max-w-column" id={ id } data-track="photos">
    <script type="application/json" data-tarot-options>{ options | json }</script>
    <div class="mb-step-xl flex items-end justify-between gap-step-lg px-gutter md:px-0">
      {#if settings.show_heading && settings.heading}<h2 class="font-heading text-h2 font-bold text-scheme-heading">{ settings.heading }</h2>{:else}<span></span>{/if}
      <Counter index={ 1 } total={ items.length } carousel_id={ id } />
    </div>
    <tarot-viewport>
      <tarot-track>
        {#for item in items, i}
          <tarot-slide class="{ stagger ? 'md:odd:pt-step-xl' : '' }">
            {#if settings.lightbox}
              <a class="block cursor-zoom-in overflow-hidden rounded-md bg-scheme-surface-2" href="{ image_url(item.asset, 2560) }" data-tarot-lightbox aria-label="{ t('open_photo', { index: i + 1 }) }"><img class="h-auto w-full" src="{ image_url(item.asset, 960) }" srcset="{ image_srcset(item.asset, [480, 640, 960, 1280]) }" sizes="(min-width: 64rem) 22rem, (min-width: 48rem) 40vw, 80vw" data-tarot-lightbox-src="{ image_url(item.asset, 2560) }" alt="{ item.alt }" loading="lazy" width={ item.asset.width } height={ item.asset.height } /></a>
            {:else}
              <img class="h-auto w-full overflow-hidden rounded-md bg-scheme-surface-2" src="{ image_url(item.asset, 960) }" srcset="{ image_srcset(item.asset, [480, 640, 960, 1280]) }" sizes="(min-width: 64rem) 22rem, (min-width: 48rem) 40vw, 80vw" alt="{ item.alt }" loading="lazy" width={ item.asset.width } height={ item.asset.height } />
            {/if}
            {#if item.caption}<p class="sr-only" data-caption data-tarot-lightbox-fade>{ item.caption }</p>{/if}
          </tarot-slide>
        {/for}
      </tarot-track>
    </tarot-viewport>
  </tarot-carousel>
</section>
{/if}

<schema>
{
  "name": "Gallery strip",
  "description": "A photographic strip with natural proportions.",
  "kind": "Content",
  "icon": "gallery-thumbnails",
  "settings": [
    {
      "type": "gallery",
      "id": "gallery",
      "label": "Gallery",
      "info": "Reads gallery items: asset, alt and caption."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Around Halfmoon"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "type": "select",
      "id": "stagger",
      "label": "Stagger",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "alternate",
          "label": "Alternate"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "lightbox",
      "label": "Lightbox",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "None",
      "settings": {
        "heading": "Around Halfmoon",
        "show_heading": false,
        "stagger": "none",
        "lightbox": true,
        "color_scheme": "paper",
        "gallery": "the-room"
      }
    },
    {
      "name": "Alternate",
      "settings": {
        "heading": "Around Halfmoon",
        "show_heading": false,
        "stagger": "alternate",
        "lightbox": true,
        "color_scheme": "paper",
        "gallery": "the-room"
      }
    }
  ]
}
</schema>
