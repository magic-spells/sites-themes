<section>Gallery strip</section>

<schema>
{
  "name": "Gallery strip",
  "description": "A photographic strip with natural proportions.",
  "settings": [
    {
      "type": "gallery",
      "id": "gallery",
      "label": "Gallery",
      "info": "Reads gallery items: asset, alt and caption."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Around Halfmoon"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "type": "select",
      "id": "stagger",
      "label": "Stagger",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "alternate",
          "label": "Alternate"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "lightbox",
      "label": "Lightbox",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "None",
      "settings": {
        "heading": "Around Halfmoon",
        "show_heading": false,
        "stagger": "none",
        "lightbox": true,
        "color_scheme": "paper",
        "gallery": "the-room"
      }
    },
    {
      "name": "Alternate",
      "settings": {
        "heading": "Around Halfmoon",
        "show_heading": false,
        "stagger": "alternate",
        "lightbox": true,
        "color_scheme": "paper",
        "gallery": "the-room"
      }
    }
  ]
}
</schema>
