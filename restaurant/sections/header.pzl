<section>Header</section>

<schema>
{
  "name": "Header",
  "description": "The wordmark, navigation, category panel and reservation action.",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": ""
    },
    {
      "type": "menu",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone",
      "default": false
    },
    {
      "type": "text",
      "id": "book_label",
      "label": "Book label",
      "default": "Book a table"
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Menu label",
      "default": "Menu"
    },
    {
      "type": "collection",
      "id": "categories",
      "label": "Categories",
      "info": "Reads menu_categories entries: title, handle, description, image, image_alt and tint."
    },
    {
      "type": "url",
      "id": "menu_path",
      "label": "Menu path",
      "default": "/menu"
    },
    {
      "type": "checkbox",
      "id": "show_chevron",
      "label": "Show chevron",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Solid",
      "settings": {
        "logo_text": "",
        "style": "solid",
        "sticky": true,
        "show_phone": false,
        "book_label": "Book a table",
        "menu_label": "Menu",
        "menu_path": "/menu",
        "show_chevron": true,
        "color_scheme": "paper",
        "menu": "main",
        "categories": "menu_categories"
      }
    },
    {
      "name": "Overlay",
      "settings": {
        "logo_text": "",
        "style": "overlay",
        "sticky": true,
        "show_phone": false,
        "book_label": "Book a table",
        "menu_label": "Menu",
        "menu_path": "/menu",
        "show_chevron": true,
        "color_scheme": "paper",
        "menu": "main",
        "categories": "menu_categories"
      }
    }
  ]
}
</schema>
