      "id": "photo_style",
      "label": "Photo style",
      "default": "photo",
      "options": [
        {
          "value": "photo",
          "label": "Photo"
        },
        {
          "value": "cutout",
          "label": "Cutout"
        }
      ]
    },
    {
      "type": "select",
      "id": "tint",
      "label": "Tint",
      "default": "tomato",
      "options": [
        {
          "value": "tomato",
          "label": "Tomato"
        },
        {
          "value": "saffron",
          "label": "Saffron"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "sea",
          "label": "Sea"
        },
        {
          "value": "plum",
          "label": "Plum"
        },
        {
          "value": "clay",
          "label": "Clay"
        }
      ]
    },
    {
      "type": "select",
      "id": "well_shape",
      "label": "Well shape",
      "default": "rounded",
      "options": [
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "arch",
          "label": "Arch"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "slideshow",
      "label": "Slideshow",
      "default": false
    },
    {
      "type": "gallery",
      "id": "gallery",
      "label": "Gallery",
      "info": "Reads gallery items: asset, alt and caption."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "full",
      "options": [
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "tall",
          "label": "Tall"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Interval",
      "default": 5,
      "min": 3,
      "max": 10,
      "step": 1
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Split",
      "settings": {
        "layout": "split",
        "heading": "Breakfast until three, dinner until late.",
        "text": "An all-day canteen by the harbour. Good food, a warm room, a table for you.",
        "show_eyebrow": false,
        "eyebrow": "Halfmoon Canteen · Bellport",
        "show_service_strip": false,
        "book_label": "Book a table",
        "menu_label": "View menu",
        "menu_path": "/menu",
        "photo_style": "photo",
        "tint": "saffron",
        "well_shape": "rounded",
        "slideshow": false,
        "height": "full",
        "autoplay": true,
        "interval": 5,
