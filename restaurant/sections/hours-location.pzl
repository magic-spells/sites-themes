    {
      "type": "image",
      "id": "map_image",
      "label": "Map image"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Directions label",
      "default": "Open in Maps"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Hours & location",
        "show_map": true,
        "directions_label": "Open in Maps",
        "color_scheme": "paper",
        "map_image": "as_3x2_1"
      }
    }
  ]
}
</schema>
