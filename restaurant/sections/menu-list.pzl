<section>Menu list</section>

<schema>
{
  "name": "Menu list",
  "description": "A text menu with dotted leaders or right-aligned prices.",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Reads menu_items entries: title, handle, description, ingredients, price, category, dietary, image, image_alt, featured, tag and photos."
    },
    {
      "type": "collection",
      "id": "categories",
      "label": "Categories",
      "info": "Reads menu_categories entries: title, handle, description, image, image_alt and tint."
    },
    {
      "type": "select",
      "id": "prices",
      "label": "Prices",
      "default": "dotted",
      "options": [
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_ingredients",
      "label": "Show ingredients",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dietary",
      "label": "Show dietary",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_legend",
      "label": "Show legend",
      "default": true
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Base path",
      "default": "/dishes"
    },
    {
      "type": "checkbox",
      "id": "show_category_description",
      "label": "Show category description",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Dotted",
      "settings": {
        "prices": "dotted",
        "show_ingredients": true,
        "show_dietary": true,
        "show_legend": true,
        "base_path": "/dishes",
        "show_category_description": true,
        "color_scheme": "paper",
        "collection": "menu_items",
        "categories": "menu_categories"
      }
    },
    {
      "name": "Right",
      "settings": {
        "prices": "right",
        "show_ingredients": true,
        "show_dietary": true,
        "show_legend": true,
        "base_path": "/dishes",
        "show_category_description": true,
        "color_scheme": "paper",
        "collection": "menu_items",
        "categories": "menu_categories"
      }
    }
  ]
}
</schema>
