<!-- The mobile menu: a @magic-spells <bottom-sheet> inside its
     <dialog-panel>. It rises over the scrim, drags down to dismiss, closes
     on the scrim, Escape and its close button, and hands focus back to the
     header's hamburger. The main menu in the heading face; under the item
     that leads to the menu path, the categories as pills on their tints;
     then Book a table and the phone. -->
{#let categories = settings.categories.entries | sort('fields.order')}
<dialog-panel>
  <dialog class="text-scheme-foreground" aria-label="{ t('menu') }">
    <bottom-sheet id="mobile-menu" max-display-width="767">
      <bottom-sheet-header class="flex justify-end pt-step-sm">
        <button class="-m-step-xs flex size-icon-button items-center justify-center text-scheme-muted hover:text-scheme-foreground" type="button" data-action-hide-dialog><span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/close.svg'}</span><span class="sr-only">{ t('close') }</span></button>
      </bottom-sheet-header>
      <bottom-sheet-content>
        <div class="grid gap-step-lg">
          {#if settings.menu.items.length}
            <nav aria-label="{ t('main_navigation') }">
              <ul class="grid gap-step-md">
                {#for item in settings.menu.items}
                  <li class="grid gap-step-sm">
                    <a class="font-heading text-h2 font-bold text-scheme-heading hover:text-scheme-links" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null } aria-current={ item.active ? 'page' : null }>{ item.label }</a>
                    {#if item.href == settings.menu_path && categories.length}
                      <ul class="flex flex-wrap gap-step-xs">
                        {#for category in categories}
                          <li data-tint={ category.fields.tint }><a class="block rounded-full bg-tint px-step-sm py-step-xs font-mono text-code font-medium tracking-code text-tint-ink uppercase" href="{ settings.menu_path }#{ category.handle }">{ category.title }</a></li>
                        {/for}
                      </ul>
                    {:else if item.children.length}
                      <ul class="grid gap-step-xs">
                        {#for child in item.children}<li><a class="text-body text-scheme-muted hover:text-scheme-foreground" href="{ child.href }">{ child.label }</a></li>{/for}
                      </ul>
                    {/if}
                  </li>
                {/for}
              </ul>
            </nav>
          {/if}
          <hr class="border-scheme-rule" />
          {#if settings.book_label}<Button booking={ true } wide={ true }>{ settings.book_label }</Button>{/if}
          {#if settings.show_phone && (site.settings.phone || site.settings.email)}
            <p class="grid gap-step-xs font-mono text-code font-medium tracking-code text-scheme-muted uppercase">
              {#if site.settings.phone}<a class="hover:text-scheme-foreground" href="tel:{ site.settings.phone | replace(' ', '') }">{ site.settings.phone }</a>{/if}
              {#if site.settings.email}<a class="hover:text-scheme-foreground" href="mailto:{ site.settings.email }">{ site.settings.email }</a>{/if}
            </p>
          {/if}
        </div>
      </bottom-sheet-content>
    </bottom-sheet>
  </dialog>
</dialog-panel>

<schema>
{
  "name": "Mobile menu",
  "description": "A mobile navigation sheet with category links.",
  "kind": "Panels",
  "icon": "menu",
  "settings": [
    {
      "type": "menu",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "collection",
      "id": "categories",
      "label": "Categories",
      "info": "Reads menu_categories entries: title, handle, description, image, image_alt and tint."
    },
    {
      "type": "url",
      "id": "menu_path",
      "label": "Menu path",
      "default": "/menu"
    },
    {
      "type": "text",
      "id": "book_label",
      "label": "Book label",
      "default": "Book a table"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "menu_path": "/menu",
        "book_label": "Book a table",
        "show_phone": true,
        "menu": "main",
        "categories": "menu_categories"
      }
    }
  ]
}
</schema>
