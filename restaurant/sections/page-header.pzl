<section>Page header</section>

<schema>
{
  "name": "Page header",
  "description": "A plain page heading with an optional eyebrow and introduction.",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "text",
      "id": "standfirst",
      "label": "Standfirst",
      "default": ""
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_standfirst",
      "label": "Show standfirst",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Left",
      "settings": {
        "eyebrow": "",
        "heading": "",
        "standfirst": "",
        "align": "left",
        "show_eyebrow": true,
        "show_standfirst": true,
        "color_scheme": "paper"
      }
    },
    {
      "name": "Centered",
      "settings": {
        "eyebrow": "",
        "heading": "",
        "standfirst": "",
        "align": "center",
        "show_eyebrow": true,
        "show_standfirst": true,
        "color_scheme": "paper"
      }
    }
  ]
}
</schema>
