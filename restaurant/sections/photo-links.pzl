<!-- Up to four doors into the site, each a 4:3 photo over an outline pill;
     three or four across from 48rem, stacked below. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" aria-label={ settings.show_heading ? null : settings.heading } aria-labelledby={ settings.show_heading ? 'photo-links-' + section.id : null }>
  <div class="mx-auto grid max-w-column gap-step-xl">
    {#if settings.show_heading && settings.heading}<h2 class="font-heading text-h2 font-bold text-scheme-heading" id="photo-links-{ section.id }">{ settings.heading }</h2>{/if}
    <ul class="grid gap-gap-lg md:grid-cols-3 { blocks.length == 4 ? 'lg:grid-cols-4' : '' }">
      {#for block in blocks}<li data-block={ block.editor_id }><Door image={ block.settings.image } label={ block.settings.label } link={ block.settings.link } booking={ block.settings.booking } /></li>{/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Photo links",
  "description": "Photographs with links to the menu, events and reservations.",
  "kind": "Content",
  "icon": "link",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where to next"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "Where to next",
        "show_heading": false
      },
      "blocks": [
        {
          "type": "door",
          "settings": {
            "image": "as_4x3_leaf",
            "label": "Menu",
            "link": "/menu",
            "booking": false
          }
        },
        {
          "type": "door",
          "settings": {
            "image": "as_4x3_sea",
            "label": "What's on",
            "link": "/events",
            "booking": false
          }
        },
        {
          "type": "door",
          "settings": {
            "image": "as_4x3_saffron",
            "label": "Book a table",
            "link": "/reservations",
            "booking": true
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "door",
      "name": "Door",
      "settings": [
        {
          "type": "image",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "booking",
          "label": "Booking",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 4
}
</schema>
