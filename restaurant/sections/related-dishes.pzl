<section>Related dishes</section>

<schema>
{
  "name": "Related dishes",
  "description": "Other dishes in the current dish’s category.",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More from {category}"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Reads menu_items entries: title, handle, description, ingredients, price, category, dietary, image, image_alt, featured, tag and photos."
    },
    {
      "type": "url",
      "id": "base_path",
      "label": "Base path",
      "default": "/dishes"
    },
    {
      "type": "url",
      "id": "menu_path",
      "label": "Menu path",
      "default": "/menu"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "default": 6,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "select",
      "id": "photo_style",
      "label": "Photo style",
      "default": "photo",
      "options": [
        {
          "value": "photo",
          "label": "Photo"
        },
        {
          "value": "cutout",
          "label": "Cutout"
        }
      ]
    },
    {
      "type": "text",
      "id": "see_all_label",
      "label": "See all label",
      "default": "See all {category}"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Photo",
      "settings": {
        "heading": "More from {category}",
        "base_path": "/dishes",
        "menu_path": "/menu",
        "limit": 6,
        "photo_style": "photo",
        "see_all_label": "See all {category}",
        "show_dots": false,
        "color_scheme": "paper",
        "collection": "menu_items"
      }
    },
    {
      "name": "Cutout",
      "settings": {
        "heading": "More from {category}",
        "base_path": "/dishes",
        "menu_path": "/menu",
        "limit": 6,
        "photo_style": "cutout",
        "see_all_label": "See all {category}",
        "show_dots": false,
        "color_scheme": "paper",
        "collection": "menu_items"
      }
    }
  ],
  "templates": [
    "dish"
  ]
}
</schema>
