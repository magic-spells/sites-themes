  ],
  "presets": [
    {
      "name": "Default",
      "settings": {
        "heading": "",
        "body": "",
        "width": "reading",
        "color_scheme": "paper"
      }
    },
    {
      "name": "Wide",
      "settings": {
        "heading": "",
        "body": "",
        "width": "wide",
        "color_scheme": "paper"
      }
    }
  ]
}
</schema>
