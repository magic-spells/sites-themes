<!-- The canteen's story: the eyebrow, the heading, the body and a link
     beside a photo in the ratio the setting picks (3:2, 4:5 or 1:1), the
     photo on the right or the left; the arch well rounds its top. Below
     48rem the photo comes first. The heading is the page's <h1> when the
     story opens the page (About does). -->
{#let
  ratio = settings.ratio == '4:5' ? 'aspect-4/5' : (settings.ratio == '1:1' ? 'aspect-square' : 'aspect-3/2')
  left = settings.layout == 'image_left'
  heading_class = 'font-heading text-h1 font-bold text-balance text-scheme-heading'
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-step-2xl md:grid-cols-2 md:gap-step-3xl">
    <div class="overflow-hidden bg-scheme-surface-2 { ratio } { settings.well_shape == 'arch' ? 'rounded-t-full rounded-b-lg' : 'rounded-lg' } { left ? '' : 'md:order-last' }">
      {#if settings.image}<img class="size-full object-cover" src="{ image_url(settings.image, 1280) }" srcset="{ image_srcset(settings.image, [480, 768, 1024, 1280]) }" sizes="(min-width: 48rem) 45vw, 100vw" alt="" loading={ section.index == 0 ? 'eager' : 'lazy' } width={ settings.image.width } height={ settings.image.height } />{/if}
    </div>
    <div class="grid max-w-reading justify-items-start gap-step-lg">
      {#if settings.eyebrow}<p class="font-mono text-code font-medium tracking-code text-scheme-meta uppercase">{ settings.eyebrow }</p>{/if}
      {#if section.index == 0}<h1 class={ heading_class }>{ settings.heading }</h1>{:else}<h2 class={ heading_class }>{ settings.heading }</h2>{/if}
      {#if settings.body}<div class="sites-prose text-body">{ settings.body }</div>{/if}
      {#if settings.link_label && settings.link}<a class="text-body text-scheme-links underline decoration-1 underline-offset-4 hover:no-underline" href="{ settings.link }">{ settings.link_label }</a>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Story",
  "description": "A photograph beside the story of the place.",
  "kind": "Content",
  "icon": "book-open",
  "settings": [
    {
      "type": "image",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "default": "3:2",
      "options": [
        {
          "value": "3:2",
          "label": "3:2"
        },
        {
          "value": "4:5",
          "label": "4:5"
        },
        {
          "value": "1:1",
          "label": "1:1"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "image_right",
      "options": [
        {
          "value": "image_right",
          "label": "Image right"
        },
        {
          "value": "image_left",
          "label": "Image left"
        }
      ]
    },
    {
      "type": "select",
      "id": "well_shape",
      "label": "Well shape",
      "default": "rounded",
      "options": [
        {
          "value": "rounded",
          "label": "Rounded"
        },
        {
          "value": "arch",
          "label": "Arch"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Since 2019"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A canteen by the harbour"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Halfmoon began with a simple idea: a good meal, a warm room and a place to come back to.</p><p>We cook with the season and the boats, bake each morning and keep a seat for our neighbours.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "About us"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/about"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Right",
      "settings": {
        "ratio": "3:2",
        "layout": "image_right",
        "well_shape": "rounded",
        "eyebrow": "Since 2019",
        "heading": "A canteen by the harbour",
        "body": "<p>Halfmoon began with a simple idea: a good meal, a warm room and a place to come back to.</p><p>We cook with the season and the boats, bake each morning and keep a seat for our neighbours.</p>",
        "link_label": "About us",
        "link": "/about",
        "color_scheme": "paper",
        "image": "as_3x2_1"
      }
    },
    {
      "name": "Left",
      "settings": {
        "ratio": "3:2",
        "layout": "image_left",
        "well_shape": "rounded",
        "eyebrow": "Since 2019",
        "heading": "A canteen by the harbour",
        "body": "<p>Halfmoon began with a simple idea: a good meal, a warm room and a place to come back to.</p><p>We cook with the season and the boats, bake each morning and keep a seat for our neighbours.</p>",
        "link_label": "About us",
        "link": "/about",
        "color_scheme": "paper",
        "image": "as_3x2_1"
      }
    }
  ]
}
</schema>
