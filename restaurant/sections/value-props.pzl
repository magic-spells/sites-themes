<!-- Three or four reasons to come, on the band's scheme. Cards are the
     scheme's surface, Boxes its second surface. 2 × 2 at 48rem, stacked
     below. A prop with booking makes its button a Book a table, the primary
     pill; the others are outline. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" aria-label={ settings.show_heading ? null : settings.heading } aria-labelledby={ settings.show_heading ? 'props-' + section.id : null }>
  <div class="mx-auto grid max-w-column gap-step-xl">
    {#if settings.show_heading && settings.heading}<h2 class="font-heading text-h2 font-bold text-scheme-heading" id="props-{ section.id }">{ settings.heading }</h2>{/if}
    <ul class="grid gap-gap-lg md:grid-cols-2 { settings.columns == '4' ? 'lg:grid-cols-4' : 'lg:grid-cols-3' }">
      {#for block in blocks}
        {#let b = block.settings}
        <li class="flex flex-col items-start rounded-lg p-step-lg { settings.style == 'boxes' ? 'gap-step-xs bg-scheme-surface-2' : 'gap-step-2xs bg-scheme-surface' }" data-block={ block.editor_id }>
          {#if b.heading}<h3 class="font-heading text-h3 font-bold text-scheme-heading">{ b.heading }</h3>{/if}
          {#if b.subline}<p class="font-mono text-code font-medium tracking-code text-scheme-meta uppercase">{ b.subline }</p>{/if}
          {#if b.text}<p class="text-body-sm text-scheme-muted">{ b.text }</p>{/if}
          {#if b.link_label}<div class="mt-auto pt-step-md">{#if b.booking}<Button booking={ true }>{ b.link_label }</Button>{:else}<Button href={ b.link } tone="outline">{ b.link_label }</Button>{/if}</div>{/if}
        </li>
      {/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Value props",
  "description": "Three or four notes about the kitchen, room and welcome.",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "cards",
      "options": [
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "boxes",
          "label": "Boxes"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Halfmoon"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "wine"
    }
  ],
  "presets": [
    {
      "name": "Cards",
      "settings": {
        "style": "cards",
        "heading": "Why Halfmoon",
        "show_heading": false,
        "columns": "3",
        "color_scheme": "wine"
      },
      "blocks": [
        {
          "type": "prop",
          "settings": {
            "heading": "Book a table",
            "subline": "Tables for 2 to 10",
            "text": "A long lunch, a quick supper, a seat by the window.",
            "link_label": "Book a table",
            "link": "/reservations",
            "booking": true
          }
        },
        {
          "type": "prop",
          "settings": {
            "heading": "See the menu",
            "subline": "Breakfast to dinner",
            "text": "Seasonal plates, familiar favourites and something from the boats.",
            "link_label": "View menu",
            "link": "/menu",
            "booking": false
          }
        },
        {
          "type": "prop",
          "settings": {
            "heading": "Find us",
            "subline": "14 Quay Street",
            "text": "Two doors from the ferry, a short walk from the harbour.",
            "link_label": "Directions",
            "link": "https://maps.google.com/?q=14+Quay+Street+Bellport",
            "booking": false
          }
        }
      ]
    },
    {
      "name": "Boxes",
      "settings": {
        "style": "boxes",
        "heading": "Why Halfmoon",
        "show_heading": false,
        "columns": "4",
        "color_scheme": "navy"
      },
      "blocks": [
        {
          "type": "prop",
          "settings": {
            "heading": "Sourcing",
            "subline": "",
            "text": "Close to home, with the season in mind.",
            "link_label": "",
            "link": "",
            "booking": false
          }
        },
        {
          "type": "prop",
          "settings": {
            "heading": "Kitchen",
            "subline": "",
            "text": "Good ingredients, handled with care.",
            "link_label": "",
            "link": "",
            "booking": false
          }
        },
        {
          "type": "prop",
          "settings": {
            "heading": "Room",
            "subline": "",
            "text": "A warm welcome and space to settle in.",
            "link_label": "",
            "link": "",
            "booking": false
          }
        },
        {
          "type": "prop",
          "settings": {
            "heading": "Bread",
            "subline": "",
            "text": "Baked here each morning.",
            "link_label": "",
            "link": "",
            "booking": false
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Prop",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": ""
        },
        {
          "type": "text",
          "id": "subline",
          "label": "Subline",
          "default": ""
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": ""
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "booking",
          "label": "Booking",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 4
}
</schema>
