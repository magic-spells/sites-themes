<!-- template: Password -->
<!-- layout: default -->
<!-- A photograph from the home hero behind a dark scrim, the wordmark at the
     display size, the password field and Enter. data-bare hides the header,
     footer and panel groups (styles/theme.css). -->
{#let photo = galleries['home-hero'].items[0]}
<section class="relative isolate grid min-h-dvh flex-1 place-items-center bg-scheme-surface-2 px-gutter py-section text-on-photo" data-bare>
  {#if photo}<img class="absolute inset-0 -z-10 size-full object-cover" src="{ image_url(photo.asset, 1920) }" srcset="{ image_srcset(photo.asset, [768, 1280, 1920, 2560]) }" sizes="100vw" alt="" width={ photo.asset.width } height={ photo.asset.height } />{/if}
  <span class="absolute inset-0 -z-10 bg-backdrop opacity-80" aria-hidden="true"></span>
  <div class="grid w-full justify-items-center gap-step-lg text-center">
    <h1 class="font-heading text-display font-extrabold text-balance">{ site.settings.wordmark || site.name }</h1>
    <div class="grid w-full max-w-docket gap-step-md">
      <p class="text-body-lg text-pretty opacity-85">{ t('password_body') }</p>
      <!-- The unlock endpoint reads `password` and redirects to the `to` path. -->
      <form class="flex w-full flex-wrap gap-step-sm text-left" method="post" action="/_sites/unlock">
        <input type="hidden" name="to" value="{ request.query.return_to }" />
        {#if request.query.password_error}<p class="w-full font-mono text-code text-on-photo" role="alert">{ request.query.password_error }</p>{/if}
        <Field name="password" label="{ t('password_label') }" type="password" autocomplete="current-password" required={ true } placeholder={ t('password_label') } prefix="password" wrapper_class="min-w-0 flex-1 basis-circle text-scheme-foreground" />
        <Submit>{ t('password_submit') }</Submit>
      </form>
      <p class="font-mono text-code font-medium tracking-code uppercase opacity-70">{ t('password_help') }</p>
    </div>
  </div>
</section>
