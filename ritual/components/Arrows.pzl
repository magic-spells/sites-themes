<!-- component: Arrows -->
<!-- A carousel's chrome under its track: bar (an id) holds tarot's progress bar across the row, and the previous and next buttons sit at its right end: round, a hairline in the text colour, filled on hover, hidden below 48rem. Tarot finds the buttons by their data-action attributes. wrap replaces the row's classes (the testimonials put the buttons at the stage's sides). -->
<div class="{ wrap ?? 'mt-space-md flex items-center justify-end gap-space-xs' }">
  {#if bar}<div class="me-space-md flex-1" id="{ bar }"></div>{/if}
  <button class="flex size-control max-md:hidden items-center justify-center rounded-full border border-scheme-foreground transition-colors duration-fast hover:bg-scheme-foreground hover:text-scheme-background disabled:pointer-events-none disabled:opacity-40" type="button" data-action-tarot-previous aria-label="{ t('previous') }"><span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/angle-left.svg'}</span></button>
  <button class="flex size-control max-md:hidden items-center justify-center rounded-full border border-scheme-foreground transition-colors duration-fast hover:bg-scheme-foreground hover:text-scheme-background disabled:pointer-events-none disabled:opacity-40" type="button" data-action-tarot-next aria-label="{ t('next') }"><span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/angle-right.svg'}</span></button>
</div>
