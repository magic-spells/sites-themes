<!-- component: Arrows -->
<!-- A carousel's previous and next buttons: round, a hairline in the text colour, filled on hover. Tarot finds them by their data-action attributes; hidden below 48rem. wrap replaces the wrapper's classes (the testimonials put them at the stage's sides). -->
<div class="{ wrap ?? 'hidden shrink-0 gap-space-xs md:flex' }">
  <button class="pointer-events-auto flex size-control items-center justify-center rounded-full border border-scheme-foreground transition-colors duration-fast hover:bg-scheme-foreground hover:text-scheme-background disabled:pointer-events-none disabled:opacity-40" type="button" data-action-tarot-previous aria-label="{ t('previous') }"><span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/angle-left.svg'}</span></button>
  <button class="pointer-events-auto flex size-control items-center justify-center rounded-full border border-scheme-foreground transition-colors duration-fast hover:bg-scheme-foreground hover:text-scheme-background disabled:pointer-events-none disabled:opacity-40" type="button" data-action-tarot-next aria-label="{ t('next') }"><span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/angle-right.svg'}</span></button>
</div>
