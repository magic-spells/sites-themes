<!-- component: SectionHead -->
<!-- A section's heading block: the heading in h2 with its accent word, a line under it; the view-all link as a secondary button and anything the section passes in (carousel arrows) sit right, centred on the block, from 48rem, and the button under it below. centred centres the block; beside stacks the button under the heading and drops the bottom margin from 64rem, for a head that sits beside its content. -->
{#if heading}
<div class="mb-space-xl flex flex-wrap items-center gap-x-space-lg gap-y-space-md { centred ? 'justify-center text-center' : '' } { beside ? 'lg:mb-0' : '' }">
  <div class="grid max-w-reading gap-space-xs { centred ? '' : 'me-auto max-md:w-full' } { beside ? 'lg:w-full' : '' }">
    <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Accent text={ heading } rise={ true } /></h2>
    {#if text}<p class="text-body text-pretty text-scheme-muted">{ text }</p>{/if}
  </div>
  {#if link_label && link_href}<Button href={ link_href } tone="secondary">{ link_label }</Button>{/if}
  <Children/>
</div>
{/if}
