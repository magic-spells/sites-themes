<!-- component: TeamCard -->
<!-- A person: the 4:5 portal portrait, the name in Card title, role · level in Meta, the specialties as a line and a "Book with" link to their page. -->
{#let f = entry.fields}
<article class="group relative grid content-start gap-space-sm { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
  <Well asset={ f.image } alt={ f.image_alt } ratio="aspect-portrait" shape="portal" width={ 640 } sizes="(min-width: 64rem) 25rem, (min-width: 48rem) 50vw, 70vw" zoom={ true } />
  <div class="grid gap-space-2xs">
    <h3 class="text-body-lg font-semibold"><a class="after:absolute after:inset-0 hover:underline hover:underline-offset-4" href="{ base_path }/{ entry.handle }">{ entry.title }</a></h3>
    <p class="text-body-sm text-scheme-meta">{ f.role }{#if f.level} · { f.level }{/if}</p>
    {#if f.specialties}<p class="text-body-sm text-scheme-muted">{ f.specialties | replace(', ', ' · ') }</p>{/if}
    <span class="mt-space-2xs text-body-sm font-semibold text-accent underline underline-offset-4">{ t('book_with', { name: (entry.title | split(' ') | first) }) }</span>
  </div>
</article>
