<!-- component: Well -->
<!-- An image well on surface-2 that clips its photo. shape: portal (a full arch on a portrait), cap (capped top corners on a landscape), dome (a half circle hanging from its top), square (none). ratio is the aspect utility. tilt turns it 3° anticlockwise. -->
{#if asset}
<span class="relative block overflow-hidden bg-scheme-surface-2 { ratio } { shape == 'portal' ? 'rounded-t-full' : (shape == 'cap' ? 'rounded-t-cap' : (shape == 'dome' ? 'dome' : '')) } { tilt ? '-rotate-3' : '' }">
  <img class="absolute inset-0 size-full object-cover { zoom ? 'transition-transform duration-panel ease-out-soft group-hover:scale-105' : '' }" src="{ image_url(asset, width ?? 800) }" srcset="{ image_srcset(asset, [480, 768, 1024, 1600]) }" sizes="{ sizes ?? '100vw' }" alt="{ alt ?? asset.alt }" loading="{ eager ? 'eager' : 'lazy' }" fetchpriority={ eager ? 'high' : null } width={ asset.width } height={ asset.height } />
  <Children/>
</span>
{/if}
