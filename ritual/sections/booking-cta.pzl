<!-- The band a page ends on: one H2 line with its accent word, the confirm line, Book and Call, centred, with grain while House texture is on. edge dome raises a half-ellipse of this band's colour into the padding of the band above. -->
{#let
  loc = content.locations.entries | sort('fields.order') | first
  phone = (loc && loc.fields.phone) || site.settings.phone
  confirm = settings.text || site.settings.confirm_line
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground { settings.edge == 'dome' ? 'edge-dome' : '' }" data-texture={ settings.grain && site.settings.texture == 'grain' ? 'grain' : null }>
  <div class="mx-auto grid max-w-reading justify-items-center gap-space-md py-space-xl text-center">
    <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Accent text={ settings.heading } /></h2>
    {#if confirm}<p class="text-body-lg text-scheme-muted">{ confirm }</p>{/if}
    <div class="flex flex-wrap justify-center gap-space-xs pt-space-xs">
      <Button action={ true }>{ settings.action_label || site.settings.action_label }</Button>
      {#if settings.show_call && phone}<Button href="tel:{ phone | replace(' ', '') }" tone="secondary">{ t('call_number', { phone: phone }) }</Button>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Booking band",
  "description": "The closing band: one line, the confirm line, Book and Call.",
  "kind": "Call to action",
  "icon": "calendar-check",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Book an *appointment*", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "", "info": "Leave empty to use the House confirm line." },
    { "type": "text", "id": "action_label", "label": "Action label", "default": "" },
    { "type": "checkbox", "id": "show_call", "label": "Show Call", "default": true },
    { "type": "checkbox", "id": "grain", "label": "Grain", "default": true, "info": "A fine grain while House texture is on." },
    { "type": "select", "id": "edge", "label": "Top edge", "default": "flat", "options": [
      { "value": "flat", "label": "Flat" },
      { "value": "dome", "label": "Dome" }
    ], "info": "Dome rises a half-ellipse of this band into the band above." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "clay" }
  ],
  "presets": [
    { "name": "Clay", "settings": { "color_scheme": "clay" } },
    { "name": "Clay dome", "settings": { "edge": "dome", "color_scheme": "clay" } }
  ]
}
</schema>
