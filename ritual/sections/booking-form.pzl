<!-- The appointment request inline, for the booking page and for a visitor without JavaScript: the form on a surface-2 panel in two columns from 48rem, beside a 4:5 portal photo. -->
{#let confirm = settings.confirm || site.settings.confirm_line}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl lg:grid-cols-5 lg:gap-space-3xl">
    {#if settings.image}<div class="hidden w-full max-w-photo lg:col-span-2 lg:block"><Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-portrait" shape="portal" width={ 960 } sizes="30rem" /></div>{/if}
    <div class="grid gap-space-lg rounded-md bg-scheme-surface-2 p-space-lg md:p-space-xl { settings.image ? 'lg:col-span-3' : 'lg:col-span-5 lg:max-w-panel' }">
      <SectionHead heading={ settings.heading } text={ settings.text } />
      <Form handle={ settings.form || site.settings.booking_form } class="grid gap-space-md" id="booking-form-{ section.id }">
        {#if form.sent}
          <p class="text-body-lg" role="status">{ form.success_message || t('form_success') }</p>
        {:else}
          {#if form.error}<p class="text-body-sm text-scheme-error" role="alert">{ t('form_error') }</p>{/if}
          <FormFields fields={ form.fields } prefix="book-{ section.id }" columns={ true } />
          <div class="flex flex-wrap items-center gap-space-md">
            <Button type="submit">{ form.submit_label || t('request_appointment') }</Button>
            {#if confirm}<p class="text-body-sm text-scheme-meta">{ confirm }</p>{/if}
          </div>
          <noscript><p class="text-body-sm text-scheme-muted">{ t('form_requires_javascript') }</p></noscript>
        {/if}
      </Form>
    </div>
  </div>
</section>

<schema>
{
  "name": "Booking form",
  "description": "The appointment request form on the page, beside a photo.",
  "kind": "Forms",
  "icon": "calendar-plus",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us what you would *like*", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "Pick a treatment and a time of day. We will find the hour and confirm it with you." },
    { "type": "form", "id": "form", "label": "Form", "info": "Leave empty to use the House booking form." },
    { "type": "text", "id": "confirm", "label": "Confirm line", "default": "", "info": "Leave empty to use the House confirm line." },
    { "type": "image", "id": "image", "label": "Image", "info": "4:5, beside the form on large screens." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "linen" } }
  ]
}
</schema>
