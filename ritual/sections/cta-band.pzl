<!-- One H2 line with its accent word and one button, centred, on any scheme. edge dome raises a half-ellipse of this band into the band above. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground { settings.edge == 'dome' ? 'edge-dome' : '' }">
  <div class="mx-auto grid max-w-reading justify-items-center gap-space-md py-space-lg text-center">
    <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Accent text={ settings.heading } /></h2>
    {#if settings.text}<p class="text-body-lg text-scheme-muted">{ settings.text }</p>{/if}
    {#if settings.link_href}<Button href={ settings.link_href }>{ settings.link_label }</Button>{:else}<Button action={ true }>{ settings.link_label || site.settings.action_label }</Button>{/if}
  </div>
</section>

<schema>
{
  "name": "Call to action",
  "description": "One line and one button.",
  "kind": "Call to action",
  "icon": "megaphone",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Treatments for *two*", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Book for two" },
    { "type": "url", "id": "link_href", "label": "Button link", "default": "", "info": "Leave empty to open the booking panel." },
    { "type": "select", "id": "edge", "label": "Top edge", "default": "flat", "options": [
      { "value": "flat", "label": "Flat" },
      { "value": "dome", "label": "Dome" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "celadon" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "celadon" } }
  ]
}
</schema>
