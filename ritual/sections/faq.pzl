<!-- Questions and answers as rows that open (components/Questions.pzl). edge dome raises a half-ellipse of this band into the band above. -->
<Questions s={ settings } items={ blocks } />

<schema>
{
  "name": "FAQ",
  "description": "Questions and answers as rows that open.",
  "kind": "Content",
  "icon": "circle-help",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "checkbox", "id": "first_open", "label": "First answer open", "default": true },
    { "type": "select", "id": "edge", "label": "Top edge", "default": "flat", "options": [
      { "value": "flat", "label": "Flat" },
      { "value": "dome", "label": "Dome" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "blocks": [
    { "type": "item", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "What should I wear?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Whatever is comfortable. We have robes, slippers and lockers.</p>" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": {}, "blocks": [
      { "type": "item", "settings": { "question": "What should I wear?", "answer": "<p>Whatever is comfortable. We have robes, slippers and lockers.</p>" } },
      { "type": "item", "settings": { "question": "Do you take walk-ins?", "answer": "<p>When a room is free, yes. Text us first and we will tell you.</p>" } },
      { "type": "item", "settings": { "question": "How do I cancel or reschedule?", "answer": "<p>Text or call a day ahead and there is no charge.</p>" } }
    ] }
  ]
}
</schema>
