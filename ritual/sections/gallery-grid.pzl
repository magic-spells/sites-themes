<!-- The gallery. Albums: each album a tile with the rounded well, the title and its kind and date, three, two then one across. Photos (on an album's page): the album's title and line, then its photos three, two then two across, each opening the lightbox; a before-and-after album reads its photos in pairs, each pair one tile split by a hairline with Before and After labels. -->
{#let
  album = settings.mode == 'photos' ? page.entry : null
  f = album ? album.fields : null
  items = f && f.photos ? f.photos.items | slice(0, 12) : []
  pairs = f && f.kind == 'before-after'
  id = 'album-' + section.id
  lb = { lightbox: true, navigation: { showButtons: false, showPagination: false } }
  others = content.albums.entries | sort('fields.order') | reject('id', page.entry.id) | slice(0, settings.limit)
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    {#if album}
      <div class="mb-space-xl grid max-w-reading gap-space-sm">
        <h1 class="font-heading text-h1 text-balance text-scheme-heading">{ album.title }</h1>
        {#if f.description || f.date}<p class="text-body-lg text-pretty text-scheme-muted">{ [f.description, f.date ? f.date | date('long') : ''] | compact | join(' · ') }</p>{/if}
      </div>
      {#if items.length}
        <LightboxCompanion items={ items } id={ id }><script type="application/json" data-tarot-options>{ lb | json }</script></LightboxCompanion>
        {#if pairs}
          <ul class="grid gap-space-md md:grid-cols-2">
            {#for item in items, i}
              {#if i % 2 == 0}
                <li class="grid grid-cols-2 gap-px overflow-hidden rounded-cap bg-scheme-rule">
                  {#for half in items | slice(i, 2), j}
                    <button class="group relative block cursor-zoom-in bg-scheme-surface-2" type="button" data-lightbox-open={ id } data-index={ i + j } aria-label="{ t('open_photo', { index: i + j + 1 }) }">
                      <Well asset={ half.asset } alt={ half.alt } ratio="aspect-portrait" width={ 640 } sizes="(min-width: 48rem) 25vw, 50vw" zoom={ true } />
                      <span class="absolute bottom-space-xs left-space-xs rounded-full bg-scheme-background px-space-xs text-kicker font-semibold uppercase">{ j == 0 ? t('before') : t('after') }</span>
                    </button>
                  {/for}
                </li>
              {/if}
            {/for}
          </ul>
        {:else}
          <ul class="grid grid-cols-2 gap-space-sm lg:grid-cols-3">
            {#for item in items, i}<li><button class="group block w-full cursor-zoom-in" type="button" data-lightbox-open={ id } data-index={ i } aria-label="{ t('open_photo', { index: i + 1 }) }"><Well asset={ item.asset } alt={ item.alt } ratio="aspect-square" shape="round" width={ 640 } sizes="(min-width: 64rem) 30vw, 50vw" zoom={ true } /></button></li>{/for}
          </ul>
        {/if}
      {/if}
    {:else}
      <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } />
      <ul class="grid gap-x-space-md gap-y-space-xl md:grid-cols-2 lg:grid-cols-3">
        {#for entry in others}<li><AlbumTile entry={ entry } base_path={ settings.base_path } /></li>{/for}
      </ul>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Gallery grid",
  "description": "The albums as tiles, or on an album's page its photos with a lightbox.",
  "kind": "Gallery",
  "icon": "images",
  "settings": [
    { "type": "select", "id": "mode", "label": "Show", "default": "albums", "options": [
      { "value": "albums", "label": "The albums" },
      { "value": "photos", "label": "This album's photos" }
    ], "info": "This album's photos works on an album's page. Elsewhere it shows the albums." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "range", "id": "limit", "label": "Most albums to show", "min": 1, "max": 12, "step": 1, "default": 12 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/gallery" },
    { "type": "url", "id": "base_path", "label": "Album page path", "default": "/gallery" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Albums", "settings": { "mode": "albums", "color_scheme": "linen" } },
    { "name": "Album photos", "settings": { "mode": "photos", "color_scheme": "linen" } }
  ]
}
</schema>
