<!-- A strip of photographs: a tarot track of equal-width slides cropped to one ratio, 1.2, 2.5 then 3.5 across, starting at the column edge and bleeding off the right on a phone, with the progress bar and round arrows under it. Collage: the first three photos overlap across the column at every width, a 3:2 landscape, a square hanging below it and an upright 4:5 portal; the grid lines and ratios are tokens in styles/theme.css. Each photo opens the lightbox. -->
{#let
  items = settings.gallery ? settings.gallery.items | slice(0, 12) : []
  id = 'strip-' + section.id
  ratio = settings.slide_ratio == '1:1' ? 'aspect-square' : (settings.slide_ratio == '3:2' ? 'aspect-3/2' : 'aspect-portrait')
  collage = settings.layout == 'collage'
  options = { lightbox: true, progressBar: { selector: '#bar-' + id }, slidesPerView: 1.2, gap: '1rem', navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { lightbox: true, slidesPerView: 2.5, gap: '1.5rem', navigation: { showButtons: true, showPagination: false } }, '1024': { lightbox: true, slidesPerView: 3.5, gap: '1.5rem', navigation: { showButtons: true, showPagination: false } } } }
}
{#if items.length}
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter">
  <tarot-carousel class="mx-auto block max-w-column ps-gutter md:ps-0" id={ id } data-track>
    <script type="application/json" data-tarot-options>{ options | json }</script>
    <div class="pe-gutter md:pe-0"><SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } /></div>
    <tarot-viewport class={ collage ? 'sr-only' : null }>
      <tarot-track>
        {#for item in items, i}
          <tarot-slide>
            <a class="group block cursor-zoom-in" href="{ image_url(item.asset, 2560) }" data-tarot-lightbox aria-label="{ t('open_photo', { index: i + 1 }) }">
              <span class="relative block overflow-hidden rounded-t-cap bg-scheme-surface-2 { ratio }"><img class="absolute inset-0 size-full object-cover" src="{ image_url(item.asset, 1024) }" srcset="{ image_srcset(item.asset, [480, 768, 1024]) }" sizes="(min-width: 64rem) 22rem, (min-width: 48rem) 40vw, 80vw" data-tarot-lightbox-src="{ image_url(item.asset, 2560) }" alt="{ item.alt }" loading="lazy" width={ item.asset.width } height={ item.asset.height } /></span>
            </a>
            {#if item.caption}<p class="mt-space-xs text-body-sm text-scheme-meta" data-caption data-tarot-lightbox-fade>{ item.caption }</p>{/if}
          </tarot-slide>
        {/for}
      </tarot-track>
    </tarot-viewport>
    {#if !collage}<div class="pe-gutter md:pe-0"><Arrows bar="bar-{ id }" /></div>{/if}
  </tarot-carousel>
  {#if collage}
    <ul class="mx-gutter grid aspect-collage grid-cols-collage grid-rows-collage md:mx-auto md:max-w-column md:aspect-collage-wide md:grid-cols-collage-wide md:grid-rows-collage-wide" aria-hidden="true">
      {#for item in items | slice(0, 3), i}
        <li class="min-h-0 self-start { i == 0 ? 'col-start-1 col-end-3 row-start-1 row-end-4' : (i == 1 ? 'col-start-1 col-end-2 row-start-3 row-end-4 md:col-start-2 md:col-end-5' : 'col-start-2 col-end-3 row-start-2 row-end-4 md:col-start-4 md:col-end-6') }">
          <button class="group block w-full cursor-zoom-in" type="button" tabindex="-1" data-lightbox-open={ id } data-index={ i }><Well asset={ item.asset } alt="" ratio={ i == 0 ? 'aspect-3/2' : (i == 1 ? 'aspect-square' : 'aspect-portrait') } shape={ i == 0 ? 'cap' : (i == 1 ? 'square' : 'portal') } width={ i == 0 ? 1200 : 800 } sizes="(min-width: 48rem) 40vw, 60vw" zoom={ true } /></button>
        </li>
      {/for}
    </ul>
  {/if}
</section>
{/if}

<schema>
{
  "name": "Gallery strip",
  "description": "A strip of photos that scrolls sideways, or three overlapping, each opening a lightbox.",
  "kind": "Gallery",
  "icon": "gallery-horizontal",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "strip", "options": [
      { "value": "strip", "label": "Strip" },
      { "value": "collage", "label": "Collage" }
    ], "info": "Collage overlaps the first three photos." },
    { "type": "gallery", "id": "gallery", "label": "Gallery" },
    { "type": "select", "id": "slide_ratio", "label": "Slide shape", "default": "4:5", "options": [
      { "value": "1:1", "label": "Square" },
      { "value": "4:5", "label": "Portrait 4:5" },
      { "value": "3:2", "label": "Landscape 3:2" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gallery", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All photos" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/gallery" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Strip", "settings": { "layout": "strip", "color_scheme": "linen" } },
    { "name": "Collage", "settings": { "layout": "collage", "color_scheme": "linen" } }
  ]
}
</schema>
