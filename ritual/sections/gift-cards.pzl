<!-- The gift card band, on clay with grain: a fern portal card left (the Gift card label, the amount in Price, the wordmark small), and beside it the heading with its accent word, a line, the amounts as chips, one button to the gift card shop (or the booking form) and the fine print in Meta. -->
{#let
  amounts = settings.amounts | split(',')
  url = settings.link || site.settings.gift_card_url
  wordmark = site.settings.wordmark || site.name
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground" data-texture={ settings.grain && site.settings.texture == 'grain' ? 'grain' : null }>
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:grid-cols-picture-text md:gap-space-3xl">
    <div class="sites-scheme-fern grid aspect-portrait content-between justify-items-center rounded-t-full rounded-b-md bg-scheme-background px-space-lg pt-space-3xl pb-space-lg text-center text-scheme-foreground" aria-hidden="true">
      <span class="grid gap-space-xs"><span class="text-kicker font-semibold text-scheme-meta uppercase">{ t('gift_card') }</span><span class="font-heading text-display tabular-nums">{ settings.card_amount }</span></span>
      <span class="font-heading text-h4">{ wordmark }</span>
    </div>
    <div class="grid gap-space-md">
      <h2 class="font-heading text-h1 text-balance text-scheme-heading"><Accent text={ settings.heading } /></h2>
      {#if settings.text}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
      {#if amounts.length}
        <ul class="flex flex-wrap gap-space-xs" aria-label="{ t('amounts') }">
          {#for amount in amounts}<li class="inline-flex min-h-tap items-center rounded-full border border-scheme-foreground px-space-md text-body-sm font-semibold">{ amount | strip }</li>{/for}
        </ul>
      {/if}
      <div class="pt-space-xs">{#if url}<Button href={ url } external={ true }>{ settings.button_label }</Button>{:else}<Button action={ true }>{ settings.button_label }</Button>{/if}</div>
      {#if settings.fine_print}<p class="text-body-sm text-scheme-meta">{ settings.fine_print }</p>{/if}
    </div>
  </div>
</section>

<schema>
{
  "name": "Gift cards",
  "description": "A gift card band: the card, the amounts and one button to buy.",
  "kind": "Call to action",
  "icon": "gift",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The gift of *nothing* to do", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Any treatment, any amount, for anyone who could use an hour off." },
    { "type": "text", "id": "card_amount", "label": "Amount on the card", "default": "$100" },
    { "type": "text", "id": "amounts", "label": "Amounts", "default": "$50, $100, $150, Any amount", "info": "Comma-separated, shown as chips." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Buy a gift card" },
    { "type": "url", "id": "link", "label": "Gift card link", "default": "", "info": "Leave empty to use the House gift card link, or the booking form when that is empty too." },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Sent by email the same day. No expiry." },
    { "type": "checkbox", "id": "grain", "label": "Grain", "default": true, "info": "A fine grain while House texture is on." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "clay" }
  ],
  "presets": [
    { "name": "Clay", "settings": { "color_scheme": "clay" } }
  ]
}
</schema>
