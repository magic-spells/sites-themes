<!-- The opener, four ways. Arch: the type left (Display with the accent word, the line, Book and Call) and a 4:5 portal photo right on the column's edge. Cover: a photo (or a fade slideshow with its pause button) under the fern scrim, with grain when House texture is on, the type in linen centred or low left; full bleed, or inset in the column with rounded corners. Capsules: the type left and a two-column mosaic of five capsules right, each column offset by half a capsule and bleeding off the band; on phones a row of three under the type. Quiet: the type alone, centred on a soft glow. Dome: a half circle of photo hanging from the header, the type centred under it. -->
{#let
  id = 'hero-' + section.id
  layout = settings.layout
  slides = layout == 'cover' && settings.slideshow && settings.gallery ? settings.gallery.items | slice(0, 6) : []
  options = { effect: 'fade', loop: true, autoplay: { interval: settings.interval * 1000 }, navigation: { showButtons: false, showPagination: false } }
  loc = content.locations.entries | sort('fields.order') | first
  phone = (loc && loc.fields.phone) || site.settings.phone
  grain = settings.treatment == 'grain' && site.settings.texture == 'grain'
  cover = layout == 'cover'
  capsules = layout == 'capsules'
  images = blocks | slice(0, 5)
  inset = settings.frame == 'inset'
  left = settings.align == 'left'
  second = settings.secondary_url ? settings.secondary_url : (settings.show_call && phone ? 'tel:' + (phone | replace(' ', '')) : null)
  centred = layout == 'quiet' || layout == 'dome'
}
<section class="relative isolate bg-scheme-background text-scheme-foreground { cover ? (inset ? 'px-gutter pt-space-lg' : '') : (layout == 'arch' ? 'px-gutter pb-section' : 'px-gutter py-section') } { capsules ? 'overflow-hidden lg:h-hero lg:py-0' : '' } { layout == 'quiet' ? 'bg-glow' : '' }" data-over-hero={ cover && !inset ? true : null }>
  {#if cover}
    <div class="relative isolate flex overflow-hidden { settings.height == 'full' ? 'min-h-svh' : 'min-h-hero' } { inset ? 'mx-auto max-w-column rounded-lg' : '' }" data-texture={ grain ? 'grain' : null }>
      {#if slides.length > 1}
        <tarot-carousel class="absolute inset-0 -z-20 block" id={ id }>
          <script type="application/json" data-tarot-options>{ options | json }</script>
          <tarot-viewport class="block h-full">
            <tarot-track class="h-full">
              {#for item in slides, i}<tarot-slide class="h-full"><img class="size-full object-cover" src="{ image_url(item.asset, 2000) }" srcset="{ image_srcset(item.asset, [768, 1280, 2000, 2560]) }" sizes="100vw" alt="{ item.alt }" loading="{ i == 0 ? 'eager' : 'lazy' }" width={ item.asset.width } height={ item.asset.height } /></tarot-slide>{/for}
            </tarot-track>
          </tarot-viewport>
        </tarot-carousel>
      {:else if settings.image}
        <img class="absolute inset-0 -z-20 size-full object-cover" src="{ image_url(settings.image, 2000) }" srcset="{ image_srcset(settings.image, [768, 1280, 2000, 2560]) }" sizes="100vw" alt="{ settings.image_alt || settings.image.alt }" fetchpriority="high" width={ settings.image.width } height={ settings.image.height } />
      {/if}
      <span class="absolute inset-0 -z-10 bg-scrim" aria-hidden="true"></span>
      <div class="mx-auto flex w-full max-w-column px-gutter text-on-photo { inset ? 'py-section' : 'pt-dome pb-section' } { left ? 'items-end' : 'items-center justify-center text-center' }">
        <div class="grid max-w-reading gap-space-md { left ? '' : 'justify-items-center' }">
          <h1 class="font-heading text-display text-balance"><Accent text={ settings.heading } /></h1>
          {#if settings.text}<p class="text-body-lg text-pretty { left ? 'max-w-text' : '' }">{ settings.text }</p>{/if}
          <div class="flex flex-wrap items-center gap-space-xs pt-space-xs { left ? '' : 'justify-center' }">
            <Button action={ true } tone="photo">{ settings.action_label || site.settings.action_label }</Button>
            {#if second}<Button href={ second } tone="photo">{ settings.secondary_url ? settings.secondary_label : t('call_number', { phone: phone }) }</Button>{/if}
            {#if slides.length > 1}<button class="{ left ? 'ms-auto' : '' } flex size-tap items-center justify-center rounded-full border border-on-photo hover:bg-on-photo hover:text-brand-primary current:bg-on-photo current:text-brand-primary" type="button" data-autoplay-toggle={ id } data-interval={ settings.interval * 1000 } aria-pressed="false"><span class="sites-icon size-icon" aria-hidden="true">{#svg 'icons/pause.svg'}</span><span class="sr-only">{ t('pause_slideshow') }</span></button>{/if}
          </div>
        </div>
      </div>
    </div>
  {:else}
    <div class="mx-auto grid max-w-column items-center gap-space-xl { layout == 'arch' ? 'pt-space-lg' : '' } { layout == 'arch' || capsules ? 'lg:grid-cols-text-picture lg:gap-space-3xl' : '' } { capsules ? 'lg:h-full lg:grid-rows-1' : '' } { centred ? 'justify-items-center text-center' : '' }">
      {#if layout == 'dome' && settings.image}<div class="-mx-gutter w-screen max-w-column lg:mx-0 lg:w-full"><Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-dome" shape="dome" width={ 1600 } sizes="100vw" eager={ true } /></div>{/if}
      <div class="grid gap-space-md { centred ? 'max-w-reading justify-items-center' : 'py-space-xl' }">
        <h1 class="font-heading text-display text-balance text-scheme-heading"><Accent text={ settings.heading } /></h1>
        {#if settings.text}<p class="max-w-text text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
        <div class="flex flex-wrap gap-space-xs pt-space-xs { centred ? 'justify-center' : '' }">
          <Button action={ true }>{ settings.action_label || site.settings.action_label }</Button>
          {#if second}<Button href={ second } tone="secondary">{ settings.secondary_url ? settings.secondary_label : t('call_number', { phone: phone }) }</Button>{/if}
        </div>
      </div>
      {#if layout == 'arch' && settings.image}<div class="max-lg:order-first"><Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-portrait" shape="portal" width={ 960 } sizes="(min-width: 64rem) 40vw, 100vw" eager={ true } /></div>{/if}
      {#if capsules && images.length}
        <div class="-me-gutter flex gap-space-sm overflow-hidden lg:me-0 lg:h-full lg:items-center lg:gap-space-lg lg:overflow-visible">
          {#for c in [0, 1]}
            <div class="flex w-full flex-col gap-space-lg { c ? 'max-lg:hidden' : 'max-lg:contents' }">
              {#for block in images, i}{#if i % 2 == c}<div class="w-2/5 shrink-0 lg:w-full" data-block={ block.editor_id }><Well asset={ block.settings.image } alt={ block.settings.image_alt } ratio="aspect-capsule" shape="capsule" width={ 640 } sizes="(min-width: 64rem) 20vw, 40vw" eager={ i < 2 } /></div>{/if}{/for}
            </div>
          {/for}
        </div>
      {/if}
    </div>
  {/if}
</section>

<schema>
{
  "name": "Hero",
  "description": "The opener: type beside an arched photo, a full-bleed cover, type alone, or a dome of photo over the type.",
  "kind": "Hero",
  "icon": "image",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "arch", "options": [
      { "value": "arch", "label": "Arch" },
      { "value": "cover", "label": "Cover" },
      { "value": "quiet", "label": "Quiet" },
      { "value": "dome", "label": "Dome" },
      { "value": "capsules", "label": "Capsules" }
    ], "info": "Arch: an arched 4:5 photo beside the type. Cover: a full-bleed photo under a scrim. Quiet: the type alone. Dome: a half circle of photo over the type. Capsules: up to five tall rounded photos (the Image blocks) beside the type." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come in and *breathe*", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Massage, facials, hair, nails and makeup, with a quiet studio upstairs." },
    { "type": "text", "id": "action_label", "label": "Action label", "default": "", "info": "Leave empty to use the House setting." },
    { "type": "checkbox", "id": "show_call", "label": "Show Call", "default": true, "info": "The second button calls the first location's phone, unless it has a link below." },
    { "type": "text", "id": "secondary_label", "label": "Second button label", "default": "" },
    { "type": "url", "id": "secondary_url", "label": "Second button link", "default": "", "info": "Replaces Call, for example All services and /services." },
    { "type": "image", "id": "image", "label": "Image", "info": "4:5 for Arch, 3:2 or wider for Cover, 2:1 for Dome." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "select", "id": "height", "label": "Cover height", "default": "tall", "options": [
      { "value": "tall", "label": "Tall" },
      { "value": "full", "label": "Full screen" }
    ] },
    { "type": "select", "id": "align", "label": "Cover type", "default": "center", "options": [
      { "value": "center", "label": "Centred" },
      { "value": "left", "label": "Low left" }
    ] },
    { "type": "select", "id": "frame", "label": "Cover frame", "default": "full", "options": [
      { "value": "full", "label": "Full bleed" },
      { "value": "inset", "label": "Inset" }
    ], "info": "Inset: the banner sits in the column with rounded corners." },
    { "type": "checkbox", "id": "slideshow", "label": "Slideshow", "default": false, "info": "Cover only: fades through the gallery instead of the image, with a pause button." },
    { "type": "gallery", "id": "gallery", "label": "Slideshow gallery" },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 4, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "treatment", "label": "Treatment", "default": "natural", "options": [
      { "value": "natural", "label": "Natural" },
      { "value": "grain", "label": "Grain" }
    ], "info": "Cover only: a fine grain over the photo while House texture is on." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
      { "type": "image", "id": "image", "label": "Image", "info": "Capsules only; 3:5 portrait crops best." },
      { "type": "text", "id": "image_alt", "label": "Alt text", "default": "" }
    ] }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "Arch", "settings": { "layout": "arch", "color_scheme": "linen" } },
    { "name": "Cover", "settings": { "layout": "cover", "treatment": "grain", "color_scheme": "fern" } },
    { "name": "Quiet", "settings": { "layout": "quiet", "color_scheme": "linen" } },
    { "name": "Dome", "settings": { "layout": "dome", "color_scheme": "linen" } },
    { "name": "Capsules", "settings": { "layout": "capsules", "color_scheme": "linen" } }
  ]
}
</schema>
