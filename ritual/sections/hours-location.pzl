<!-- One location: the heading, the hours as a two-column table, the address, phone and note, Directions and Call; beside them the 3:5 capsule photo, or the map: an image or an embedded map in a 3:2 well with the capped top. -->
{#let
  loc = settings.location || (content.locations.entries | sort('fields.order') | first)
  f = loc ? loc.fields : null
  embed = settings.map == 'embed' && f && f.map_embed_url
}
{#if loc}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:grid-cols-text-picture md:gap-space-3xl">
    <div class="grid gap-space-md">
      <h2 class="font-heading text-h2 text-balance text-scheme-heading"><Accent text={ settings.heading || loc.title } /></h2>
      <address class="text-body-lg not-italic text-scheme-muted">{ f.address | newline_to_br }</address>
      {#if settings.show_hours}<HoursTable hours={ f.hours } />{/if}
      {#if f.note}<p class="text-body-sm text-scheme-meta">{ f.note }</p>{/if}
      <div class="flex flex-wrap gap-space-xs pt-space-xs">
        {#if f.map_url}<Button href={ f.map_url } external={ true }>{ t('directions') }</Button>{/if}
        {#if f.phone}<Button href="tel:{ f.phone | replace(' ', '') }" tone="secondary">{ t('call_number', { phone: f.phone }) }</Button>{/if}
      </div>
    </div>
    {#if settings.show_map}
      {#if embed}
        <div class="relative aspect-3/2 overflow-hidden rounded-t-cap bg-scheme-surface-2"><iframe class="absolute inset-0 size-full" src="{ f.map_embed_url }" title="{ t('map_of', { name: loc.title }) }" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
      {:else if settings.map == 'map' && f.map_image}
        <a class="block" href={ f.map_url || null } target="_blank" rel="noopener"><Well asset={ f.map_image } alt={ f.map_image_alt } ratio="aspect-3/2" shape="cap" width={ 1200 } sizes="(min-width: 48rem) 40vw, 100vw" /></a>
      {:else}
        <div><Well asset={ f.image } alt={ f.image_alt } ratio="aspect-capsule" shape="capsule" width={ 960 } sizes="(min-width: 48rem) 40vw, 100vw" /></div>
      {/if}
    {/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Hours and location",
  "description": "One location's hours, address and phone, beside its photo or a map.",
  "kind": "Contact",
  "icon": "map-pin",
  "settings": [
    { "type": "entry", "id": "location", "label": "Location", "info": "Leave empty to use the first location." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Leave empty to use the location's name. Wrap one word in asterisks to set it in the accent." },
    { "type": "checkbox", "id": "show_hours", "label": "Show hours", "default": true },
    { "type": "checkbox", "id": "show_map", "label": "Show the picture", "default": true },
    { "type": "select", "id": "map", "label": "Picture", "default": "photo", "options": [
      { "value": "photo", "label": "The location's photo" },
      { "value": "map", "label": "The map image" },
      { "value": "embed", "label": "An embedded map" }
    ], "info": "An embedded map uses the location's embed link and falls back to the photo without one." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "linen" } }
  ]
}
</schema>
