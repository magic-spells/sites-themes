<!-- The welcome: one Display sentence with its accent word and a line of body in the reading column. Portal sets an arched photo beside it; collage overlaps two photos, the second turned 3°, at 48rem and up. -->
{#let layout = settings.layout}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl { layout == 'text' ? 'justify-items-center text-center' : 'md:grid-cols-2 md:gap-space-3xl' }">
    <div class="grid max-w-reading gap-space-md">
      {#if settings.kicker}<p class="text-kicker font-semibold text-scheme-meta uppercase">{ settings.kicker }</p>{/if}
      <h2 class="font-heading text-h1 text-balance text-scheme-heading"><Accent text={ settings.heading } /></h2>
      {#if settings.text}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
      {#if settings.link_label && settings.link_href}<a class="justify-self-start text-body font-semibold text-accent underline underline-offset-4 hover:text-scheme-foreground { layout == 'text' ? 'justify-self-center' : '' }" href="{ settings.link_href }">{ settings.link_label }</a>{/if}
    </div>
    {#if layout == 'portal' && settings.image}
      <div class="w-full max-w-photo md:justify-self-end"><Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-portrait" shape="portal" width={ 960 } sizes="(min-width: 48rem) 30rem, 100vw" /></div>
    {:else if layout == 'collage' && settings.image}
      <div class="relative grid w-full grid-cols-6 md:justify-self-end">
        <div class="col-span-4"><Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-portrait" shape="portal" width={ 800 } sizes="(min-width: 48rem) 25vw, 66vw" /></div>
        {#if settings.image_2}<div class="col-span-3 col-start-4 row-start-1 mt-space-3xl self-end"><Well asset={ settings.image_2 } alt={ settings.image_2_alt } ratio="aspect-3/2" shape="cap" width={ 640 } sizes="(min-width: 48rem) 20vw, 50vw" tilt={ settings.tilt } /></div>{/if}
      </div>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Intro",
  "description": "One large sentence and a line, alone or beside one or two photos.",
  "kind": "Content",
  "icon": "text",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "portal", "options": [
      { "value": "text", "label": "Text" },
      { "value": "portal", "label": "Beside an arched photo" },
      { "value": "collage", "label": "Collage" }
    ] },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "", "info": "Words only: no numbers or dates." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A slow *hour* in the middle of a fast week.", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Six rooms, six people and nothing on a timer. Come in early, leave when you are ready." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/about" },
    { "type": "image", "id": "image", "label": "Image", "info": "4:5." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "image", "id": "image_2", "label": "Second image", "info": "Collage only: 3:2, laid over the first." },
    { "type": "text", "id": "image_2_alt", "label": "Second image alt text", "default": "" },
    { "type": "checkbox", "id": "tilt", "label": "Tilt the second image", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Portal", "settings": { "layout": "portal", "color_scheme": "linen" } },
    { "name": "Collage", "settings": { "layout": "collage", "color_scheme": "linen" } },
    { "name": "Text", "settings": { "layout": "text", "color_scheme": "linen" } }
  ]
}
</schema>
