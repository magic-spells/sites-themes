<!-- Every location as a card: a 3:2 capped photo, the name, the address, the hours and Directions and Call. Two across from 48rem. -->
{#let locs = content.locations.entries | sort('fields.order') | slice(0, 12)}
{#if locs.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid gap-x-space-xl gap-y-space-2xl md:grid-cols-2">
      {#for entry in locs}<li><LocationCard entry={ entry } base_path={ settings.base_path } show_hours={ settings.show_hours } show_map={ settings.show_map } /></li>{/for}
    </ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Locations",
  "description": "Every location as a card with its photo, address, hours, Directions and Call.",
  "kind": "Contact",
  "icon": "map",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "checkbox", "id": "show_hours", "label": "Show hours", "default": true },
    { "type": "checkbox", "id": "show_map", "label": "Show the photo", "default": true },
    { "type": "url", "id": "base_path", "label": "Location page path", "default": "/locations" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "linen" } }
  ]
}
</schema>
