<!-- Memberships and series as portal cards: the price in the arch, the name, summary, what is included, the expiry and note, and a full-width button; the featured package on fern. Three across from 48rem; on phones a row that scrolls with the next card peeking in. -->
{#let
  all = content.packages.entries | sort('fields.order')
  picked = (settings.source == 'featured' ? all | where('fields.featured') : all) | slice(0, 12)
}
<section class="bg-scheme-background py-section md:px-gutter text-scheme-foreground">
  <div class="mx-auto max-w-column px-gutter md:px-0">
    <SectionHead kicker={ settings.kicker } heading={ settings.heading } text={ settings.text } />
  </div>
  <ul class="mx-auto flex max-w-column snap-x snap-mandatory scroll-px-gutter items-start gap-space-md overflow-x-auto px-gutter md:px-0 md:grid md:snap-none md:overflow-visible { settings.columns == 2 ? 'md:grid-cols-2' : 'md:grid-cols-3' }">
    {#for entry in picked}<li class="w-4/5 shrink-0 snap-start md:w-auto"><PackageCard entry={ entry } /></li>{/for}
  </ul>
</section>

<schema>
{
  "name": "Packages",
  "description": "Memberships, series and clubs as arched cards with the price, what is included and a button.",
  "kind": "Services",
  "icon": "package",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Come back often", "info": "Words only: no numbers or dates." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A standing *appointment*", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "select", "id": "source", "label": "Packages", "default": "all", "options": [
      { "value": "all", "label": "All" },
      { "value": "featured", "label": "Featured" }
    ] },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3", "options": [
      { "value": "2", "label": "Two" },
      { "value": "3", "label": "Three" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "linen" } }
  ]
}
</schema>
