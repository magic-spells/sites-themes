<!-- The house policies (cancellation, late arrival, children, gift cards, health) as rows that open (components/Questions.pzl). -->
<Questions s={ settings } items={ blocks } />

<schema>
{
  "name": "Policies",
  "description": "The house policies as rows that open.",
  "kind": "Content",
  "icon": "scroll-text",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The small print", "info": "Words only: no numbers or dates." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our *policies*", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "checkbox", "id": "first_open", "label": "First answer open", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "blocks": [
    { "type": "item", "name": "Policy", "settings": [
      { "type": "text", "id": "question", "label": "Policy", "default": "Cancellation" },
      { "type": "richtext", "id": "answer", "label": "Text", "default": "<p>Cancel or move an appointment up to a day ahead at no charge.</p>" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": {}, "blocks": [
      { "type": "item", "settings": { "question": "Cancellation", "answer": "<p>Cancel or move an appointment up to a day ahead at no charge.</p>" } },
      { "type": "item", "settings": { "question": "Late arrival", "answer": "<p>We keep your room as long as we can, and finish on time for the next guest.</p>" } }
    ] }
  ]
}
</schema>
