<!-- Prose in the reading column: the section's own text, or the page's body when it has none. -->
{#let body = settings.body || page.content}
{#if body || settings.heading}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-reading gap-space-md">
    {#if settings.heading}<h2 class="font-heading text-h2 text-balance text-scheme-heading"><Accent text={ settings.heading } /></h2>{/if}
    {#if body}<div class="sites-prose">{ body }</div>{/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Rich text",
  "description": "Prose in a reading column.",
  "kind": "Content",
  "icon": "align-left",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "richtext", "id": "body", "label": "Text", "default": "", "info": "Leave empty to show the page's own body." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "linen" } }
  ]
}
</schema>
