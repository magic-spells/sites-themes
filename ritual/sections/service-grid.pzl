<!-- Service cards: most booked by default. Three across from 64rem, two from 48rem, and on phones a row that scrolls with the next card peeking in. On a service page, related shows the service's own category without the service itself, or the handles listed. -->
{#let
  services = content.services.entries | sort('fields.order')
  here = page.entry
  related = settings.source == 'related' && here ? services | where('fields.category.handle', here.fields.category.handle) : []
  picked = settings.source == 'featured' ? services | where('fields.featured') : (settings.source == 'related' ? related : services)
  wanted = settings.handles | split(',')
  limit = Math.min(settings.limit, 12)
}
<section class="bg-scheme-background py-section md:px-gutter text-scheme-foreground">
  <div class="mx-auto max-w-column px-gutter md:px-0">
    <SectionHead kicker={ settings.kicker } heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } />
  </div>
  <ul class="mx-auto flex max-w-column snap-x snap-mandatory scroll-px-gutter gap-space-md overflow-x-auto px-gutter md:px-0 md:grid md:snap-none md:overflow-visible { settings.columns == 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-2 lg:grid-cols-3' }">
    {#if settings.handles}
      {#for h in wanted}
        {#let entry = services | find('handle', (h | strip))}
        {#if entry}<li class="w-4/5 shrink-0 snap-start md:w-auto"><ServiceCard entry={ entry } base_path={ settings.base_path } /></li>{/if}
      {/for}
    {:else}
      {#for entry in picked | reject('id', here ? here.id : '') | slice(0, limit)}
        <li class="w-4/5 shrink-0 snap-start md:w-auto"><ServiceCard entry={ entry } base_path={ settings.base_path } /></li>
      {/for}
    {/if}
  </ul>
</section>

<schema>
{
  "name": "Service grid",
  "description": "Services as cards with a photo, duration, price and Book: the most booked, a category's, or a list.",
  "kind": "Services",
  "icon": "layout-grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Most booked", "info": "Words only: no numbers or dates." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people come *back* for", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "select", "id": "source", "label": "Services", "default": "featured", "options": [
      { "value": "featured", "label": "Most booked (featured)" },
      { "value": "related", "label": "Same category as this service" },
      { "value": "all", "label": "All" }
    ] },
    { "type": "text", "id": "handles", "label": "Listed handles", "default": "", "info": "Service handles, comma-separated: these, in this order, instead of the choice above." },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3", "options": [
      { "value": "3", "label": "Three" },
      { "value": "4", "label": "Four" }
    ] },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See the full menu" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/services" },
    { "type": "url", "id": "base_path", "label": "Service page path", "default": "/services" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Most booked", "settings": { "source": "featured", "color_scheme": "linen" } },
    { "name": "You might also like", "settings": { "source": "related", "kicker": "", "heading": "You might also *like*", "limit": 3, "link_label": "", "color_scheme": "linen" } }
  ]
}
</schema>
