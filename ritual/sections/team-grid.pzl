<!-- The people: 4:5 portal portraits with the name, role and level, specialties and a Book with link. Three across from 64rem, two from 48rem; on phones a row that scrolls with the next portrait peeking in, or a stack. -->
{#let
  team = content.team.entries | sort('fields.order')
  people = (settings.source == 'featured' ? team | where('fields.featured') : team) | slice(0, Math.min(settings.limit, 12))
  row = settings.mobile == 'row'
}
<section class="bg-scheme-background py-section md:px-gutter text-scheme-foreground">
  <div class="mx-auto max-w-column px-gutter md:px-0">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } />
  </div>
  <ul class="mx-auto max-w-column gap-x-space-md gap-y-space-xl px-gutter md:grid md:px-0 md:grid-cols-2 lg:grid-cols-3 { row ? 'flex snap-x snap-mandatory scroll-px-gutter overflow-x-auto md:snap-none md:overflow-visible' : 'grid' }">
    {#for entry in people}<li class="{ row ? 'w-3/4 shrink-0 snap-start md:w-auto' : '' }"><TeamCard entry={ entry } base_path={ settings.base_path } /></li>{/for}
  </ul>
</section>

<schema>
{
  "name": "Team grid",
  "description": "The people, as arched portraits with their role and a link to book with them.",
  "kind": "Team",
  "icon": "users",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six of us, one room *each*", "info": "Wrap one word in asterisks to set it in the accent." },
    { "type": "text", "id": "text", "label": "Text", "default": "" },
    { "type": "select", "id": "source", "label": "People", "default": "all", "options": [
      { "value": "all", "label": "Everyone" },
      { "value": "featured", "label": "Featured" }
    ] },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 12 },
    { "type": "select", "id": "mobile", "label": "On phones", "default": "row", "options": [
      { "value": "row", "label": "A row that scrolls" },
      { "value": "stack", "label": "A stack" }
    ] },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Meet everyone" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/team" },
    { "type": "url", "id": "base_path", "label": "Person page path", "default": "/team" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "linen" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "linen" } }
  ]
}
</schema>
