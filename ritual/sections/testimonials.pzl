<!-- What people say. Carousel: a tarot one-up on fern, the head with round arrows right, the quote centred in Gloock with its accent word, the name and the treatment under it. Portraits: three across, each a 4:5 portal portrait, the quote, the name and the treatment. -->
{#let
  id = 'quotes-' + section.id
  all = content.testimonials.entries | sort('fields.order')
  quotes = (settings.source == 'featured' ? all | where('fields.featured') : all) | slice(0, settings.limit)
  options = { slidesPerView: 1, gap: '1.5rem', loop: true, navigation: { showButtons: true, showPagination: false } }
}
{#if quotes.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    {#if settings.layout == 'portraits'}
      <SectionHead heading={ settings.heading } />
      <ul class="grid gap-x-space-md gap-y-space-xl md:grid-cols-2 lg:grid-cols-3">
        {#for entry in quotes}
          {#let f = entry.fields}
          <li class="grid content-start gap-space-md { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
            {#if f.image}<span class="block w-full max-w-thumb"><Well asset={ f.image } alt={ f.image_alt } ratio="aspect-portrait" shape="portal" width={ 480 } sizes="10rem" /></span>{/if}
            <figure class="grid gap-space-sm">
              <blockquote class="font-heading text-h4 text-pretty"><Accent text={ '“' + f.quote + '”' } /></blockquote>
              <figcaption class="text-body-sm"><span class="font-semibold">{ f.name }</span>{#if f.line || f.service} <span class="text-scheme-meta">· { f.line || f.service.title }</span>{/if}</figcaption>
            </figure>
          </li>
        {/for}
      </ul>
    {:else}
      <tarot-carousel class="block" id={ id }>
        <script type="application/json" data-tarot-options>{ options | json }</script>
        <SectionHead heading={ settings.heading }>{#if quotes.length > 1}<Arrows />{/if}</SectionHead>
        <tarot-viewport><tarot-track>
          {#for entry in quotes}
            {#let f = entry.fields}
            <tarot-slide>
              <figure class="mx-auto grid max-w-reading justify-items-center gap-space-md py-space-lg text-center">
                <blockquote class="font-heading text-h2 text-balance"><Accent text={ '“' + f.quote + '”' } /></blockquote>
                <figcaption class="text-body-sm"><span class="font-semibold">{ f.name }</span>{#if f.line || f.service} <span class="text-scheme-meta">· { f.line || f.service.title }</span>{/if}</figcaption>
              </figure>
            </tarot-slide>
          {/for}
        </tarot-track></tarot-viewport>
      </tarot-carousel>
    {/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Testimonials",
  "description": "Kind words: one at a time in a carousel, or three across with portraits.",
  "kind": "Social proof",
  "icon": "quote",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "carousel", "options": [
      { "value": "carousel", "label": "Carousel" },
      { "value": "portraits", "label": "Portraits" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people *say*", "info": "Wrap one word in asterisks to set it in the accent. A quote may mark its own word the same way." },
    { "type": "select", "id": "source", "label": "Testimonials", "default": "all", "options": [
      { "value": "all", "label": "All" },
      { "value": "featured", "label": "Featured" }
    ] },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 6 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "fern" }
  ],
  "presets": [
    { "name": "Carousel", "settings": { "layout": "carousel", "color_scheme": "fern" } },
    { "name": "Portraits", "settings": { "layout": "portraits", "source": "featured", "limit": 3, "color_scheme": "fern" } }
  ]
}
</schema>
