<!-- What people say. Carousel: a tarot one-up on fern under a centred head, the quote centred in Gloock, the name and the treatment under it, page dots below; from 64rem round arrows at the stage's sides show on hover or keyboard focus. Portraits: three across from 48rem, each a small 4:5 capsule portrait, the quote in Body large and one Meta line with the name and the treatment. -->
{#let
  id = 'quotes-' + section.id
  all = content.testimonials.entries | sort('fields.order')
  quotes = (settings.source == 'featured' ? all | where('fields.featured') : all) | slice(0, settings.limit)
  options = { slidesPerView: 1, gap: '1.5rem', loop: true, navigation: { showButtons: true, showPagination: true } }
}
{#if quotes.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    {#if settings.layout == 'portraits'}
      <SectionHead heading={ settings.heading } />
      <ul class="grid gap-space-lg md:grid-cols-3">
        {#for entry in quotes}
          {#let f = entry.fields}
          <li class="grid max-w-quote content-start gap-space-sm { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
            {#if f.image}<span class="block w-portrait"><Well asset={ f.image } alt={ f.image_alt } ratio="aspect-portrait" shape="capsule" width={ 240 } sizes="6rem" /></span>{/if}
            <figure class="grid gap-space-xs">
              <blockquote class="text-body-lg text-pretty">“{ f.quote }”</blockquote>
              <figcaption class="text-body-sm text-scheme-meta">{ f.name }{#if f.line || f.service} · { f.line || f.service.title }{/if}</figcaption>
            </figure>
          </li>
        {/for}
      </ul>
    {:else}
      <tarot-carousel class="block" id={ id }>
        <script type="application/json" data-tarot-options>{ options | json }</script>
        <SectionHead heading={ settings.heading } centred={ true } />
        <div class="group relative">
          <tarot-viewport><tarot-track>
            {#for entry in quotes}
              {#let f = entry.fields}
              <tarot-slide>
                <figure class="mx-auto grid max-w-reading justify-items-center gap-space-md pt-space-lg text-center">
                  <blockquote class="font-heading text-h2 text-balance">“{ f.quote }”</blockquote>
                  <figcaption class="text-body-sm"><span class="font-semibold">{ f.name }</span>{#if f.line || f.service} <span class="text-scheme-meta">· { f.line || f.service.title }</span>{/if}</figcaption>
                </figure>
              </tarot-slide>
            {/for}
          </tarot-track></tarot-viewport>
          {#if quotes.length > 1}<Arrows wrap="pointer-events-none absolute *:pointer-events-auto inset-0 hidden items-center justify-between opacity-0 transition-opacity duration-fast group-hover:opacity-100 has-focus-visible:opacity-100 lg:flex" />{/if}
        </div>
      </tarot-carousel>
    {/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Testimonials",
  "description": "Kind words: one at a time in a carousel, or three across with portraits.",
  "kind": "Social proof",
  "icon": "quote",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "carousel", "options": [
      { "value": "carousel", "label": "Carousel" },
      { "value": "portraits", "label": "Portraits" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    { "type": "select", "id": "source", "label": "Testimonials", "default": "all", "options": [
      { "value": "all", "label": "All" },
      { "value": "featured", "label": "Featured" }
    ] },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 6 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "fern" }
  ],
  "presets": [
    { "name": "Carousel", "settings": { "layout": "carousel", "color_scheme": "fern" } },
    { "name": "Portraits", "settings": { "layout": "portraits", "source": "featured", "limit": 3, "color_scheme": "fern" } }
  ]
}
</schema>
