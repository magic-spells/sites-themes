<!-- template: 404 -->
<!-- layout: default -->
<!-- A wrong path on sand: the line and a way home, then the most-booked services as cards so it still leads somewhere. -->
{#let services = content.services.entries | where('fields.featured') | sort('fields.order') | slice(0, 3)}
<section class="sites-scheme-sand bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column justify-items-start gap-space-md">
    <h1 class="max-w-reading font-heading text-h1 text-balance text-scheme-heading"><Accent text={ t('not_found_title') } /></h1>
    <p class="max-w-text text-body-lg text-pretty text-scheme-muted">{ t('not_found_body') }</p>
    <Button href="/">{ t('home') }</Button>
  </div>
</section>
{#if services.length}
<section class="sites-scheme-linen bg-scheme-background px-gutter py-section text-scheme-foreground">
  <ul class="mx-auto grid max-w-column gap-space-md md:grid-cols-2 lg:grid-cols-3">
    {#for entry in services}<li><ServiceCard entry={ entry } base_path="/services" /></li>{/for}
  </ul>
</section>
{/if}
