<!-- template: Password -->
<!-- layout: default -->
<!-- The site behind a password, on linen: the stamp, a portal photo, a line and the password field over Enter. data-bare hides the header, footer and panel groups (styles/theme.css). -->
{#let loc = content.locations.entries | sort('fields.order') | first}
<section class="sites-scheme-linen grid min-h-dvh flex-1 place-items-center bg-scheme-background px-gutter py-section text-scheme-foreground" data-bare>
  <div class="grid w-full max-w-text justify-items-center gap-space-lg text-center">
    <Stamp name={ site.settings.wordmark || site.name } line={ site.settings.stamp_line || (loc ? loc.fields.address | split('\n') | first | split(' ') | slice(1) | join(' ') : '') } />
    {#if loc && loc.fields.image}<div class="w-full max-w-thumb"><Well asset={ loc.fields.image } alt="" ratio="aspect-portrait" shape="portal" width={ 480 } sizes="10rem" /></div>{/if}
    <p class="text-body-lg text-pretty text-scheme-muted">{ t('password_body') }</p>
    <form class="grid w-full gap-space-sm text-left" method="post" action="/_sites/unlock">
      <input type="hidden" name="to" value="{ request.query.return_to }" />
      {#if request.query.password_error}<p class="text-body-sm text-scheme-error" role="alert">{ request.query.password_error }</p>{/if}
      <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" required={ true } prefix="password" />
      <Submit wide={ true }>{ t('password_submit') }</Submit>
    </form>
  </div>
</section>
