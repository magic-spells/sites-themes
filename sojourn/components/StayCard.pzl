<!-- component: StayCard -->
<!-- props: entry base_path view -->
<!-- A stay, one link. grid: a card at content radius with a hairline, a 3:2 well at well radius with the price chip, the title, the facts line in meta and one line of summary; the text block grows so a row's cards end level. list: the photo left five parts, the text right seven with the first four amenities as glyph and label pairs; stacked on phones. -->
{#let
  f = entry.fields
  href = (base_path ?? '/stays') + '/' + entry.handle
  list = view == 'list'
}
<article class="group relative h-full rounded-content border border-scheme-border bg-scheme-background p-space-sm { list ? 'grid gap-space-md md:grid-cols-picture-text md:items-center md:gap-space-xl' : 'flex flex-col gap-space-sm' } { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
  <Well asset={ f.image } alt={ f.image_alt } ratio="aspect-photo" radius="well" width={ 800 } sizes="(min-width: 64rem) 25rem, (min-width: 48rem) 50vw, 85vw" zoom={ true }><PriceChip f={ f } /></Well>
  <div class="flex flex-1 flex-col gap-space-2xs px-space-xs pb-space-xs">
    <h3 class="text-h4 font-semibold"><a class="after:absolute after:inset-0 hover:underline hover:underline-offset-4" href="{ href }">{ entry.title }</a></h3>
    <p class="text-body-sm text-scheme-meta"><FactsLine f={ f } /></p>
    {#if f.summary}<p class="text-body-sm text-pretty text-scheme-muted">{ f.summary }</p>{/if}
    {#if list && f.amenities}
      <ul class="mt-space-sm grid grid-cols-2 gap-space-xs">
        {#for line in f.amenities | split('\n') | slice(0, 4)}<li><Amenity label={ line } /></li>{/for}
      </ul>
    {/if}
  </div>
</article>
