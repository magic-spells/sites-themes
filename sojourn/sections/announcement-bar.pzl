<!-- The ticker: short phrases with a pin between them on a marquee, the whole line one link; a pause button and, with a key, a close button that hides it for good. scroll off: the phrases stand still, centred. Under reduced motion the marquee stands still, one copy, cut with an ellipsis. -->
{#let lines = settings.lines | split('\n') | compact | slice(0, 6)}
{#if lines.length}
<aside class="relative bg-scheme-background text-scheme-foreground" data-dismiss-key="{ settings.key }" aria-label="{ t('announcement') }" data-ticker={ settings.scroll ? true : null }>
  <div class="flex items-center">
    <a class="block min-w-0 flex-1 py-space-xs text-body-sm focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent" href={ settings.link || null }>
      {#if settings.scroll}
        <scrolling-content class="block" speed="30" fade>
          <scrolling-track>
            <scrolling-item class="flex items-center">
              {#for line in lines}<span class="whitespace-nowrap">{ line | strip }</span><span class="mx-space-md text-accent"><Glyph name="pin" cls="size-icon" /></span>{/for}
            </scrolling-item>
          </scrolling-track>
        </scrolling-content>
      {:else}
        <span class="flex flex-wrap items-center justify-center gap-x-space-md px-gutter text-center">{#for line in lines, i}{#if i}<span class="text-accent"><Glyph name="pin" /></span>{/if}<span>{ line | strip }</span>{/for}</span>
      {/if}
    </a>
    {#if settings.scroll}<button class="flex size-tap shrink-0 items-center justify-center text-scheme-meta hover:text-scheme-foreground" type="button" data-ticker-toggle aria-pressed="false"><Glyph name="pause" /><span class="sr-only">{ t('pause') }</span></button>{/if}
    {#if settings.key}<button class="flex size-tap shrink-0 items-center justify-center text-accent hover:text-scheme-foreground" type="button" data-dismiss><Glyph name="close" /><span class="sr-only">{ t('dismiss') }</span></button>{/if}
  </div>
</aside>
{/if}

<schema>
{
  "name": "Announcement bar",
  "description": "Short phrases above the header, scrolling as a ticker or standing still.",
  "kind": "Header",
  "icon": "megaphone",
  "settings": [
    { "type": "textarea", "id": "lines", "label": "Phrases", "default": "Open May to October\nDogs welcome in the cabins\nNew: the sauna by the water", "info": "One per line, up to six. A pin sits between them." },
    { "type": "url", "id": "link", "label": "Link", "default": "", "info": "The whole line links here." },
    { "type": "checkbox", "id": "scroll", "label": "Scroll", "default": true, "info": "On: the phrases move as a ticker with a pause button. Off: they stand still, centred." },
    { "type": "text", "id": "key", "label": "Dismiss key", "default": "", "info": "Set a key to show a close button. A visitor who closes the bar does not see it again until you change the key." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "night" }
  ],
  "presets": [
    { "name": "Night", "settings": { "color_scheme": "night" } },
    { "name": "Sunset", "settings": { "color_scheme": "sunset" } }
  ]
}
</schema>
