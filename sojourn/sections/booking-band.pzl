<!-- Where booking happens: H2, one line and the booking button, and, when Place booking is embed or both, the booking app in a dashed surface-2 frame beside or under them (its own iframe of the Place embed URL at the Place height). off, or Place booking link only: the centred link band, with the dot grid when Brand texture is dots. -->
{#let
  s = site.settings
  embed = settings.embed_position != 'off' && s.booking != 'link' && s.booking_embed_url
  beside = embed && settings.embed_position == 'beside'
  centred = !embed
}
<section class="relative isolate bg-scheme-background px-gutter py-section text-scheme-foreground" id="book">
  {#if centred && s.texture == 'dots'}<span class="pointer-events-none absolute top-0 right-0 -z-10 h-full w-1/4 bg-dots" aria-hidden="true"></span>{/if}
  <div class="mx-auto grid max-w-column items-center gap-space-xl { beside ? 'md:grid-cols-picture-text md:gap-space-3xl' : '' } { centred ? 'justify-items-center text-center' : '' }">
    <div class="grid max-w-reading gap-space-md { centred ? 'justify-items-center' : 'justify-items-start' }">
      <div class="grid gap-space-xs">
        <h2 class="text-h2 font-semibold text-balance text-scheme-heading"><Accent text={ settings.heading } rise={ true } /></h2>
        {#if settings.text}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
      </div>
      {#if s.booking != 'embed' && s.booking_url}<Button action={ true }>{ s.booking_label }</Button>{/if}
    </div>
    {#if embed}<div class="overflow-hidden rounded-content border border-dashed border-scheme-border bg-scheme-surface-2"><iframe class="block w-full" src="{ s.booking_embed_url }" height={ s.booking_embed_height || 640 } loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="{ t('booking_frame') }"></iframe></div>{/if}
  </div>
</section>

<schema>
{
  "name": "Booking band",
  "description": "Book your stay: a line, the booking button and the booking app's frame.",
  "kind": "Call to action",
  "icon": "calendar",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Book your stay" },
    { "type": "text", "id": "text", "label": "Text", "default": "Availability and booking run through our booking partner." },
    { "type": "select", "id": "embed_position", "label": "Booking frame", "default": "beside", "options": [
      { "value": "beside", "label": "Beside the text" },
      { "value": "below", "label": "Below the text" },
      { "value": "off", "label": "Off" }
    ], "info": "Shown when Place booking is Embed or Both and the embed URL is set. Off, or a link-only booking, centres the text and the button." },
    { "type": "paragraph", "content": "The button, the frame's address and its height come from the Place settings." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Beside", "settings": { "embed_position": "beside", "color_scheme": "white" } },
    { "name": "Below", "settings": { "embed_position": "below", "color_scheme": "white" } },
    { "name": "Link", "settings": { "embed_position": "off", "color_scheme": "white" } }
  ]
}
</schema>
