<!-- STUB (agent C builds it): the head and the things to do as cards. -->
{#let things = content.experiences.entries | sort('fields.order') | reject('id', page.entry.id) | slice(0, settings.limit)}
{#if things.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } link_label={ settings.link_label } link_href={ settings.link_href } />
    <ul class="grid gap-x-space-md gap-y-space-xl md:grid-cols-2 lg:grid-cols-3">
      {#for entry in things}<li><ExploreCard entry={ entry } base_path={ settings.base_path } /></li>{/for}
    </ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Explore grid",
  "description": "Things to do, here and nearby, as cards.",
  "kind": "Explore",
  "icon": "compass",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Things to do" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "chips", "label": "Kind chips", "default": false, "info": "All, Here, Nearby and Trips as links that show only that kind. For the things to do page." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All things to do" },
    { "type": "url", "id": "link_href", "label": "Link", "default": "/explore" },
    { "type": "url", "id": "base_path", "label": "Page path", "default": "/explore" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "lake" }
  ],
  "presets": [
    { "name": "Home", "settings": { "limit": 3, "color_scheme": "lake" } },
    { "name": "All", "settings": { "heading": "", "limit": 12, "chips": true, "link_label": "", "color_scheme": "paper" } }
  ]
}
</schema>
