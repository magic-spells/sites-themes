<!-- The colophon: the wordmark, the address and the social glyphs left; the main menu large and the legal menu small at the right edge, each item on its own line; a hairline, then the small print. -->
{#let
  s = site.settings
  name = s.wordmark || site.name
  social = settings.social_menu ? settings.social_menu.items : []
}
<footer class="bg-scheme-background px-gutter pt-section pb-space-lg text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-xl">
    <div class="grid gap-space-xl md:grid-cols-2">
      <div class="grid content-start gap-space-md">
        <a class="justify-self-start text-h3 font-bold" href="/">{ name }</a>
        {#if s.address}<address class="text-body-sm not-italic text-scheme-muted">{ s.address | split('\n') | compact | join(', ') }</address>{/if}
        {#if social.length}
          <ul class="flex gap-space-xs">
            {#for item in social}
              {#let glyph = item.label | strip | downcase}
              <li><a class="flex size-tap items-center justify-center rounded-full text-accent hover:bg-scheme-surface-2" href="{ item.href }" target="_blank" rel="noopener"><Glyph name={ glyph == 'instagram' || glyph == 'facebook' ? glyph : 'arrow-right' } /><span class="sr-only">{ item.label }</span></a></li>
            {/for}
          </ul>
        {/if}
      </div>
      <div class="flex flex-wrap gap-x-space-2xl gap-y-space-lg md:justify-end">
        {#for menu in [settings.menu, settings.legal_menu], i}
          {#if menu && menu.items.length}
            <nav aria-label="{ menu.title }">
              <ul class="grid { i ? 'gap-space-sm text-body-sm' : 'gap-space-2xs text-h4 font-medium' }">
                {#for item in menu.items}<li><a class="underline-offset-4 hover:underline" href="{ item.href }" target={ item.open_in_new ? '_blank' : null } rel={ item.open_in_new ? 'noopener' : null }>{ item.label }</a></li>{/for}
              </ul>
            </nav>
          {/if}
        {/for}
      </div>
    </div>
    <p class="border-t border-scheme-border pt-space-md text-body-sm text-scheme-meta">{ settings.small_print || '© ' + name }</p>
  </div>
</footer>

<schema>
{
  "name": "Footer",
  "description": "The colophon: the wordmark, the address, the social links and the menus.",
  "kind": "Footer",
  "icon": "panel-bottom",
  "settings": [
    { "type": "menu", "id": "menu", "label": "Menu" },
    { "type": "menu", "id": "legal_menu", "label": "Legal menu" },
    { "type": "menu", "id": "social_menu", "label": "Social menu", "info": "Items labelled Instagram or Facebook show their glyph." },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "", "info": "Leave empty for © and the wordmark." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "night", "info": "Pick a scheme that differs from the band above." }
  ],
  "presets": [
    { "name": "Night", "settings": { "menu": "main", "legal_menu": "legal", "social_menu": "social", "color_scheme": "night" } },
    { "name": "Forest", "settings": { "menu": "main", "legal_menu": "legal", "social_menu": "social", "color_scheme": "forest" } }
  ]
}
</schema>
