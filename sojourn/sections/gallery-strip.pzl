<!-- A gallery's photos as a carousel of equal slides at one shape, 1.25, 2.25 then 3.2 across, the track bleeding off the right. Dots under it on phones; from 48rem the progress hairline and the round arrows at its right. -->
{#let
  items = settings.gallery ? settings.gallery.items | slice(0, 12) : []
  id = 'strip-' + section.id
  nav = { showButtons: true, showPagination: false }
  options = { slidesPerView: 1.25, gap: '0.75rem', progressBar: { selector: '#bar-' + id }, navigation: { showButtons: false, showPagination: true }, breakpoints: { '768': { slidesPerView: 2.25, gap: '1rem', navigation: nav }, '1024': { slidesPerView: 3.2, gap: '1rem', navigation: nav } } }
}
{#if items.length}
<section class="overflow-hidden bg-scheme-background px-gutter py-section text-scheme-foreground">
  <tarot-carousel class="mx-auto block max-w-column" id={ id } data-track>
    <script type="application/json" data-tarot-options>{ options | json }</script>
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <tarot-viewport class="ms-0 -me-gutter w-auto"><tarot-track>
      {#for item in items}<tarot-slide><Well asset={ item.asset } alt={ item.alt } ratio="aspect-{ settings.slide_ratio }" width={ 800 } sizes="(min-width: 64rem) 27rem, (min-width: 48rem) 40vw, 80vw" /></tarot-slide>{/for}
    </tarot-track></tarot-viewport>
    <div class="mt-space-md flex items-center gap-space-md max-md:hidden"><div class="flex-1" id="bar-{ id }"></div><Arrows wrap="flex gap-space-xs" /></div>
  </tarot-carousel>
</section>
{/if}

<schema>
{
  "name": "Gallery strip",
  "description": "A gallery's photos as a carousel of equal slides.",
  "kind": "Gallery",
  "icon": "gallery-horizontal",
  "settings": [
    { "type": "gallery", "id": "gallery", "label": "Gallery", "info": "Reads each item's asset, alt and caption." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "slide_ratio", "label": "Slide shape", "default": "portrait", "options": [
      { "value": "portrait", "label": "Portrait 4:5" },
      { "value": "photo", "label": "Landscape 3:2" },
      { "value": "square", "label": "Square" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "gallery": "strip", "color_scheme": "white" } }
  ]
}
</schema>
