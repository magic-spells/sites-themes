<!-- STUB (agent C builds it): the gallery's photos in a row. -->
{#let items = settings.gallery ? settings.gallery.items | slice(0, 12) : []}
{#if items.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="flex gap-space-sm overflow-x-auto">
      {#for item in items}<li class="w-3/4 shrink-0 md:w-1/3"><Well asset={ item.asset } alt={ item.alt } ratio="aspect-portrait" width={ 640 } sizes="(min-width: 48rem) 33vw, 75vw" /></li>{/for}
    </ul>
  </div>
</section>
{/if}

<schema>
{
  "name": "Gallery strip",
  "description": "A gallery's photos as a carousel of equal slides.",
  "kind": "Gallery",
  "icon": "gallery-horizontal",
  "settings": [
    { "type": "gallery", "id": "gallery", "label": "Gallery", "info": "Reads each item's asset, alt and caption." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "slide_ratio", "label": "Slide shape", "default": "portrait", "options": [
      { "value": "portrait", "label": "Portrait 4:5" },
      { "value": "photo", "label": "Landscape 3:2" },
      { "value": "square", "label": "Square" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" }
  ],
  "presets": [
    { "name": "Default", "settings": { "gallery": "strip", "color_scheme": "white" } }
  ]
}
</schema>
