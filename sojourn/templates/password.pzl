<!-- template: Password -->
<!-- layout: default -->
<!-- The site behind a password, on night with no header or footer: a tall photo, the wordmark, a line and the password field over Enter. -->
<Utility bare={ true }>
  <p class="text-h4 font-bold">{ site.settings.wordmark || site.name }</p>
  <h1 class="text-h1 font-bold text-balance text-scheme-heading">{ t('password_title') }</h1>
  <p class="text-body-lg text-pretty text-scheme-muted">{ t('password_body') }</p>
  <form class="grid w-full max-w-text gap-space-sm" method="post" action="/_sites/unlock">
    <input type="hidden" name="to" value="{ request.query.return_to }" />
    {#if request.query.password_error}<p class="text-body-sm text-scheme-error" role="alert">{ request.query.password_error }</p>{/if}
    <Field name="password" label={ t('password_label') } type="password" autocomplete="current-password" required={ true } prefix="password" />
    <Button type="submit" wide={ true }>{ t('password_submit') }</Button>
  </form>
</Utility>
