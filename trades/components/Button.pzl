<!-- component: Button -->
<!-- The button: mixed case, 0.5rem corners. tone: solid (the scheme's button, the default) or outline (a hairline in the text colour). With type it is a <button> of that type. With ask it is the ask: a link to the Yard ask url that opens the estimate sheet instead while Yard ask is form (theme.ts), labelled with the Yard ask label unless the caller writes one. small is the 2.75rem height; wide fills the row; cls adds classes (the header's over-hero look). -->
{#let
  s = site.settings
  sheet = ask && s.ask != 'link'
  url = ask ? s.ask_url : href
  look = tone == 'outline' ? 'border-scheme-foreground text-scheme-foreground hover:bg-scheme-surface-2' : 'border-scheme-button-background bg-scheme-button-background text-scheme-button-foreground hover:border-scheme-button-hover-background hover:bg-scheme-button-hover-background hover:text-scheme-button-hover-foreground'
  look_all = 'inline-flex items-center justify-center gap-space-xs rounded-button border px-button-x text-button font-medium whitespace-nowrap transition-colors duration-fast ' + (small ? 'min-h-tap ' : 'min-h-control ') + look + (wide ? ' w-full' : '') + (cls ? ' ' + cls : '')
}
{#if type}<button class="{ look_all }" type="{ type }"><Children/></button>{:else}<a class="{ look_all }" href="{ url }" data-panel-open={ sheet ? 'estimate' : null } aria-haspopup={ sheet ? 'dialog' : null }><Children>{ ask ? s.ask_label : '' }</Children></a>{/if}
