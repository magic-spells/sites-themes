<!-- component: Field -->
<!-- A labelled input: the label above, the box on the band colour in a muted hairline, the hairline in the text colour on focus; the placeholder in the muted colour; the error under it in the scheme's error colour, tied by aria-describedby. -->
{#let
  id = 'field-' + prefix + '-' + name
  err = error ? 'error-' + prefix + '-' + name : null
  box = 'block w-full rounded-input border bg-scheme-background px-space-sm text-body text-scheme-foreground placeholder:text-scheme-muted focus:border-scheme-foreground focus:outline-none ' + (error ? 'border-scheme-error' : 'border-scheme-muted')
}
<div class={ wide ? 'md:col-span-2' : null }>
  <label class="mb-space-xs block text-body-sm font-medium" for="{ id }">{ label }{#if required}<span aria-hidden="true"> *</span>{/if}</label>
  {#if type == 'textarea'}
    <textarea class="{ box } min-h-textarea resize-y py-space-sm" id="{ id }" name={ name } placeholder={ placeholder } maxlength={ maxlength } required={ required } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ err }>{ value }</textarea>
  {:else}
    <input class="{ box } min-h-control" id="{ id }" name={ name } type={ type ?? 'text' } placeholder={ placeholder } autocomplete={ autocomplete ?? (type == 'email' ? 'email' : (name == 'name' ? 'name' : (type == 'tel' ? 'tel' : 'off'))) } maxlength={ maxlength } required={ required } value={ value } aria-invalid={ error ? 'true' : 'false' } aria-describedby={ err } />
  {/if}
  {#if error}<p class="mt-space-xs text-body-sm text-scheme-error" id="{ err }">{ t('form_field_' + error) }</p>{/if}
</div>
