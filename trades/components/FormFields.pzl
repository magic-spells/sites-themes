<!-- component: FormFields -->
<!-- A site form's fields. The engine's field types are text, textarea, email, checkbox and select, so the id picks the input: "phone" is a telephone field. Selects are select-dropdowns with their own markup; a select with one option is sent hidden. From 48rem name and phone sit side by side when the form has both and every other field takes the full row. Placeholders are locale strings keyed by the field id. -->
{#let paired = fields | find('id', 'phone')}
<div class="grid gap-space-md md:grid-cols-2">
  {#for field in fields}
    {#let half = paired && (field.id == 'name' || field.id == 'phone')}
    {#if field.type == 'select' && field.options.length == 1}
      <input type="hidden" name={ field.id } value={ field.options[0] } />
    {:else if field.type == 'select'}
      <div class="md:col-span-2">
        <span class="mb-space-xs block text-body-sm font-medium" id="label-{ prefix }-{ field.id }">{ field.label }{#if field.required}<span aria-hidden="true"> *</span>{/if}</span>
        <select-dropdown class="text-body" aria-labelledby="label-{ prefix }-{ field.id }">
          <select-trigger class="flex min-h-control items-center justify-between gap-space-sm rounded-input border bg-scheme-surface-2 px-space-sm { field.error ? 'border-scheme-error' : 'border-transparent' }" aria-describedby={ field.error ? 'error-' + prefix + '-' + field.id : null }>
            <span class="select-label-text truncate { field.value ? '' : 'text-scheme-muted' }">{ field.value || t('choose') }</span>
            <Glyph name="chevron-down" />
          </select-trigger>
          <input type="hidden" name={ field.id } value={ field.value } />
          <select-panel>
            {#for option in field.options}<select-option value={ option } selected={ field.value == option }>{ option }</select-option>{/for}
          </select-panel>
        </select-dropdown>
        {#if field.error}<p class="mt-space-xs text-body-sm text-scheme-error" id="error-{ prefix }-{ field.id }">{ t('form_field_' + field.error) }</p>{/if}
      </div>
    {:else if field.type == 'checkbox'}
      <label class="flex items-start gap-space-xs text-body-sm md:col-span-2"><input class="mt-space-2xs size-icon accent-accent" type="checkbox" name={ field.id } value="on" checked={ field.value == 'on' } required={ field.required } />{ field.label }</label>
    {:else}
      <Field name={ field.id } label={ field.label } type={ field.id == 'phone' ? 'tel' : field.type } placeholder={ t('placeholder.' + field.id) } required={ field.required } maxlength={ field.max_length } value={ field.value } error={ field.error } prefix={ prefix } wide={ !half } />
    {/if}
  {/for}
</div>
