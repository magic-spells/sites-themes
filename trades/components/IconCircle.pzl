<!-- component: IconCircle -->
<!-- A glyph or service icon in the accent on a round surface-2. size: sm 2rem (the footer's contact rows), md 3.5rem, lg 4rem, xl 8rem (the value-prop cards); 3rem by default. -->
{#let
  box = size == 'sm' ? 'size-circle-sm' : (size == 'md' ? 'size-circle-md' : (size == 'lg' ? 'size-circle-lg' : (size == 'xl' ? 'size-circle-xl' : 'size-circle')))
  glyph = size == 'sm' ? 'size-icon-sm' : (size == 'lg' ? 'size-glyph-lg' : (size == 'xl' ? 'size-glyph-xl' : 'size-glyph'))
}
<span class="flex shrink-0 items-center justify-center rounded-full bg-scheme-surface-2 text-accent { box }"><Glyph name={ icon } cls={ glyph } /></span>
