<!-- component: ProofRow -->
<!-- The proof under the ask button in Meta, middle dots between: the star and the rating, the review count with its source, the insured line and the since year, each from the Yard settings and left out when empty. -->
{#let
  s = site.settings
  items = [s.review_count ? t('review_count', { n: s.review_count | number_with_delimiter, source: s.review_source }) : null, s.insured_line || null, s.since_year ? t('since', { year: s.since_year }) : null] | compact
}
<ul class="flex flex-wrap items-center gap-x-space-sm gap-y-space-2xs text-body-sm text-scheme-muted">
  {#if s.rating}<li class="flex items-center gap-space-2xs"><Glyph name="star-filled" cls="size-icon-sm text-accent" /><span class="font-semibold text-scheme-foreground">{ s.rating }</span></li>{/if}
  {#for item in items, i}<li class="flex items-center gap-space-sm">{#if i > 0 || s.rating}<Glyph name="dot" cls="size-dot" />{/if}{ item }</li>{/for}
</ul>
