<!-- component: Stat -->
<!-- A figure from a stats block on a surface-2 card: the numeral in Barlow at h1 so four fit a row (tabular), a trailing +, % or K in the accent, the label in Card title, the line in Meta. -->
{#let
  b = block.settings
  last = b.number | slice(-1)
  suffix = contains(['+', '%', 'K'], last)
}
<li class="grid content-start gap-space-xs rounded-card bg-scheme-surface-2 p-space-xl" data-block={ editor_id }>
  <p class="font-heading text-h1 tnum">{#if suffix}{ b.number | slice(0, size(b.number) - 1) }<span class="text-accent">{ last }</span>{:else}{ b.number }{/if}</p>
  <h3 class="text-h4 font-semibold">{ b.label }</h3>
  {#if b.text}<p class="text-body-sm text-scheme-muted">{ b.text }</p>{/if}
</li>
