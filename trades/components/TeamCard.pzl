<!-- component: TeamCard -->
<!-- A person: the 4:5 portrait, the name in Card title, the role in Meta, the credentials one per line in the Licence style. -->
{#let f = entry.fields}
<article class="grid content-start gap-space-xs { site.settings.reveal ? 'reveal reveal-fade-up' : '' }">
  <Well asset={ f.image } alt={ f.image_alt } ratio="aspect-portrait" width={ 640 } sizes="(min-width: 64rem) 20rem, 50vw" />
  <h3 class="mt-space-xs text-h4 font-semibold">{ entry.title }</h3>
  {#if f.role}<p class="text-body-sm text-scheme-muted">{ f.role }</p>{/if}
  {#if f.credentials}<ul class="grid text-body-sm font-medium tnum">{#for line in f.credentials | split('\n')}{#if line | strip}<li>{ line | strip }</li>{/if}{/for}</ul>{/if}
</article>
