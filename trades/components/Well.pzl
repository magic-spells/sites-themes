<!-- component: Well -->
<!-- A photo well: a frame on surface-2 that clips its photo, 1rem corners unless inset (inside a card that clips it). ratio is the aspect utility (aspect-photo by default, aspect-portrait, aspect-square). zoom grows the photo on the parent group's hover. -->
{#if asset}
<span class="relative block overflow-hidden bg-scheme-surface-2 { ratio ?? 'aspect-photo' } { inset ? '' : 'rounded-card' }"><img class="size-full object-cover { zoom ? 'transition-transform duration-panel group-hover:scale-105' : '' }" src="{ image_url(asset, width ?? 800) }" srcset="{ image_srcset(asset, [480, 768, 1024, 1600]) }" sizes="{ sizes ?? '100vw' }" alt="{ alt ?? asset.alt }" loading="{ eager ? 'eager' : 'lazy' }" fetchpriority={ eager ? 'high' : null } width={ asset.width } height={ asset.height } /></span>
{/if}
