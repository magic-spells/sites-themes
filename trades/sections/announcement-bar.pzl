<!-- One line on navy, the whole line one link: the offer, then the link label underlined in the accent; a close button at the right that, with a key, hides it for good. Ticker: the line repeats on a marquee with a pause button; under reduced motion it stands still. -->
{#if settings.text}
<aside class="bg-scheme-background text-scheme-foreground" data-dismiss-key="{ settings.key }" aria-label="{ t('announcement') }" data-ticker={ settings.motion == 'ticker' ? true : null }>
  <div class="flex items-center ps-tap">
    <a class="block min-w-0 flex-1 py-space-xs text-body-sm" href={ settings.link || null }>
      {#if settings.motion == 'ticker'}
        <scrolling-content class="block" speed="30" fade>
          <scrolling-track>
            <scrolling-item class="flex items-center">{#for n in [1, 2, 3]}<span class="whitespace-nowrap">{ settings.text }{#if settings.link_label} <span class="text-accent underline underline-offset-4">{ settings.link_label }</span>{/if}</span><Glyph name="dot" cls="mx-space-lg size-dot text-accent" />{/for}</scrolling-item>
          </scrolling-track>
        </scrolling-content>
      {:else}
        <span class="block text-center text-pretty">{ settings.text }{#if settings.link_label} <span class="ms-space-xs text-accent underline underline-offset-4">{ settings.link_label }</span>{/if}</span>
      {/if}
    </a>
    {#if settings.motion == 'ticker'}<button class="flex size-tap shrink-0 items-center justify-center text-scheme-meta hover:text-scheme-foreground" type="button" data-ticker-toggle aria-pressed="false"><Glyph name="pause" /><span class="sr-only">{ t('pause') }</span></button>{/if}
    <button class="flex size-tap shrink-0 items-center justify-center hover:text-accent" type="button" data-dismiss><Glyph name="close" /><span class="sr-only">{ t('dismiss') }</span></button>
  </div>
</aside>
{/if}

<schema>
{
  "name": "Announcement bar",
  "description": "One offer or the emergency line above the header, the whole line a link, with a close button.",
  "kind": "Header",
  "icon": "megaphone",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "$50 off your next repair this month" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See specials" },
    { "type": "url", "id": "link", "label": "Link", "default": "/specials" },
    { "type": "select", "id": "motion", "label": "Motion", "default": "static", "options": [
      { "value": "static", "label": "Still" },
      { "value": "ticker", "label": "Ticker" }
    ] },
    { "type": "text", "id": "key", "label": "Dismiss key", "default": "", "info": "Set a key (any word) and a closed bar stays closed for that visitor. Change it to show a new offer to everyone." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "navy" } }
  ]
}
</schema>
