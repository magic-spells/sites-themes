<!-- TODO sync with Figma -->
<!-- A town's page from the areas collection: the pin line, the Brand tagline in the town as the title, the town's line; its paragraph beside its map at 4:5; then the featured services, the jobs in the town and the reviews that name it, each under a section head; the routes centred to close. -->
{#let
  entry = page.entry
  f = entry.fields
  town = entry.title
  services = content.services.entries | sort('fields.order') | where('fields.featured') | slice(0, 6)
  projects = content.projects.entries | sort('fields.order') | where('fields.area.id', entry.id) | slice(0, 3)
  reviews = content.testimonials.entries | sort('fields.order') | slice(0, 12)
  lines = reviews | map('fields.line') | join(' | ')
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-section">
    <header class="grid max-w-reading gap-space-sm">
      <p class="flex items-center gap-space-xs text-body-sm text-scheme-muted"><Glyph name="pin" cls="size-icon text-accent" />{ t('serving', { town: town }) }</p>
      <h1 class="font-heading text-h1 case-heading text-balance text-scheme-heading">{ t('in_town', { line: site.settings.tagline, town: town }) }</h1>
      {#if f.description}<p class="text-body-lg text-pretty text-scheme-muted">{ f.description }</p>{/if}
    </header>
    <div class="grid items-start gap-space-xl md:grid-cols-text-picture md:gap-space-3xl">
      {#if f.body}<div class="sites-prose max-w-reading" data-lead>{ f.body }</div>{/if}
      <div class="md:col-start-2">{#if f.map_embed_url}<iframe class="aspect-portrait w-full rounded-card bg-scheme-surface-2" src="{ f.map_embed_url }" title="{ f.map_image_alt }" loading="lazy"></iframe>{:else}<Well asset={ f.map_image } alt={ f.map_image_alt } ratio="aspect-portrait" sizes="(min-width: 48rem) 40vw, 100vw" />{/if}</div>
    </div>
    <div>
      <SectionHead heading={ t('services') } link_label={ t('all_services') } link_href="/services" />
      <ul class="grid gap-space-md md:grid-cols-2 lg:grid-cols-3">{#for svc in services}<li><ServiceCard entry={ svc } price /></li>{/for}</ul>
    </div>
    {#if projects.length}<div>
      <SectionHead heading={ t('work_in', { town: town }) } />
      <ul class="grid gap-x-space-md gap-y-space-xl md:grid-cols-2 lg:grid-cols-3">{#for project in projects}<li><ProjectCard entry={ project } /></li>{/for}</ul>
    </div>{/if}
    {#if contains(lines, town)}<div>
      <SectionHead heading={ t('town_says', { town: town }) } />
      <ul class="grid gap-space-md md:grid-cols-2 lg:grid-cols-3">{#for review in reviews}{#if contains(review.fields.line, town)}<li><ReviewCard entry={ review } /></li>{/if}{/for}</ul>
    </div>{/if}
    <div class="flex justify-center"><Routes /></div>
  </div>
</section>

<schema>
{
  "name": "Area detail",
  "description": "A town's page from the areas collection: its paragraph and map, the services, the jobs and the reviews there.",
  "kind": "Places",
  "icon": "map",
  "templates": ["area"],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
