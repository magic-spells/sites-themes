<!-- TODO sync with Figma -->
<!-- Accreditations: an optional heading, then the logos from the blocks, muted to the scheme's text colour at 70%; a wrapping row from 48rem, a row that scrolls on phones. A logo with a link opens it. -->
<section class="bg-scheme-background py-section text-scheme-foreground md:px-gutter">
  <div class="mx-auto max-w-column">
    {#if settings.heading}<h2 class="mb-space-lg px-gutter text-center text-body-sm text-scheme-muted md:px-0">{ settings.heading }</h2>{/if}
    <ul class="flex snap-x gap-space-xl overflow-x-auto px-gutter md:flex-wrap md:items-center md:justify-center md:overflow-visible md:px-0">
      {#for block in blocks}
        <li class="shrink-0 snap-start" data-block={ block.editor_id }>
          {#if block.settings.link}<a class="block opacity-70 grayscale transition-opacity hover:opacity-100" href="{ block.settings.link }"><img class="h-control w-auto" src="{ image_url(block.settings.logo, 320) }" alt="{ block.settings.alt }" loading="lazy" width={ block.settings.logo.width } height={ block.settings.logo.height } /></a>
          {:else}<img class="h-control w-auto opacity-70 grayscale" src="{ image_url(block.settings.logo, 320) }" alt="{ block.settings.alt }" loading="lazy" width={ block.settings.logo.width } height={ block.settings.logo.height } />{/if}
        </li>
      {/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Badge row",
  "description": "Accreditation and award logos in a row.",
  "kind": "Social proof",
  "icon": "award",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Accredited by" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "blocks": [
    { "type": "badge", "name": "Badge", "settings": [
      { "type": "image", "id": "logo", "label": "Logo" },
      { "type": "text", "id": "alt", "label": "Name (alt text)" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
