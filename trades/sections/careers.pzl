<!-- Join the crew: the heading and standfirst over the openings from the blocks as rows split by hairlines (title, line in Meta, text) left, and the apply form on a chalk card right. Stacked on phones. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl md:grid-cols-2 md:gap-space-3xl">
    <div class="grid gap-space-lg">
      {#if settings.heading}<h2 class="font-heading text-h2 case-heading text-balance text-scheme-heading">{ settings.heading }</h2>{/if}
      {#if settings.text}<p class="text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
      <ul class="divide-y divide-scheme-border border-t border-scheme-border">
        {#for block in blocks}
          <li class="grid gap-space-xs py-space-lg" data-block={ block.editor_id }>
            <h3 class="text-h4 font-semibold">{ block.settings.title }</h3>
            {#if block.settings.line}<p class="text-body-sm text-scheme-muted">{ block.settings.line }</p>{/if}
            {#if block.settings.text}<div class="sites-prose text-body">{ block.settings.text }</div>{/if}
          </li>
        {/for}
      </ul>
    </div>
    <FormCard handle={ settings.form } prefix="apply" />
  </div>
</section>

<schema>
{
  "name": "Careers",
  "description": "Open roles beside the apply form.",
  "kind": "Content",
  "icon": "briefcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the crew" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "Two openings this autumn." },
    { "type": "form", "id": "form", "label": "Apply form", "default": "apply" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "blocks": [
    { "type": "opening", "name": "Opening", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "line", "label": "Line (full time, the pay)" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" }, "blocks": [
      { "type": "opening", "settings": { "title": "Heating engineer", "line": "Full time · Ashby", "text": "<p>Gas Safe registered, three years on boilers and heat pumps. Your own van, weekdays, one Saturday in four.</p>" } },
      { "type": "opening", "settings": { "title": "Apprentice plumber", "line": "Full time · Ashby · Paid training", "text": "<p>No experience needed, a driving licence and an early start are. Four years with us and college one day a week.</p>" } }
    ] }
  ]
}
</schema>
