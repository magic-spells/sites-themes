<!-- TODO sync with Figma -->
<!-- Join the crew: the section head, the openings from the blocks as rows on hairlines (title, line in Meta, text) left, and the apply form on a chalk card right. Stacked on phones. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <div class="grid items-start gap-space-xl md:grid-cols-2 md:gap-space-3xl">
      <ul class="border-t border-scheme-border">
        {#for block in blocks}
          <li class="grid gap-space-xs border-b border-scheme-border py-space-lg" data-block={ block.editor_id }>
            <h3 class="text-h4 font-semibold">{ block.settings.title }</h3>
            {#if block.settings.line}<p class="text-body-sm text-scheme-muted">{ block.settings.line }</p>{/if}
            {#if block.settings.text}<div class="sites-prose text-body">{ block.settings.text }</div>{/if}
          </li>
        {/for}
      </ul>
      <FormCard handle={ settings.form } prefix="apply" />
    </div>
  </div>
</section>

<schema>
{
  "name": "Careers",
  "description": "Open roles beside the apply form.",
  "kind": "Content",
  "icon": "briefcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Open roles" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "Local work, a van of your own and a family firm that has been here since 1986." },
    { "type": "form", "id": "form", "label": "Apply form", "default": "apply" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "blocks": [
    { "type": "opening", "name": "Opening", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "line", "label": "Line (full time, the pay)" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" }, "blocks": [
      { "type": "opening", "settings": { "title": "Heating engineer", "line": "Full time · Gas Safe registered · from $62,000", "text": "<p>Boiler installs, servicing and fault-finding across Ashby and the towns around it. Your own van and tools.</p>" } },
      { "type": "opening", "settings": { "title": "Apprentice plumber", "line": "Full time · four-year apprenticeship", "text": "<p>Learn the trade on real jobs beside Dan and Priya, with college one day a week paid.</p>" } }
    ] }
  ]
}
</schema>
