<!-- TODO sync with Figma -->
<!-- The contact page's form: the heading, the standfirst and the four contact rows left; the contact form (name, email, subject, message) on a chalk card right. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-start gap-space-xl md:grid-cols-2 md:gap-space-3xl">
    <div class="grid gap-space-lg">
      <div class="grid gap-space-md">
        <h2 class="font-heading text-h2 case-heading text-balance text-scheme-heading">{ settings.heading }</h2>
        {#if settings.text}<p class="max-w-reading text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
      </div>
      <ContactRows />
    </div>
    <div class="sites-scheme-chalk rounded-card border border-scheme-border bg-scheme-background p-space-xl text-scheme-foreground">
      <EstimateFields handle={ settings.form || site.settings.contact_form } prefix="contact" plain />
    </div>
  </div>
</section>

<schema>
{
  "name": "Contact",
  "description": "A contact form on a card beside the ways to reach you.",
  "kind": "Contact",
  "icon": "mail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Write to the yard" },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "For an existing job, a bill or anything that is not an estimate. Sarah answers within one business day." },
    { "type": "form", "id": "form", "label": "Form", "info": "Leave empty to use the Contact form setting." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
