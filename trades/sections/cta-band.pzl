<!-- TODO sync with Figma -->
<!-- Stub (code B builds it): the heading, the Yard confirm line and the routes; inline adds the estimate form on a chalk card. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl { settings.form == 'inline' ? 'md:grid-cols-2' : '' }">
    <div class="grid gap-space-md">
      <h2 class="font-heading text-display case-heading text-balance text-scheme-heading">{ settings.heading }</h2>
      {#if site.settings.confirm_line}<p class="text-body-lg text-scheme-muted">{ site.settings.confirm_line }</p>{/if}
      <Routes />
    </div>
    {#if settings.form == 'inline'}<div class="sites-scheme-chalk rounded-card bg-scheme-background p-space-xl text-scheme-foreground"><EstimateFields prefix="cta-{ section.id }" /></div>{/if}
  </div>
</section>

<schema>
{
  "name": "CTA band",
  "description": "The band every page ends on: the heading, the routes and, inline, the estimate form.",
  "kind": "Contact",
  "icon": "mouse-pointer-click",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready when you are." },
    { "type": "select", "id": "form", "label": "Form", "default": "none", "options": [
      { "value": "none", "label": "None: the routes only" },
      { "value": "inline", "label": "Inline: the estimate form beside" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "presets": [
    { "name": "Routes", "settings": { "form": "none", "color_scheme": "navy" } },
    { "name": "Inline", "settings": { "form": "inline", "color_scheme": "navy" } }
  ]
}
</schema>
