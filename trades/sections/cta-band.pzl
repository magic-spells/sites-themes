<!-- TODO sync with Figma -->
<!-- The band every page ends on, with a hairline at its foot above the footer. None: the Display heading, the Yard confirm line and the routes centred, the proof row under a rule. Inline: five parts to seven from 48rem, the heading, the routes stacked and the licence lines left; the estimate form on a chalk card right, the confirm line under its button. -->
{#let s = site.settings}
<section class="border-b border-scheme-border bg-scheme-background px-gutter py-section text-scheme-foreground">
  {#if settings.form == 'inline'}
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:grid-cols-picture-text md:gap-space-3xl">
    <div class="grid justify-items-start gap-space-lg">
      <h2 class="font-heading text-display case-heading text-balance text-scheme-heading">{ settings.heading }</h2>
      <Routes stack />
      {#if s.licence_lines}<p class="grid border-t border-scheme-border pt-space-md text-body-sm font-semibold tnum">{#for line in s.licence_lines | split('\n')}<span>{ line }</span>{/for}</p>{/if}
    </div>
    <div class="sites-scheme-chalk rounded-card border border-scheme-border bg-scheme-background p-space-xl text-scheme-foreground"><EstimateFields prefix="cta-{ section.id }" /></div>
  </div>
  {:else}
  <div class="mx-auto grid max-w-column justify-items-center gap-space-lg text-center">
    <h2 class="font-heading text-display case-heading text-balance text-scheme-heading">{ settings.heading }</h2>
    {#if s.confirm_line}<p class="text-body-lg text-pretty text-scheme-muted">{ s.confirm_line }</p>{/if}
    <Routes />
    <div class="grid w-full justify-items-center border-t border-scheme-border pt-space-lg"><ProofRow /></div>
  </div>
  {/if}
</section>

<schema>
{
  "name": "CTA band",
  "description": "The band every page ends on: the heading, the routes and, inline, the estimate form.",
  "kind": "Contact",
  "icon": "mouse-pointer-click",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready when you are." },
    { "type": "select", "id": "form", "label": "Form", "default": "none", "options": [
      { "value": "none", "label": "None: the routes only" },
      { "value": "inline", "label": "Inline: the estimate form beside" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "presets": [
    { "name": "Routes", "settings": { "form": "none", "color_scheme": "navy" } },
    { "name": "Inline", "settings": { "form": "inline", "color_scheme": "navy" } }
  ]
}
</schema>
