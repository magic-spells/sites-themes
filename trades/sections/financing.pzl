<!-- TODO sync with Figma -->
<!-- Pay over time, from the Yard financing line and link; nothing when both are empty. Band: one row from 48rem, the heading, the line over the fine print, the lender button. Split: the same copy stacked, seven parts to five beside the photo. -->
{#let
  s = site.settings
  split = settings.layout == 'split'
}
{#if s.financing_url || s.financing_line}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl { split ? 'md:grid-cols-text-picture md:gap-space-3xl' : '' }">
    <div class="flex flex-col items-start gap-space-lg { split ? '' : 'md:flex-row md:items-center md:gap-space-xl' }">
      <h2 class="flex-1 font-heading text-h2 case-heading text-balance text-scheme-heading">{ settings.heading }</h2>
      <div class="grid flex-1 gap-space-2xs">
        {#if s.financing_line}<p class="text-body-lg text-pretty">{ s.financing_line }</p>{/if}
        {#if settings.fine_print}<p class="text-body-sm text-scheme-muted">{ settings.fine_print }</p>{/if}
      </div>
      {#if s.financing_url}<Button href={ s.financing_url }>{ settings.button_label }</Button>{/if}
    </div>
    {#if split}<Well asset={ settings.image } alt={ settings.image_alt } sizes="(min-width: 48rem) 40vw, 100vw" />{/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Financing",
  "description": "Pay over time: the line, the lender button and the fine print.",
  "kind": "Offers",
  "icon": "receipt",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "band", "options": [
      { "value": "band", "label": "A band" },
      { "value": "split", "label": "Beside a photo" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Comfort now, pay over time." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See financing" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Subject to credit approval" },
    { "type": "image", "id": "image", "label": "Image (split)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "chalk" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "chalk" } }
  ]
}
</schema>
