<!-- A photo beside copy: the text and the 3:2 photo in halves from 48rem, the photo left or right; stacked on phones, the photo first. The heading, the rich text and one outlined button. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column items-center gap-space-xl md:grid-cols-2 md:gap-space-3xl">
    <div class="grid justify-items-start gap-space-md { settings.image_side == 'left' ? 'md:order-last' : '' }">
      <h2 class="font-heading text-h2 case-heading text-balance text-scheme-heading">{ settings.heading }</h2>
      <div class="sites-prose max-w-reading text-body-lg">{ settings.text }</div>
      {#if settings.link_label && settings.link}<Button href={ settings.link } tone="outline">{ settings.link_label }</Button>{/if}
    </div>
    <div class="max-md:order-first"><Well asset={ settings.image } alt={ settings.image_alt } ratio="aspect-photo" width={ 960 } sizes="(min-width: 48rem) 45vw, 100vw" /></div>
  </div>
</section>

<schema>
{
  "name": "Image with text",
  "description": "A photo beside a heading, text and a button.",
  "kind": "Content",
  "icon": "columns-2",
  "settings": [
    { "type": "image", "id": "image", "label": "Image (4:5)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "select", "id": "image_side", "label": "Image", "default": "right", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One crew, start to finish" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The people who quote your job are the people who do it. No subcontractors, no strangers in your kitchen.</p>" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "About us" },
    { "type": "url", "id": "link", "label": "Button link", "default": "/about" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
