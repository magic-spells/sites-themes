<!-- TODO sync with Figma -->
<!-- Two or more yards as cards, two across from 48rem: the 3:2 photo, the name, the address, the hours line by line, the phone and Directions. -->
{#let locs = content.locations.entries | sort('fields.order') | slice(0, 12)}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid gap-space-lg md:grid-cols-2">
      {#for loc in locs}
        {#let f = loc.fields}
        <li class="grid content-start gap-space-md rounded-card border border-scheme-border bg-scheme-card p-space-lg">
          <Well asset={ f.image } alt={ f.image_alt } sizes="(min-width: 48rem) 40vw, 100vw" />
          <h3 class="text-h4 font-semibold">{ loc.title }</h3>
          {#if f.address}<p class="whitespace-pre-line text-body">{ f.address }</p>{/if}
          {#if f.hours}<p class="whitespace-pre-line text-body-sm text-scheme-muted tnum">{ f.hours }</p>{/if}
          <div class="flex flex-wrap items-center gap-space-md">
            {#if f.phone}<a class="font-heading text-h4 tnum hover:text-accent" href="tel:{ f.phone | replace(' ', '') }">{ f.phone }</a>{/if}
            {#if f.map_url}<a class="text-body-sm text-accent underline underline-offset-4" href="{ f.map_url }">{ t('directions') }</a>{/if}
          </div>
        </li>
      {/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Locations",
  "description": "Every yard or office as a card with its address, hours and phone.",
  "kind": "Contact",
  "icon": "map",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our yards" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
