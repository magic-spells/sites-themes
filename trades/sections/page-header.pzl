<!-- A page's head: the h1 in capitals (the page title unless a heading is set), the standfirst under it, and the Yard rating pill when show rating is on (the Reviews page). Left or centred, over the section head's rule. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-md border-rule pb-space-lg { settings.align == 'center' ? 'justify-items-center text-center' : 'justify-items-start' }">
    <h1 class="max-w-reading font-heading text-h1 case-heading text-balance text-scheme-heading">{ settings.heading || page.title }</h1>
    {#if settings.text}<p class="max-w-reading text-body-lg text-pretty text-scheme-muted">{ settings.text }</p>{/if}
    {#if settings.show_rating}<RatingPill />{/if}
  </div>
</section>

<schema>
{
  "name": "Page header",
  "description": "The page's title, a standfirst and, on the reviews page, the rating.",
  "kind": "Content",
  "icon": "heading-1",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Centred" }
    ] },
    { "type": "checkbox", "id": "show_rating", "label": "Rating", "default": false, "info": "The Yard rating, review count and link." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } },
    { "name": "Reviews", "settings": { "show_rating": true, "color_scheme": "paper" } }
  ]
}
</schema>
