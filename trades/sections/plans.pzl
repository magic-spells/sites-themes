<!-- Maintenance plans: the section head, then the plans as cards, two (or three from 64rem) across, the row centred and each card at most 26.25rem; stacked on phones. -->
{#let
  all = content.plans.entries | sort('fields.order')
  plans = (settings.source == 'featured' ? all | where('fields.featured') : all) | slice(0, 12)
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="mx-auto grid gap-space-sm md:w-fit md:gap-space-lg md:grid-cols-2 { settings.columns == 3 ? 'lg:grid-cols-3' : '' }">{#for entry in plans}<li><PlanCard entry={ entry } /></li>{/for}</ul>
  </div>
</section>

<schema>
{
  "name": "Plans",
  "description": "Maintenance plans and memberships as cards with their price and what they include.",
  "kind": "Offers",
  "icon": "receipt",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Plans that pay for themselves" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "Cancel any time." },
    { "type": "select", "id": "source", "label": "Plans", "default": "all", "options": [
      { "value": "all", "label": "All" },
      { "value": "featured", "label": "Featured" }
    ] },
    { "type": "range", "id": "columns", "label": "Columns from 64rem", "min": 2, "max": 3, "step": 1, "default": 2 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "chalk" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "chalk" } }
  ]
}
</schema>
