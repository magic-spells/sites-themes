<!-- TODO sync with Figma -->
<!-- A job's page: the 3:2 photo, the service, town and date in Meta, the title, the summary, the before and after when both are set, the story in the reading column, the photos three then two across (each opens the lightbox of a hidden carousel of the same photos, theme.ts) and three more jobs of the same service. -->
{#let
  entry = page.entry
  f = entry.fields
  photos = f.photos ? f.photos.items | slice(0, 12) : []
  id = 'photos-' + section.id
  more = f.service ? content.projects.entries | sort('fields.order') | where('fields.service.id', f.service.id) | reject('id', entry.id) | slice(0, 3) : []
}
<article class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto grid max-w-column gap-space-xl">
    <Well asset={ f.image } alt={ f.image_alt } width={ 1600 } sizes="(min-width: 82.5rem) 82.5rem, 100vw" eager />
    <header class="grid max-w-reading gap-space-sm">
      <p class="text-body-sm text-scheme-muted">{ [f.service.title, f.area.title, f.date ? f.date | date : null] | compact | join(' · ') }</p>
      <h1 class="font-heading text-h1 case-heading text-balance text-scheme-heading">{ entry.title }</h1>
      {#if f.summary}<p class="text-body-lg text-pretty text-scheme-muted">{ f.summary }</p>{/if}
    </header>
    <PairWell entry={ entry } />
    {#if f.description}<div class="sites-prose max-w-reading" data-lead>{ f.description }</div>{/if}
    {#if photos.length}<div class="mt-space-xl grid gap-space-lg">
      <h2 class="font-heading text-h3 case-heading text-scheme-heading">{ t('photos') }</h2>
      <ul class="grid grid-cols-2 gap-space-md lg:grid-cols-3">
        {#for item in photos, i}<li><a class="group block cursor-zoom-in" href="{ image_url(item.asset, 2560) }" data-lightbox-open={ id } data-index={ i } aria-label="{ t('open_photo', { index: i + 1 }) }"><Well asset={ item.asset } alt={ item.alt } ratio="aspect-square" width={ 640 } sizes="(min-width: 64rem) 26rem, 50vw" zoom /></a></li>{/for}
      </ul>
      <tarot-carousel class="hidden" id={ id }>
        <script type="application/json" data-tarot-options>{ { lightbox: true, draggable: false, navigation: { showButtons: false, showPagination: false } } | json }</script>
        <tarot-viewport><tarot-track>
          {#for item in photos}<tarot-slide><img src="{ image_url(item.asset, 480) }" data-tarot-lightbox-src="{ image_url(item.asset, 2560) }" alt="{ item.alt }" loading="lazy" width={ item.asset.width } height={ item.asset.height } /></tarot-slide>{/for}
        </tarot-track></tarot-viewport>
      </tarot-carousel>
    </div>{/if}
    {#if more.length}<div class="mt-space-xl grid gap-space-lg">
      <h2 class="font-heading text-h3 case-heading text-scheme-heading">{ t('more_work') }</h2>
      <ul class="grid gap-x-space-md gap-y-space-xl md:grid-cols-3">{#for project in more}<li><ProjectCard entry={ project } /></li>{/for}</ul>
    </div>{/if}
  </div>
</article>

<schema>
{
  "name": "Project detail",
  "description": "A job's page: the photo, before and after, the story, the photos and more like it.",
  "kind": "Collections",
  "icon": "file-text",
  "templates": ["project"],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
