<!-- Featured jobs on a tarot strip of equal slides at one shape, 1.25 across on phones inside the gutters, the slides beside showing through them, then whole slides, 2 from 48rem and 3 from 64rem. From 48rem the progress hairline and the round arrows sit under it. -->
{#let
  id = 'strip-' + section.id
  projects = content.projects.entries | sort('fields.order') | where('fields.featured') | slice(0, 12)
  nav = { showButtons: true, showPagination: false }
  options = { slidesPerView: 1.25, gap: '1rem', progressBar: { selector: '#bar-' + id }, navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { slidesPerView: 2, gap: '1.5rem', navigation: nav }, '1024': { slidesPerView: 3, gap: '1.5rem', navigation: nav } } }
}
<section class="overflow-hidden bg-scheme-background px-gutter py-section text-scheme-foreground">
  <tarot-carousel class="mx-auto block max-w-column" id={ id }>
    <script type="application/json" data-tarot-options>{ options | json }</script>
    <SectionHead heading={ settings.heading } link_label={ settings.link_label } link_href={ settings.link_href } />
    <tarot-viewport class="max-md:overflow-visible"><tarot-track>
      {#for entry in projects}<tarot-slide><ProjectCard entry={ entry } ratio="aspect-{ settings.slide_ratio }" /></tarot-slide>{/for}
    </tarot-track></tarot-viewport>
    <Arrows bar="bar-{ id }" />
  </tarot-carousel>
</section>

<schema>
{
  "name": "Projects strip",
  "description": "Featured jobs on a carousel of equal slides.",
  "kind": "Collections",
  "icon": "gallery-horizontal",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recent work" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "All work" },
    { "type": "url", "id": "link_href", "label": "Button link", "default": "/work" },
    { "type": "select", "id": "slide_ratio", "label": "Slide shape", "default": "photo", "options": [
      { "value": "photo", "label": "3:2" },
      { "value": "square", "label": "1:1" },
      { "value": "portrait", "label": "4:5" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "chalk" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "chalk" } }
  ]
}
</schema>
