<!-- The Services page: every service as a row (icon, name, summary, price line, Details), two columns from 64rem. Grouped by tag: one group per tag in order of first appearance, the untagged under "Services"; below 48rem each group folds, the first open. -->
{#let
  all = content.services.entries | sort('fields.order') | slice(0, 12)
  tags = all | map('fields.tag') | uniq
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    {#if settings.group_by_tag}
      <div class="grid gap-space-xl">
        {#for tag in tags, i}
          {#let group = all | where('fields.tag', tag)}
          <collapsible-component class="block">
            <h2><button class="group flex w-full items-center justify-between gap-space-md border-b border-scheme-border pb-space-sm text-left font-heading text-h3 md:pointer-events-none" type="button">{ tag || t('services') }<Glyph name="chevron-down" cls="size-icon text-accent transition-transform duration-fast group-aria-expanded:rotate-180 md:hidden" /></button></h2>
            <collapsible-content open={ i == 0 } data-unfold>
              <ul class="grid gap-x-space-3xl lg:grid-cols-2">{#for entry in group}<ServiceRow entry={ entry } />{/for}</ul>
            </collapsible-content>
          </collapsible-component>
        {/for}
      </div>
    {:else}
      <ul class="grid gap-x-space-3xl lg:grid-cols-2">{#for entry in all}<ServiceRow entry={ entry } />{/for}</ul>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Services list",
  "description": "Every service as a row with its price and a Details link, in two columns, optionally grouped by tag.",
  "kind": "Services",
  "icon": "layout-list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "checkbox", "id": "group_by_tag", "label": "Group by tag", "default": false, "info": "One group per tag; the groups fold on phones." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
