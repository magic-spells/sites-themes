<!-- The numbers: the section head, then the figures as surface-2 cards in one row from 64rem (as many columns as figures), two across from 48rem, stacked on phones; typed strings, never counted up. -->
{#let n = blocks.length}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid gap-space-sm md:grid-cols-2 md:gap-space-lg { n == 3 ? 'lg:grid-cols-3' : (n > 3 ? 'lg:grid-cols-4' : '') } { settings.align == 'center' ? 'text-center' : '' }">{#for block in blocks | slice(0, 4)}<Stat block={ block } editor_id={ block.editor_id } />{/for}</ul>
  </div>
</section>

<schema>
{
  "name": "Stats",
  "description": "Two to four figures as cards: years, jobs, the guarantee, the rating.",
  "kind": "Content",
  "icon": "hash",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "By the numbers" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Centred" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "number", "label": "Figure (38, 12,400+)" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "text", "label": "Line" }
    ] }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "navy" }, "blocks": [
      { "type": "stat", "settings": { "number": "38", "label": "Years in business", "text": "Second generation, same yard." } },
      { "type": "stat", "settings": { "number": "12,400+", "label": "Jobs completed", "text": "Across Ashby and ten towns." } },
      { "type": "stat", "settings": { "number": "12", "label": "Month guarantee", "text": "Parts and labour, every job." } },
      { "type": "stat", "settings": { "number": "4.9", "label": "Google rating", "text": "From 612 reviews." } }
    ] }
  ]
}
</schema>
