<!-- The crew: 4:5 portraits with the name, the role and the credentials, four across from 64rem and two below; or one crew photo across the column when the layout is group. -->
{#let
  team = content.team.entries | sort('fields.order')
  people = (settings.source == 'featured' ? team | where('fields.featured') : team) | slice(0, settings.limit)
}
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    {#if settings.layout == 'group' && settings.image}
      <Well asset={ settings.image } alt={ settings.image_alt } width={ 1600 } sizes="(min-width: 82.5rem) 82.5rem, 100vw" />
    {:else}
      <ul class="grid grid-cols-2 gap-x-space-sm gap-y-space-xl lg:grid-cols-4 lg:gap-x-space-lg">{#for entry in people}<li><TeamCard entry={ entry } /></li>{/for}</ul>
    {/if}
  </div>
</section>

<schema>
{
  "name": "Team grid",
  "description": "The crew as portraits with their role and credentials, or one crew photo.",
  "kind": "Team",
  "icon": "users",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The crew" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "portraits", "options": [
      { "value": "portraits", "label": "Portraits" },
      { "value": "group", "label": "One crew photo" }
    ] },
    { "type": "image", "id": "image", "label": "Crew photo (3:2)" },
    { "type": "text", "id": "image_alt", "label": "Crew photo alt text", "default": "" },
    { "type": "select", "id": "source", "label": "People", "default": "all", "options": [
      { "value": "all", "label": "Everyone" },
      { "value": "featured", "label": "Featured" }
    ] },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 8 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Default", "settings": { "color_scheme": "paper" } }
  ]
}
</schema>
