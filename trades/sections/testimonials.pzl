<!-- TODO sync with Figma -->
<!-- What neighbours say: the section head with the Yard rating pill at its right. Rows: review cards three across from 64rem, two from 48rem, one on phones. Carousel: the same cards on a tarot track, 1.1, 2 then 3 across, the progress hairline and round arrows under it. Featured first or all, capped at the limit. -->
{#let
  id = 'reviews-' + section.id
  all = content.testimonials.entries | sort('fields.order')
  reviews = (settings.source == 'featured' ? all | where('fields.featured') : all) | slice(0, settings.limit)
  options = { progressBar: { selector: '#bar-' + id }, slidesPerView: 1.1, gap: '1rem', navigation: { showButtons: false, showPagination: false }, breakpoints: { '768': { slidesPerView: 2, gap: '1.5rem', navigation: { showButtons: true, showPagination: false } }, '1024': { slidesPerView: 3, gap: '1.5rem', navigation: { showButtons: true, showPagination: false } } } }
}
{#if reviews.length}
<section class="overflow-hidden bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text }>{#if settings.show_rating}<RatingPill />{/if}</SectionHead>
    {#if settings.layout == 'carousel'}
      <tarot-carousel class="block" id={ id }>
        <script type="application/json" data-tarot-options>{ options | json }</script>
        <tarot-viewport class="overflow-visible"><tarot-track>
          {#for entry in reviews}<tarot-slide><ReviewCard entry={ entry } /></tarot-slide>{/for}
        </tarot-track></tarot-viewport>
        <Arrows bar="bar-{ id }" />
      </tarot-carousel>
    {:else}
      <ul class="grid gap-space-md md:grid-cols-2 lg:grid-cols-3">{#for entry in reviews}<li><ReviewCard entry={ entry } /></li>{/for}</ul>
    {/if}
  </div>
</section>
{/if}

<schema>
{
  "name": "Testimonials",
  "description": "Reviews as cards in rows or a carousel, with the rating beside the heading.",
  "kind": "Social proof",
  "icon": "message-square-quote",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear what your neighbors say" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "checkbox", "id": "show_rating", "label": "Rating", "default": true, "info": "The Yard rating, review count and link at the right of the heading." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "rows", "options": [
      { "value": "rows", "label": "Rows" },
      { "value": "carousel", "label": "Carousel" }
    ] },
    { "type": "select", "id": "source", "label": "Reviews", "default": "featured", "options": [
      { "value": "featured", "label": "Featured" },
      { "value": "all", "label": "All" }
    ] },
    { "type": "range", "id": "limit", "label": "Most to show", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "paper" }
  ],
  "presets": [
    { "name": "Rows", "settings": { "layout": "rows", "color_scheme": "paper" } },
    { "name": "Carousel", "settings": { "layout": "carousel", "source": "all", "limit": 12, "color_scheme": "charcoal" } }
  ]
}
</schema>
