<!-- TODO sync with Figma -->
<!-- Stub (code B builds it): the section head and the reasons from the blocks, as tall cards or one row of columns. -->
<section class="bg-scheme-background px-gutter py-section text-scheme-foreground">
  <div class="mx-auto max-w-column">
    <SectionHead heading={ settings.heading } text={ settings.text } />
    <ul class="grid gap-space-md md:grid-cols-2 { settings.layout == 'row' ? 'lg:grid-cols-4' : 'lg:grid-cols-3' }">
      {#for block in blocks | slice(0, settings.layout == 'row' ? 4 : 12)}<ValueProp block={ block } editor_id={ block.editor_id } layout={ settings.layout == 'row' ? 'column' : 'card' } />{/for}
    </ul>
  </div>
</section>

<schema>
{
  "name": "Value props",
  "description": "The reasons to call: tall cards with a big icon, or one row of four.",
  "kind": "Content",
  "icon": "badge-check",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Hollis & Sons" },
    { "type": "text", "id": "text", "label": "Standfirst", "default": "" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "cards", "options": [
      { "value": "cards", "label": "Tall cards" },
      { "value": "row", "label": "One row of four" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "navy" }
  ],
  "blocks": [
    { "type": "prop", "name": "Value prop", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "shield-check", "options": [
        { "value": "shield-check", "label": "Shield" }, { "value": "badge-check", "label": "Badge" }, { "value": "clock", "label": "Clock" },
        { "value": "check", "label": "Check" }, { "value": "house", "label": "House" }, { "value": "star", "label": "Star" },
        { "value": "wrench", "label": "Wrench" }, { "value": "truck", "label": "Van" }, { "value": "phone", "label": "Phone" }
      ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Line" }
    ] }
  ],
  "presets": [
    { "name": "Cards", "settings": { "layout": "cards", "color_scheme": "navy" }, "blocks": [
      { "type": "prop", "settings": { "icon": "shield-check", "title": "Licensed & insured", "text": "Every technician carries a state licence and we are insured to $5M." } },
      { "type": "prop", "settings": { "icon": "badge-check", "title": "Upfront pricing", "text": "A fixed price before we start, and the invoice matches it." } },
      { "type": "prop", "settings": { "icon": "clock", "title": "Same-day callouts", "text": "A real person answers, and a van is on its way within the hour." } },
      { "type": "prop", "settings": { "icon": "check", "title": "12-month guarantee", "text": "Every job guaranteed for a year, parts and labour." } },
      { "type": "prop", "settings": { "icon": "house", "title": "Family-run since 1986", "text": "Second generation, same yard, same phone number." } },
      { "type": "prop", "settings": { "icon": "star", "title": "4.9 on Google", "text": "612 reviews from your neighbours across ten towns." } }
    ] },
    { "name": "Row", "settings": { "layout": "row", "color_scheme": "paper" }, "blocks": [
      { "type": "prop", "settings": { "icon": "shield-check", "title": "Licensed & insured", "text": "Every technician carries a state licence and we are insured to $5M." } },
      { "type": "prop", "settings": { "icon": "badge-check", "title": "Upfront pricing", "text": "A fixed price before we start, and the invoice matches it." } },
      { "type": "prop", "settings": { "icon": "clock", "title": "Same-day callouts", "text": "A real person answers, and a van is on its way within the hour." } },
      { "type": "prop", "settings": { "icon": "check", "title": "12-month guarantee", "text": "Every job guaranteed for a year, parts and labour." } }
    ] }
  ]
}
</schema>
